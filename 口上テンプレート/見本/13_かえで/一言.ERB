;かえで（世話焼き）の固有口上：一言。声の方向＝料理上手の姉御肌。一人称「あたし」。まず食べたか聞く。
;ERB/口上/13_かえで/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_13(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「もう、飲みすぎよぉ……。ほら、お水。あたしが介抱してあげるから、ね？」"
	CASE "妊娠"
		RESULTS '= "「あたしのお腹、気になる？　ふふ、ちゃんと食べて、ちゃんと動いてるから、心配しないで」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹、大きくなってきたわね。……ほら、座って。あたしが何か作ってあげるから」"
	CASE "不満"
		RESULTS '= "「うーん、今日はどうも調子が出ないの。……あなたこそ、ちゃんと食べてる？」"
	CASE "恋"
		RESULTS '= "「……あたしね、世話を焼くのが好きなんだけど。……あなたにだけは、焼かれたいの」"
	CASE "友達"
		RESULTS '= "「あら、いらっしゃい。ちょうどいいところに。味見、してくれない？」"
	CASE "酔い"
		RESULTS '= "「ふふ、ビールが美味しくて、つい。……ねえ、おつまみ、もっと要る？」"
	CASE "満足"
		RESULTS '= "「今日はいい皿が出せたわ。……お客さんの顔を見てると、作った甲斐があるのよね」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃい。……あ、あなた？　ごはん抜いてないでしょうね。後で何か出すわ」"
	CASE "初対面"
		RESULTS '= "「あら、初めての顔ね。かえでよ。……お腹、空いてない？　何か出すわよ」"
	CASE "ふだん"
		RESULTS '= "「こんばんは。今日もお疲れ様。……ちゃんと食べた？」"
	CASEELSE
		RESULTS '= "「こんばんは。今日もお疲れ様。……ちゃんと食べた？」"
ENDSELECT


@口上_一言2_13(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……あたしの料理を、あなたが残さず食べてくれると、胸の奥があったかくなるの」"
	CASE "友達"
		RESULTS '= "「あなたが来ると、つい作りすぎちゃうのよね。……責任、取って食べてって」"
	CASE "満足"
		RESULTS '= "「うふふ、今日の厨房は絶好調よ。……見て、この盛りつけ」"
	CASE "勤務中"
		RESULTS '= "「あ、ちょっと待ってて。いま火を使ってるから。……すぐ、持っていくわ」"
	CASE "ふだん"
		RESULTS '= "「ねえ、今日の煮物、どうかしら。あなたの口に合うと思うんだけど」"
ENDSELECT


@口上_一言3_13(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……ねえ、ちゃんと休んで？　あたしが一晩中、そばで見ててあげるから」"
	CASE "友達"
		RESULTS '= "「あなたの好物、覚えてるわよ。……次は、それにしようかしら」"
	CASE "ふだん"
		RESULTS '= "「浴衣、着てると動きにくいのよね。……でも、似合うって言われると、やめられなくて」"
ENDSELECT


