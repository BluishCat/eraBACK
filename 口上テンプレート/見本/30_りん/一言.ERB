;りん（甘え）の固有口上：一言。声の方向＝語尾を伸ばす甘えん坊。一人称「りん」「あたし」。〜だもん。
;ERB/口上/30_りん/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_30(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「うぅ〜、りん、もう飲めなぁい……。ねぇ〜、おんぶして〜」"
	CASE "妊娠"
		RESULTS '= "「ねぇねぇ、お腹、ふくらんできたでしょ？　……触って、いいよ？」"
	CASE "あなたの妊娠"
		RESULTS '= "「ねぇ、お腹、おっきくなったね〜。……ちゃんと座って？　りんが、肩もんだげる」"
	CASE "不満"
		RESULTS '= "「む〜……今日、なんかつまんない。……ねぇ、かまってよぉ」"
	CASE "恋"
		RESULTS '= "「……ねぇ、りんのこと、ちゃんと見ててくれる？　……ほかの子、見ちゃやだよ？」"
	CASE "友達"
		RESULTS '= "「あ、来たー！　待ってたんだよ〜。ねぇ、今日は何して遊ぶ？」"
	CASE "酔い"
		RESULTS '= "「えへへ〜、ちょっと酔っちゃったぁ。……ねぇ、ぎゅってして？」"
	CASE "満足"
		RESULTS '= "「今日、楽しかったぁ！　りん、また来たいなぁ〜」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃいませぇ〜。……あ、あなただ。ちょっと待っててね、すぐ行くから！」"
	CASE "初対面"
		RESULTS '= "「はじめまして〜。りんだよ、よろしくね〜」"
	CASE "ふだん"
		RESULTS '= "「やっほ〜。今日もよろしくね。りん、あなたに会えるの、楽しみにしてたんだよ？」"
	CASEELSE
		RESULTS '= "「やっほ〜。今日もよろしくね。りん、あなたに会えるの、楽しみにしてたんだよ？」"
ENDSELECT


