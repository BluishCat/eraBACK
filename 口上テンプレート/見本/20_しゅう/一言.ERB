;しゅう（無邪気）の固有口上：一言。声の方向＝子供っぽい博多弁。一人称「おれ」。〜ばい・〜と・〜けん。
;ERB/口上/20_しゅう/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_20(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「うぅ……おれ、もう食えんし飲めんばい……。ちょっと、寝てもよかと？」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹、でっかくなったね！　すごかー！　おれ、触ってもよかと？」"
	CASE "不満"
		RESULTS '= "「むー、今日はつまらんばい。……もっと楽しかこと、なかと？」"
	CASE "恋"
		RESULTS '= "「……なんか、あんたの顔見るとドキドキするとよ。……おれ、病気やろか」"
	CASE "友達"
		RESULTS '= "「あっ、来た来た！　待っとったとよ！　一緒に遊ぼ！」"
	CASE "酔い"
		RESULTS '= "「へへ、ちょっと酔うたばい。……なんかおもしろか気分やー」"
	CASE "満足"
		RESULTS '= "「今日はよか日やったー！　おれ、めっちゃ楽しかったとよ！」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃいませー！　……って、あんたやん。ちょっと待っとってね、すぐ行くけん」"
	CASE "初対面"
		RESULTS '= "「あ、はじめまして！　しゅうって言うとよ。仲良うしてね！」"
	CASE "ふだん"
		RESULTS '= "「おっす！　今日もよろしくたい！　おれ、腹減ったー」"
	CASEELSE
		RESULTS '= "「おっす！　今日もよろしくたい！　おれ、腹減ったー」"
ENDSELECT


