;ゆうじ（高慢）の固有口上：一言。声の方向＝強気で自信過剰の関西弁。一人称「俺」。〜やろ・〜や。
;ERB/口上/26_ゆうじ/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_26(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「あー……ちょっと飲みすぎたわ。……こら、笑うなや。俺が酔うとるのは、お前のせいや」"
	CASE "あなたの妊娠"
		RESULTS '= "「お前、腹、でかなったなぁ。……俺の子やったら、ええ男になるで？」"
	CASE "不満"
		RESULTS '= "「なんや、今日は気分悪いわ。……店、ちゃんとせえよ。俺を誰やと思うてんねん」"
	CASE "恋"
		RESULTS '= "「……なんやねん、その顔。……勘違いすんなよ、俺がお前に惚れとるわけやないんやからな」"
	CASE "友達"
		RESULTS '= "「おう、来たか。……俺が来てやったんやから、ありがたく思えよ」"
	CASE "酔い"
		RESULTS '= "「ええ酒やなぁ。……こら、もう一杯や。俺に逆らうんか？」"
	CASE "満足"
		RESULTS '= "「悪ないな、今日は。……まあ、俺が居るさかい、当然やけどな」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃい。……って、なんや、お前かいな。仕事の邪魔、すんなや」"
	CASE "初対面"
		RESULTS '= "「おう、新顔か。……ゆうじや。覚えとけ、損はさせへん」"
	CASE "ふだん"
		RESULTS '= "「おう。今日も俺が来たったで。喜べや」"
	CASEELSE
		RESULTS '= "「おう。今日も俺が来たったで。喜べや」"
ENDSELECT


@口上_一言2_26(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……お前だけは、他の女と違うんやなぁ。……癪やけど、認めたるわ」"
	CASE "友達"
		RESULTS '= "「お前、わりかし分かっとるやんけ。……ええ、そういうの、嫌いやないで」"
	CASE "満足"
		RESULTS '= "「ええ夜や。……俺の機嫌がええ日に当たって、お前、運がええで」"
	CASE "勤務中"
		RESULTS '= "「広報、俺に任しとけ。……お客の十人や二十人、一晩で連れてきたるわ」"
	CASE "ふだん"
		RESULTS '= "「ウイスキー、ダブルで。……氷はいらん。俺は、ストレートが好きなんや」"
ENDSELECT


@口上_一言3_26(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……ほんま、お前には勝てんなぁ。……今夜は、俺の隣、空けといたるわ」"
	CASE "友達"
		RESULTS '= "「俺みたいな男が、こない素直に話すんは、珍しいんやで？」"
	CASE "ふだん"
