;あかり（元気）の固有口上：絶頂。声の方向＝明るい看板娘・歌い手。一人称「あたし」。照れると早口。
;ERB/口上/1_あかり/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_絶頂_1(番号, 部位)
#DIM 番号
#DIM 部位

RESULTS '= ""
SELECTCASE 部位
	CASE 0
		RESULTS '= "「んっ……口、だけで……っ！　……はぁ、あたし、変な声出た……」"
	CASE 1
		RESULTS '= "「ひゃっ、胸……っ！　……そこ、だめ、弱いの……っ」"
	CASE 2
		RESULTS '= "「あっ、そこ……っ、だめ、だめっ……！　……はぁ……っ」"
	CASE 3
		IF 好感度の段(好感度_恋愛:番号:0) >= 5
			RESULTS '= "「あっ、あぁっ……！　……好き、好きだよ……っ」"
		ELSE
			RESULTS '= "「あ、あぁっ……！　……はぁ、はぁ……。あたし、いま、どんな顔してた……？」"
		ENDIF
	CASE 4
		RESULTS '= "「そ、そんなとこ……っ！　……んんっ、はぁ……」"
ENDSELECT


;強く達したとき。書いていない部位は連続絶頂 → 絶頂に落ちる
@口上_強絶頂_1(番号, 部位, 回数)
#DIM 番号
#DIM 部位
#DIM 回数

RESULTS '= ""
SELECTCASE 部位
	CASE 3
		RESULTS '= "「あっ、あぁぁっ……！　奥、だめ、来ちゃう……っ！！　……はぁ、はぁ……。頭、真っ白……」"
ENDSELECT


;あなたと一緒に達したとき（★の行の後）
@口上_同時絶頂_1(番号)
#DIM 番号

RESULTS '= ""
RESULTS '= "「あっ、一緒に……っ！　……はぁ、あったかい……」"
