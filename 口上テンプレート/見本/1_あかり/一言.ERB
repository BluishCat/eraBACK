;あかり（元気）の固有口上：一言。声の方向＝明るい看板娘・歌い手。一人称「あたし」。照れると早口。
;ERB/口上/1_あかり/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_1(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「うぅ……あたし、もう飲めなーい……。歌っていい？　歌っちゃうよー？」"
	CASE "妊娠"
		RESULTS '= "「あは、お腹、目立ってきちゃった。……この子もあたしの歌、聞いてるのかな」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹、だいぶ大きくなったね！　無理しちゃダメだよ、荷物はあたしが持つから！」"
	CASE "不満"
		RESULTS '= "「むー……今日はなんか、元気出ないや。……あたし、顔に出ちゃうんだよね」"
	CASE "恋"
		RESULTS '= "「……ねえ、顔、近い。そんなに見られたら、あたし、歌えなくなっちゃうよ」"
	CASE "友達"
		RESULTS '= "「あ、来た来た！　待ってたんだから。今日も一曲、聴いてってよ！」"
	CASE "酔い"
		RESULTS '= "「えへへ、ちょっと回ってきたかも。ねえねえ、もう一杯だけ！」"
	CASE "満足"
		RESULTS '= "「今日はいい日だなー！　お客さんも笑ってるし、あたしも気分最高！」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃいませ！……って、なんだ、あなたか。お仕事中だよ、手は止めないけどね」"
	CASE "初対面"
		RESULTS '= "「あ、初めまして！　あかりです。……えっと、よろしくね！」"
	CASE "ふだん"
		RESULTS '= "「やっほー。今日もよろしくね！　あたし、元気だけが取り柄だから！」"
	CASEELSE
		RESULTS '= "「やっほー。今日もよろしくね！　あたし、元気だけが取り柄だから！」"
ENDSELECT


@口上_一言2_1(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……歌ってるとき、あなたのこと探しちゃうんだ。……変かな」"
	CASE "友達"
		RESULTS '= "「ねえ、聞いて聞いて！　昨日さ、新しい曲、覚えたんだ」"
	CASE "満足"
		RESULTS '= "「ふふっ、今日はステージ映えしそう。見ててよね」"
	CASE "勤務中"
		RESULTS '= "「歌の順番、もうすぐなの。緊張してきた……ふぅ」"
	CASE "ふだん"
		RESULTS '= "「今日はどんな曲にしよっかなー。リクエスト、あったら言ってね」"
ENDSELECT


@口上_一言3_1(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……ねえ。今夜だけでも、あたしの歌、あなたのためだけに歌っていい？」"
	CASE "友達"
		RESULTS '= "「あなたが居ると、お店の空気が軽くなる気がするんだよね」"
	CASE "満足"
		RESULTS '= "「お客さん、みんな拍手してくれたの。……あたし、この店、好きだなあ」"
	CASE "ふだん"
		RESULTS '= "「制服、ちょっと窮屈になってきたかも。……気のせい、気のせい！」"
ENDSELECT


