;とおる（クール）の固有口上：一言。声の方向＝口数が少ない金持ちのピアニスト。一人称「俺」。皮肉と間。
;ERB/口上/5_とおる/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_5(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「……飲みすぎた。……ピアノなら、目を閉じても弾けるんだがな」"
	CASE "あなたの妊娠"
		RESULTS '= "「……腹が重いだろう。……俺の椅子を使え」"
	CASE "不満"
		RESULTS '= "「……この店の音が、少し濁っている。……何があった」"
	CASE "恋"
		RESULTS '= "「……お前の前だと、指が止まる。……迷惑な話だ」"
	CASE "友達"
		RESULTS '= "「……来たか。……今夜は、お前のために一曲弾いてもいい」"
	CASE "酔い"
		RESULTS '= "「……悪くない酒だ。……饒舌になる前に、水をくれ」"
	CASE "満足"
		RESULTS '= "「……いい夜だ。……音が、ちゃんと店に馴染んでいる」"
	CASE "勤務中"
		RESULTS '= "「……仕事中だ。……用なら、演奏の後にしろ」"
	CASE "初対面"
		RESULTS '= "「……誰だ。……ここは、俺の席のはずだが」"
	CASE "ふだん"
		RESULTS '= "「……ああ。……今夜も、いつもの席でいい」"
	CASEELSE
		RESULTS '= "「……ああ。……今夜も、いつもの席でいい」"
ENDSELECT


@口上_一言2_5(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……お前にだけ、弾く。……他の奴に聞かせるつもりはない」"
	CASE "友達"
		RESULTS '= "「……新しい曲を書いている。……聴かせるのは、お前が最初だ」"
	CASE "満足"
		RESULTS '= "「……悪くない。……金を払う価値はある」"
	CASE "勤務中"
		RESULTS '= "「……鍵盤の前に座れば、客が黙る。……それが俺の仕事だ」"
	CASE "ふだん"
		RESULTS '= "「……ウイスキーだ。……ロックで」"
ENDSELECT


@口上_一言3_5(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……惚れたら負けだと言うが。……俺は、もう負けているのか」"
	CASE "友達"
		RESULTS '= "「……お前の笑い方は、嫌いじゃない」"
	CASE "ふだん"
		RESULTS '= "「……金で買えないものが、この店にはある。……皮肉だな」"
ENDSELECT


