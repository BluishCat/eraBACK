;とおる（クール）の固有口上：絶頂。声の方向＝口数が少ない金持ちのピアニスト。一人称「俺」。皮肉と間。
;ERB/口上/5_とおる/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_絶頂_5(番号, 部位)
#DIM 番号
#DIM 部位

RESULTS '= ""
SELECTCASE 部位
	CASE 0
		RESULTS '= "「……っ、口で……っ。……く……」"
	CASE 1
		RESULTS '= "「……っ、そこは……っ。……やめろ、とは言わんが……」"
	CASE 4
		RESULTS '= "「……っ、ぐ……っ！　……そんな、ところを……っ」"
	CASE 5
		IF 好感度の段(好感度_恋愛:番号:0) >= 5
			RESULTS '= "「……っ、出る……っ！　……お前、だから……だ……」"
		ELSE
			RESULTS '= "「……っ、出る……っ！　……く……はぁ……」"
		ENDIF
ENDSELECT


;強く達したとき。書いていない部位は連続絶頂 → 絶頂に落ちる
@口上_強絶頂_5(番号, 部位, 回数)
#DIM 番号
#DIM 部位
#DIM 回数

RESULTS '= ""
SELECTCASE 部位
	CASE 5
		RESULTS '= "「……っ、ぐ……止まらん……っ！！　……はぁ……。……俺が、こんなに……」"
ENDSELECT


;あなたと一緒に達したとき（★の行の後）
@口上_同時絶頂_5(番号)
#DIM 番号

RESULTS '= ""
RESULTS '= "「……っ、一緒に……か。……悪くない……」"
