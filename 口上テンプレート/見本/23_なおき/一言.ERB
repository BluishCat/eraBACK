;なおき（真面目）の固有口上：一言。声の方向＝堂々とした警備・少し純。一人称「私」。丁寧語。
;ERB/口上/23_なおき/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_23(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「……申し訳ありません。……少々、飲みすぎました。……警備が、聞いて呆れます」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹が重そうですね。……私にできることがあれば、何でも仰ってください」"
	CASE "不満"
		RESULTS '= "「……今夜は、どうも気が散ります。……私の不徳の致すところです」"
	CASE "恋"
		RESULTS '= "「……私は、警備が仕事です。……あなたを守りたいと思うのは、それ以上の理由があるからですが」"
	CASE "友達"
		RESULTS '= "「お疲れ様です。……あなたが居ると、店の空気が締まります」"
	CASE "酔い"
		RESULTS '= "「……ビールが旨いですね。……すこし、気が緩んでいるようです」"
	CASE "満足"
		RESULTS '= "「今夜は穏やかでした。……何事もない夜が、一番です」"
	CASE "勤務中"
		RESULTS '= "「勤務中です。……ご用件は、手短にお願いします」"
	CASE "初対面"
		RESULTS '= "「初めてお目にかかります。……なおきと申します。以後、お見知りおきを」"
	CASE "ふだん"
		RESULTS '= "「お疲れ様です。……本日も、異常はありません」"
	CASEELSE
		RESULTS '= "「お疲れ様です。……本日も、異常はありません」"
ENDSELECT


@口上_一言2_23(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……不謹慎かもしれませんが。……あなたの隣に立つ時間が、一番、落ち着きます」"
	CASE "友達"
		RESULTS '= "「……あなたには、気を許しているようです。……私としたことが」"
	CASE "満足"
		RESULTS '= "「……異常なし。……それが、私にとっての最上の言葉です」"
	CASE "勤務中"
		RESULTS '= "「ここは私が見ています。……どうぞ、ご安心を」"
	CASE "ふだん"
		RESULTS '= "「見回りに行ってきます。……何かあれば、すぐ呼んでください」"
ENDSELECT


@口上_一言3_23(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……私は、不器用です。……ですが、あなたを大切にする気持ちだけは、本物です」"
	CASE "友達"
		RESULTS '= "「……誰かを守るのは、仕事ではなく、性分なのかもしれません」"
	CASE "ふだん"
		RESULTS '= "「ネクタイが曲がっていないか、毎日、鏡で確認しているのですが……。……曲がっていますか」"
ENDSELECT


