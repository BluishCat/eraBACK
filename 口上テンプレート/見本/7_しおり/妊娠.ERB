;しおり（内気）の固有口上：妊娠・出産。声の方向＝引っ込み思案・下戸。一人称「わたし」。言いよどむ。
;ERB/口上/7_しおり/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_妊娠_7(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "妊娠発覚"
		IF 出産回数:番号:0 == 0
			RESULTS '= "「……あ、あの……わたし、赤ちゃん……できたみたい、です。……ど、どうしましょう……」"
		ELSE
			RESULTS '= "「……また、なんですね。……が、頑張ります。……わたしなりに」"
		ENDIF
	CASE "陣痛開始"
		RESULTS '= "「……っ、あ……き、来ました……っ。……あの、そばに、居てください……」"
	CASE "破水"
		RESULTS '= "「あ……っ、水が……。……す、すみません、床、汚して……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……ふ、ふたり……。……ふたりとも……ちゃんと……。……よかった……」"
		ELSE
			RESULTS '= "「……はぁ……はぁ……。……あ、泣いてる……。……よかった……」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……あ。……そう、なんですね。……ごめんなさい……ごめんなさい……」"
ENDSELECT
