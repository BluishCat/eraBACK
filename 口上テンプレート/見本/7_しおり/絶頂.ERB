;しおり（内気）の固有口上：絶頂。声の方向＝引っ込み思案・下戸。一人称「わたし」。言いよどむ。
;ERB/口上/7_しおり/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_絶頂_7(番号, 部位)
#DIM 番号
#DIM 部位

RESULTS '= ""
SELECTCASE 部位
	CASE 0
		RESULTS '= "「……んっ、く……っ。……く、口が……っ、あ……」"
	CASE 1
		RESULTS '= "「あ……っ、胸……っ。……や、やぁ……恥ずかしい……っ」"
	CASE 2
		RESULTS '= "「あ……っ、そこ……っ、だめ……っ。……あ、あぁ……」"
	CASE 3
		IF 好感度の段(好感度_恋愛:番号:0) >= 5
			RESULTS '= "「あ……っ、あぁ……っ！　……すき……あなたが、好き、です……っ」"
		ELSE
			RESULTS '= "「あ……っ、あぁ……っ。……わ、わたし……こ、こんな……」"
		ENDIF
	CASE 4
		RESULTS '= "「そ、そこは……っ、だめ、です……っ。……あぁ……」"
ENDSELECT


;強く達したとき。書いていない部位は連続絶頂 → 絶頂に落ちる
@口上_強絶頂_7(番号, 部位, 回数)
#DIM 番号
#DIM 部位
#DIM 回数

RESULTS '= ""
SELECTCASE 部位
	CASE 3
		RESULTS '= "「あ、あぁっ……っ、だめ、おかしく……っ！！　……はぁ、はぁ……。……わ、わたし、こんな声……」"
ENDSELECT


;あなたと一緒に達したとき（★の行の後）
@口上_同時絶頂_7(番号)
#DIM 番号

RESULTS '= ""
RESULTS '= "「あ……っ、い、一緒に……っ。……はぁ……あったかい……」"
