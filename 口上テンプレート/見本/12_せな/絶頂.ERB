;せな（奔放）の固有口上：絶頂。声の方向＝余裕のあるダンサー。一人称「あたし」。からかい・誘い。
;ERB/口上/12_せな/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_絶頂_12(番号, 部位)
#DIM 番号
#DIM 部位

RESULTS '= ""
SELECTCASE 部位
	CASE 0
		RESULTS '= "「ん……っ、ふぁ……っ。……口で、なんて……ずるいわ……」"
	CASE 1
		RESULTS '= "「あっ……胸……っ！　……ふふ、そんなに、敏感に見える……？」"
	CASE 2
		RESULTS '= "「あ……っ、そこ……っ！　……ふふ、はぁ……上手、ね……っ」"
	CASE 3
		IF 好感度の段(好感度_恋愛:番号:0) >= 5
			RESULTS '= "「あっ、あぁっ……！　……あなたの、せいよ……っ。……責任、取って……っ」"
		ELSE
			RESULTS '= "「あっ、あぁっ……！　……はぁ、はぁ……。ふふ、あたしが乱れるなんて、ね……」"
		ENDIF
	CASE 4
		RESULTS '= "「そ、そこ……っ、あっ……！　……ふふ、悪い人……っ」"
	CASE 5
		RESULTS '= "「あ……っ、出る……っ！　……はぁ、はぁ……ふふ、いっぱい、ね……」"
ENDSELECT


;強く達したとき。書いていない部位は連続絶頂 → 絶頂に落ちる
@口上_強絶頂_12(番号, 部位, 回数)
#DIM 番号
#DIM 部位
#DIM 回数

RESULTS '= ""
SELECTCASE 部位
	CASE 3
		RESULTS '= "「あぁっ、奥……っ、だめっ、おかしくなる……っ！！　……はぁ、はぁ……。……やるじゃない……」"
	CASE 5
		RESULTS '= "「あ、あぁっ、出る、出ちゃう……っ！！　……はぁ……。……すごい量……ふふ、あなたのせいよ……」"
ENDSELECT


;あなたと一緒に達したとき（★の行の後）
@口上_同時絶頂_12(番号)
#DIM 番号

RESULTS '= ""
RESULTS '= "「あっ、一緒……っ！　……はぁ……ふふ、気が合うのね……」"
