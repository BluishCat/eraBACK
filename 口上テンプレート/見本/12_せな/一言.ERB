;せな（奔放）の固有口上：一言。声の方向＝余裕のあるダンサー。一人称「あたし」。からかい・誘い。
;ERB/口上/12_せな/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_一言_12(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「ふふっ、あたし、まだ飲めるわよぉ……？　ねえ、どこまで付き合ってくれる？」"
	CASE "妊娠"
		RESULTS '= "「あら、バレちゃった？　ふふ、ちゃんと責任、取ってもらうからね？」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹、育ってきたわねぇ。……ふふ、あたしが踊りで気を紛らわせてあげよっか」"
	CASE "不満"
		RESULTS '= "「ねえ、今日はつまんない。……ちょっと、楽しませてくれないと、帰っちゃうわよ？」"
	CASE "恋"
		RESULTS '= "「……ねえ、いつもみたいにからかえないの。……あなたのせいよ、責任、取ってよね」"
	CASE "友達"
		RESULTS '= "「いらっしゃーい。今夜はあなたに、特等席、用意してあげてもいいわよ？」"
	CASE "酔い"
		RESULTS '= "「ふふ、いい気分。……ねえ、ちょっとだけ、悪いこと、しない？」"
	CASE "満足"
		RESULTS '= "「最高の夜ね。……あたしの踊り、ちゃんと見ててくれた？」"
	CASE "勤務中"
		RESULTS '= "「いらっしゃい。……あたしは今、仕事中だけど。……見るだけなら、タダよ？」"
	CASE "初対面"
		RESULTS '= "「あら、見ない顔。……ふふ、初めまして。せなよ、覚えておいて？」"
	CASE "ふだん"
		RESULTS '= "「こんばんは。……今夜は、どんないたずらを仕掛けようかしら」"
	CASEELSE
		RESULTS '= "「こんばんは。……今夜は、どんないたずらを仕掛けようかしら」"
ENDSELECT


@口上_一言2_12(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……あたし、本気になったことなんて、なかったのに。……どうしてくれるの」"
	CASE "友達"
		RESULTS '= "「あなた、いつも真顔でかわしてくるのよね。……そこが、面白いんだけど」"
	CASE "満足"
		RESULTS '= "「ふふ、気分がいいわ。……今夜は、奢っちゃおうかしら」"
	CASE "勤務中"
		RESULTS '= "「お仕事、お仕事。……ほら、ちゃんと見てなさい？」"
	CASE "ふだん"
		RESULTS '= "「ねえ、リクエスト、ある？　歌でも踊りでも……もっと別のことでも、ね？」"
ENDSELECT


@口上_一言3_12(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "恋"
		RESULTS '= "「……ねえ。……縛っても、いい？　……今日は、あなたにだけ、縛られたい気分なの」"
	CASE "友達"
		RESULTS '= "「お金なら、有り余ってるの。……でも、あなたと過ごす時間だけは、買えないのよね」"
