;せな（奔放）の固有口上：妊娠・出産。声の方向＝余裕のあるダンサー。一人称「あたし」。からかい・誘い。
;ERB/口上/12_せな/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_妊娠_12(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "妊娠発覚"
		IF 出産回数:番号:0 == 0
			RESULTS '= "「……あら。……あたしに、赤ちゃん？　……ふふ、あたしが母親になるなんて。……責任、取ってくれるんでしょうね？」"
		ELSE
			RESULTS '= "「あらあら。……また、できちゃったの。……ふふ、あたし、もう、覚悟はできてるわよ」"
		ENDIF
	CASE "陣痛開始"
		RESULTS '= "「……っ、あ、来た……っ。……ふふ、ちょっと、余裕ないかも……っ。……そばに、居て……」"
	CASE "破水"
		RESULTS '= "「あ……っ、水……。……ふふ、いよいよ、ね」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……っ。……ふたりも、なんて。……ふふ、やるじゃない、あたし……」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……ふふ、泣き声……。……あたしの、子……」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……あ。……そう。……ふふ、笑うしかないわね。……ちょっと、一人にして……」"
ENDSELECT
