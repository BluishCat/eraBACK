;せな（奔放）の固有口上：訪問。声の方向＝余裕のあるダンサー。一人称「あたし」。からかい・誘い。
;ERB/口上/12_せな/。タイプ別・共通の汎用口上より先に呼ばれ、空を返した所は汎用に落ちる（→口上テンプレート/README.txt）

@口上_訪問_12(番号, 場面)
#DIM 番号
#DIM 場面

RESULTS '= ""
SELECTCASE 場面
	CASE 0
		IF 好感度の段(好感度_友情:番号:0) >= 5
			RESULTS '= "「ふふ、来ちゃった。……上がってもいい？　あなたの部屋、見てみたいの」"
		ELSE
			RESULTS '= "「こんばんは。……近くまで来たから、遊びに来ちゃった」"
		ENDIF
	CASE 1
		RESULTS '= "「おじゃましまーす。……あら、無防備ね？」"
	CASE 2
		RESULTS '= "「ふぅん、残念。……じゃ、また、お店で会いましょ」"
ENDSELECT
