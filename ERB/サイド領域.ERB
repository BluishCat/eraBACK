;画面の右に常時出す枠（→設計メモ「サイド領域と画像」）
;eraJK の サイド領域描画.ERB を参考にした作り
;
;rect の単位は「フォントサイズの1/100」。100＝全角1文字。px を付けると生のピクセル
;  X0  本文の右。本文の組み幅は全角60文字（6000単位）なので、少し空けて6200
;  BODYH 本文パネルの高さ。大きくするとタブ帯がウィンドウ下端からはみ出す
;display は指定しない（既定の relative＝出力した位置に描く）。
;absolute にすると画面に張り付いて、下から積まれる本文と離れる
;
;div はカーソルを進めないので、出したあと呼び出し側で高さ分の空行を入れる

@サイド領域描画
#DIMS 出力
#DIM X0
#DIM W0
#DIM BODYY
#DIM BODYH
#DIM TY

;本文の組み幅 6000（本文罫線と同じ全角60文字）のすぐ右から。2026-09-12 に 7000 → 6200
X0 = 6200
;幅はウィンドウの右端まで（幅1920px、スクロールバーを引いて 11800 単位ほど）。見取り図（自宅で全角44文字）は余裕で入る
W0 = 5600
BODYY = 0
;高さはウィンドウ（1220px ≒ 67行）に、上の数行と下段の設定・ロードが残る範囲で大きく。56行ぶん（2026-09-12 に 34 → 46、2026-10-17 に 46 → 56）
;あなたタブが 素質・服装・妊娠・胎内精液まで積むと 46行では下が切れたので、emuera.config のウィンドウ高さも 1040 → 1220 に伸ばした
BODYH = 6270
TY = BODYY + BODYH

SIF SAVESTR:サイド表示 == ""
	SAVESTR:サイド表示 = 状態
;起床前（場面 1）にはクイック移動タブが無い。行動中に移動タブのまま寝たら店のタブに落とす
SIF サイドの場面 == 1 && SAVESTR:サイド表示 == "移動"
	SAVESTR:サイド表示 = 状態

;--- 本文パネル ---
出力 = <div rect='{X0}, {BODYY}, {W0}, {BODYH}' padding='50,25,25' color='#101010' border='31' bcolor='#C0C0C0'><nobr>
SELECTCASE SAVESTR:サイド表示
	CASE "移動"
		;CALL は #FUNCTION 中で使えないので、移動タブと能力タブは通常関数にしてある
		CALL サイド_移動
		出力 += RESULTS
	CASE "能力"
		CALL サイド_能力
		出力 += RESULTS
	CASE "持ち物"
		CALL サイド_持ち物
		出力 += RESULTS
	CASE "自分"
		CALL サイド_自分
		出力 += RESULTS
	CASEELSE
		出力 += サイド_状態()
ENDSELECT
出力 += "</nobr></div>"

;--- タブ帯。本文パネルの下辺から生やす（コマンド欄に近く押しやすい）。4等分（→画面イメージ）。
;選んでいるタブはパネルの下辺に重ねて描き、境目をパネル色で塗って一体に見せる。他のタブは少し下げて暗く ---
IF サイドの場面 == 1
	;起床前はクイック移動が無いので4等分（→一日.ERB「起床前のサイド」）
	出力 += タブ枠("状態", "店", 1090, X0, W0 / 4 - 20, TY)
	出力 += タブ枠("能力", "能力表示", 1092, X0 + W0 / 4 + 7, W0 / 4 - 20, TY)
	出力 += タブ枠("持ち物", "持ち物", 1094, X0 + W0 * 2 / 4 + 14, W0 / 4 - 20, TY)
	出力 += タブ枠("自分", "あなた", 1093, X0 + W0 * 3 / 4 + 20, W0 / 4 - 20, TY)
ELSE
	;5等分（持ち物タブは 2026-09-14 ユーザ指定）
	出力 += タブ枠("状態", "店", 1090, X0, W0 / 5 - 20, TY)
	出力 += タブ枠("移動", "クイック移動", 1091, X0 + W0 / 5 + 5, W0 / 5 - 20, TY)
	出力 += タブ枠("能力", "能力表示", 1092, X0 + W0 * 2 / 5 + 10, W0 / 5 - 20, TY)
	出力 += タブ枠("持ち物", "持ち物", 1094, X0 + W0 * 3 / 5 + 15, W0 / 5 - 20, TY)
	出力 += タブ枠("自分", "あなた", 1093, X0 + W0 * 4 / 5 + 20, W0 / 5 - 20, TY)
ENDIF

RESULTS = %出力%

;枠が何行ぶんかを返す。呼び出し側はこの分だけ空行を入れて、
;枠が画面の下からはみ出さないようにする。
;1行の高さはフォント16pxに対して18px＝112単位（100で割ると3行ほど余る。実測 2026-09-12）。切り上げ
RETURN (TY + 180 + 111) / 112


;タブ1枚。上＝パネルの下辺の位置。
;選んでいるタブ：パネルと同じ色・同じ枠色で、パネルの枠に重ねて描き、境目（パネルの下枠）を枠なしのマスで塗り潰してつなげる。字は黄色、ボタンにしない。
;他のタブ：少し下げて低く、暗い背景に暗い枠、字は灰のボタン（奥に引っ込んで見える）
@タブ枠(値, 表示名, 番号, 左, 幅, 上)
#FUNCTIONS
#DIMS 値
#DIMS 表示名
#DIM 番号
#DIM 左
#DIM 幅
#DIM 上
#DIMS 出力

IF SAVESTR:サイド表示 == 値
	出力 = <div rect='{左}, {上 - 31}, {幅}, 230' padding='55,15,0' color='#101010' border='31' bcolor='#C0C0C0'><nobr><font color='#ffcc44'>%表示名%</font></nobr></div>
	;境目。パネルの下枠の太さぶん（31）を、タブの内側の幅だけパネル色で塗る
	出力 += @"<div rect='{左 + 31}, {上 - 31}, {幅 - 62}, 62' color='#101010'></div>"
	RETURNF 出力
ENDIF

RETURNF @"<div rect='{左}, {上 + 30}, {幅}, 150' padding='15,15,0' color='#181818' border='31' bcolor='#606060'><nobr><font color='#909090'><button value='{番号}'>　%表示名%</button></font></nobr></div>"


;店のタブ。今日の営業・施設・金。体力・気力と現在地は本文（あなたの段・先頭の行）にあるのでここには置かない
;（2026-09-12 に「状態」から「店」に寄せた。→画面イメージ）
;気になる線を超えた場所を並べる。無ければ何も出さない
;場所名は押すとそこへ移動する（クイック移動タブと同じく場所番号をそのまま返す → USERCOM.ERB @USERCOM_実行）。
;押せるのは 店の中に居て、行動中の画面で、席を外せない状態でないとき。居る場所は押せない
@汚れの一覧
#FUNCTIONS
#DIMS 出力
#DIM 場所
#DIM 数
#DIM 押せる

;ローカルの文字列は呼び出し間で残る。+= で積む前に空にする（= の右辺は FORM 解釈なので式代入 '= で）
出力 '= ""
数 = 0
;起床前のサイドは移動を受けない（見取り図の番号が増築などのメニューとぶつかる）。汚れの場所は店（画面0）の番号なので、店に居るときだけ
押せる = (サイドの場面 == 0 && 裏の相手:MASTER:0 == 0 && 出産ショー中:MASTER:0 == 0 && CFLAG:MASTER:現在位置 / 100 == 0)
FOR 場所, 0, 100
	SIF 汚れ:場所 <= 汚れの気になる線 || GET_PLACE_NAME(場所) == ""
		CONTINUE
	SIF 数 == 0
		出力 += 節見出し("汚れ")
	IF 押せる && 場所 != CFLAG:MASTER:現在位置
		;見取り図の番号と同じ黄色（押せると分かるように）
		出力 += @"　<font color='#ffcc44'><button value='{場所}'>%GET_PLACE_NAME(場所)%</button></font>%汚れのタグ(場所)%<br>"
	ELSE
		出力 += @"　%GET_PLACE_NAME(場所)%%汚れのタグ(場所)%<br>"
	ENDIF
	数 += 1
NEXT
SIF 数 > 0
	出力 += "<br>"
RETURNF 出力


@サイド_状態
#FUNCTIONS
#DIMS 出力
#DIM 在店

出力 = <font color='#ffcc44'>■店</font><br>

出力 += 節見出し("今日")
出力 += @"　営業：%営業時間の文()%"
IF 営業中(現在時刻)
	出力 += "（営業中）<br>"
ELSE
	出力 += "（開店前）<br>"
ENDIF
;行事の日だけ（日付から出すので開店前にも見える。→行事.ERB）
SIF 行事の行(経過日数) != ""
	出力 += @"　行事：%行事の行(経過日数)%<br>"
在店 = 在店客数()
出力 += @"　来客 {今日の来客}／売上 %金額(今日の売上)%円　　在店 {在店}人<br>"
SIF 今日の汚れで帰った > 0
	出力 += @"　汚れで引き返した客 {今日の汚れで帰った}人<br>"
;端末があるので、どこに居ても注文の数は分かる（→画面イメージ「料理の流れ」）
出力 += @"　注文 {注文の数(1) + 注文の数(2)}（できあがり {注文の数(2)}）<br>"
;その晩シフトの入っている人数（→設計メモ「スタッフ」）。営業曜日は開店で決まるので、開店前は人数を出さない
IF スタッフ数() > 0 && 営業中(現在時刻)
	出力 += @"　出勤 {出勤の数()}人／給料 %金額(今日の給料)%円<br>"
ELSEIF スタッフ数() > 0
	出力 += @"　給料 %金額(今日の給料)%円<br>"
ENDIF
;迷惑客が出ていれば、居る場所と残り（→設計メモ「迷惑客」）
SIF 迷惑客の場所 > 0
	出力 += @"　迷惑客：%GET_PLACE_NAME(迷惑客の場所)%（あと{迷惑客の残り}分）<br>"
;打った日だけ出す。効くのは明日（→設計メモ「経済の輪」）
SIF 広報の効き > 0
	出力 += @"　広報 +{広報の効き}％（明日）<br>"
出力 += "<br>"

;進行中の目標（→目標.ERB）
IF 目標数 > 0
	出力 += 節見出し("目標")
	出力 += サイドの目標()
	出力 += "<br>"
ENDIF

;汚れは目につく場所だけ並べる（→設計メモ「経済の輪」）
出力 += 汚れの一覧()

出力 += 節見出し("施設")
出力 += @"　スタッフ　{スタッフ数()}人／寮 {寮の部屋数}部屋<br>"
出力 += @"　個室　　　{個室数}<br>"
出力 += @"　ボックス席 {ボックス席数}／使用中 {ボックス席使用数()}<br>"
出力 += @"　寮の部屋　{寮の部屋数}<br>"
;自宅で同棲している人（→行動.ERB「同棲」）
出力 += @"　同棲　　　{同棲の人数()}人／部屋 {同棲の部屋数}<br>"
出力 += @"　後付け施設 {後付け施設数}<br>"
;地下（会員制）。会員の数は店の持ち主なので分かる（→画面イメージ「地下」）
SIF 地下あり
	出力 += @"　地下　　　会員 {会員数()}人／在席 {客の数(地下ホールの位置)}<br>"
出力 += "<br>"

出力 += 節見出し("金")
出力 += @"　所持金 %金額(MONEY:MASTER)%円<br>"

RETURNF 出力


;その状態（1=待ち 2=できあがり）の注文を持つ客の数
@注文の数(状態)
#FUNCTION
#DIM 状態
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && 注文状態:番号:0 == 状態
		数 += 1
NEXT
RETURNF 数


;いま店の中（1〜99）に居る客の数
@在店客数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && CFLAG:番号:現在位置 > 0 && CFLAG:番号:現在位置 < 100
		数 += 1
NEXT
RETURNF 数


;クイック移動。見取り図と凡例をそのまま出し、下に行ける場所を並べる
;（eraJK も「地図グリッド＋文字凡例の同時表示」にしている）
@サイド_移動
#DIMS 出力
#DIMS 地図
#DIMS 凡例
#DIMS 名前
#DIM 画面
#DIM 番号

;RESULTS は使い回されるので、呼んだ直後に退避する
CALL DRAW_MAP
地図 = %RESULTS%
CALL DRAW_凡例(0)
凡例 = %RESULTS%

画面 = CFLAG:MASTER:現在位置 / 100

出力 = <font color='#808080'>クイック移動</font><br>
出力 += 地図
出力 += "<br>"
出力 += 凡例
;どこに居ても私室まで一度に戻る。移動画面の[1099]と同じ（→USERCOM.ERB @私室へ戻る）。もう私室なら出さない
SIF CFLAG:MASTER:現在位置 != 私室の位置
	出力 += @"<button value='1099'>私室へ戻る</button><br>"
;居場所感知を買っていれば、部屋ごとに居る者を並べる（→怪しい店.ERB）
出力 += 居場所の文()

RESULTS = %出力%


;================================ 能力表示 ================================
;主役（同室者が居なければ主人公）の能力。erablue_resort のサイド「能力表示」に倣う（→画面イメージ「サイド領域（能力表示タブ）」）。
;■名前 → □ 情報 □ → □ 技能 □ → □ 素質 □ → □ 服装 □ → □ 開発度 □ → □ 妊娠・出産 □（妊娠中だけ）→ □ 胎内精液 □（残っているときだけ。eraTOWN のサイドと同じ）
@サイド_能力
#DIM 番号

CALL 主役を決める
番号 = 主役
SIF 番号 <= 0
	番号 = MASTER
CALL サイド_能力表示(番号)


;あなたのタブ。中身は能力表示と同じ組み方で、相手を主人公に固定
@サイド_自分

CALL サイド_能力表示(MASTER)


;================================ 持ち物 ================================
;持ち物タブ（2026-09-14 ユーザ指定「所持アイテムの一覧と使用ができるタブ」）。種類ごと（薬・アイテム・プレゼント）に並べ、
;いま使えるものは［使う］（5600＋品目番号 → ショップ.ERB @持ち物を一つ使う。起床前でも効く）。
;プレゼントは相手が要るので、行動中に主役が居るときだけ［贈る］（1108。個室の中は席を外せないので出さない）
@サイド_持ち物
#DIMS 出力
#DIM 甲
#DIM 種類
#DIM 見出し済み
#DIM 贈れる

出力 '= "<font color='#ffcc44'>■持ち物</font><br><br>"
IF 持ち物の数() <= 0
	出力 += "　（何も持っていない）"
	RESULTS = %出力%
	RETURN 0
ENDIF

;［贈る］を出せるか。主役は同室者から決まる
贈れる = 0
IF サイドの場面 == 0 && 裏の相手:MASTER:0 == 0
	CALL 主役を決める
	SIF 主役 > 0
		贈れる = 1
ENDIF

FOR 種類, 1, 4
	見出し済み = 0
	FOR 甲, 0, 品目数
		SIF ITEM:甲 <= 0 || 品目種類:甲 != 種類
			CONTINUE
		IF !見出し済み
			SELECTCASE 種類
				CASE 種類_薬
					出力 += 節見出し("薬")
				CASE 種類_アイテム
					出力 += 節見出し("アイテム")
				CASEELSE
					出力 += 節見出し("プレゼント")
			ENDSELECT
			見出し済み = 1
		ENDIF
		出力 += @"　%ITEMNAME:甲, 16, LEFT%×{ITEM:甲, 2}　"
		IF 種類 == 種類_プレゼント
			出力 += @"%軸の名(品目軸:甲)%%好物の添え(甲)%"
			SIF 贈れる
				出力 += "<button value='1108'>[贈る]</button>"
		ELSEIF 使えるか(甲)
			IF 種類 == 種類_薬
				出力 += @"<button value='{5600 + 甲}'>[飲む]</button>"
			ELSE
				出力 += @"<button value='{5600 + 甲}'>[使う]</button>"
			ENDIF
		ELSE
			出力 += "<font color='#666666'>[いまは使えない]</font>"
		ENDIF
		出力 += 持ち物の添え(甲)
		出力 += "<br>"
		SIF 品目の効果(甲) != ""
			出力 += @"　　<font color='#808080'>└ %品目の効果(甲)%</font><br>"
	NEXT
	SIF 見出し済み
		出力 += "<br>"
NEXT
RESULTS = %出力%


;効いている残りなど。持ち物を使うの一覧と同じ文
@持ち物の添え(番号)
#FUNCTIONS
#DIM 番号

IF 番号 == アイテム_避妊薬 && 避妊薬残:MASTER:0 > 0
	RETURNF @"　<font color='#808080'>（あと{避妊薬残:MASTER:0}日効いている）</font>"
ELSEIF 番号 == アイテム_排卵誘発剤 && 排卵誘発剤残:MASTER:0 > 0
	RETURNF @"　<font color='#808080'>（あと{排卵誘発剤残:MASTER:0}日効いている）</font>"
ELSEIF 番号 == アイテム_陣痛促進剤 && 促進剤中:MASTER:0
	RETURNF "　<font color='#808080'>（効いている）</font>"
ELSEIF 番号 == アイテム_香水 && 香水の日 == 経過日数 + 1
	RETURNF "　<font color='#808080'>（今日はもう付けている）</font>"
ENDIF
RETURNF ""


@サイド_能力表示(番号)
#DIMS 出力
#DIM 番号

IF 番号 == MASTER
	出力 = <font color='#ffcc44'>■あなた</font><br>
ELSE
	出力 = <font color='#ffcc44'>■%CALLNAME:番号%%立場のタグ(番号)%</font><br>
ENDIF
出力 += "<br>"

出力 += 節見出し("情報")
出力 += 能力_情報(番号)
出力 += "<br>"
;技能は開示の1段目、素質は3段目から（→画面イメージ「怪しい店」の見えるものの段。2026-09-14）
IF 値が見えるか(番号, 1)
	出力 += 節見出し("技能")
	出力 += 能力_技能(番号)
	出力 += "<br>"
ENDIF
IF 値が見えるか(番号, 3)
	出力 += 節見出し("素質")
	出力 += 能力_素質(番号)
	出力 += "<br>"
ENDIF
出力 += 節見出し("服装")
出力 += 能力_服装(番号)
出力 += "<br>"
出力 += 節見出し("開発度")
出力 += 能力_開発度(番号)
;日数・父親は確信してから（疑いの間は情報の節の「疑っている」だけ）
IF 妊娠の確度(番号, MASTER) == 2
	出力 += "<br>"
	出力 += 節見出し("妊娠・出産")
	出力 += 能力表示_妊娠(番号) + "<br>"
ENDIF
IF 膣の合計(番号) > 0 || 子宮の合計(番号) > 0
	出力 += "<br>"
	出力 += 節見出し("胎内精液")
	出力 += 能力_胎内精液(番号)
ENDIF

RESULTS = %出力%


;「□ 名前 □────」。erablue_resort の節の見出しそのまま。見出しの下は1行あける（詰まって見えたので 2026-09-12）
@節見出し(名前)
#FUNCTIONS
#DIMS 名前
#DIMS 線

;枠の幅（5600）いっぱいまで。この "─" は1本 ≒ 90単位（実測）
線 '= "─" * (56 - STRLENSU(名前))
RETURNF @"<font color='#C0C0C0'>□ %名前% □%線%</font><br><br>"


;性別・妊娠・体型・来店の癖・今日の満足度と残り滞在
@能力_情報(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 残り

;3つの組（性別／体型／店での様子）に分け、組の間は1行あける（erablue_resort の情報の節と同じ。詰まって見えたので 2026-09-12）
;妊娠は主人公が気づいているものだけ（→設計メモ「露見」）。気づいていなければ「していない」に見える。
;兆しだけ（妊娠自覚 1）なら確定ではないので「疑っている」（→ 妊娠.ERB @妊娠の確度）
出力 '= "　性別：" + 性別名(番号) + 処女のタグ(番号) + "　　　　　　　　　　妊娠："
SELECTCASE 妊娠の確度(番号, MASTER)
	CASE 2
		出力 += "している（" + 腹段階の名(腹段階(番号)) + "）"
	CASE 1
		出力 += "疑っている"
	CASEELSE
		出力 += "していない"
ENDSELECT
;周期のタグ。主人公は 安全日・生理中まで、他人は危険日・やや危険だけ（メイン画面と同じ。→主役.ERB）
IF 番号 == MASTER
	出力 += "　" + あなたの周期のタグ(番号)
ELSE
	SIF 危険日のタグ(番号) != ""
		出力 += "　" + 危険日のタグ(番号)
ENDIF
;陣痛中は段・破水などを次の行に（幅が足りないので別の行。舞台の上でも出す）。妊娠に気づいていなければ「していない」に見えるので出さない
IF 妊娠の確度(番号, MASTER) == 2 && 陣痛:番号:0 > 0
	出力 += "<br>　" + 陣痛の状態(番号)
ENDIF
出力 += "<br><br>"

;体型は 0.1cm 単位の整数（→設計メモ「体型の変化」）。全キャラが登録時に持つ
出力 += @"　身長：{身長:番号:0 / 10}.{身長:番号:0 % 10}cm　　　　　体重：{体重:番号:0 / 10}.{体重:番号:0 % 10}kg<br>"
出力 += @"　B/W/H：{胸囲:番号:0 / 10}.{胸囲:番号:0 % 10}cm"
;カップは女・ふたなりだけ（eraTOWN と同じく (G) の形で）
SIF 性別ビット(番号) & 6
	出力 += @"(%カップ(番号)%)"
出力 += @" / {胴囲:番号:0 / 10}.{胴囲:番号:0 % 10}cm / {腰囲:番号:0 / 10}.{腰囲:番号:0 % 10}cm<br>"
;体型・バスト・下半身の段（素質。→ERB/体格.ERB）
出力 += @"　%体格の行(番号)%<br>"
;容姿＝素の値＋着ている服と小物（→画面イメージ「個室の中」の容姿）
出力 += @"　容姿：%容姿の文(番号)%　　露出度：{露出度(番号)}<br>"

SIF 番号 != MASTER
	出力 += @"<br>　来店の癖：%来店の癖(番号)%<br>"

;客のときだけ。主人公の退店予定は0のままなので番号でも弾く
IF 番号 != MASTER && 退店予定:番号:0 >= 0
	残り = 退店予定:番号:0 - (経過日数 * 1440 + 現在時刻)
	SIF 残り < 0
		残り = 0
	出力 += @"　今日：%満足度の段名:(LIMIT((満足度:番号:0 + 100) / 40, 0, 4))%　　残り滞在 あと{残り}分<br>"
ENDIF

RETURNF 出力


;CSV の来店時刻中心・滞在時間中心・曜日偏りを一文に
@来店の癖(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 曜日番号
#DIM 週末
#DIM 平日
#DIMS 日々

;= の右辺は FORM なので @" を付けない（付けると @" が文字に入る）
IF CFLAG:番号:来店時刻中心 > 0
	出力 = {CFLAG:番号:来店時刻中心 / 60}時ごろに来て
ELSE
	出力 = 決まった時間はなく
ENDIF
IF CFLAG:番号:滞在時間中心 >= 60
	出力 += @"{CFLAG:番号:滞在時間中心 / 60}時間ほど"
ELSEIF CFLAG:番号:滞在時間中心 > 0
	出力 += @"{CFLAG:番号:滞在時間中心}分ほど"
ELSE
	出力 += "1時間半ほど"
ENDIF

;偏りが100を超える曜日。金土日だけなら「週末」、それ以外は曜日を並べる
週末 = 0
平日 = 0
日々 '= ""
FOR 曜日番号, 0, 7
	SIF CFLAG:番号:(GETNUM(CFLAG, "曜日偏り_日") + 曜日番号) <= 100
		CONTINUE
	IF 曜日番号 == 0 || 曜日番号 >= 5
		週末 += 1
	ELSE
		平日 += 1
	ENDIF
	SIF 日々 != ""
		日々 += "・"
	日々 += 曜日名(曜日番号)
NEXT
IF 週末 > 0 && 平日 == 0
	出力 += "。週末に多い"
ELSEIF 週末 + 平日 > 0
	出力 += @"。%日々%に多い"
ENDIF

RETURNF 出力


;8つ全部、Lv とバー。3つずつ3行（4つだと詰まって見えた）。バーは次の Lv までの経験の進み（刻みは仮）
@能力_技能(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 技能

出力 '= "　"
FOR 技能, 0, 技能数
	出力 += @"%ABLNAME:技能% Lv{ABL:番号:技能} %ゲージHTML(EXP:番号:技能 % 技能の一段, 技能の一段, 500, 50, "70A0D0", "203040")%　　　"
	SIF 技能 % 3 == 2
		出力 += "<br>　"
NEXT
出力 += "<br>"

RETURNF 出力


;素質タグを [ ] で並べる。性別タグ（0〜3）は情報に出したので除く。口上タイプ（口上_）と方言（方言_）は中身の話でないので出さない
@能力_素質(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 素質
#DIM 数

出力 '= "　"
数 = 0
FOR 素質, 4, VARSIZE("TALENT")
	SIF !TALENT:番号:素質 || TALENTNAME:素質 == "" || STRFIND(TALENTNAME:素質, "口上_") == 0 || 方言の素質か(素質) || 体格の素質か(素質)
		CONTINUE
	出力 += @"[%TALENTNAME:素質%]"
	数 += 1
NEXT
SIF 数 == 0
	出力 += "（なし）"
出力 += "<br>"

RETURNF 出力


;服装（erablue_resort の @PRINT_STATE_CLOTH の形）：■服の名前（CSTR 服装。未記入は私服）→ 着ているものを [ ] で → 汚れ。
;服の状態と汚れは主人公の居る個室の中でだけ動く（→個室.ERB の脱衣と汚れ、画面イメージ「サイド領域」）
@能力_服装(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
