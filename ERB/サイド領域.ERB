;感度は部位ごと（PALAM list と同じ英字。性別に無い部位は出さない）、耐性と慣れは1本ずつ（刻みは仮）
;胎内精液（eraTOWN の □ 胎内精液 □）：膣内／子宮内の量の名と相手別の内訳。残っている段だけ。
;膣の分は洗えば消え、子宮の分は日替わりで減る（→妊娠.ERB「精液のスロット」）
@能力_胎内精液(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力

出力 '= ""
SIF 膣の合計(番号) > 0
	出力 += @"　膣内：%精液量の名(膣の合計(番号))%%精液の内訳(番号, 1)%<br>"
SIF 子宮の合計(番号) > 0
	出力 += @"　子宮内：%精液量の名(子宮の合計(番号))%%精液の内訳(番号, 0)%<br>"
RETURNF 出力


@能力_開発度(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 部位
#DIM 数

;感度を2本ずつ1行に
出力 '= ""
数 = 0
FOR 部位, 0, 6
	SIF !(部位のある性別:部位 & 性別ビット(番号))
		CONTINUE
	出力 += 開発度マス(@"感度%部位記号:部位%", 開発度_感度:番号:部位)
	数 += 1
	SIF 数 % 2 == 0
		出力 += "<br>"
NEXT
SIF 数 % 2 == 1
	出力 += "<br>"
;感度の並びと耐性・慣れの間は1行あける
出力 += "<br>"
;「感度M」（全角2＋半角1）と幅を揃えるため、半角スペースで埋める
出力 += 開発度マス("耐性 ", 開発度_耐性:番号:0)
出力 += 開発度マス("慣れ ", 開発度_慣れ:番号:0)
出力 += "<br>"

RETURNF 出力


