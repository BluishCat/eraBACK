;================================ 後付け施設（3F。50〜） ================================
;建てるときに種類を選び、種類ごとに中身がある（→画面イメージ「後付け施設の中身」）。
;台帳は CSV/台帳/施設.csv（番号・名前・値段・一言。番号は下の分岐と結びついているので動かさない）。
;建てた枠（0〜19。場所は 50＋枠）にどの種類が入っているかは `施設の種類:枠`（0 は未建築なので +1 して入れる）。
;種類が入っていない枠は古いセーブで建てた分。場所名は「施設n」のまま、中身は無い

;その場所に建っている施設の種類。施設でなければ -1
@場所の施設(位置)
#FUNCTION
#DIM 位置

SIF 位置 < 50 || 位置 >= 50 + 後付け施設数
	RETURNF -1
RETURNF 施設の種類:(位置 - 50) - 1


;その種類が建っているか
@施設が建っているか(種類)
#FUNCTION
#DIM 種類
#DIM 枠

FOR 枠, 0, 後付け施設数
	SIF 施設の種類:枠 == 種類 + 1
		RETURNF 1
NEXT
RETURNF 0


;その種類の場所（建っていなければ -1）
@施設のある場所(種類)
#FUNCTION
#DIM 種類
#DIM 枠

FOR 枠, 0, 後付け施設数
	SIF 施設の種類:枠 == 種類 + 1
		RETURNF 50 + 枠
NEXT
RETURNF -1


;================================ 建てる（起床前の増築 [4]） ================================
;増築メニューの行。建てた数を出し、その下に全種類を値段つきで並べる（2026-10-01 ユーザ指定
;「後付け施設は値段とともにすべて表示しておく」）。建ててあるものも並べる。番号は [4] ひとつで、種類は開いた先で選ぶ
@後付け施設の行(番号)
#DIM 番号
#DIM 種類
#DIM 残り
#DIM 最安

残り = 0
最安 = -1
FOR 種類, 0, 施設種類数
	SIF 施設名:種類 == "" || 施設が建っているか(種類)
		CONTINUE
	残り += 1
	SIF 最安 < 0 || 施設値段:種類 < 最安
		最安 = 施設値段:種類
NEXT

IF 後付け施設数 >= 増築の上限 || 残り < 1
	PRINTFORML 　　　 %"後付け施設", 14, LEFT%{後付け施設数}　（これ以上は建てられない）
ELSEIF MONEY:MASTER < 最安
	PRINTFORML 　　　 %"後付け施設", 14, LEFT%{後付け施設数}　（所持金が足りない）
ELSE
	PRINTFORML [{番号}] %"後付け施設", 14, LEFT%{後付け施設数}　（種類を選ぶ）
ENDIF

FOR 種類, 0, 施設種類数
	SIF 施設名:種類 == ""
		CONTINUE
	PRINTFORM 　　　　　 %埋める(施設名:種類, 14)%
	IF 施設が建っているか(種類)
		PRINTFORML （建ててある）
	ELSE
		PRINTFORM %金額(施設値段:種類)%円
		IF 後付け施設数 >= 増築の上限
			PRINTFORML 　（これ以上は建てられない）
		ELSEIF MONEY:MASTER < 施設値段:種類
			PRINTFORML 　（所持金が足りない）
		ELSE
			PRINTL
		ENDIF
	ENDIF
NEXT


;種類の一覧。増築メニューの [4] から。建ててあるものは番号なしで「（建ててある）」（増築・個室の設備と同じ形）
@施設を選んで建てる
#DIM 種類
#DIMS 頭

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	CALL 見取り図を出す
	CALL 本文罫線
	PRINTL 　後付け施設（3階。建てると、そこでできることが増える）
	PRINTFORML 　所持金 %金額(MONEY:MASTER)%円
	PRINTL
	FOR 種類, 0, 施設種類数
		SIF 施設名:種類 == ""
			CONTINUE
		;「[11] 」と同じ半角5で頭を揃える（増築の設備と同じ）
		IF 施設が建っているか(種類) || MONEY:MASTER < 施設値段:種類 || 後付け施設数 >= 増築の上限
			頭 '= "　　 "
		ELSE
			頭 '= @"[{種類 + 1}] "
		ENDIF
		PRINTS 頭
		IF 施設が建っているか(種類)
			PRINTFORM %埋める(施設名:種類, 14)%%埋める("（建ててある）", 18)%
		ELSE
			PRINTFORM %埋める(施設名:種類, 14)%%埋める(@"%金額(施設値段:種類)%円", 18)%
		ENDIF
		PRINTFORM %施設の一言:種類%
		IF !施設が建っているか(種類) && 後付け施設数 >= 増築の上限
			PRINTFORML 　（これ以上は建てられない）
		ELSEIF !施設が建っているか(種類) && MONEY:MASTER < 施設値段:種類
			PRINTFORML 　（所持金が足りない）
		ELSE
			PRINTL
		ENDIF
	NEXT
	PRINTL
	PRINTL [0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE

	SIF RESULT == 0
		RETURN 0
	SIF RESULT >= 1 && RESULT <= 施設種類数
		CALL 施設を建てる(RESULT - 1)
LOOP 1


;建てる。枠を一つ使い、その枠に種類を入れる。見取り図はその場で伸びる（増築と同じ）
@施設を建てる(種類)
#DIM 種類

SIF 種類 < 0 || 種類 >= 施設種類数 || 施設名:種類 == "" || 施設が建っているか(種類)
	RETURN 0
SIF 後付け施設数 >= 増築の上限 || MONEY:MASTER < 施設値段:種類
	RETURN 0

施設の種類:後付け施設数 = 種類 + 1
後付け施設数 += 1
MONEY:MASTER -= 施設値段:種類
今日の店の外:外_増築 -= 施設値段:種類
PRINTFORML %施設名:種類%を建てた（%金額(施設値段:種類)%円）


;================================ 施設のコマンド ================================
;その場所でできること（→USERCOM.ERB @場所のコマンド）
@施設のコマンド
#DIM 種類

種類 = 場所の施設(CFLAG:MASTER:現在位置)
SELECTCASE 種類
	CASE 施設_浴場
		;自宅の風呂と同じ（個室の場面を商品なしで開く）。一人でも体を洗える
		CALL コマンドを並べる(1033, @"体を洗う（{洗うの分}分）")
		SIF 同行キャラ > 0
			CALL コマンドを並べる(1043, @"%CALLNAME:同行キャラ%と風呂に入る")
	CASE 施設_プレイルーム
		SIF 同行キャラ > 0
			CALL コマンドを並べる(1012, @"%CALLNAME:同行キャラ%と道具を使う")
	CASE 施設_稽古場
		CALL 稽古場のコマンド
	CASE 施設_休憩室
		;[1032] 休憩する は「その他」に出る（→行動.ERB @落ち着ける）。一人ならお茶は出さない
		SIF 居合わせた人数() > 0 && 払えるか(0, お茶の気力) && !酔いすぎ(MASTER)
			CALL コマンドを並べる(1029, @"お茶を淹れる（気力{お茶の気力}・{お茶の分}分）")
ENDSELECT


;稽古場の2つ。気力が足りなければ出さない
@稽古場のコマンド

SIF !払えるか(0, 稽古の気力) || 酔いすぎ(MASTER)
	RETURN 0
SIF 教えられる人数() > 0
	CALL コマンドを並べる(1013, @"技能を教える（気力{稽古の気力}・{稽古の分}分）")
CALL コマンドを並べる(1028, @"稽古する（気力{稽古の気力}・{稽古の分}分）")


;同じ場所に居る人の数。場面の相手は除く（人目の分の羞恥と、お茶の相手に使う）
@居合わせた人数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	SIF 番号 == 裏の相手:MASTER:0
		CONTINUE
	数 += 1
NEXT
RETURNF 数


;主人公と同じ場所に、相手のほかは誰も居ないか（逢引の「人目のない場所」の判定 → 行動.ERB・客.ERB「逢引」）
@二人きりか(相手)
#FUNCTION
#DIM 相手
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置 || 番号 == 相手
		CONTINUE
	RETURNF 0
NEXT
RETURNF 1


;================================ 浴場・プレイルーム ================================
;いまの場面が施設の中か（人目の分の羞恥 → 個室.ERB の一手の末尾）
@施設の場面か
#FUNCTION
#DIM 種類

SIF 裏の相手:MASTER:0 <= 0
	RETURNF 0
種類 = 場所の施設(CFLAG:MASTER:現在位置)
RETURNF 種類 == 施設_浴場 || 種類 == 施設_プレイルーム


;一手ごとの人目の分。両方に羞恥。居合わせた人が居れば倍（→画面イメージ「後付け施設の中身」）
@施設の一手
#DIM 相手
#DIM 量

相手 = 裏の相手:MASTER:0
SIF 相手 <= 0
	RETURN 0
量 = 施設の一手の羞恥
SIF 居合わせた人数() > 0
	量 *= 2
PALAM:MASTER:羞恥 += 量
PALAM:相手:羞恥 += 量
SIF PALAM:MASTER:羞恥 > PALAM上限
	PALAM:MASTER:羞恥 = PALAM上限
SIF PALAM:相手:羞恥 > PALAM上限
	PALAM:相手:羞恥 = PALAM上限


;浴場。連れている相手と入る。自宅の風呂と同じ場面（商品 −1。出るのは浴室と脱衣だけ）。
;金・同意・時間切れ・商品回数・売上は無い。個室と違って他の人が居合わせられる
@浴場に入る
#DIM 相手

相手 = 同行キャラ
IF 場所の施設(CFLAG:MASTER:現在位置) != 施設_浴場 || 相手 <= 0 || !実キャラ:相手:0
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF
裏の相手:MASTER:0 = 相手
裏の相手:相手:0 = MASTER
裏の商品:MASTER:0 = -1
裏の商品:相手:0 = -1
裏の終わり:MASTER:0 = 経過日数 * 1440 + 現在時刻 + 100000
裏の終わり:相手:0 = 裏の終わり:MASTER:0
CALL 個室に入る
PRINTL
PRINTFORML %CALLNAME:相手%と一緒に湯に浸かった
SIF 居合わせた人数() > 0
	PRINTL 湯気の向こうに人の気配がある
WAIT


;プレイルーム。連れている相手と場面を開く（商品 −5。出るのは浴室以外の全部）。
;個室で出る行為がそのまま出る（買ってある設備の手を含む）。金・同意の売り買いは無い
@プレイルームに入る
#DIM 相手

相手 = 同行キャラ
IF 場所の施設(CFLAG:MASTER:現在位置) != 施設_プレイルーム || 相手 <= 0 || !実キャラ:相手:0
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF
裏の相手:MASTER:0 = 相手
裏の相手:相手:0 = MASTER
裏の商品:MASTER:0 = 商品_プレイルーム
裏の商品:相手:0 = 商品_プレイルーム
裏の終わり:MASTER:0 = 経過日数 * 1440 + 現在時刻 + 100000
裏の終わり:相手:0 = 裏の終わり:MASTER:0
CALL 個室に入る
PRINTL
PRINTFORML %CALLNAME:相手%をプレイルームに立たせた
SIF 居合わせた人数() > 0
	PRINTL 見ている者が居る
WAIT


;プレイルームを終える。その場の値は残る（→個室.ERB @一日の開発度。個室と同じ）。拭わずに出れば部屋が汚れる。同行はそのまま
@プレイルームを終える
#DIM 相手

相手 = 裏の相手:MASTER:0
SIF 相手 <= 0
	RETURN 0
CALL モードを全部消す
CALL 個室を出る(CFLAG:MASTER:現在位置)
裏の相手:MASTER:0 = 0
裏の相手:相手:0 = 0
裏の商品:MASTER:0 = 0
裏の商品:相手:0 = 0
裏の終わり:MASTER:0 = -1
裏の終わり:相手:0 = -1
SAVESTR:モード = 店
IF 気絶中:相手:0
	SIF 同行キャラ == 相手
		CALL 同行を解く
	CALL 気絶者を運ぶ(相手, 0)
ENDIF


;================================ 稽古場 ================================
;教えられる相手（同じ場所に居るスタッフで、自分より低い技能が一つでもある人）の数
@教えられる人数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !教えられるか(番号)
		CONTINUE
	数 += 1
NEXT
RETURNF 数


;その人に教えられるか。同じ場所に居るスタッフで、気絶中・陣痛中でなく、自分より低い技能がある
@教えられるか(番号)
#FUNCTION
#DIM 番号
#DIM 技能

SIF 番号 <= 0 || 番号 == MASTER || !実キャラ:番号:0 || !スタッフ:番号:0
	RETURNF 0
SIF CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
	RETURNF 0
SIF 気絶中:番号:0 || 陣痛:番号:0
	RETURNF 0
FOR 技能, 0, 技能数
	SIF ABL:MASTER:技能 > ABL:番号:技能 && ABL:番号:技能 < 技能Lv上限
		RETURNF 1
NEXT
RETURNF 0


;[1013] 技能を教える。相手 → 技能 の順に選ぶ。自分の Lv が上の技能だけ出す
@技能を教える
#DIM 相手
#DIM 技能
#DIM 量
#DIMS 台詞, 4

IF 場所の施設(CFLAG:MASTER:現在位置) != 施設_稽古場 || !払えるか(0, 稽古の気力) || 酔いすぎ(MASTER)
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF
CALL 教える相手を選ぶ
相手 = RESULT
SIF 相手 <= 0
	RETURN 0
CALL 教える技能を選ぶ(相手)
技能 = RESULT
SIF 技能 < 0
	RETURN 0

CALL 体力気力を減らす(MASTER, 0, 稽古の気力)
PRINTL
PRINTFORML %CALLNAME:相手%に%ABLNAME:技能%を教えた
;Lv の差が大きいほど入る
量 = 稽古の経験 * (ABL:MASTER:技能 - ABL:相手:技能)
CALL 経験を積む(相手, 技能, 量)
;教えた側にも少し
CALL 経験を積む(MASTER, 技能, 教えるの経験)
;稽古なので相手には少し溜まる
ストレス:相手:0 += 稽古のストレス
SIF ストレス:相手:0 > ストレスの上限
	ストレス:相手:0 = ストレスの上限
;教わった相手の一言（反応）
台詞:0 '= "真剣な顔でうなずき、「ありがとうございます」と言った"
台詞:1 '= "コツをつかんだように、小さく息をついた"
台詞:2 '= "汗を拭いながら「疲れました…」と苦笑いした"
台詞:3 '= "何度も繰り返し確かめるように動きをなぞっていた"
PRINTFORML 　%CALLNAME:相手%は%台詞:(RAND(4))%
CALL 時間を進める(稽古の分)
CALL 結果で止まる


;誰に教えるか。自分より低い技能だけを並べて材料にする
@教える相手を選ぶ
#DIM 番号
#DIM 技能
#DIM 数

PRINTL
PRINTL 誰に教えますか（キャラ番号。[0] でやめる）
数 = 0
FOR 番号, 1, キャラ枠
	SIF !教えられるか(番号)
		CONTINUE
	PRINTFORM [{番号, 2, RIGHT}] %埋める(CALLNAME:番号, 10)%
	FOR 技能, 0, 技能数
		SIF ABL:MASTER:技能 <= ABL:番号:技能 || ABL:番号:技能 >= 技能Lv上限
			CONTINUE
		PRINTFORM %埋める(@"%ABLNAME:技能% Lv{ABL:番号:技能}", 12)%
	NEXT
	PRINTL
	数 += 1
NEXT
IF 数 == 0
	PRINTL 教えられる相手が居ない
	WAIT
	RETURN 0
ENDIF
PRINTL [ 0] やめる
INPUT
番号 = RESULT
SIF 番号 <= 0 || 番号 >= キャラ枠 || !教えられるか(番号)
	RETURN 0
RETURN 番号


;何を教えるか。技能の番号 +1 で出す（[0] はやめる）
@教える技能を選ぶ(相手)
#DIM 相手
#DIM 技能

PRINTL
PRINTFORML %CALLNAME:相手%に何を教えますか（番号。[0] でやめる）
FOR 技能, 0, 技能数
	SIF ABL:MASTER:技能 <= ABL:相手:技能 || ABL:相手:技能 >= 技能Lv上限
		CONTINUE
	PRINTFORML [{技能 + 1}] %埋める(ABLNAME:技能, 8)%Lv{ABL:相手:技能}　→　（あなた Lv{ABL:MASTER:技能}）
NEXT
PRINTL [0] やめる
INPUT
技能 = RESULT - 1
SIF 技能 < 0 || 技能 >= 技能数 || ABL:MASTER:技能 <= ABL:相手:技能 || ABL:相手:技能 >= 技能Lv上限
	RETURN -1
RETURN 技能


;[1028] 稽古する。自分の技能を一つ選んで積む。相手は要らない
@稽古する
#DIM 技能

IF 場所の施設(CFLAG:MASTER:現在位置) != 施設_稽古場 || !払えるか(0, 稽古の気力) || 酔いすぎ(MASTER)
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF
PRINTL
PRINTL 何の稽古をしますか（番号。[0] でやめる）
FOR 技能, 0, 技能数
	SIF ABL:MASTER:技能 >= 技能Lv上限
		CONTINUE
	PRINTFORML [{技能 + 1}] %埋める(ABLNAME:技能, 8)%Lv{ABL:MASTER:技能}
NEXT
PRINTL [0] やめる
INPUT
技能 = RESULT - 1
SIF 技能 < 0 || 技能 >= 技能数 || ABL:MASTER:技能 >= 技能Lv上限
	RETURN 0

CALL 体力気力を減らす(MASTER, 0, 稽古の気力)
PRINTL
PRINTFORML %ABLNAME:技能%の稽古をした
CALL 経験を積む(MASTER, 技能, 稽古の経験)
CALL 時間を進める(稽古の分)
CALL 結果で止まる


;================================ 休憩室 ================================
;[1029] お茶を淹れる。同じ場所に居る人全員（主人公も）の体力・気力が戻り、ストレスが抜ける
@お茶を淹れる
#DIM 番号
#DIM 数
#DIMS 名

IF 場所の施設(CFLAG:MASTER:現在位置) != 施設_休憩室 || !払えるか(0, お茶の気力) || 酔いすぎ(MASTER)
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF

CALL 体力気力を減らす(MASTER, 0, お茶の気力)
CALL 体力気力を戻す(MASTER)
数 = 0
名 '= ""
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	SIF 気絶中:番号:0
		CONTINUE
	CALL 体力気力を戻す(番号)
	ストレス:番号:0 -= お茶のストレス
	SIF ストレス:番号:0 < 0
		ストレス:番号:0 = 0
	SIF 名 != ""
		名 += "と"
	名 += CALLNAME:番号
	数 += 1
NEXT

PRINTL
IF 数 > 0
	PRINTFORML お茶を淹れた。%名%が一息ついた
ELSE
	PRINTL お茶を淹れて、一息ついた
ENDIF
CALL 時間を進める(お茶の分)
CALL 結果で止まる


;お茶の分だけ体力と気力を戻す（上限で止める）
@体力気力を戻す(番号)
#DIM 番号

BASE:番号:体力 += お茶の回復
SIF BASE:番号:体力 > MAXBASE:番号:体力
	BASE:番号:体力 = MAXBASE:番号:体力
BASE:番号:気力 += お茶の回復
SIF BASE:番号:気力 > MAXBASE:番号:気力
	BASE:番号:気力 = MAXBASE:番号:気力
