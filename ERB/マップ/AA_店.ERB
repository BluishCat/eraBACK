;画面0 — 店。左に1階、右に3階と2階を並べる（→設計メモ「画面0 — 店」）
;
;1階の間取りは _tools/間取り生成.py が吐いたもの。手で直すと幅がずれ、隣接表とも食い違う
;  裏方（05バックヤード・06厨房・07控室・14事務室）が上段
;  02カウンターが表と裏の境の帯
;  03ホールが中央で、04舞台はその中に囲まれている
;  下段に BX（ボックス席の区画）・08玄関・10トイレ・11一階の階段
;  下辺の隙間が玄関で、その外の09が店の外へ通じる
;
;可変の3種（ボックス席・個室・後付け施設）は区画の中に建てた分だけ番号を並べる
;地下（会員制）は建ててあれば1階の下に出す。1階の 02／04／03 の組み方をそのまま写す（→画面イメージ「地下」）

@MAP_VIEWING_0(AA)
#DIMS REF AA, 0
#DIMS 左, 40
#DIMS 右, 40
#DIM 左数
#DIM 右数
#DIM 行

VARSET 左
VARSET 右

CALL 店_一階(左)
左数 = RESULT
IF 地下あり
	CALL 店_地下(左, 左数)
	左数 = RESULT
ENDIF
CALL 店_上の階(右)
右数 = RESULT

FOR 行, 0, MAX(左数, 右数)
	SIF 行 >= 左数
		左:行 = %PAD("", 50)%
	SIF 行 >= 右数
		右:行 = 
	AA:行 = %PAD(左:行, 54)%%右:行%
NEXT

RETURN 0


;-----------------------------------------------------------
;1階。BXの行だけボックス席の数で中身が変わる
;-----------------------------------------------------------
@店_一階(左)
#DIMS REF 左, 0
#DIM 行
#DIM 席
#DIMS 一時

行 = 0

左:(行++) = 一階
;地下が建っていれば、裏の廊下の右端に裏階段78（地下裏階段76の真上）
IF 地下あり
	左:(行++) = ┌───────────────────┬───┐
	左:(行++) = │　　　　　　　　　16　　　　　　　　　│　78　│
	左:(行++) = ├─　─┬─　─────┬─　─┬─　─┴───┤
ELSE
	左:(行++) = ┌───────────────────────┐
	左:(行++) = │　　　　　　　　　　　　　16　　　　　　　　　│
	左:(行++) = ├─　─┬─　─────┬─　─┬─　─────┤
ENDIF
左:(行++) = │　05　│　　　　　06　│　07　│　　　　　14　│
左:(行++) = ├───┴─　─────┴───┴───────┤
左:(行++) = │　　　　　　　　　　　　　02　　　　　　　　　│
左:(行++) = ├─　─┬───────┬───────────┤
左:(行++) = │　　　　　　　　　04　│　　　　　　　　　　　│
左:(行++) = │　　　└───────┘　　　　　　　　　　　│
左:(行++) = │　　　　　03　　　　　　　　　　　　　　　　　│
左:(行++) = ├─　─────────┬─　─┬─　─┬─　─┤

;ボックス席。建てた分だけ番号を並べる（区画の内側は幅22）
一時 = 
FOR 席, 0, ボックス席数
	一時 += @"　{席 + 80, 2, RIGHT}"
NEXT
左:(行++) = │%PAD(一時, 22)%│　08　│　10　│　11　│

左:(行++) = └───────────┴─　─┴───┴───┘
左:(行++) = %PAD("　　　　　　　　　　　　　09", 50)%

RETURN 行


;-----------------------------------------------------------
;地下。右上に地下裏階段76（1階の裏階段78から降りて18へ）、カウンター18が上の帯、ホール17の中にステージ19、右下にトイレ79と地下階段77（一階階段11から降りて17へ）
;-----------------------------------------------------------
@店_地下(左, 開始行)
#DIMS REF 左, 0
#DIM 開始行
#DIM 行

行 = 開始行

左:(行++) = 地下
左:(行++) = 　　　　　　　　　　　　　　　　　　　　┌───┐
左:(行++) = 　　　　　　　　　　　　　　　　　　　　│　76　│
左:(行++) = ┌───────────────────┴─　─┤
左:(行++) = │　　　　　　　　　　　　　18　　　　　　　　　│
左:(行++) = ├─　─┬───────┬───────────┤
左:(行++) = │　　　　　　　　　19　│　　　　　　　　　　　│
左:(行++) = │　　　└───────┘　　　　　　　　　　　│
左:(行++) = │　　　　　17　　　　　　　　　┌─　─┬─　─┤
左:(行++) = │　　　　　　　　　　　　　　　│　79　│　77　│
左:(行++) = └───────────────┴───┴───┘

RETURN 行


;-----------------------------------------------------------
;3階と2階。建てた部屋の数だけ横に伸びる
;-----------------------------------------------------------
@店_上の階(右)
#DIMS REF 右, 0
#DIM 行

行 = 0

右:(行++) = 三階
CALL 階を組む(右, 行, 後付け施設数, 50, 13)
行 = RESULT
右:(行++) = 
右:(行++) = 二階
CALL 階を組む(右, 行, 個室数, 20, 12)
行 = RESULT

RETURN 行


;階段ホールと、その下に並ぶ部屋を組む
@階を組む(配列, 開始行, 部屋数, 基準番号, 階段番号)
#DIMS REF 配列, 0
#DIM 開始行
#DIM 部屋数
#DIM 基準番号
#DIM 階段番号
#DIM 行
#DIM 部屋
#DIM 幅
#DIMS 上
#DIMS 中
#DIMS 下

行 = 開始行

;部屋が無ければ階段ホールだけ
IF 部屋数 < 1
	配列:(行++) = ┌─────────────┐
	配列:(行++) = │%PAD(@"　{階段番号, 2, RIGHT}", 26)%│
	配列:(行++) = └─────────────┘
	RETURN 行
ENDIF

;部屋1つで幅10。階段ホールの枠をその幅に合わせる
幅 = 部屋数 * 10

配列:(行++) = ┌%罫線(幅 - 4)%┐
配列:(行++) = │%PAD(@"　{階段番号, 2, RIGHT}", 幅 - 4)%│

;部屋の枠を横に並べる。最初の部屋にだけ階段ホールからのドアを開ける
上 = ├─　─
中 = │
下 = └
FOR 部屋, 0, 部屋数
	SIF 部屋 > 0
		上 += 罫線(6)
	中 += FORMAT_部屋(部屋 + 基準番号)
	下 += 罫線(6)
	IF 部屋 < 部屋数 - 1
		上 += "┬"
		中 += "│"
		下 += "┴"
	ENDIF
NEXT
配列:(行++) = %上%┤
配列:(行++) = %中%│
配列:(行++) = %下%┘

RETURN 行


;部屋のマス（内側6幅）
@FORMAT_部屋(番号)
#FUNCTIONS
#DIM 番号
RETURNF @"　{番号, 2, RIGHT}　"
