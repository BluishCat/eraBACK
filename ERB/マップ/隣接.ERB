;場所どうしのつながり。移動にかかる時間を最短手数から出すために持つ（→設計メモ「建物」）
;
;隣接の制約は置かない。どの番号も押せる。この表は「遠さ」を数えるためだけにある
;起動のたびに組み直すので、セーブには載せない

@初期化_隣接
#DIM 番号

VARSET 隣接数
VARSET 隣接

;----- 店の1F -----
;ホールが1Fの中心。玄関・外・トイレ・階段・寮・自宅がここから出る
CALL つなぐ(3, 8)
CALL つなぐ(3, 9)
CALL つなぐ(3, 10)
CALL つなぐ(3, 11)
CALL つなぐ(3, 15)
CALL つなぐ(3, 1)
CALL つなぐ(3, 4)
CALL つなぐ(3, 2)

;裏方は裏の廊下16でつながる。厨房だけカウンターと直結
;（注文→調理→配膳を短くするため。他の部屋は廊下ぶん遠くなる）
CALL つなぐ(2, 6)
CALL つなぐ(16, 5)
CALL つなぐ(16, 6)
CALL つなぐ(16, 7)
CALL つなぐ(16, 14)

;ボックス席はホールの中
FOR 番号, 80, 100
	CALL つなぐ(3, 番号)
NEXT

;----- 階段 -----
CALL つなぐ(11, 12)
CALL つなぐ(12, 13)

;地下（会員制）。ホール17が中心で、カウンター18・ステージ19・トイレ79はその中（→画面イメージ「地下」）
;階段は1階の 11／12／13 と同じで階ごとに場所を持つ（2026-09-15）：客側は 一階階段11 → 地下階段77 → 17、裏側は 裏の廊下16 → 裏階段78 → 地下裏階段76 → 18（厨房は1階と共用）
;建てていなくてもつないでおく（起動のたびに組み直す表なので、建った日に組み直さずに済む。番号が押せるかは場所名で決まる）
CALL つなぐ(11, 77)
CALL つなぐ(77, 17)
CALL つなぐ(16, 78)
CALL つなぐ(78, 76)
CALL つなぐ(76, 18)
CALL つなぐ(17, 18)
CALL つなぐ(17, 19)
CALL つなぐ(17, 79)

;個室は2Fの階段から。建てられる数まで（帯の余り 40〜49 はつながない）
FOR 番号, 20, 20 + 増築の上限
	CALL つなぐ(12, 番号)
NEXT

;後付け施設は3Fの階段から。建てられる数まで（帯の余り 70〜79 はつながない。79 は地下トイレ）
FOR 番号, 50, 50 + 増築の上限
	CALL つなぐ(13, 番号)
NEXT

;----- 店の外 -----
;施設を選んで直接行くので、店の外どうしは全部つながっている
CALL つなぐ(300, 301)
CALL つなぐ(300, 302)
CALL つなぐ(300, 304)
CALL つなぐ(300, 309)
CALL つなぐ(9, 309)

;----- 寮 -----
CALL つなぐ(15, 409)
CALL つなぐ(400, 409)
FOR 番号, 410, 500
	CALL つなぐ(400, 番号)
NEXT

;----- 自宅 -----
;玄関01が1Fの中心。絵の壁の隙間と一致させる
;  上：風呂03・トイレ02（水回り）／下：階段06・客間07／右：リビング05
CALL つなぐ(1, 509)
CALL つなぐ(501, 509)
CALL つなぐ(501, 503)
CALL つなぐ(501, 502)
CALL つなぐ(501, 506)
CALL つなぐ(501, 507)
CALL つなぐ(501, 505)

;リビング05の下がキッチン04
CALL つなぐ(505, 504)

;階段で2Fへ。私室と空き部屋は2Fの階段から
CALL つなぐ(506, 508)
CALL つなぐ(508, 510)
CALL つなぐ(508, 511)
CALL つなぐ(508, 512)
CALL つなぐ(508, 513)


;双方向に登録する
@つなぐ(こちら, あちら)
#DIM こちら
#DIM あちら

IF 隣接数:こちら < 隣接上限
	隣接:こちら:(隣接数:こちら) = あちら
	隣接数:こちら ++
ENDIF
IF 隣接数:あちら < 隣接上限
	隣接:あちら:(隣接数:あちら) = こちら
	隣接数:あちら ++
ENDIF


;画面をまたぐ出入口の番号なら、その先の画面（3＝店の外・4＝寮・5＝自宅・0＝店）。出入口でなければ -1
;出入口は見取り図を切り替えるだけのボタンで、場所ではない（→USERCOM.ERB @USERCOM_実行）
;408（寮）と514（自宅）は店を通らずに店の外へ出る出口（2026-10-16 ユーザ指定「家や寮からは直接外に出られるように」）
@入口の行き先画面(番号)
#FUNCTION
#DIM 番号

SELECTCASE 番号
	CASE 9, 408, 514
		RETURNF 3
	CASE 15
		RETURNF 4
	CASE 1
		RETURNF 5
	CASE 309, 409, 509
		RETURNF 0
ENDSELECT
RETURNF -1


;見取り図で見ている画面。出入口で切り替えていなければ、居る場所の画面
@見ている画面
#FUNCTION

SIF 見取り図の画面 > 0
	RETURNF 見取り図の画面 - 1
RETURNF CFLAG:MASTER:現在位置 / 100


;店から各画面へ入る：かかる手数と、着く場所（店の外の入口・寮の入口・自宅の玄関）
@入る手数(画面)
#FUNCTION
#DIM 画面

SELECTCASE 画面
	CASE 3
		RETURNF 2
	CASE 4, 5
		RETURNF 1
ENDSELECT
RETURNF 0


@入る先(画面)
#FUNCTION
#DIM 画面

RETURNF 画面 * 100


;各画面から店へ戻る：かかる手数と、着く場所（店の入口・寮への出口・自宅への出口）
@戻る手数(画面)
#FUNCTION
#DIM 画面

SELECTCASE 画面
	CASE 3
		RETURNF 2
	CASE 4, 5
		RETURNF 1
ENDSELECT
RETURNF 0


@戻る先(画面)
#FUNCTION
#DIM 画面

SELECTCASE 画面
	CASE 3
		RETURNF 8
	CASE 4
		RETURNF 15
	CASE 5
		RETURNF 1
ENDSELECT
RETURNF 0


;寮・自宅から店を通らずに店の外へ出られるか（元の画面が 4 か 5、先の画面が 3）。かかる手数は店から外へ出るのと同じ（入る手数(3)）で、店へ戻る分が無い
@直接外へ出るか(元の画面, 先の画面)
#FUNCTION
#DIM 元の画面
#DIM 先の画面

RETURNF (元の画面 == 4 || 元の画面 == 5) && 先の画面 == 3


;いまの場所から先までの手数（時間は × 一手の分数）。別の画面なら出入口の分も足す（→USERCOM.ERB @画面をまたいで移動）。届かないときは -1
@行き先までの手数(先)
#FUNCTION
#DIM 先
#DIM 元の画面
#DIM 先の画面
#DIM 手数
#DIM 起点
#DIM 残り

元の画面 = CFLAG:MASTER:現在位置 / 100
先の画面 = 先 / 100
SIF 元の画面 == 先の画面
	RETURNF 移動手数(CFLAG:MASTER:現在位置, 先)

手数 = 0
起点 = CFLAG:MASTER:現在位置
IF 元の画面 != 0 && !直接外へ出るか(元の画面, 先の画面)
	手数 += 戻る手数(元の画面)
	起点 = 戻る先(元の画面)
ENDIF
IF 先の画面 != 0
	手数 += 入る手数(先の画面)
	起点 = 入る先(先の画面)
ENDIF
残り = 移動手数(起点, 先)
SIF 残り < 0
	RETURNF -1
RETURNF 手数 + 残り


;最短手数を幅優先で数える。届かないときは -1
@移動手数(元, 先)
#FUNCTION
#DIM 元
#DIM 先
#DIM 頭
#DIM 尾
#DIM 今
#DIM 次
#DIM 番号

SIF 元 == 先
	RETURNF 0

VARSET 訪問済, 0
VARSET 探索列, 0

頭 = 0
尾 = 0
探索列:(尾++) = 元
訪問済:元 = 1

WHILE 頭 < 尾
	今 = 探索列:(頭++)
	FOR 番号, 0, 隣接数:今
		次 = 隣接:今:番号
		SIF 訪問済:次
			CONTINUE
		訪問済:次 = 訪問済:今 + 1
		SIF 次 == 先
			RETURNF 訪問済:次 - 1
		探索列:(尾++) = 次
	NEXT
WEND

RETURNF -1


;元から先までの経路を 経路 に格納する（元は含まず、先で終わる）。手数を返す。届かないときは -1
;移動手数 と同じ幅優先探索だが、通った道筋（親）も覚えておいて後から辿る
@移動経路(元, 先)
#FUNCTION
#DIM 元
#DIM 先
#DIM 頭
#DIM 尾
#DIM 今
#DIM 次
#DIM 番号

SIF 元 == 先
	RETURNF 0

VARSET 訪問済, 0
VARSET 探索列, 0
VARSET 親, -1

頭 = 0
尾 = 0
探索列:(尾++) = 元
訪問済:元 = 1

WHILE 頭 < 尾
	今 = 探索列:(頭++)
	FOR 番号, 0, 隣接数:今
		次 = 隣接:今:番号
		SIF 訪問済:次
			CONTINUE
		訪問済:次 = 1
		親:次 = 今
		SIF 次 == 先
			RETURNF 経路を積む(先, 元)
		探索列:(尾++) = 次
	NEXT
WEND

RETURNF -1


;親をたどって 経路 に 元→先 の順で積む（元は含まず、先で終わる）。積んだ手数を返す
@経路を積む(先, 元)
#FUNCTION
#DIM 先
#DIM 元
#DIM 今
#DIM 数
#DIM 位置

数 = 0
今 = 先
WHILE 今 != 元
	数 += 1
	今 = 親:今
WEND

位置 = 数 - 1
今 = 先
WHILE 位置 >= 0
	経路:位置 = 今
	今 = 親:今
	位置 -= 1
WEND

RETURNF 数
