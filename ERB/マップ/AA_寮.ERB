;画面4 — 寮。店から直接つながる別棟。店 → 入口 → 部屋 の2手で着く（→設計メモ「画面4 — 寮」）
;
;番号は画面3と同じ流儀で 09 が「店に戻る」。部屋は 10 から（最大90室）
;一人一部屋。部屋数がそのまま雇える人数の上限になる

@MAP_VIEWING_4(AA)
#DIMS REF AA, 0
#DIM 行
#DIM 部屋
#DIM 並び
#DIMS 一時

行 = 0

AA:(行++) = ┌──────────────────────────────────────┐
AA:(行++) = %枠付き寮("寮")%

;部屋。建てた数だけ並べる。1行10室
一時 = 
並び = 0
FOR 部屋, 0, 寮の部屋数
	一時 += @"　　{部屋 + 10, 2, RIGHT}"
	並び ++
	IF 並び >= 10
		AA:(行++) = %枠付き寮(一時)%
		一時 = 
		並び = 0
	ENDIF
NEXT
IF 並び > 0 || 寮の部屋数 == 0
	AA:(行++) = %枠付き寮(一時)%
ENDIF

AA:(行++) = %枠付き寮("")%
AA:(行++) = %枠付き寮("　　08　　09")%
AA:(行++) = └──────────────────────────────────────┘


@枠付き寮(中身)
#FUNCTIONS
#DIMS 中身
RETURNF @"│%PAD(中身, 76)%│"
