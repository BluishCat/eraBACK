;見取り図と一覧まわりの共通の道具
;幅は半角単位（全角＝2）。STRLENS が表示幅を返すのでそれで数える

;全角スペースで目標幅まで埋める
@PAD(文字列, 目標幅)
#FUNCTIONS
#DIMS 文字列
#DIM 目標幅

WHILE STRLENS(文字列) < 目標幅
	文字列 += "　"
WEND

RETURNF 文字列


;─ を指定幅ぶん並べる
@罫線(幅)
#FUNCTIONS
#DIM 幅
#DIMS 出力

出力 = 

WHILE STRLENS(出力) < 幅
	出力 += "─"
WEND

RETURNF 出力


;================================ 番号付きの選択肢の並べ方 ================================
;素質・好物・口上タイプ・服装のように [番号] 名前 を沢山並べる一覧は、全角空白ひとつで区切ると詰まって列も揃わず読みにくい
;（2026-09-21 ユーザ指摘）。一マスを 選択肢のマス幅（半角単位）に揃え、一行の数 ごとに折る。
;呼び元は 数 を 0 から数えて渡し、折った行頭には 字下げ（見出しの幅ぶんの空白）を出す。付いている なら 付いている色

;[番号] 名前 を 幅 まで半角空白で埋めた一マス。全角は 2 と数える（STRLENS）
@選択肢のマス(番号, 名前, 幅)
#FUNCTIONS
#DIM 番号
#DIMS 名前
#DIM 幅
#DIMS 出力

出力 '= "[" + TOSTR(番号) + "] " + 名前
WHILE STRLENS(出力) < 幅
	出力 += " "
WEND

RETURNF 出力


;一マスを出す。数 が 一行の数 の倍数なら先に折り返す
@選択肢を並べる(数, 番号, 名前, 付いている, 一行の数, 字下げ)
#DIM 数
#DIM 番号
#DIMS 名前
#DIM 付いている
#DIM 一行の数
#DIMS 字下げ

IF 数 > 0 && 数 % 一行の数 == 0
	PRINTL
	PRINTS 字下げ
ENDIF
SIF 付いている
	SETCOLOR 付いている色
PRINTS 選択肢のマス(番号, 名前, 選択肢のマス幅)
RESETCOLOR


;主画面の［日常］［その他］のコマンドも、［セクハラ］の行と同じ列に揃える（2026-09-30 ユーザ指摘「まだコマンドの表示ズレがある」→
;各コマンドが「[番号] 名前」＋全角空白で好きな幅を取っていて、行ごとに列がずれ、折り返した行の字下げも抜けていた）。
;一マスは 選択肢のマス幅、長い名前は幅を切り上げて複数マスを取る。一行は4マスまで（全角1字下げ＋4マス）で、入りきらなければ折り返す。
;行頭は全角1字下げ。並べ終わったら @コマンド行を閉じる で改行する
@コマンドを並べる(番号, 名前)
#DIM 番号
#DIMS 名前
#DIMS 出力
#DIM 幅
#DIM マス

出力 '= 名前
;番号が負ならボタンにしない（選べないものを、理由つきの文字だけで並べる）
SIF 番号 >= 0
	出力 '= "[" + TOSTR(番号) + "] " + 名前
;ボタンにしない文字は、同じ行の前のボタンの後ろに出さない。Emuera は [番号] から行末（か次の [番号]）までを一つのボタンにするので、
;続けて出すとその文字もボタンの一部になり、押すと前のボタンが動く（2026-10-27 ユーザ指摘「就寝をクリックしたら、仮眠の動作をする」）。前に何か並んでいたら改行して行頭から出す
IF 番号 < 0 && コマンド桁 > 0
	PRINTL
	コマンド桁 = 0
ENDIF
幅 = STRLENS(出力)
マス = (幅 + 選択肢のマス幅 - 1) / 選択肢のマス幅
IF コマンド桁 > 0 && コマンド桁 + マス * 選択肢のマス幅 > 2 + 選択肢のマス幅 * 4
	PRINTL
	コマンド桁 = 0
ENDIF
IF コマンド桁 == 0
	PRINTS "　"
	コマンド桁 = 2
ENDIF
PRINTS 出力 + " " * (マス * 選択肢のマス幅 - 幅)
コマンド桁 += マス * 選択肢のマス幅


;並べかけの行があれば改行して閉じる。何も並べていなければ何も出さない
@コマンド行を閉じる

SIF コマンド桁 > 0
	PRINTL
コマンド桁 = 0


;================================ 数値パッド ================================
;マウスだけで数値を入力させるテンキー（2026-09-23 ユーザ指定「数値入力が必要なところにキーパッドを追加してマウスだけでもプレイ可能に」）。
;INPUTS で文字列を打たせる画面や、範囲の広い INPUT を数値のままキーボード前提で受けていた画面（体型・技能Lv・金額・時刻・倍率など）から呼ぶ。
;きざみ=1 なら整数、きざみ=10 なら小数第一位（下限・上限・初期値・戻り値はすべて ×10 した整数で渡す。表示だけ小数点で割って見せる）。
;数字ボタンを押すたび 値=値*10+数字 で桁を足していく（上限を超える桁は無視）。[確定] は下限〜上限に収まっているときだけ通す。[やめる] は 取消値 をそのまま返す
;#FUNCTION にすると INPUT／WAIT が使えない（Emuera の制約）ので、CALL＋RESULT の普通の関数にしてある。
;最初の数字ボタンは今の値を消してから打ち始める（2026-09-23 ユーザ指摘「今なんと入力しているかわからない」→ 今の値の下一桁に数字を継ぎ足す形だと
;すぐ上限を超えて弾かれ、押しても表示が変わらなかった。電卓の新規入力と同じで、最初の一打で今の表示を消す形にした）。
;CLEARLINE で毎回パッドの表示（9行）を消してから描き直すので、押すたびに画面が下へ伸び続けることもない
@数値パッド(見出し, 下限, 上限, 初期値, きざみ, 取消値, サイド = 0)
#DIMS 見出し
#DIM 下限
#DIM 上限
#DIM 初期値
#DIM きざみ
#DIM 取消値
#DIM サイド
#DIM 値
#DIM 選んだ
#DIM 未入力

値 = 初期値
未入力 = 1
DO
	PRINTL
	;サイド = 1 なら起床前の小画面と同じ枠・ヘッダの中に出す（→一日.ERB「起床前のサイド」）
	IF サイド
		CALL 起床前のサイド
		CALL 起床前の見出し
	ENDIF
	IF きざみ == 10
		PRINTFORML %見出し%（{下限 / 10}.{ABS(下限 % 10)} 〜 {上限 / 10}.{ABS(上限 % 10)}）
		PRINTFORML 入力中：{値 / 10}.{ABS(値 % 10)}
	ELSE
		PRINTFORML %見出し%（{下限} 〜 {上限}）
		PRINTFORML 入力中：{値}
	ENDIF
	PRINTL [ 7] [ 8] [ 9]
	PRINTL [ 4] [ 5] [ 6]
	PRINTL [ 1] [ 2] [ 3]
	PRINTL [ 0]
	PRINTFORML [{数値パッドのクリア}] クリア　[{数値パッドの1桁消す}] 1桁消す
	PRINTFORML [{数値パッドの確定}] これで決める　[{数値パッドのやめる}] やめる（変更しない）
	SIF サイド
		CALL 起床前のサイドの下
	INPUT
	選んだ = RESULT
	;パッドの表示9行＋INPUTが打った数字をエコーする1行の計10行を消す。
	;枠を出したときは消さずに下へ描き直す（ほかの枠つき画面でタブを押したときと同じ。枠の高さ分の行を CLEARLINE で消す形にはしない。2026-10-15）
	IF サイド
		CALL 起床前のサイド入力
		SIF サイドで受けた
			CONTINUE
	ELSE
		CLEARLINE 10
	ENDIF
	IF 選んだ == 数値パッドのクリア
		値 = 0
		未入力 = 0
	ELSEIF 選んだ == 数値パッドの1桁消す
		値 = 値 / 10
		未入力 = 0
	ELSEIF 選んだ == 数値パッドの確定
		IF 値 < 下限 || 値 > 上限
			PRINTFORML その値は入れられない（{下限}〜{上限}）
			WAIT
		ELSE
			RETURN 値
		ENDIF
	ELSEIF 選んだ == 数値パッドのやめる
		RETURN 取消値
	ELSEIF 選んだ >= 0 && 選んだ <= 9
		IF 未入力
			値 = 選んだ
			未入力 = 0
		ELSEIF 値 * 10 + 選んだ <= 上限
			値 = 値 * 10 + 選んだ
		ENDIF
	ENDIF
LOOP 1
