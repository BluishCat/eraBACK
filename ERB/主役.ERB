	RETURN 0
ENDIF

CALL 主役へのコマンドの行(1100, "会話", 会話の気力)
CALL 主役へのコマンドの行(1101, "スキンシップ", スキンシップの気力)
CALL 主役へのコマンドの行(1102, "口説く", 口説くの気力)
;プレゼントを持っていれば贈れる（→ショップ.ERB）
CALL 贈るの行
;まだ交換していない相手にだけ（→行動.ERB「連絡先」）
SIF !連絡先:主役:0
	CALL 主役へのコマンドの行(1109, "連絡先を交換する", 連絡先の気力)
;連れて行く／別れる（→同行.ERB）
CALL 連れて行くの行
;店の中の客・スタッフへの行動は二行目（一行に収まらず右端が切れた。2026-09-14）。同棲の行もここ（→行動.ERB「同棲」）
IF (CFLAG:主役:現在位置 > 0 && CFLAG:主役:現在位置 < 100) || スタッフ:主役:0 || 同棲を持ちかけられるか(主役) || 同棲を解消できるか(主役) || 処女オークションを持ちかけられるか(主役)
	CALL コマンド行を閉じる
ENDIF
;酒を勧めるのは店内の客にだけ（→画面イメージ「飲み物の流れ」）。スタッフには今日使える額が無く全部「払えない」になるので除く（2026-09-23）
IF CFLAG:主役:現在位置 > 0 && CFLAG:主役:現在位置 < 100 && !スタッフ:主役:0
	CALL 主役へのコマンドの行(1103, "酒を勧める", 酒を勧めるの気力)
	CALL 主役へのコマンドの行(1104, "一緒に飲む", 一緒に飲むの気力)
	;引き抜き。まだ雇っていない相手で、寮に空きがあるときだけ（→設計メモ「スタッフ」）
	;雇う前に日給と技能が分からないと決められないので、行に出す（2026-09-22 ユーザ指定「判断材料となる情報を画面に表示」）
	SIF !スタッフ:主役:0 && 空き部屋() > 0
		CALL 主役へのコマンドの行(1105, @"雇う（日給 %金額(給料(主役))%円　%技能の並び(主役, 0)%）", 雇うの気力)
	;裏を勧める。商品の勧誘なので日常に置く（相手へのセクハラ行為ではない。2026-09-13 にユーザ指定）
	SIF !スタッフ:主役:0
		CALL 裏を勧めるの行
ENDIF
;裏の仕事の同意はスタッフにだけ（雇用と同意は別 → 設計メモ「提供する側」）
SIF スタッフ:主役:0
	CALL 主役へのコマンドの行(1106, "裏の仕事を頼む", 説得の気力)
;同棲を持ちかける／解消する。相手がどこに居ても（→行動.ERB「同棲」）
CALL 同棲の行(主役)
;処女を競りにかける。処女で店に居て、地下ホールに入札できる客が居るとき（→客.ERB「処女オークション」）。二行目に収まらないので三行目
IF 処女オークションを持ちかけられるか(主役)
	CALL コマンド行を閉じる
	CALL 主役へのコマンドの行(1124, "処女オークションを持ちかける", 説得の気力)
ENDIF
;逢引に誘う。人目のない場所で、体か恋愛の段が届く相手にだけ（→行動.ERB「逢引」）
IF 逢引に誘えるか(主役)
	CALL コマンド行を閉じる
	CALL 逢引の行(主役)
ENDIF
CALL コマンド行を閉じる


;選べないものは出さない（2026-09-13 にユーザ指定）。酒に関わる行動（1103〜）は主人公が泥酔なら出さない
;引数を「気力」と名付けると BASE:MASTER:気力 の「気力」までその引数に解釈される（Base.csv の名前が隠れる）
@主役へのコマンドの行(番号, 名前, 要る気力)
#DIM 番号
#DIMS 名前
#DIM 要る気力

SIF 番号 >= 1103 && 酔いすぎ(MASTER)
	RETURN 0
SIF !払えるか(0, 要る気力)
	RETURN 0
CALL コマンドを並べる(番号, 名前)


;================================ 実行 ================================
@主役へのコマンド(番号)
#DIM 番号
#DIM 要る気力

CALL 主役を決める
IF 主役 <= 0
	PRINTL 相手が居ない
	WAIT
	RETURN 0
ENDIF
IF 気絶中:主役:0
	PRINTFORML %CALLNAME:主役%は気絶して眠っている
	WAIT
	RETURN 0
ENDIF
IF 出産ショー中:主役:0
	PRINTFORML %CALLNAME:主役%は舞台で陣痛に耐えている
	WAIT
	RETURN 0
ENDIF
;寝床で陣痛中の相手には付き添うだけ（→立ち会い.ERB）
IF 番号 == 1125
	IF 陣痛:主役:0 <= 0
		PRINTFORML %CALLNAME:主役%の陣痛は始まっていない
		WAIT
		RETURN 0
	ENDIF
	CALL 出産に立ち会う(主役)
	RETURN 0
ELSEIF 陣痛:主役:0 > 0
	PRINTFORML %CALLNAME:主役%は陣痛に耐えている
	WAIT
	RETURN 0
ENDIF

;酒を勧める・一緒に飲むは一覧から選ぶので、気力と時間は向こうで扱う
IF 番号 == 1103
	CALL 酒を勧める(主役)
	RETURN 0
ELSEIF 番号 == 1104
	CALL 一緒に飲む(主役)
	RETURN 0
ELSEIF 番号 == 1105
	CALL 雇う(主役)
	RETURN 0
ELSEIF 番号 == 1106
	CALL 裏の仕事を頼む(主役)
	RETURN 0
ELSEIF 番号 == 1107
	CALL 裏を勧める(主役)
	RETURN 0
ELSEIF 番号 == 1108
	CALL 贈る(主役)
	RETURN 0
ELSEIF 番号 == 1109
	CALL 連絡先を交換する(主役)
	RETURN 0
ELSEIF 番号 == 1120
	CALL 連れて行く(主役)
	RETURN 0
ELSEIF 番号 == 1121
	CALL 別れる
	RETURN 0
ELSEIF 番号 == 1122
	CALL 同棲を持ちかける(主役)
	RETURN 0
ELSEIF 番号 == 1123
	CALL 同棲を解消する(主役)
	RETURN 0
ELSEIF 番号 == 1124
	CALL 処女オークションを持ちかける(主役)
	RETURN 0
ELSEIF 番号 == 1126
	CALL 逢引に誘う(主役)
	RETURN 0
ENDIF

SELECTCASE 番号
	CASE 1100
		要る気力 = 会話の気力
	CASE 1101
		要る気力 = スキンシップの気力
	CASE 1102
		要る気力 = 口説くの気力
ENDSELECT
IF !払えるか(0, 要る気力)
	PRINTL 気力が足りない（体力でも補えない）
	WAIT
	RETURN 0
ENDIF
CALL 体力気力を減らす(MASTER, 0, 要る気力)

PRINTL 
SELECTCASE 番号
	CASE 1100
		CALL 会話(主役)
	CASE 1101
		CALL スキンシップ(主役)
	CASE 1102
		CALL 口説く(主役)
ENDSELECT
CALL 時間を進める(対面の分)
CALL 結果で止まる


;［セクハラ］の行。同意のない接触。重いものは 体の関係の段が上がるか、相手が泥酔していないと出ない
;（関係や状態で選べる手が増える。2026-09-13 にユーザ指定）
@セクハラの行
#DIM 手
#DIM 数
#DIM 設備の行

SIF 主役 <= 0 || 気絶中:主役:0 || 出産ショー中:主役:0 || 陣痛:主役:0 > 0
	RETURN 0

;8手が全部出ると一行に収まらず右端が切れるので、5つごとに折る（個室の行為の行と同じ。2026-09-15）
;行頭のラベル（「セクハラ」など）は付けない。見出しと重なる上、ボタンにくっついて番号のない文字に見えた（2026-09-30 ユーザ指摘「コマンドに変なのが出てる」）。
;一行目・折った行とも他のコマンド行と同じ全角1字下げ
;手は重さの順（変数定義.ERH）に並べてあり、軽いものが上・重いものが下。設備の手は体に触れる手と折り返しが混ざらないよう、最後に別の行にする（2026-10-03）
数 = 0
設備の行 = 0
FOR 手, 0, セクハラ数
	;段に届かず相手も泥酔していない、衣装が合わない、気力が足りない手は出ない（→行動.ERB）
	SIF !セクハラの手が出るか(手, 主役)
		CONTINUE
	IF 手 >= 設備の手の最初 && !設備の行
		設備の行 = 1
		IF 数 > 0
			PRINTL
			数 = 0
		ENDIF
	ENDIF
	SIF 数 == 0
		PRINTS "　"
	IF 手 >= 設備の手の最初
		CALL 選択肢を並べる(数, 1130 + 手 - 設備の手の最初, セクハラ名:手, 0, 4, "　")
	ELSE
		CALL 選択肢を並べる(数, 1110 + 手, セクハラ名:手, 0, 4, "　")
	ENDIF
	数 += 1
NEXT
IF 数 > 0
	PRINTL
	セクハラの塊 = 1
ENDIF


;自分の体を「触らせる」の行。セクハラの行の逆向き（→行動.ERB「触らせる」。2026-09-24 ユーザ指定）
@触らせるの行
#DIM 通番
#DIM 数

SIF 主役 <= 0 || 気絶中:主役:0 || 出産ショー中:主役:0 || 陣痛:主役:0 > 0
	RETURN 0

数 = 0
FOR 通番, 0, 触らせる数
	SIF !触らせるが出るか(通番, 主役)
		CONTINUE
	IF 数 == 0
		;前の塊（セクハラする）との間に空行を一つ。塊ごとに見た目を分ける（2026-10-03 ユーザ指定）
		SIF セクハラの塊
			PRINTL
		PRINTS "　"
	ENDIF
	CALL 選択肢を並べる(数, 1140 + 通番, 触らせる名:通番, 0, 4, "　")
	数 += 1
NEXT
IF 数 > 0
	PRINTL
	セクハラの塊 = 1
ENDIF


;自分の体を「見せる」の行（→行動.ERB「見せる」。2026-09-24 ユーザ指定）
@見せるの行
#DIM 通番
#DIM 数

SIF 主役 <= 0 || 気絶中:主役:0 || 出産ショー中:主役:0 || 陣痛:主役:0 > 0
	RETURN 0

数 = 0
FOR 通番, 0, 見せる数
	SIF !見せるが出るか(通番, 主役)
		CONTINUE
	;「する」と同じ塊（こちらがする）なので、空行は挟まず次の行から続ける（2026-10-03 ユーザ指摘「3段になってる」）
	SIF 数 == 0
		PRINTS "　"
	CALL 選択肢を並べる(数, 1150 + 通番, 見せる名:通番, 0, 4, "　")
	数 += 1
NEXT
IF 数 > 0
	PRINTL
	セクハラの塊 = 1
ENDIF


;裏を勧めるの行。個室の空きも見るので、他の主役コマンドとは別に書く（→設計メモ「指名」）
@裏を勧めるの行

SIF !客の席か(CFLAG:主役:現在位置)
	RETURN 0

;地下ホールの客は個室が空いていなくても勧められる（その場で受けられる商品があるため。→画面イメージ「地下ホールのその場の裏」）
SIF 空き個室() <= 0 && !(地下あり && CFLAG:主役:現在位置 == 地下ホールの位置)
	RETURN 0
SIF !払えるか(0, 勧めるの気力)
	RETURN 0
CALL コマンドを並べる(1107, "裏を勧める")


;大成功 1／成功 0／失敗 -1 を引く。会話の技能が高いほど失敗が減る（erablue_resort の会話と同じ刻み）
@対面判定
#FUNCTION
#DIM 目
#DIM 失敗線

目 = RAND(100)
失敗線 = 90 + ABL:MASTER:会話 * 2
SIF 失敗線 > 99
	失敗線 = 99

;香水を付けた日は一段上がる（失敗→成功→大成功。→ショップ.ERB）
IF 香水が効いているか()
	SIF 目 >= 失敗線
		RETURNF 0
	RETURNF 1
ENDIF
SIF 目 < 10
	RETURNF 1
SIF 目 >= 失敗線
	RETURNF -1
RETURNF 0


;結果に応じた上げ幅。大成功は倍、失敗は1割
@対面の上げ幅(結果)
#FUNCTION
#DIM 結果
#DIM 幅

幅 = 対面の幅 + ABL:MASTER:会話 * 2
IF 結果 > 0
	RETURNF 幅 * 2
ELSEIF 結果 < 0
	RETURNF 幅 / 10
ENDIF
RETURNF 幅


;会話。友情だけ。同じ来店で繰り返すと話題が尽きる
@会話(相手)
#DIM 相手
#DIM 結果
#DIM 今
#DIM 戻る数

;話題は時間で1つずつ戻る。尽きていない間は戻し済みの時刻を今に寄せる（古い時刻のまま溜め直して一気に戻らないように）
今 = 経過日数 * 1440 + 現在時刻
IF 会話累積:相手:0 <= 0
	会話累積:相手:0 = 0
	会話累積の時刻:相手:0 = 今
ELSE
	戻る数 = (今 - 会話累積の時刻:相手:0) / 話題の回復分
	IF 戻る数 > 0
		会話累積:相手:0 -= 戻る数
		SIF 会話累積:相手:0 < 0
			会話累積:相手:0 = 0
		会話累積の時刻:相手:0 += 戻る数 * 話題の回復分
	ENDIF
ENDIF

IF 会話累積:相手:0 >= 話題の数 + ABL:MASTER:会話
	PRINTFORML %CALLNAME:相手%に話しかけようとしたが、言葉が見つからない
	PRINTL あたりに気まずい空気が流れた…
	RETURN 0
ENDIF

結果 = 対面判定()
好感度_友情:相手:0 += 対面の上げ幅(結果) * 友情の伸び / 100
会話累積:相手:0 += 1

PRINTFORML %CALLNAME:相手%とたわいない話をした
IF 結果 > 0
	PRINTL 楽しい時間が流れた…
ELSEIF 結果 < 0
	PRINTL 会話が途切れると、気まずい空気が流れた…
ENDIF
;腹の目立つ妊娠（あなたか相手）のことを口にすることがある（→画面イメージ「妊娠の話」）
CALL 会話の妊娠の話(相手)
;Lv が上がったことは行動の文の後に出す。話した相手の会話も同じだけ伸びる（客の技能はここでだけ動く。2026-09-14）
CALL 経験を入れる(技能_会話, 経験の量(結果))
CALL 経験を積む(相手, 技能_会話, 経験の量(結果))


;会話のついでに、腹の目立つ妊娠のことを言う。相手の腹（本人が妊娠中であなたが知っている）かあなたの腹（あなたが妊娠中で相手が知っている）。両方ならどちらか
@会話の妊娠の話(相手)
#DIM 相手
#DIM 自分の腹
#DIM あなたの腹

SIF RAND(100) >= 妊娠の話の率
	RETURN 0
自分の腹 = 腹が見えているか(相手, MASTER)
あなたの腹 = 腹が見えているか(MASTER, 相手)
SIF !自分の腹 && !あなたの腹
	RETURN 0
SIF 自分の腹 && あなたの腹
	自分の腹 = RAND(2)
IF 自分の腹
	CALL 妊娠の話(相手, "自分の腹", 相手)
ELSE
	CALL 妊娠の話(相手, "相手の腹", MASTER)
ENDIF


;口説く。恋愛感情だけ
@口説く(相手)
#DIM 相手
#DIM 結果

結果 = 対面判定()
好感度_恋愛:相手:0 += 対面の上げ幅(結果)

PRINTFORML %CALLNAME:相手%に好意的な言葉をかけた
IF 結果 > 0
	PRINTFORML %CALLNAME:相手%は嬉しそうに笑った
ELSEIF 結果 < 0
	PRINTFORML %CALLNAME:相手%は困ったように目をそらした
ELSE
	PRINTFORML %CALLNAME:相手%は曖昧に微笑んだ
ENDIF
CALL 経験を入れる(技能_会話, 経験の量(結果))


;スキンシップ。成功すれば3軸とも少しずつ。失敗すると不快で友情と恋愛感情が下がる
@スキンシップ(相手)
#DIM 相手
#DIM 結果
#DIM 幅

結果 = 対面判定()
幅 = 対面の上げ幅(0)

IF 結果 < 0
	好感度_友情:相手:0 -= 幅 / 2
	好感度_恋愛:相手:0 -= 幅 / 2
	SIF 好感度_友情:相手:0 < 0
		好感度_友情:相手:0 = 0
	SIF 好感度_恋愛:相手:0 < 0
		好感度_恋愛:相手:0 = 0
	PRINTFORML %CALLNAME:相手%に軽く触れた
	PRINTFORML %CALLNAME:相手%は身を引いた。不快そうだ…
	CALL 経験を入れる(技能_会話, 経験の量(結果))
	RETURN 0
ENDIF

SIF 結果 > 0
	幅 = 幅 * 2
好感度_友情:相手:0 += 幅 / 2
好感度_恋愛:相手:0 += 幅 / 3
好感度_体:相手:0 += 幅 / 3

PRINTFORML %CALLNAME:相手%に軽く触れた
IF 結果 > 0
	PRINTFORML %CALLNAME:相手%は照れたように笑った
ELSE
	PRINTFORML %CALLNAME:相手%はくすぐったそうに小さく身じろぎした
ENDIF
CALL 経験を入れる(技能_会話, 経験の量(結果))


;================================ 追跡 ================================
;［付いていく］を押した。付いている最中ならやめ、そうでなければ主役に付く
@追跡を切り替える

IF 追跡キャラ > 0
	追跡キャラ = 0
ELSEIF 主役 > 0
	追跡キャラ = 主役
ENDIF


;画面を描く前に呼ぶ。追跡中の相手が別の部屋に居れば、そこへ移動する（移動の時間は掛かる）。
;相手が店から居なくなっていれば追跡をやめる。ここでは同じ画面（店）の中だけ追う
@追跡で移動

SIF 追跡キャラ <= 0
	RETURN 0

IF !実キャラ:追跡キャラ:0 || CFLAG:追跡キャラ:現在位置 == 0
	PRINTFORML %CALLNAME:追跡キャラ%が居なくなったので、付いていくのをやめた
	追跡キャラ = 0
	RETURN 0
ENDIF
SIF CFLAG:追跡キャラ:現在位置 == CFLAG:MASTER:現在位置
	RETURN 0
;玄関に現れた直後は次のティックで席へ動く。玄関までは追わず、座るのを待つ
SIF CFLAG:追跡キャラ:現在位置 == 8
	RETURN 0
;別の画面（店の外・寮・自宅）は追わない
IF CFLAG:追跡キャラ:現在位置 / 100 != CFLAG:MASTER:現在位置 / 100
	PRINTFORML %CALLNAME:追跡キャラ%は別の建物に居るので、付いていくのをやめた
	追跡キャラ = 0
	RETURN 0
ENDIF

PRINTFORML %CALLNAME:追跡キャラ%を追って%GET_PLACE_NAME(CFLAG:追跡キャラ:現在位置)%へ
CALL 移動(CFLAG:追跡キャラ:現在位置)
