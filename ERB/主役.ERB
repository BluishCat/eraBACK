;主役＝同室者の中で向き合っている相手（→画面イメージ「主役」、設計メモ「満足度と好感度は別のもの」）
;
;同室になれば自動で決まる（友情＋恋愛感情の高い順。体の関係は数えない）。名前を押せば切り替わり、その相手のまま留まる。
;主役への行動は 会話・スキンシップ・口説く。形は erablue_resort の日常コマンド（ERB/コマンド/日常/）に倣う。
;毎回 大成功／成功／失敗 を引き、会話の技能で成功率と上げ幅が変わる。
;会話は友情だけ、口説くは恋愛感情だけ、スキンシップは3軸とも少しずつ（失敗すると不快で下がる）。
;人との関わりは気力を食う。足りなければコマンドが選べない（番号を付けずに出す）
;
;好感度は 好感度_○○:相手:MASTER に持つ（相手が主人公に向ける気持ち）


;================================ 主役 ================================
;追跡中の相手が同室ならその人。次に、押して選んだ相手が同室に居ればそのまま。
;居なければ友情＋恋愛感情の高い順で選び直す。誰も居なければ0
@主役を決める
#DIM 番号
#DIM 最高
#DIM 値

IF 追跡キャラ > 0 && 実キャラ:追跡キャラ:0 && CFLAG:追跡キャラ:現在位置 == CFLAG:MASTER:現在位置
	主役 = 追跡キャラ
	RETURN 0
ENDIF
;地下ホールのその場の裏の最中の二人（席の奥に居る）は主役にしない（→客.ERB @その場の最中か）
SIF 主役 > 0 && 実キャラ:主役:0 && CFLAG:主役:現在位置 == CFLAG:MASTER:現在位置 && !その場の最中か(主役)
	RETURN 0
;連れている相手は常に同室。選び直すならまずその人（→同行.ERB）
IF 同行キャラ > 0 && 実キャラ:同行キャラ:0 && CFLAG:同行キャラ:現在位置 == CFLAG:MASTER:現在位置
	主役 = 同行キャラ
	RETURN 0
ENDIF

主役 = 0
;気絶して眠っている人は 100000 引くので、その下に置く
最高 = -200000
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置 || その場の最中か(番号)
		CONTINUE
	値 = 好感度_友情:番号:0 + 好感度_恋愛:番号:0
	;気絶して眠っている人は、他に誰も居なければ（→気絶.ERB）。舞台で分娩中の人も（→客.ERB「出産ショー」）
	SIF 気絶中:番号:0 || 舞台に立っているか(番号)
		値 -= 100000
	IF 値 > 最高
		最高 = 値
		主役 = 番号
	ENDIF
NEXT


;同室者の名前を押したとき
@主役を切り替える(番号)
#DIM 番号

SIF 番号 < 1 || 番号 >= キャラ枠 || !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置 || その場の最中か(番号)
	RETURN 0
主役 = 番号


;================================ 画面 ================================
;同室者の段の下。erablue_resort の通常画面の相手（TARGET）の段に倣う（INFO.ERB の SHOW_STATUS → 画面イメージ「主役」）。
;左右2列。左：名前 → 残り滞在 → 好感度3軸 → 満足度 → 体力・気力・性欲・欲情・理性（関係と体、行動の指標）。右：PALAM list（畳める）→ 酔い（・勃起・精力）（性まわり）
;（2026-09-28 ユーザ指定「体力気力の下の空きに右列の性欲などを振り分ける」で性欲・欲情・理性を左列に移した。右列だけが長く左列の体力・気力の下が空くのを均した）。
;下に 技能。口上の一言は画面の一番下、コマンド履歴の直前に移した（2026-09-24 ユーザ指定「表示位置を変更するように」→「コマンド履歴の上」）。
;1行ずつ、左右の中身を div で置いて HTML_PRINT＋PRINTL（eraTOWN の並列表示と同じ）。同室者が居なければ段ごと畳む
;
;rect の単位は 100＝全角1文字。組み幅 6000 を5区画に割る（サイドの枠は 6200 から）。
;列の幅と行の入れ物（主役左／主役右）は 変数定義.ERH

@主役の段
#DIM 左行数
#DIM 右行数
#DIM 行
#DIM 行数

CALL 主役を決める
SIF 主役 <= 0
	RETURN 0

;前回描いた行が残らないように空にする（畳んだのに前の行が出た）
VARSET 主役左
VARSET 主役右
CALL 主役の左列(主役)
左行数 = RESULT
CALL 主役のPALAM列(主役)
右行数 = RESULT
CALL 主役の性の段(主役, 右行数)
右行数 = RESULT

;名前行（主役左:0）だけは段の幅いっぱいに一行で出す。状態タグが増えると左列（全角23字）に収まらず右列の下に隠れた（2026-09-15 ユーザ指定「名前行をのばして」）。
;左列の残りは次の行から右列と並べる
HTML_PRINT @"<div rect='0,0,{左列幅 + PALAM列幅 * 2},100'><nobr>%主役左:0%</nobr></div>", 1
PRINTL 
行数 = 左行数 - 1
SIF 右行数 > 行数
	行数 = 右行数
FOR 行, 0, 行数
	HTML_PRINT @"<div rect='0,0,{左列幅},100'><nobr>%主役左:(行 + 1)%</nobr></div>%主役右:行%", 1
	PRINTL
NEXT


;主役の段の下、罫線を挟んで自分の段（erablue_resort の 相手の段 → 罫線 → SHOW_INFO_PALAM_PLAYER と同じ順）。
;左端の余白は対象の段との区別のため元は1区画（1200）空けていたが（2026-09-12）、2026-09-24 ユーザ指定「左の余白部分をもうちょっと減らせば」
;「あった余白の幅を狭めろってこと（無くすのではない）」で半分の600に狭め、浮いた600ぶんをPALAM値の幅に回した。
;名前 → 表（左に体力／気力／酔い、右に勃起／精力）。PALAM値（快感の部位→潤滑）は体力などの右にまとめる（2026-09-24 ユーザ指定「行を減らす」で
;別枠の「▼PALAM list」を廃止して統合した）。性欲・欲情・理性・苦痛・羞恥は出さない。主役が居なくても出す
@あなたの段
#DIM 行
#DIM 行数
#DIM 部位
#DIM 列
#DIM 男性器あり
#DIM 開始行
#DIM 列数
#DIM 開始位置
#DIM PALAM幅

;主役の段が無いときは、その上の罫線がそのまま区切りになる
SIF 主役 > 0
	CALL 本文罫線
VARSET 主役右

;文字列は式で組む（'=）。FORM の中に @"" と %関数("x")% を重ねると崩れる
主役右:0 '= あなたの行("▼あなた　" + 性別名(MASTER) + 処女のタグ(MASTER) + 酔いのタグ(MASTER) + 妊娠のタグ(MASTER) + 母乳のタグ(MASTER) + あなたの周期のタグ(MASTER))
;左に 体力・気力・酔い（バーは対象側と同じ 600）、右に 勃起・精力（男性器のある性別だけ）。
;枠の幅は中身に合わせる（左 1700、右 1600）。区画の等分だと間が空きすぎた
主役右:1 '= あなた枠("体力：" + ゲージHTML(BASE:MASTER:体力, MAXBASE:MASTER:体力, 600, 50, "50B050", "205020") + " " + TOSTR(BASE:MASTER:体力) + "/" + TOSTR(MAXBASE:MASTER:体力), 0, 1700)
主役右:2 '= あなた枠("気力：" + ゲージHTML(BASE:MASTER:気力, MAXBASE:MASTER:気力, 600, 50, "70C0C0", "205050") + " " + TOSTR(BASE:MASTER:気力) + "/" + TOSTR(MAXBASE:MASTER:気力), 0, 1700)
主役右:3 '= あなた枠("酔い：" + 酔いバー(MASTER), 0, 1700)

男性器あり = 性別ビット(MASTER) & 5
IF 男性器あり
	主役右:1 += あなた枠("勃起：" + ゲージHTML(PALAM:MASTER:勃起, 勃起の上限, 500, 50, "A060D0", "302040"), 1700, 1600)
	主役右:2 += あなた枠("精力：" + ゲージHTML(BASE:MASTER:精力, MAXBASE:MASTER:精力, 500, 50, "60A0A0", "204040") + " " + TOSTR(BASE:MASTER:精力) + "/" + TOSTR(MAXBASE:MASTER:精力), 1700, 1600)
ENDIF

;PALAM値（快感の部位→潤滑）。男性器が無ければ体力・気力・酔いの右（幅1550の2列）に詰める。
;男性器があれば体力・気力の右は勃起・精力で埋まっているので、その右（幅1500）を2列（750ずつ）に分けて2個ずつ乗せ、
;あふれた分は酔いの行から3列（幅1033）で詰める（2026-09-24 ユーザ指定「勃起の右側にパラメータを二列に並べられんか」）
列 = 0
IF 男性器あり
	FOR 部位, 0, 6
		SIF !(部位のある性別:部位 & 性別ビット(MASTER))
			CONTINUE
		CALL あなたPALAMを置く(列, @"快%部位記号:部位%", PALAM値幅(MASTER, 部位, あなたPALAMバー幅(列)))
		列 += 1
	NEXT
	;潤滑は膣のある性別だけ（ふたなり）。置かなければ最後に置いた列は一つ前
	IF 性別ビット(MASTER) & 6
		CALL あなたPALAMを置く(列, "潤滑", PALAM値幅(MASTER, 9, あなたPALAMバー幅(列)))
	ELSE
		列 -= 1
	ENDIF
	IF 列 < 4
		行数 = 1 + 列 / 2 + 1
	ELSE
		行数 = 3 + (列 - 4) / 3 + 1
	ENDIF
ELSE
	開始行 = 1
	列数 = 2
	PALAM幅 = 1850
	開始位置 = 1700
	FOR 部位, 0, 6
		SIF !(部位のある性別:部位 & 性別ビット(MASTER))
			CONTINUE
		主役右:(開始行 + 列 / 列数) += あなた枠(@"快%部位記号:部位% " + PALAM値幅(MASTER, 部位, 450), 開始位置 + PALAM幅 * (列 % 列数), PALAM幅)
		列 += 1
	NEXT
	;潤滑は膣のある性別だけ。置かなければ最後に置いた列は一つ前
	IF 性別ビット(MASTER) & 6
		主役右:(開始行 + 列 / 列数) += あなた枠("潤滑 " + PALAM値幅(MASTER, 9, 450), 開始位置 + PALAM幅 * (列 % 列数), PALAM幅)
	ELSE
		列 -= 1
	ENDIF
	行数 = 開始行 + 列 / 列数 + 1
ENDIF
SIF 行数 < 4
	行数 = 4
FOR 行, 0, 行数
	HTML_PRINT 主役右:行, 1
	PRINTL
NEXT
PRINTL


;あなたの段の1マス。あなたの段の左端からの位置と幅を単位（100＝全角1文字）で。字下げは全マス共通でここに
@あなた枠(中身, 開始, 幅)
#FUNCTIONS
#DIMS 中身
#DIM 開始
#DIM 幅

RETURNF @"<div rect='{あなた列X + 開始},0,{幅},100'><nobr>　%中身%</nobr></div>"


;男性器のある性別のPALAM値のバー幅。マスの幅から「　快B Lv3 」＋バー＋「 1000」の文字ぶんを引いた残り（潤滑は名前が1字長い）。
;2列（幅1050）は200、3列（幅1233）は350。数値が見切れない範囲で、相手の段（450）にできるだけ近づけた
@あなたPALAMバー幅(列)
#FUNCTION
#DIM 列

SIF 列 < 4
	RETURNF 200
RETURNF 350


;男性器のある性別のPALAM値を置く。0〜3個目は体力・気力の右（勃起・精力の隣、幅2100）を2列（1050ずつ）に分けて2個ずつ、
;4個目以降は酔いの行（3行目）から3列（幅1233）で詰める
@あなたPALAMを置く(列, 名前, 値)
#DIM 列
#DIMS 名前
#DIMS 値

IF 列 < 4
	主役右:(1 + 列 / 2) += あなた枠(@"%名前% %値%", 3300 + 1050 * (列 % 2), 1050)
ELSE
	主役右:(3 + (列 - 4) / 3) += あなた枠(@"%名前% %値%", 1700 + 1233 * ((列 - 4) % 3), 1233)
ENDIF


;あなたの段の左端から右端まで
@あなたの行(中身)
#FUNCTIONS
#DIMS 中身

RETURNF @"<div rect='{あなた列X},0,{あなた列幅 * 4},100'><nobr>%中身%</nobr></div>"


;左列の行を 主役左:0〜 に詰める。行数を返す
@主役の左列(番号)
#DIM 番号
#DIM 行
#DIM 残り
#DIM 段

行 = 0
主役左:行 = %主役の名前行(番号)%
行 += 1

IF 退店予定:番号:0 >= 0
	残り = 退店予定:番号:0 - (経過日数 * 1440 + 現在時刻)
	SIF 残り < 0
		残り = 0
	主役左:行 = 　残り滞在：あと{残り}分
	行 += 1
ENDIF
;注文があれば品目と状態（→画面イメージ「料理の流れ」）
IF 注文状態:番号:0 > 0
	主役左:行 = 　注文　　：%料理名:(注文品目:番号:0)%（%注文状態名(注文状態:番号:0)%）
	行 += 1
ENDIF

;好感度3軸。バー＋段の名前は最初から見える。数字は開示の3段目を買うまで出さない（→画面イメージ「主役の段」110行目。2026-09-23。それまでは行ごと隠していたが画面イメージの意図とズレていたので直した）
IF 値が見えるか(番号, 3)
	主役左:行 = 　好感度：友情 %段バー(好感度_友情:番号:0)% %友情の段名:好感度の段(好感度_友情:番号:0)%（{好感度_友情:番号:0}）
	行 += 1
	主役左:行 = 　　　　　恋愛 %段バー(好感度_恋愛:番号:0)% %恋愛の段名:好感度の段(好感度_恋愛:番号:0)%（{好感度_恋愛:番号:0}）
	行 += 1
	主役左:行 = 　　　　　体　 %段バー(好感度_体:番号:0)% %体の段名:好感度の段(好感度_体:番号:0)%（{好感度_体:番号:0}）
	行 += 1
ELSE
	主役左:行 = 　好感度：友情 %段バー(好感度_友情:番号:0)% %友情の段名:好感度の段(好感度_友情:番号:0)%
	行 += 1
	主役左:行 = 　　　　　恋愛 %段バー(好感度_恋愛:番号:0)% %恋愛の段名:好感度の段(好感度_恋愛:番号:0)%
	行 += 1
	主役左:行 = 　　　　　体　 %段バー(好感度_体:番号:0)% %体の段名:好感度の段(好感度_体:番号:0)%
	行 += 1
ENDIF

;満足度。-100〜100 を1本に。名前は5段。バー＋段の名前は最初から見える。数字は開示の2段目から（2026-09-23。好感度と同じ直し）
段 = LIMIT((満足度:番号:0 + 100) / 40, 0, 4)
IF 値が見えるか(番号, 2)
	主役左:行 = 　満足度：%ゲージHTML(満足度:番号:0 + 100, 200, 600, 50, "C0A040", "403820")% %満足度の段名:段%（{満足度:番号:0}）
ELSE
	主役左:行 = 　満足度：%ゲージHTML(満足度:番号:0 + 100, 200, 600, 50, "C0A040", "403820")% %満足度の段名:段%
ENDIF
行 += 1

;体力と気力。erablue_resort の相手の段の体力と同じく、バーの後ろに 現在/上限。満足度との間は1行あける
行 += 1
主役左:行 = 　体力　：%ゲージHTML(BASE:番号:体力, MAXBASE:番号:体力, 600, 50, "50B050", "205020")% {BASE:番号:体力}/{MAXBASE:番号:体力}
行 += 1
主役左:行 = 　気力　：%ゲージHTML(BASE:番号:気力, MAXBASE:番号:気力, 600, 50, "70C0C0", "205050")% {BASE:番号:気力}/{MAXBASE:番号:気力}
行 += 1

;性欲・欲情・理性は行動の指標になるので、体力・気力の下に続けて置く（あなたの段と同じ並び。2026-09-28 ユーザ指定「体力気力の下の空きに右列の性欲などを振り分ける」で
;右列の性まわり（→主役の性の段）から移した。酔い・勃起・精力は関係が薄いので右列に残す）
主役左:行 = 　性欲　：%ゲージHTML(BASE:番号:性欲, MAXBASE:番号:性欲, 600, 50, "D06080", "402028")% {BASE:番号:性欲}/{MAXBASE:番号:性欲}
行 += 1
主役左:行 = 　欲情　：%記号バー("❤", "♡", LIMIT(PALAM:番号:欲情 / 欲情の一段, 0, 5), "FF80A0")%
行 += 1
主役左:行 = 　理性　：%記号バー("★", "☆", LIMIT((PALAM:番号:理性 * 5 + 理性の上限 - 1) / 理性の上限, 0, 5), "FFD060")%
行 += 1

;技能。0でないものだけ「会話3」の形で、4つずつ改行（幅が変わってもボタンの位置に響かないように左列の中で折る）。1行あけて。
;開示の1段目から（→画面イメージ「怪しい店」）
IF 値が見えるか(番号, 1)
	行 += 1
	CALL 主役の技能行(番号, 行)
	行 = RESULT
ENDIF

RETURN 行


;0でない技能だけ「会話3」の形で、4つずつ 主役左:行〜 に詰める。次の行番号を返す
@主役の技能行(番号, 行)
#DIM 番号
#DIM 行
#DIM 技能
#DIM 数
#DIMS 出力

出力 '= "　技能　："
数 = 0
FOR 技能, 0, 技能数
	SIF ABL:番号:技能 <= 0
		CONTINUE
	;SIF は次の1行にしか掛からないので IF で
	IF 数 > 0 && 数 % 4 == 0
		主役左:行 '= 出力
		行 += 1
		出力 '= "　　　　　"
	ENDIF
	出力 += ABLNAME:技能 + TOSTR(ABL:番号:技能) + "　"
	数 += 1
NEXT
SIF 数 == 0
	出力 += "なし"
主役左:行 '= 出力
行 += 1

RETURN 行


;［能力表示］（詳細はこれから）と［付いていく］。右列の性まわりの下に固定で置く
