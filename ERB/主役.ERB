#DIM 番号
#DIM 行

行 += 1
主役右:行 = %右列の行("酔い：" + 酔いバー(番号))%
行 += 1
IF 性別ビット(番号) & 5
	;勃起は erablue_resort と同じ紫のバー
	主役右:行 = %右列の行("勃起：" + ゲージHTML(PALAM:番号:勃起, 勃起の上限, 600, 50, "A060D0", "302040"))%
	行 += 1
	主役右:行 = %右列の行("精力：" + ゲージHTML(BASE:番号:精力, MAXBASE:番号:精力, 600, 50, "60A0A0", "204040") + " " + TOSTR(BASE:番号:精力) + "/" + TOSTR(MAXBASE:番号:精力))%
	行 += 1
ENDIF
;1行あけてボタン。技能の数で動かないように、ここに固定
行 += 1
主役右:行 '= 主役のボタン行(番号)
行 += 1

RETURN 行


