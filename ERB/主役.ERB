RETURNF 右列の行(出力)


;口上の一言コメント（erablue_resort の 口上_INFO画面_一言コメント と同じ入口）。口上が無ければ行ごと出さない
;段で落とす（行為の口上と同じ形。2026-09-15）：口上_一言_{キャラ番号}(番号) → 口上_一言_{タイプ}_{性別}(番号) →（ふたなりは _女）→ 口上_一言_{タイプ}(番号)。
;どの段も空を返せば次へ。タイプ別の中身は ERB/口上/汎用/一言.ERB（状況で選ぶ：泥酔／妊娠／不満／恋／友達／酔い／満足／勤務中／初対面／ふだん）
;同じ状況でも数本から替わる（2026-10-19）：2本目は 口上_一言2_…、3本目は 口上_一言3_… と名前に数を付けて同じ段で落とす。
;その本が無ければ1本目（数なし）に落ちる。どれを言うかは @一言の本目を決める
@主役の一言(番号)
#DIM 番号
#DIM 本目

;気絶して眠っていれば喋らない（→気絶.ERB）。舞台で分娩中なら喘いでいる（→客.ERB「出産ショー」）
IF 気絶中:番号:0
	PRINTL 　（静かな寝息を立てている）
	RETURN 0
ENDIF
;陣痛中なら喘いでいる（舞台でも寝床でも → 客.ERB「出産ショー」、立ち会い.ERB）
IF 陣痛:番号:0 > 0
	PRINTL 　（陣痛に喘いでいる）
	RETURN 0
ELSEIF 出産ショー中:番号:0 || 処女オークション中:番号:0
	PRINTL 　（客席の視線に身を固くしている）
	RETURN 0
ENDIF
;口上を出さない設定（→変数定義.ERH 口上なし）なら、上の地の文だけで台詞は出さない
RESULTS '= ""
SIF CFLAG:番号:口上なし
	RETURN 0
本目 = 一言の本目を決める(番号)
CALL 一言を引く(番号, 本目)
;その本が無ければ1本目に落ちる
IF RESULTS == "" && 本目 > 0
	CALL 一言を引く(番号, 0)
ENDIF
SIF RESULTS != ""
	PRINTFORML 　%CALLNAME:番号%%RESULTS%


;何本目（0 始まり）を言うか。同じ相手のまま一定の分（一言の替わり分）が経たない間は変えない（コマンドを選ぶたびの描き直しで毎回替わらないように）。
;相手が替わる・主役が居なくなる（USERCOM.ERB が一言の相手を 0 に戻す）・時間が経つと、その人の前の本とは違う本に替える（続けて同じ台詞にならない）
@一言の本目を決める(番号)
#FUNCTION
#DIM 番号
#DIM 今
#DIM 前

今 = 経過日数 * 1440 + 現在時刻
前 = 一言の本目:番号:0 - 1
SIF 一言の相手 == 番号 && 前 >= 0 && 今 >= 一言の時刻:番号:0 && 今 - 一言の時刻:番号:0 < 一言の替わり分
	RETURNF 前
;まだ選んでいなければ好きな本から。選んであれば前の本以外から
IF 前 < 0
	前 = RAND(一言の本数)
ELSE
	前 = (前 + 1 + RAND(一言の本数 - 1)) % 一言の本数
ENDIF
一言の本目:番号:0 = 前 + 1
一言の時刻:番号:0 = 今
一言の相手 = 番号
RETURNF 前


;一言を RESULTS に引く。本目 0＝口上_一言、1＝口上_一言2、2＝口上_一言3 …。段の落とし方は @主役の一言 の頭
@一言を引く(番号, 本目)
#DIM 番号
#DIM 本目
#DIM 標準を許す
#DIMS 接頭
#DIMS タイプ
#DIMS 性別
#DIMS 方言

RESULTS '= ""
接頭 '= "口上_一言"
SIF 本目 > 0
	接頭 += TOSTR(本目 + 1)
TRYCCALLFORM %接頭%_{番号}(番号)
CATCH
ENDCATCH
;キャラ別の口上は1本だけのことが多い。その人の本が無ければ、その人の1本目を（タイプ別より先に）言う
IF RESULTS == "" && 本目 > 0
	TRYCCALLFORM 口上_一言_{番号}(番号)
	CATCH
	ENDCATCH
ENDIF
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
方言 '= 方言の接尾(番号)
;方言の人に、2本目以降だけ標準語の台詞が落ちてこないように（方言の2本目が無ければ1本目＝方言のほうを言う）
標準を許す = 本目 == 0 || 方言 == ""
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM %接頭%_%タイプ%_%性別%%方言%(番号)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 標準を許す
	TRYCCALLFORM %接頭%_%タイプ%_%性別%(番号)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && 方言 != ""
	TRYCCALLFORM %接頭%_%タイプ%_女%方言%(番号)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 標準を許す && 性別 == "ふたなり"
	TRYCCALLFORM %接頭%_%タイプ%_女(番号)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM %接頭%_%タイプ%%方言%(番号)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 標準を許す
	TRYCCALLFORM %接頭%_%タイプ%(番号)
	CATCH
	ENDCATCH
ENDIF


;▼名前　【客】性別　（状態タグ）…
;立場は スタッフ／客 の2つ（同じキャラがどちらにもなる → 設計メモ「スタッフ」）。状態タグは 酔い・妊娠・恋・危険日（後の2つは開示の段3から）。眠りは仕組みができてから
@主役の名前行(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力

出力 = ▼%CALLNAME:番号%　%立場のタグ(番号)%%性別名(番号)%%処女のタグ(番号)%
