	RETURNF "<font color='#ff7070'>(危険日)</font>"
SELECTCASE 生理周期:番号:0
	CASE 10, 11, 17, 18
		RETURNF "<font color='#ffb070'>(やや危険)</font>"
	CASE 0 TO 4
