	CFLAG:枠:来店時刻ばらつき = 60
ENDIF
引き = RAND(60)
IF 引き < 17
	CFLAG:枠:滞在時間中心 = 60
ELSEIF 引き < 37
	CFLAG:枠:滞在時間中心 = 90
ELSEIF 引き < 52
	CFLAG:枠:滞在時間中心 = 120
ELSE
	CFLAG:枠:滞在時間中心 = 150
ENDIF
引き = RAND(60)
IF 引き < 1
	CFLAG:枠:滞在時間ばらつき = 10
ELSEIF 引き < 16
	CFLAG:枠:滞在時間ばらつき = 15
ELSEIF 引き < 24
	CFLAG:枠:滞在時間ばらつき = 20
ELSEIF 引き < 58
	CFLAG:枠:滞在時間ばらつき = 30
