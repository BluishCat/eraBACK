MAXBASE:枠:気力 = 0
MAXBASE:枠:性欲 = 0
MAXBASE:枠:精力 = 0
MAXBASE:枠:酔い = 0
MAXBASE:枠:母乳 = 0
BASE:枠:体力 = 0
