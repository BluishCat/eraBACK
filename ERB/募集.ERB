;================================ 応募者の画面 ================================
;戻り：1 雇った／0 戻る／2 条件を変える。条件あり＝条件の画面から来た（[3] 条件を変える を出す）
@応募者を見る(条件あり)
#DIM 条件あり
#DIM 枠
#DIM 個数
#DIM 料
#DIM 引き直し
#DIM 払える

枠 = 募集の枠を取る()
IF 枠 == 0
	PRINTL
	PRINTL もう応募を受けられない（空き枠が無い）
	WAIT
	RETURN 0
ENDIF
個数 = 募集の条件数()
料 = 募集の雇用料(個数)
引き直し = 0
CALL 応募者を組む(枠)

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTS "■応募者　　"
	IF 条件あり
		PRINTFORM 条件 {個数}つ
		PRINTS "　　"
	ELSE
		PRINTS "条件なし　　"
	ENDIF
	PRINTFORML 引き直し {引き直し}回　　雇用料 %金額(料)%円　　所持金 %金額(MONEY:MASTER)%円
	CALL 本文罫線
	CALL 応募者を出す(枠)
	PRINTL
	払える = MONEY:MASTER >= 料
	IF 払える
		PRINTFORML [1] 雇う（雇用料 %金額(料)%円）
	ELSE
		PRINTL 　　雇う（所持金が足りない）
	ENDIF
	PRINTL [2] 引き直す
	SIF 条件あり
		PRINTL [3] 条件を変える
	PRINTL [0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE

	SELECTCASE RESULT
		CASE 0
			CALL 募集の枠を空にする(枠)
			RETURN 0
		CASE 1
			IF 払える
				CALL 応募者を雇う(枠, 料)
				IF RESULT == 1
					RETURN 1
				ENDIF
				;部屋が埋まっていた。応募者は残っているので、そのまま戻す
				CALL 募集の枠を空にする(枠)
				RETURN 0
			ENDIF
		CASE 2
			引き直し += 1
			CALL 応募者を組む(枠)
		CASE 3
			IF 条件あり
				CALL 募集の枠を空にする(枠)
				RETURN 2
			ENDIF
	ENDSELECT
LOOP 1


