;募集する（起床前 [110]。→画面イメージ「募集する」）
;2026-10-02 ユーザ指定「起床前メニューにおいてランダムキャラを雇えるように。条件なしで／ある程度条件を指定したうえでリロードしながら選択。
;雇用時の金額は条件をつけるほど上がる。日の給料はこれまで通りの条件」。ランダムキャラは新規に作る人、条件は 性別・性格＋方言・技能・素質、
;金額は条件の個数で数える、候補は 1 人ずつ（いずれもユーザ指定）。
;
;応募者は乱数で組んだ新規の人。雇うまでは空き枠（番号の大きい方から。同梱キャラを後から足してもぶつからない）に仮に組むだけで、実キャラにしない。
;雇うと 実キャラ・スタッフ・寮の部屋 を入れる（雇い方は 行動.ERB @雇う と同じ。友情は 雇うのに要る段 まで上げる）。
;離れるとき（雇わなかった・引き直し）は枠を空に戻すので、セーブには残らない。
;組み方の数は同梱 60 人を数えて決めた（女31・男25・ふたなり4、技能は 1〜2 種で Lv1〜3、素質は 4〜9 個、初期容姿 240〜420）。全部仮


;================================ トップ ================================
@募集メニュー

DO
	IF 空き部屋() == 0
		PRINTL
		PRINTL 寮に空き部屋が無い
		WAIT
		RETURN 0
	ENDIF
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML ■募集する　　所持金 %金額(MONEY:MASTER)%円　　寮の空き {寮の空き数()}部屋
	CALL 本文罫線
	PRINTL 　応募してきた人の中から雇う。気に入らなければ何度でも引き直せる。
	PRINTL 　雇用料は雇うときに一度だけ払う。条件をつけるほど高くなる。
	PRINTL 　日給はこれまでどおり（5000＋技能の合計×500）。雇ったあとの技能で決まる。
	PRINTL
	PRINTFORML [1] 条件なしで探す　　　　　雇用料 %金額(募集の雇用料(0))%円
	PRINTL [2] 条件を決めて探す
	PRINTL [0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE

	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			CALL 募集の条件を空にする
			CALL 応募者を見る(0)
		CASE 2
			CALL 募集の条件を決める
	ENDSELECT
LOOP 1


;寮の空き部屋の数
@寮の空き数
#FUNCTION
#DIM 部屋
#DIM 番号
#DIM 埋まり
#DIM 数

数 = 0
FOR 部屋, 410, 410 + 寮の部屋数
	埋まり = 0
	FOR 番号, 1, キャラ枠
		IF 実キャラ:番号:0 && スタッフ:番号:0 && 寮の部屋:番号:0 == 部屋
			埋まり = 1
			BREAK
		ENDIF
	NEXT
	SIF !埋まり
		数 += 1
NEXT
RETURNF 数


;雇用料。基本＋条件の個数×一つ
@募集の雇用料(個数)
#FUNCTION
#DIM 個数

RETURNF 募集の雇用料の基本 + 個数 * 募集の雇用料の一つ


;================================ 条件の画面 ================================
@募集の条件を空にする
#DIM 甲

募集_性別 = 0
募集_口上 = 0
募集_方言 = 0
FOR 甲, 0, 16
	募集_技能:甲 = 0
NEXT
FOR 甲, 0, 募集の素質の範囲
	募集_素質:甲 = 0
NEXT
FOR 甲, 0, 4
	募集_体格有:甲 = 0
	募集_体格段:甲 = 0
NEXT
募集_経験 = 0


;条件の数。性別・性格・方言・経験は 1、技能・素質・体格は付けたものごとに 1
@募集の条件数
#FUNCTION
#DIM 数
#DIM 甲

数 = 0
SIF 募集_性別 != 0
	数 += 1
SIF 募集_口上 != 0
	数 += 1
SIF 募集_方言 != 0
	数 += 1
SIF 募集_経験 != 0
	数 += 1
FOR 甲, 0, 技能数
	SIF 募集_技能:甲 > 0
		数 += 1
NEXT
FOR 甲, 0, 募集の素質の範囲
	SIF 募集_素質:甲 != 0
		数 += 1
NEXT
FOR 甲, 0, 4
	SIF 募集_体格有:甲 != 0
		数 += 1
NEXT
RETURNF 数


;[8] で候補の画面へ。雇えば トップへ戻る（条件は空に戻す）。[0] もトップへ（条件は残る）
@募集の条件を決める
#DIM 個数
#DIM 結果

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	個数 = 募集の条件数()
	PRINTFORML ■条件を決める　　条件 {個数}つ　　雇用料 %金額(募集の雇用料(個数))%円（%金額(募集の雇用料の基本)%円＋1つにつき %金額(募集の雇用料の一つ)%円）
	CALL 本文罫線
	PRINTFORML [1] 性別　　　　%募集の性別の文()%
	PRINTFORML [2] 性格　　　　%募集の口上の文()%
	PRINTFORML [3] 方言　　　　%募集の方言の文()%
	PRINTFORML [4] 技能　　　　%募集の技能の文()%
	PRINTFORML [5] 素質　　　　%募集の素質の文()%
	PRINTFORML [6] 経験　　　　%募集の経験の文()%
	PRINTL [9] 条件をすべて外す
	PRINTL [8] この条件で探す
	PRINTL [0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE

	SELECTCASE RESULT
		CASE 0
			RETURN 0
		CASE 1
			CALL 募集の性別を選ぶ
		CASE 2
			CALL 募集の性格を選ぶ
		CASE 3
			CALL 募集の方言を選ぶ
		CASE 4
			CALL 募集の技能を選ぶ
		CASE 5
			CALL 募集の素質を選ぶ
		CASE 6
			CALL 募集の経験を選ぶ
		CASE 8
			CALL 応募者を見る(1)
			結果 = RESULT
			IF 結果 == 1
				CALL 募集の条件を空にする
				RETURN 1
			ELSEIF 結果 == 0
				RETURN 0
			ENDIF
		CASE 9
			CALL 募集の条件を空にする
	ENDSELECT
LOOP 1


;---- 条件の文 ----
@募集の性別の文
#FUNCTIONS

SELECTCASE 募集_性別
	CASE 1
		RETURNF "男"
	CASE 2
		RETURNF "女"
	CASE 4
		RETURNF "ふたなり"
	CASE 8
		RETURNF "性別なし"
ENDSELECT
RETURNF "指定なし"


@募集の口上の文
#FUNCTIONS

SIF 募集_口上 <= 0
	RETURNF "指定なし"
RETURNF 施術の素質の名(募集_口上)


@募集の方言の文
#FUNCTIONS

SIF 募集_方言 == 0
	RETURNF "指定なし"
SIF 募集_方言 < 0
	RETURNF "標準語"
RETURNF 施術の素質の名(募集_方言)


@募集の技能の文
#FUNCTIONS
#DIMS 出力
#DIM 技能

出力 '= ""
FOR 技能, 0, 技能数
	SIF 募集_技能:技能 <= 0
		CONTINUE
	SIF 出力 != ""
		出力 += "　"
	出力 += ABLNAME:技能 + TOSTR(募集_技能:技能) + "以上"
NEXT
SIF 出力 == ""
	RETURNF "指定なし"
RETURNF 出力


@募集の素質の文
#FUNCTIONS
#DIMS 出力
#DIM 素質
#DIM 種

出力 '= ""
FOR 素質, 0, 募集の素質の範囲
	SIF !募集_素質:素質
		CONTINUE
	SIF 出力 != ""
		出力 += "　"
	出力 += TALENTNAME:素質
NEXT
FOR 種, 0, 4
	SIF !募集_体格有:種
		CONTINUE
	SIF 出力 != ""
		出力 += "　"
	出力 += 募集の体格の名(種, 募集_体格段:種)
NEXT
SIF 出力 == ""
	RETURNF "指定なし"
RETURNF 出力


;経験の条件の名前。段＝初期経験の段（0〜3）
@募集の経験の段名(段)
#FUNCTIONS
#DIM 段

SELECTCASE 段
	CASE 0
		RETURNF "未経験（処女・童貞）"
	CASE 1
		RETURNF "少し"
	CASE 2
		RETURNF "ふつう"
	CASE 3
		RETURNF "多い"
ENDSELECT
RETURNF "指定なし"


@募集の経験の文
#FUNCTIONS

SIF 募集_経験 <= 0
	RETURNF "指定なし"
RETURNF 募集の経験の段名(募集_経験 - 1)


;体格の条件の名前。「バスト：巨乳」
@募集の体格の名(種, 段)
#FUNCTIONS
#DIM 種
#DIM 段

SELECTCASE 種
	CASE 0
		RETURNF "体型：" + 体型の段名(段)
	CASE 1
		RETURNF "バスト：" + バストの段名(段)
	CASE 2
		RETURNF "下半身：" + 下半身の段名(段)
ENDSELECT
RETURNF "男性器：" + 男性器の段名(段)


;---- 条件の整合 ----
;体格の条件が通る性別。バストは女・ふたなり（6）、男性器サイズは男・ふたなり（5）
@募集の体格の許す性別(種)
#FUNCTION
#DIM 種

SIF 種 == 1
	RETURNF 6
SIF 種 == 3
	RETURNF 5
RETURNF 15


;いまの条件ぜんぶが通る性別（性別ビット）。性別を指定していればその一つ、無ければ 男・女・ふたなり（性別なしは指定したときだけ）。0 なら成り立たない
@募集の許す性別
#FUNCTION
#DIM 許
#DIM 甲

許 = 7
SIF 募集_性別 != 0
	許 = 募集_性別
FOR 甲, 0, 募集の素質の範囲
	SIF 募集_素質:甲
		許 = 許 & 素質の許す性別(甲)
NEXT
FOR 甲, 0, 4
	SIF 募集_体格有:甲
		許 = 許 & 募集の体格の許す性別(甲)
NEXT
;未経験＝処女・童貞は 膣か男性器のある人だけ（性別なしには付かない）
SIF 募集_経験 == 1
	許 = 許 & 7
RETURNF 許


;---- 性別 ----
@募集の性別を選ぶ
#DIM 前
#DIM 甲

前 = 募集_性別
PRINTL
PRINTFORML 性別（いま：%募集の性別の文()%）
PRINTL [0] 指定なし　　[1] 男　　[2] 女　　[3] ふたなり　　[4] 性別なし　　[5] やめる
INPUT
SELECTCASE RESULT
	CASE 0
		募集_性別 = 0
	CASE 1
		募集_性別 = 1
	CASE 2
		募集_性別 = 2
	CASE 3
		募集_性別 = 4
	CASE 4
		募集_性別 = 8
	CASEELSE
		RETURN 0
ENDSELECT

;性別に合わなくなった素質・体格の条件は外す
SIF 募集_性別 == 0
	RETURN 0
FOR 甲, 0, 募集の素質の範囲
	IF 募集_素質:甲 && !(素質の許す性別(甲) & 募集_性別)
		募集_素質:甲 = 0
		PRINTFORML （%TALENTNAME:甲%は%募集の性別の文()%に付けられないので外した）
	ENDIF
NEXT
FOR 甲, 0, 4
	IF 募集_体格有:甲 && !(募集の体格の許す性別(甲) & 募集_性別)
		募集_体格有:甲 = 0
		PRINTFORML （%募集の体格の名(甲, 募集_体格段:甲)%は%募集の性別の文()%に付けられないので外した）
	ENDIF
NEXT
IF 募集_経験 == 1 && !(7 & 募集_性別)
	募集_経験 = 0
	PRINTFORML （未経験は%募集の性別の文()%に付けられないので外した）
ENDIF


;---- 性格・方言 ----
@募集の性格を選ぶ
#DIM 素質
#DIM 数

PRINTL
PRINTFORML 性格（口上タイプ。いま：%募集の口上の文()%）
PRINTL [0] 指定なし
数 = 0
FOR 素質, 0, 100
	SIF !口上タイプの素質か(素質)
		CONTINUE
	CALL 選択肢を並べる(数, 素質, 施術の素質の名(素質), 募集_口上 == 素質, 4, "")
	数 += 1
NEXT
PRINTL
INPUT
IF RESULT == 0
	募集_口上 = 0
ELSEIF 口上タイプの素質か(RESULT)
	募集_口上 = RESULT
ENDIF


@募集の方言を選ぶ
#DIM 素質
#DIM 数

PRINTL
PRINTFORML 方言（いま：%募集の方言の文()%。「標準語」は方言のない人だけ）
PRINTL [0] 指定なし
CALL 選択肢を並べる(0, 1, "標準語", 募集_方言 == -1, 4, "")
数 = 1
FOR 素質, 方言素質の始め, 方言素質の終わり + 1
	SIF !方言の素質か(素質)
		CONTINUE
	CALL 選択肢を並べる(数, 素質, 施術の素質の名(素質), 募集_方言 == 素質, 4, "")
	数 += 1
NEXT
PRINTL
INPUT
IF RESULT == 0
	募集_方言 = 0
ELSEIF RESULT == 1
	募集_方言 = -1
ELSEIF 方言の素質か(RESULT)
	募集_方言 = RESULT
ENDIF


;---- 技能 ----
@募集の技能を選ぶ
#DIM 技能
#DIMS 名

DO
	PRINTL
	PRINTFORML 技能（番号を選ぶと「いくつ以上か」を聞く。複数指定してよい）
	FOR 技能, 0, 技能数
		名 '= ABLNAME:技能
		SIF 募集_技能:技能 > 0
			名 += "（" + TOSTR(募集_技能:技能) + "以上）"
		CALL 選択肢を並べる(技能, 技能 + 1, 名, 募集_技能:技能 > 0, 5, "")
	NEXT
	PRINTL
	PRINTL [0] 戻る
	INPUT
	SIF RESULT < 1 || RESULT > 技能数
		RETURN 0
	技能 = RESULT - 1
	PRINTFORML %ABLNAME:技能%はいくつ以上にしますか（1〜{募集の技能の上限}。0 で外す）
	INPUT
	募集_技能:技能 = LIMIT(RESULT, 0, 募集の技能の上限)
LOOP 1


;---- 素質 ----
;主人公作成の素質と同じ並び（伸び・才・苦手・敏感・鈍感・体質・裏の好み・性癖）に、好物と体格を足したもの。番号は Talent.csv の素質番号そのまま
@募集の素質を選ぶ
#DIM 素質
#DIM 数

DO
	PRINTL
	PRINTL 素質　（番号で付け外し。排他のものは付けると相手が外れる。体格は段を選ぶ）
	PRINTFORM 　%"食べ物", 10, LEFT%
	CALL 募集の帯を出す(20, 30, 0)
	PRINTFORM 　%"飲み物", 10, LEFT%
	CALL 募集の帯を出す(30, 好物素質の終わり + 1, 0)
	PRINTFORM 　%"伸び", 10, LEFT%
	CALL 募集の帯を出す(伸び素質の始め, 伸び素質の始め + 2, 0)
	PRINTFORM 　%"才", 10, LEFT%
	CALL 募集の帯を出す(70, 80, 0)
	PRINTFORM 　%"苦手", 10, LEFT%
	CALL 募集の帯を出す(80, 90, 0)
	PRINTFORM 　%"敏感", 10, LEFT%
	CALL 募集の帯を出す(敏感の始め, 敏感の始め + 6, 1)
	PRINTFORM 　%"鈍感", 10, LEFT%
	CALL 募集の帯を出す(鈍感の始め, 鈍感の始め + 6, 1)
	PRINTFORM 　%"体質", 10, LEFT%
	CALL 募集の帯を出す(120, 体質素質の終わり + 1, 1)
	PRINTFORM 　%"裏の好み", 10, LEFT%
	CALL 募集の帯を出す(40, 裏の好み素質の終わり + 1, 0)
	PRINTFORM 　%"性癖", 10, LEFT%
	CALL 募集の帯を出す(性癖素質の始め, 性癖素質の終わり + 1, 0)
	PRINTFORM 　%"体格", 10, LEFT%
	FOR 数, 0, 4
		CALL 選択肢を並べる(数, 体格素質の始め + 数, TALENTNAME:(体格素質の始め + 数), 募集_体格有:数, 4, "　　　　　　")
	NEXT
	PRINTL
	PRINTL [0] 戻る
	INPUT
	素質 = RESULT
	SIF 素質 <= 0 || 素質 >= 募集の素質の範囲
		RETURN 0
	IF 素質 >= 体格素質の始め && 素質 < 体格素質の始め + 4
		CALL 募集の体格を選ぶ(素質 - 体格素質の始め)
	ELSEIF 募集で付けられる素質か(素質)
		CALL 募集の素質を付け外す(素質)
	ENDIF
LOOP 1


;始め〜終わり−1 の素質を列に揃えて並べる（主人公作成の @素質の帯を出す と同じ形）。性別で＝敏感／鈍感・濡れ系は、性別を指定していれば その性別に無いものを飛ばす（→主人公作成.ERB @素質の許す性別）。付けた条件は色を変える
@募集の帯を出す(始め, 終わり, 性別で)
#DIM 始め
#DIM 終わり
#DIM 性別で
#DIM 素質
#DIM 数

数 = 0
FOR 素質, 始め, 終わり
	SIF TALENTNAME:素質 == ""
		CONTINUE
	SIF 性別で && 募集_性別 != 0 && !(素質の許す性別(素質) & 募集_性別)
		CONTINUE
	CALL 選択肢を並べる(数, 素質, TALENTNAME:素質, 募集_素質:素質, 4, "　　　　　　")
	数 += 1
NEXT
PRINTL


;条件に付けられる素質か（好物・伸び・体質・裏の好み・客の癖・性癖。性別・口上・方言・体格・妊娠の上書きは別）
@募集で付けられる素質か(素質)
#FUNCTION
#DIM 素質

SIF 素質 < 0 || 素質 >= 募集の素質の範囲 || TALENTNAME:素質 == ""
	RETURNF 0
SIF 素質 >= 好物素質の始め && 素質 <= 好物素質の終わり
	RETURNF 1
SIF 素質 >= 40 && 素質 <= 裏の好み素質の終わり
	RETURNF 1
SIF 素質 >= 伸び素質の始め && 素質 <= 伸び素質の終わり
	RETURNF 1
SIF 素質 >= 体質素質の始め && 素質 <= 体質素質の終わり
	RETURNF 1
SIF 性癖の素質か(素質)
	RETURNF 1
RETURNF 0


@募集の素質を付け外す(素質)
#DIM 素質
#DIM 相方
#DIM 甲
#DIM 下戸番

IF 募集_素質:素質
	募集_素質:素質 = 0
	RETURN 0
ENDIF
募集_素質:素質 = 1
IF 募集の許す性別() == 0
	募集_素質:素質 = 0
	PRINTFORML %TALENTNAME:素質%は、いまの性別・条件と両立しない
	WAIT
	RETURN 0
ENDIF
相方 = 素質の相方(素質)
SIF 相方 >= 0 && 相方 < 募集の素質の範囲
	募集_素質:相方 = 0
;下戸と飲み物の好物は排他（酒を頼まない人に、酒の好物は付かない）
下戸番 = GETNUM(TALENT, "下戸")
IF 素質 == 下戸番
	FOR 甲, 30, 34
		募集_素質:甲 = 0
	NEXT
ELSEIF 素質 >= 30 && 素質 <= 33 && 下戸番 >= 0
	募集_素質:下戸番 = 0
ENDIF


;体格の段を選ぶ。種＝0 体型／1 バスト／2 下半身／3 男性器サイズ
@募集の体格を選ぶ(種)
#DIM 種
#DIMS 名
#DIM 段
#DIM 前有
#DIM 前段

PRINTL
名 '= "指定なし"
SIF 募集_体格有:種
	名 '= 募集の体格の名(種, 募集_体格段:種)
PRINTFORML %TALENTNAME:(体格素質の始め + 種)%（いま：%名%）
PRINTL [0] 指定なし
