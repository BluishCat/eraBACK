;応募者を一人組む。条件（募集_…）は必ず満たす。残りは乱数（数は仮。画面イメージ「募集する」の応募者の組み方）
@応募者を組む(枠)
#DIM 枠
#DIM 型
#DIM 甲
#DIM 素質
#DIM 数
#DIM 目標
#DIM 技能
#DIM 候補, 100
#DIM 候補数
#DIM 選段, 4
#DIM 回
#DIM 相方
#DIM 引き
#DIM 下戸番
#DIMS 名

CALL 募集の枠を空にする(枠)

;---- 性別 ----
型 = 募集の性別を引く()
SELECTCASE 型
	CASE 1
		TALENT:枠:男 = 1
	CASE 4
		TALENT:枠:ふたなり = 1
	CASE 8
		TALENT:枠:性別なし = 1
	CASEELSE
		TALENT:枠:女 = 1
ENDSELECT

;---- 名前（呼び名を兼ねる）----
名 '= 応募者の名前を引く(型)
NAME:枠 = %名%
CALLNAME:枠 = %名%

;---- 性格（口上タイプ）----
IF 募集_口上 > 0
	TALENT:枠:募集_口上 = 1
ELSE
	候補数 = 0
	FOR 素質, 0, 100
		IF 口上タイプの素質か(素質)
			候補:候補数 = 素質
			候補数 += 1
		ENDIF
	NEXT
	IF 候補数 > 0
		素質 = 候補:RAND(候補数)
		TALENT:枠:素質 = 1
	ENDIF
ENDIF

;---- 方言（標準語 60％、他は同じ確率）----
IF 募集_方言 > 0
	TALENT:枠:募集_方言 = 1
ELSEIF 募集_方言 == 0 && RAND(100) >= 60
	候補数 = 0
	FOR 素質, 方言素質の始め, 方言素質の終わり + 1
		IF 方言の素質か(素質)
			候補:候補数 = 素質
			候補数 += 1
		ENDIF
	NEXT
	IF 候補数 > 0
		素質 = 候補:RAND(候補数)
		TALENT:枠:素質 = 1
	ENDIF
ENDIF

;---- 条件の素質 ----
FOR 素質, 0, 募集の素質の範囲
	SIF 募集_素質:素質
		TALENT:枠:素質 = 1
NEXT

;---- 好物（条件が無い側だけ。食べ物は 1〜2 つ、飲み物は 1 つか下戸）----
数 = 0
FOR 素質, 20, 25
	SIF TALENT:枠:素質
		数 += 1
NEXT
IF 数 == 0
	引き = RAND(100)
	目標 = 0
	IF 引き < 70
		目標 = 1
	ELSEIF 引き < 90
		目標 = 2
	ENDIF
	FOR 回, 0, 目標
		素質 = 20 + RAND(5)
		TALENT:枠:素質 = 1
	NEXT
ENDIF
下戸番 = GETNUM(TALENT, "下戸")
数 = 0
FOR 素質, 30, 34
	SIF TALENT:枠:素質
		数 += 1
NEXT
SIF 下戸番 >= 0 && TALENT:枠:下戸番
	数 += 1
IF 数 == 0
	IF 下戸番 >= 0 && RAND(100) < 15
		TALENT:枠:下戸番 = 1
	ELSE
		素質 = 30 + RAND(4)
		TALENT:枠:素質 = 1
	ENDIF
ENDIF

;---- 素質を 0〜3 個足す（性別に合うものから。条件の素質の相方は付けない）----
候補数 = 0
FOR 素質, 40, 135
	IF 募集で付けられる素質か(素質) && (素質の許す性別(素質) & 型) != 0 && 候補数 < 100
		候補:候補数 = 素質
		候補数 += 1
	ENDIF
NEXT
目標 = RAND(4)
FOR 回, 0, 目標
	SIF 候補数 <= 0
		BREAK
	素質 = 候補:RAND(候補数)
	SIF TALENT:枠:素質
		CONTINUE
	相方 = 素質の相方(素質)
	SIF 相方 >= 0 && TALENT:枠:相方
		CONTINUE
	TALENT:枠:素質 = 1
NEXT

;---- 性癖：条件の分は上で付いている。条件が無い人は 0〜2 個（0＝30％・1＝57％・2＝13％。同梱 60 人の分布）。条件の性癖があれば足さない ----
数 = 0
FOR 素質, 性癖素質の始め, 性癖素質の終わり + 1
	SIF 性癖の素質か(素質) && TALENT:枠:素質
		数 += 1
NEXT
IF 数 == 0
	引き = RAND(100)
	目標 = 0
	IF 引き >= 87
		目標 = 2
	ELSEIF 引き >= 30
		目標 = 1
	ENDIF
	FOR 回, 0, 目標
		素質 = 性癖素質の始め + RAND(性癖の数)
		SIF 性癖の素質か(素質)
			TALENT:枠:素質 = 1
	NEXT
ENDIF

;---- 技能：1〜2 種に Lv1〜3。条件の技能は指定 Lv〜上限 で必ず入れる ----
FOR 技能, 0, 技能数
	SIF 募集_技能:技能 > 0
		ABL:枠:技能 = 募集_技能:技能 + RAND(募集の技能の上限 - 募集_技能:技能 + 1)
NEXT
目標 = 1 + RAND(2)
数 = 0
FOR 技能, 0, 技能数
	SIF ABL:枠:技能 > 0
		数 += 1
NEXT
WHILE 数 < 目標
	技能 = RAND(技能数)
	IF ABL:枠:技能 == 0
		ABL:枠:技能 = 1 + RAND(3)
		数 += 1
	ENDIF
WEND

;---- 体格の段（0＝60％・±1＝15％ずつ・±2＝4％ずつ・±3＝1％ずつ）。バストは女・ふたなり、男性器サイズは男・ふたなりだけ ----
選段:0 = 募集の段を引く(募集の体格の下限:0, 募集の体格の上限:0)
選段:1 = 0
SIF 型 & 6
	選段:1 = 募集の段を引く(募集の体格の下限:1, 募集の体格の上限:1)
選段:2 = 募集の段を引く(募集の体格の下限:2, 募集の体格の上限:2)
選段:3 = 0
SIF 型 & 5
	選段:3 = 募集の段を引く(募集の体格の下限:3, 募集の体格の上限:3)
FOR 甲, 0, 4
	SIF 募集_体格有:甲
