	CALL 選択肢を並べる(段 - 募集の体格の下限:種, 段 - 募集の体格の下限:種 + 1, 募集の体格の名(種, 段), 募集_体格有:種 && 募集_体格段:種 == 段, 4, "")
NEXT
PRINTL
INPUT
IF RESULT == 0
	募集_体格有:種 = 0
	RETURN 0
ENDIF
SIF RESULT < 1 || RESULT > 募集の体格の上限:種 - 募集の体格の下限:種 + 1
	RETURN 0
前有 = 募集_体格有:種
前段 = 募集_体格段:種
募集_体格有:種 = 1
募集_体格段:種 = 募集の体格の下限:種 + RESULT - 1
IF 募集の許す性別() == 0
	募集_体格有:種 = 前有
	募集_体格段:種 = 前段
	PRINTFORML %TALENTNAME:(体格素質の始め + 種)%は、いまの性別・条件と両立しない
