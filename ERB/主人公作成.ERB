;================================ [9] 服装 ================================
;衣装.csv の組の名前を並べる（同じ名前の女／男の行は一つに。台帳が増えれば増える）。CSTR:MASTER:服装 に名前で入れる。中身は性別で決まる（→個室.ERB @衣装の組）
@主人公作成_服装
#DIM 衣装
#DIM 甲
#DIM 数
#DIMS 名
#DIMS 候補, 64

PRINTL
名 '= CSTR:MASTER:服装
SIF 名 == ""
	名 '= "私服"
PRINTFORML 服装　いま：%名%（%着ているものの文(MASTER)%）　容姿 %容姿の文(MASTER)%
;いま着ているものは色を変える（付いている色）
数 = 0
FOR 衣装, 0, 衣装数
	;同じ名前は最初の一つだけ
	甲 = 0
	WHILE 甲 < 数 && 候補:甲 != 衣装名:衣装
		甲 += 1
	WEND
	SIF 甲 < 数
		CONTINUE
	候補:数 '= 衣装名:衣装
	CALL 選択肢を並べる(数, 数 + 1, 候補:数, 候補:数 == 名, 4, "")
	数 += 1
NEXT
PRINTL
PRINTL [0] 戻る
INPUT
SIF RESULT < 1 || RESULT > 数
	RETURN 0
CSTR:MASTER:服装 = %候補:(RESULT - 1)%


;================================ [10] 経験 ================================
;era標準の EXP_CUSTOM と同じ「番号を選んで数字を入れる」。eraBACK の経験は 行為ごとの回数（128枠）と 開発度（8本）（→設計メモ「行為の値」）。
;開発度は [1〜16] の [−][＋]（感度M B C V A P・耐性・慣れの順）、行為は 100＋台帳の番号。処女／童貞の素質は置かず、回数 0 で初回を判定する
@主人公作成_経験
#DIM 部位
#DIM 分類
#DIM 行為
#DIM 数
#DIM 番号

WHILE 1
	PRINTL
	PRINTL 経験
	PRINTL 　開発度（Lv 0〜10）
	PRINT 　
	FOR 部位, 0, 6
		SIF !(部位のある性別:部位 & 性別ビット(MASTER))
			CONTINUE
		PRINTFORM 感度%部位記号:部位% Lv{開発度_感度:MASTER:部位 / 開発度の一段} [{部位 * 2 + 1}−][{部位 * 2 + 2}＋]　
	NEXT
	PRINTL
	PRINTFORML 　耐性 Lv{開発度_耐性:MASTER:0 / 開発度の一段} [13−][14＋]　慣れ Lv{開発度_慣れ:MASTER:0 / 開発度の一段} [15−][16＋]
	PRINTL
	PRINTL 　行為の回数（番号で回数を入れる。0 で消す）
	FOR 分類, 0, 行為分類数
		数 = 0
		FOR 行為, 0, 行為数
			SIF 行為名:行為 == "" || 行為の分類:行為 != 分類
				CONTINUE
			SIF 数 == 0
				PRINTFORM 　%行為分類名:分類, 8, LEFT%
			;回数のあるものは色を変える（付いている色）。折った行頭は見出し（全角1＋8）ぶん空ける。行為は多いので5列（この画面はサイドが無く幅を全部使える）
			CALL 選択肢を並べる(数, 行為 + 100, 行為名:行為 + " " + TOSTR(経験回数:MASTER:行為), 経験回数:MASTER:行為 > 0, 5, "　　　　　")
			数 += 1
		NEXT
		SIF 数 > 0
			PRINTL
	NEXT
	PRINTL [0] 戻る
	INPUT
	番号 = RESULT
	IF 番号 >= 1 && 番号 <= 12
		部位 = (番号 - 1) / 2
		CALL 開発度を刻む(部位, 番号 % 2 == 0)
	ELSEIF 番号 >= 13 && 番号 <= 16
		CALL 開発度を刻む(6 + (番号 - 13) / 2, 番号 % 2 == 0)
	ELSEIF 番号 >= 100 && 番号 < 100 + 行為数 && 行為名:(番号 - 100) != ""
		行為 = 番号 - 100
		;マウスだけで打てる数値パッドに直した（2026-09-23 ユーザ指定。→マップ/共通.ERB @数値パッド）
		CALL 数値パッド(@"%行為名:行為%を何回にしますか", 0, 9999, 経験回数:MASTER:行為, 1, 経験回数:MASTER:行為)
		経験回数:MASTER:行為 = RESULT
	ELSE
		BREAK
	ENDIF
WEND


;開発度を Lv ひとつ上げ下げ。部位 0〜5 は感度、6 は耐性、7 は慣れ。上限 Lv10（開発度の一段 × 10）
@開発度を刻む(部位, 上げる)
#DIM 部位
#DIM 上げる
#DIM 幅

幅 = 開発度の一段
SIF !上げる
	幅 = 0 - 開発度の一段
IF 部位 < 6
	開発度_感度:MASTER:部位 = LIMIT(開発度_感度:MASTER:部位 + 幅, 0, 開発度の一段 * 10)
ELSEIF 部位 == 6
	開発度_耐性:MASTER:0 = LIMIT(開発度_耐性:MASTER:0 + 幅, 0, 開発度の一段 * 10)
ELSE
	開発度_慣れ:MASTER:0 = LIMIT(開発度_慣れ:MASTER:0 + 幅, 0, 開発度の一段 * 10)
ENDIF


;================================ 最初のスタッフ ================================
;ゲーム開始のとき、同梱キャラから 最初のスタッフの上限 人まで雇って始める（→画面イメージ「最初のスタッフ」）。
;寮は6部屋で始まり（初期化_店）、3部屋は後から自分で雇う分。選ばなくてもいい。
;雇い方は 行動.ERB @雇う と同じ（スタッフ・寮の部屋）。友情は 雇うのに要る段 に届くまで上げる（雇えている以上はそれだけの仲）
;トップは「組（テンプレ）で選ぶ／個別に選ぶ」の二択（2026-09-23 ユーザ指定「出力項目が多すぎて見切れている」）。
;個別に選ぶは人数が多いので 最初のスタッフ一覧の一段 人ごとにページを分ける（→ @最初のスタッフ_個別に選ぶ）
@最初のスタッフを選ぶ
#DIM 番号
#DIM 部屋
#DIM 数
;キャラ枠（500）ぶん。#DIM の大きさに定数名は使わない
#DIM 選んだ, 500
#DIMS 名

WHILE 1
	数 = 0
	FOR 番号, 1, キャラ枠
		SIF 選んだ:番号
			数 += 1
	NEXT
	PRINTL
	DRAWLINE
	SETCOLOR 0xffcc44
	PRINT ■最初のスタッフ
	RESETCOLOR
	PRINTFORML 　　選んだ {数}人／{最初のスタッフの上限}人
	DRAWLINE
	PRINTL 　マスターの下で働いていた顔ぶれ。誰に残ってもらうか決める。
	PRINTFORML 　番号で付け外し。日給は出勤した日だけ払う。寮は{寮の部屋数}部屋で、{寮の部屋数 - 最初のスタッフの上限}部屋は後から雇う分に空けておく。
	PRINTL
	PRINTFORM 　選んだ：
	IF 数 == 0
		PRINT なし
	ELSE
		名 '= ""
		FOR 番号, 1, キャラ枠
			SIF !選んだ:番号
				CONTINUE
			SIF 名 != ""
				名 += "・"
			名 += CALLNAME:番号
		NEXT
		PRINTS 名
	ENDIF
	PRINTFORML （{数}人／{最初のスタッフの上限}人）
	PRINTL
	SIF 最初の組数 > 0
		PRINTL [1] 組（テンプレ）で選ぶ
	PRINTL [2] 個別に選ぶ
	PRINTL [0] これで始める
	INPUT
	IF RESULT == 0
		BREAK
	ELSEIF RESULT == 1 && 最初の組数 > 0
		CALL 最初のスタッフ_テンプレで選ぶ(選んだ)
	ELSEIF RESULT == 2
		CALL 最初のスタッフ_個別に選ぶ(選んだ)
	ENDIF
WEND

;雇う。部屋は 410 から順に
PRINTL
数 = 0
FOR 番号, 1, キャラ枠
	SIF !選んだ:番号
		CONTINUE
	部屋 = 空き部屋()
	SIF 部屋 == 0
		BREAK
	スタッフ:番号:0 = 1
	寮の部屋:番号:0 = 部屋
	SIF 好感度の段(好感度_友情:番号:0) < 雇うのに要る段
		好感度_友情:番号:0 = 雇うのに要る段 * 好感度の一段
	IF 数 == 0
		PRINTFORM %CALLNAME:番号%
	ELSE
		PRINTFORM ・%CALLNAME:番号%
	ENDIF
	数 += 1
NEXT
IF 数 == 0
	PRINTL 誰にも残ってもらわず、一人で始める
ELSE
	PRINT に残ってもらった。
	数 = 0
	FOR 番号, 1, キャラ枠
		SIF !選んだ:番号
			CONTINUE
		SIF 数 > 0
			PRINT ・
		PRINTFORM %GET_PLACE_NAME(寮の部屋:番号:0)%
		数 += 1
	NEXT
	PRINTL に住む
ENDIF
WAIT


;組で選ぶ（CSV/台帳/最初のスタッフ.csv →画面イメージ「最初のスタッフ」）。[901] から順。押すと 選んだ を丸ごとその顔ぶれに入れ替える。
;CSV の無い番号は飛ばし、一人も居ない組は行ごと出さない。いま選んでいる顔ぶれと一致する組は 付いている色
@最初のスタッフ_テンプレで選ぶ(選んだ)
#DIM REF 選んだ, 0
#DIM 番号
#DIM 数
#DIMS 名
#DIM 組番
#DIM 品
#DIM 人数
#DIM 一致

WHILE 1
	数 = 0
	FOR 番号, 1, キャラ枠
		SIF 選んだ:番号
			数 += 1
	NEXT
	PRINTL
	DRAWLINE
	PRINTL ■組（テンプレ）で選ぶ
	DRAWLINE
	PRINTL 　押すと選んだを丸ごとその顔ぶれに入れ替える。戻ったあとも個別に付け外しできる。
	PRINTL
	FOR 組番, 0, 最初の組数
		名 '= ""
		人数 = 0
		一致 = 1
		FOR 品, 0, 最初のスタッフの上限
			番号 = 最初の組の番号:組番:品
			SIF 番号 <= 0 || 番号 >= キャラ枠 || !実キャラ:番号:0
				CONTINUE
			SIF 名 != ""
				名 += "・"
			名 += CALLNAME:番号
			人数 += 1
			SIF !選んだ:番号
				一致 = 0
		NEXT
		SIF 人数 == 0
			CONTINUE
		SIF 人数 != 数
			一致 = 0
		SIF 一致
			SETCOLOR 付いている色
		PRINTFORM 　%選択肢のマス(最初の組の番号の始まり + 組番, 最初の組名:組番, 24)%
		WHILE STRLENS(名) < 30
			名 += " "
		WEND
		PRINTS 名
		PRINTFORML %最初の組の一言:組番%
		RESETCOLOR
	NEXT
	PRINTL
	PRINTL [0] 戻る
	INPUT
	IF RESULT == 0
		RETURN
	ELSEIF RESULT >= 最初の組の番号の始まり && RESULT < 最初の組の番号の始まり + 最初の組数
		;一人も居ない組（行を出していない）は何もしない
		組番 = RESULT - 最初の組の番号の始まり
		人数 = 0
		FOR 品, 0, 最初のスタッフの上限
			番号 = 最初の組の番号:組番:品
			SIF 番号 > 0 && 番号 < キャラ枠 && 実キャラ:番号:0
				人数 += 1
		NEXT
		SIF 人数 == 0
			CONTINUE
		FOR 番号, 1, キャラ枠
			選んだ:番号 = 0
		NEXT
		FOR 品, 0, 最初のスタッフの上限
			番号 = 最初の組の番号:組番:品
			SIF 番号 > 0 && 番号 < キャラ枠 && 実キャラ:番号:0
				選んだ:番号 = 1
		NEXT
		RETURN
	ENDIF
WEND


;個別に選ぶ。先頭のタグで組を切って見出しを挟む（組の順は先頭のタグが最初に出た番号順。タグの無い人は最後）。
;項目が多いので 最初のスタッフ一覧の一段 人ごとにページを分ける（[920] 前のページ／[921] 次のページ）
@最初のスタッフ_個別に選ぶ(選んだ)
#DIM REF 選んだ, 0
#DIM 番号
#DIM 数
#DIM 順位, 500
#DIM 総数
#DIM 総ページ
#DIM ページ
#DIMS 組, 500
#DIM 組の数
#DIM 組番
#DIMS 名
#DIM 人数

;実キャラをキャラ番号順に並べて何番目かを控える（ページの範囲判定に使う）
総数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	順位:番号 = 総数
	総数 += 1
NEXT
総ページ = (総数 - 1) / 最初のスタッフ一覧の一段 + 1

;先頭のタグで組を切る（→画面イメージ「最初のスタッフ」）。組の順は先頭のタグが最初に出た番号順。タグの無い人は最後
組の数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	名 '= タグの先頭(番号)
	SIF 名 == ""
		CONTINUE
	組番 = 0
	WHILE 組番 < 組の数
		SIF 組:組番 == 名
			BREAK
		組番 += 1
	WEND
	IF 組番 == 組の数
		組:組の数 '= 名
		組の数 += 1
	ENDIF
NEXT

ページ = 0
WHILE 1
	数 = 0
	FOR 番号, 1, キャラ枠
		SIF 選んだ:番号
			数 += 1
	NEXT
	PRINTL
	DRAWLINE
	SETCOLOR 0xffcc44
	PRINT ■個別に選ぶ
	RESETCOLOR
	PRINTFORML 　　選んだ {数}人／{最初のスタッフの上限}人　　（{ページ + 1}／{総ページ}ページ）
	DRAWLINE
	FOR 組番, 0, 組の数 + 1
		人数 = 0
		FOR 番号, 1, キャラ枠
			SIF !実キャラ:番号:0
				CONTINUE
			IF 組番 < 組の数
				SIF タグの先頭(番号) != 組:組番
					CONTINUE
			ELSE
				SIF タグの先頭(番号) != ""
					CONTINUE
			ENDIF
			SIF 順位:番号 < ページ * 最初のスタッフ一覧の一段 || 順位:番号 >= ページ * 最初のスタッフ一覧の一段 + 最初のスタッフ一覧の一段
				CONTINUE
			人数 += 1
		NEXT
		SIF 人数 == 0
			CONTINUE
		IF 組番 < 組の数
			PRINTFORML 　── %組:組番% ──
		ELSEIF 組の数 > 0
			PRINTL 　── （タグなし）──
		ENDIF
		FOR 番号, 1, キャラ枠
			SIF !実キャラ:番号:0
				CONTINUE
			IF 組番 < 組の数
				SIF タグの先頭(番号) != 組:組番
					CONTINUE
			ELSE
				SIF タグの先頭(番号) != ""
					CONTINUE
			ENDIF
			SIF 順位:番号 < ページ * 最初のスタッフ一覧の一段 || 順位:番号 >= ページ * 最初のスタッフ一覧の一段 + 最初のスタッフ一覧の一段
				CONTINUE
			CALL 最初のスタッフの行(番号, 選んだ:番号)
		NEXT
	NEXT
	PRINTL
	SIF ページ > 0
		PRINTFORML [{最初のスタッフの前のページ}] 前のページ
	SIF ページ < 総ページ - 1
		PRINTFORML [{最初のスタッフの次のページ}] 次のページ
	PRINTL [0] 戻る
	INPUT
	IF RESULT == 0
		RETURN
	ELSEIF RESULT == 最初のスタッフの前のページ && ページ > 0
		ページ -= 1
		CONTINUE
	ELSEIF RESULT == 最初のスタッフの次のページ && ページ < 総ページ - 1
		ページ += 1
		CONTINUE
	ELSEIF RESULT < 1 || RESULT >= キャラ枠 || !実キャラ:RESULT:0
		CONTINUE
	ENDIF
	IF 選んだ:RESULT
		選んだ:RESULT = 0
	ELSEIF 数 >= 最初のスタッフの上限
		PRINTFORML {最初のスタッフの上限}人までにしておく
		WAIT
	ELSE
		選んだ:RESULT = 1
	ENDIF
WEND


