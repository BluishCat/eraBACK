;================================ [5] 体型 ================================
;数字を直接入れる（cm／kg の実数）か 1 刻み・5 刻み。帯から入れる（小柄〜爆乳）は身長・胸囲を帯の値にする（→SYSTEM.ERB @体型を帯から入れる）
@主人公作成_体型
#DIM 入口

WHILE 1
	PRINTL
	PRINTFORML 体型　（0.1cm／0.1kg 単位）　%体型の名札(MASTER)%
	PRINTFORML [1] 身長　%小数表示(身長:MASTER:0), 6, RIGHT%cm　　[11] −5cm　[12] −1cm　[13] ＋1cm　[14] ＋5cm
	PRINTFORML [2] 体重　%小数表示(体重:MASTER:0), 6, RIGHT%kg　　[21] −5kg　[22] −1kg　[23] ＋1kg　[24] ＋5kg
	PRINTFORM [3] 胸囲　%小数表示(胸囲:MASTER:0), 6, RIGHT%cm
	SIF 性別ビット(MASTER) & 6
		PRINTFORM (%カップ(MASTER)%)
	PRINTL 　　[31] −5cm　[32] −1cm　[33] ＋1cm　[34] ＋5cm
	PRINTFORML [4] 胴囲　%小数表示(胴囲:MASTER:0), 6, RIGHT%cm　　[41] −5cm　[42] −1cm　[43] ＋1cm　[44] ＋5cm
	PRINTFORML [5] 腰囲　%小数表示(腰囲:MASTER:0), 6, RIGHT%cm　　[51] −5cm　[52] −1cm　[53] ＋1cm　[54] ＋5cm
	;段（体型・バスト・下半身。→ERB/体格.ERB）。段を動かすと数字を段の帯に作り直す。数字を動かすと段も引き直される
	PRINTFORML 　体型　　　%埋める(体型の段名(TALENT:MASTER:体型), 10)%[61] ひとつ細く　[62] ひとつ太く
	IF 性別ビット(MASTER) & 6
		PRINTFORML 　バスト　　%埋める(バストの段名(TALENT:MASTER:バストサイズ), 10)%[71] ひとつ小さく　[72] ひとつ大きく
	ENDIF
	PRINTFORML 　下半身　　%埋める(下半身の段名(TALENT:MASTER:下半身), 10)%[81] ひとつ細く　[82] ひとつ張らせる
	IF 男性器があるか(MASTER)
		PRINTFORML 　男性器　　%埋める(男性器の段名(TALENT:MASTER:男性器サイズ), 10)%[91] ひとつ小さく　[92] ひとつ大きく
	ENDIF
	PRINT 　帯から入れる：
	FOR 入口, 体型入口の始め, 体型入口の終わり + 1
		SIF TALENTNAME:入口 == ""
			CONTINUE
		PRINTS 選択肢のマス(入口, TALENTNAME:入口, 選択肢のマス幅)
	NEXT
	PRINTL
	PRINTL 　[9] 性別の既定に戻す
	PRINTL [0] 戻る
	INPUT
	SELECTCASE RESULT
		CASE 0
			BREAK
		CASE 1
			CALL 小数の入力(身長:MASTER:0, 身長の下限, 身長の上限, "cm")
			身長:MASTER:0 = RESULT
		CASE 2
			CALL 小数の入力(体重:MASTER:0, 体重の下限, 体重の上限, "kg")
			体重:MASTER:0 = RESULT
		CASE 3
			CALL 小数の入力(胸囲:MASTER:0, 体型の下限, 体型の上限, "cm")
			胸囲:MASTER:0 = RESULT
		CASE 4
			CALL 小数の入力(胴囲:MASTER:0, 体型の下限, 体型の上限, "cm")
			胴囲:MASTER:0 = RESULT
		CASE 5
			CALL 小数の入力(腰囲:MASTER:0, 体型の下限, 体型の上限, "cm")
			腰囲:MASTER:0 = RESULT
		CASE 11
			身長:MASTER:0 = LIMIT(身長:MASTER:0 - 50, 身長の下限, 身長の上限)
		CASE 12
			身長:MASTER:0 = LIMIT(身長:MASTER:0 - 10, 身長の下限, 身長の上限)
		CASE 13
			身長:MASTER:0 = LIMIT(身長:MASTER:0 + 10, 身長の下限, 身長の上限)
		CASE 14
			身長:MASTER:0 = LIMIT(身長:MASTER:0 + 50, 身長の下限, 身長の上限)
		CASE 21
			体重:MASTER:0 = LIMIT(体重:MASTER:0 - 50, 体重の下限, 体重の上限)
		CASE 22
			体重:MASTER:0 = LIMIT(体重:MASTER:0 - 10, 体重の下限, 体重の上限)
		CASE 23
			体重:MASTER:0 = LIMIT(体重:MASTER:0 + 10, 体重の下限, 体重の上限)
		CASE 24
			体重:MASTER:0 = LIMIT(体重:MASTER:0 + 50, 体重の下限, 体重の上限)
		CASE 31
			胸囲:MASTER:0 = LIMIT(胸囲:MASTER:0 - 50, 体型の下限, 体型の上限)
		CASE 32
			胸囲:MASTER:0 = LIMIT(胸囲:MASTER:0 - 10, 体型の下限, 体型の上限)
		CASE 33
			胸囲:MASTER:0 = LIMIT(胸囲:MASTER:0 + 10, 体型の下限, 体型の上限)
		CASE 34
			胸囲:MASTER:0 = LIMIT(胸囲:MASTER:0 + 50, 体型の下限, 体型の上限)
		CASE 41
			胴囲:MASTER:0 = LIMIT(胴囲:MASTER:0 - 50, 体型の下限, 体型の上限)
		CASE 42
			胴囲:MASTER:0 = LIMIT(胴囲:MASTER:0 - 10, 体型の下限, 体型の上限)
		CASE 43
			胴囲:MASTER:0 = LIMIT(胴囲:MASTER:0 + 10, 体型の下限, 体型の上限)
		CASE 44
			胴囲:MASTER:0 = LIMIT(胴囲:MASTER:0 + 50, 体型の下限, 体型の上限)
		CASE 51
			腰囲:MASTER:0 = LIMIT(腰囲:MASTER:0 - 50, 体型の下限, 体型の上限)
		CASE 52
			腰囲:MASTER:0 = LIMIT(腰囲:MASTER:0 - 10, 体型の下限, 体型の上限)
		CASE 53
			腰囲:MASTER:0 = LIMIT(腰囲:MASTER:0 + 10, 体型の下限, 体型の上限)
		CASE 54
			腰囲:MASTER:0 = LIMIT(腰囲:MASTER:0 + 50, 体型の下限, 体型の上限)
		CASE 61, 62
			TALENT:MASTER:体型 = LIMIT(TALENT:MASTER:体型 + (RESULT == 62 ? 1 # -1), -3, 3)
			CALL 体格の段から数値を作る(MASTER, 体格_体型)
		CASE 71, 72
			SIF 性別ビット(MASTER) & 6
				TALENT:MASTER:バストサイズ = LIMIT(TALENT:MASTER:バストサイズ + (RESULT == 72 ? 1 # -1), -2, 3)
			CALL 体格の段から数値を作る(MASTER, 体格_バスト)
		CASE 81, 82
			TALENT:MASTER:下半身 = LIMIT(TALENT:MASTER:下半身 + (RESULT == 82 ? 1 # -1), -1, 1)
			CALL 体格の段から数値を作る(MASTER, 体格_下半身)
		CASE 91, 92
			SIF 男性器があるか(MASTER)
				TALENT:MASTER:男性器サイズ = LIMIT(TALENT:MASTER:男性器サイズ + (RESULT == 92 ? 1 # -1), -2, 2)
		CASE 9
			CALL 体格の段を空にする(MASTER)
			CALL 体型を入れる(MASTER)
		CASEELSE
			IF RESULT >= 体型入口の始め && RESULT <= 体型入口の終わり
				SIF TALENTNAME:RESULT != ""
					CALL 体型を帯から入れる(MASTER, RESULT)
			ENDIF
	ENDSELECT
	;数字を動かしたら段を引き直す（段を動かして数字を作ったときは、帯の内側なので同じ段に戻る）
	CALL 体格の段を引き直す(MASTER, 体格_全部)
WEND


;小数一桁の入力。0.1 単位の整数で返す。空や範囲外なら今のまま
;マウスだけで打てる数値パッドに直した（2026-09-23 ユーザ指定。→マップ/共通.ERB @数値パッド）
@小数の入力(今, 下限, 上限, 単位)
#DIM 今
#DIM 下限
#DIM 上限
#DIMS 単位

CALL 数値パッド(@"何%単位%にしますか", 下限, 上限, 今, 10, 今)
RETURN RESULT


;================================ [6] 技能 ================================
;era標準の ABL_CUSTOM と同じ [−][＋]。番号は 技能×2+1 が −、技能×2+2 が ＋
@主人公作成_技能
#DIM 技能

WHILE 1
	PRINTL
	PRINTFORML 技能　（Lv 0〜{技能Lv上限}）
	FOR 技能, 0, 技能数
		PRINTFORM %ABLNAME:技能% Lv{ABL:MASTER:技能} [{技能 * 2 + 1}−][{技能 * 2 + 2}＋]　　
		SIF 技能 % 3 == 2
			PRINTL
	NEXT
	SIF 技能数 % 3 != 0
		PRINTL
	PRINTL [0] 戻る
	INPUT
	SIF RESULT <= 0 || RESULT > 技能数 * 2
		BREAK
	技能 = (RESULT - 1) / 2
	IF RESULT % 2 == 1
		SIF ABL:MASTER:技能 > 0
			ABL:MASTER:技能 -= 1
	ELSE
		SIF ABL:MASTER:技能 < 技能Lv上限
			ABL:MASTER:技能 += 1
	ENDIF
WEND


;================================ [7] 素質 ================================
;番号は Talent.csv の素質番号そのまま（口上タイプ・怪しい店と同じ流儀）。付け外し。排他のものは付けると相手が外れる。
;伸び（60〜89）・体質（100〜139）・裏の好み（50〜59）・性癖（180〜189）・妊娠の上書き（5〜6）。性別・口上タイプ・好物はここに出さない（それぞれの画面で）
@主人公作成_素質
#DIM 素質
#DIM 相方

WHILE 1
	PRINTL
	PRINTL 素質　（番号で付け外し。排他のものは付けると相手が外れる）
	PRINTFORM 　%"伸び", 10, LEFT%
	CALL 素質の帯を出す(伸び素質の始め, 伸び素質の始め + 2, 0)
	PRINTFORM 　%"才", 10, LEFT%
	CALL 素質の帯を出す(70, 80, 0)
	PRINTFORM 　%"苦手", 10, LEFT%
	CALL 素質の帯を出す(80, 90, 0)
	PRINTFORM 　%"敏感", 10, LEFT%
	CALL 素質の帯を出す(敏感の始め, 敏感の始め + 6, 1)
	PRINTFORM 　%"鈍感", 10, LEFT%
	CALL 素質の帯を出す(鈍感の始め, 鈍感の始め + 6, 1)
	PRINTFORM 　%"体質", 10, LEFT%
	CALL 素質の帯を出す(120, 体質素質の終わり + 1, 1)
	PRINTFORM 　%"裏の好み", 10, LEFT%
	CALL 素質の帯を出す(40, 裏の好み素質の終わり + 1, 0)
	PRINTFORM 　%"性癖", 10, LEFT%
	CALL 素質の帯を出す(性癖素質の始め, 性癖素質の終わり + 1, 0)
	PRINTFORM 　%"妊娠", 10, LEFT%
	CALL 素質の帯を出す(5, 7, 0)
	PRINTL 　（どちらも無ければ性別のとおり）
	PRINTL [0] 戻る
	INPUT
	素質 = RESULT
	SIF 素質 <= 0 || 素質 >= VARSIZE("TALENT") || TALENTNAME:素質 == ""
		BREAK
	SIF !主人公作成で付けられる素質か(素質)
		CONTINUE
	IF TALENT:MASTER:素質
		TALENT:MASTER:素質 = 0
	ELSE
		相方 = 素質の相方(素質)
		SIF 相方 >= 0
			TALENT:MASTER:相方 = 0
		TALENT:MASTER:素質 = 1
	ENDIF
WEND


;始め〜終わり−1 の素質を列に揃えて並べる（→マップ/共通.ERB @選択肢を並べる）。性別で＝敏感／鈍感・濡れ系は性別に無いものを飛ばす（→@素質の許す性別）。付いているものは色を変える（付いている色）
@素質の帯を出す(始め, 終わり, 性別で)
#DIM 始め
#DIM 終わり
#DIM 性別で
#DIM 素質
#DIM 数

数 = 0
FOR 素質, 始め, 終わり
	SIF TALENTNAME:素質 == ""
		CONTINUE
	SIF 性別で && !(素質の許す性別(素質) & 性別ビット(MASTER))
		CONTINUE
	;4列で折る。折った行頭は見出し（全角1＋10）ぶん空ける
	CALL 選択肢を並べる(数, 素質, TALENTNAME:素質, TALENT:MASTER:素質, 4, "　　　　　　")
	数 += 1
NEXT
PRINTL


;素質の条件が通る性別（性別ビット）。敏感／鈍感は部位のある性別、濡れやすい／濡れにくい／潮吹き体質は膣のある性別（潤滑が入る性別。→個室.ERB @性の値を整える）、母乳体質は子宮のある性別（女・ふたなり）、それ以外は全部
@素質の許す性別(素質)
#FUNCTION
#DIM 素質

SIF 素質 >= 敏感の始め && 素質 < 敏感の始め + 6
	RETURNF 部位のある性別:(素質 - 敏感の始め)
SIF 素質 >= 鈍感の始め && 素質 < 鈍感の始め + 6
	RETURNF 部位のある性別:(素質 - 鈍感の始め)
SIF TALENTNAME:素質 == "濡れやすい" || TALENTNAME:素質 == "濡れにくい" || TALENTNAME:素質 == "潮吹き体質"
	RETURNF 部位のある性別:3
;母乳体質は子宮のある性別＝女とふたなり（妊娠の対象と同じ 6。男・性別なしには付けない。2026-10-20 ユーザ指定）
SIF TALENTNAME:素質 == "母乳体質"
	RETURNF 6
RETURNF 15


;この画面で付け外しできる素質か（伸び・体質・裏の好み・性癖・中出し癖・妊娠の上書き）
@主人公作成で付けられる素質か(素質)
#FUNCTION
#DIM 素質

SIF 素質 >= 伸び素質の始め && 素質 <= 伸び素質の終わり
	RETURNF 1
SIF 素質 >= 体質素質の始め && 素質 <= 体質素質の終わり
	RETURNF 1
SIF 素質 >= 裏の好み素質の始め && 素質 <= 裏の好み素質の終わり
	RETURNF 1
SIF 性癖の素質か(素質)
	RETURNF 1
SIF TALENTNAME:素質 == "中出し癖"
	RETURNF 1
SIF TALENTNAME:素質 == "眠りが浅い" || TALENTNAME:素質 == "眠りが深い"
	RETURNF 1
SIF TALENTNAME:素質 == "妊娠する" || TALENTNAME:素質 == "妊娠しない"
	RETURNF 1
RETURNF 0


;排他の相方。伸びは @伸びの相方（怪しい店.ERB）、体質は 敏感↔鈍感（同じ部位）と対の名前、妊娠は する↔しない。無ければ -1
@素質の相方(素質)
#FUNCTION
#DIM 素質
#DIMS 名

SIF 素質 >= 伸び素質の始め && 素質 <= 伸び素質の終わり
	RETURNF 伸びの相方(素質)
SIF 素質 >= 敏感の始め && 素質 < 敏感の始め + 6
	RETURNF 素質 - 敏感の始め + 鈍感の始め
SIF 素質 >= 鈍感の始め && 素質 < 鈍感の始め + 6
	RETURNF 素質 - 鈍感の始め + 敏感の始め
名 '= TALENTNAME:素質
SIF 名 == "痛みに強い"
	RETURNF GETNUM(TALENT, "痛みに弱い")
SIF 名 == "痛みに弱い"
	RETURNF GETNUM(TALENT, "痛みに強い")
SIF 名 == "眠りが浅い"
	RETURNF GETNUM(TALENT, "眠りが深い")
SIF 名 == "眠りが深い"
	RETURNF GETNUM(TALENT, "眠りが浅い")
SIF 名 == "恥じらい"
	RETURNF GETNUM(TALENT, "恥薄い")
SIF 名 == "恥薄い"
	RETURNF GETNUM(TALENT, "恥じらい")
SIF 名 == "濡れやすい"
	RETURNF GETNUM(TALENT, "濡れにくい")
SIF 名 == "濡れにくい"
	RETURNF GETNUM(TALENT, "濡れやすい")
SIF 名 == "快感に素直"
	RETURNF GETNUM(TALENT, "快感の否定")
SIF 名 == "快感の否定"
	RETURNF GETNUM(TALENT, "快感に素直")
SIF 名 == "回復早い"
	RETURNF GETNUM(TALENT, "回復遅い")
SIF 名 == "回復遅い"
	RETURNF GETNUM(TALENT, "回復早い")
SIF 名 == "妊娠する"
	RETURNF GETNUM(TALENT, "妊娠しない")
SIF 名 == "妊娠しない"
	RETURNF GETNUM(TALENT, "妊娠する")
RETURNF -1


;================================ [8] 好物 ================================
;排他は無い（客と同じ。複数持てる）。主人公側でまだ効く先は無い（客側だけが見る値）。「主人公も同じ尺」の線で持たせておく
@主人公作成_好物
#DIM 素質

WHILE 1
	PRINTL
	PRINTL 好物　（番号で付け外し）
	PRINTFORM 　%"食べ物", 10, LEFT%
	CALL 素質の帯を出す(20, 30, 0)
	PRINTFORM 　%"飲み物", 10, LEFT%
	CALL 素質の帯を出す(30, 好物素質の終わり + 1, 0)
	PRINTL [0] 戻る
	INPUT
	素質 = RESULT
	SIF 素質 < 好物素質の始め || 素質 > 好物素質の終わり || TALENTNAME:素質 == ""
		BREAK
	TALENT:MASTER:素質 = !TALENT:MASTER:素質
