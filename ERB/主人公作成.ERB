#DIM 技能
#DIM 部位
#DIM 行為
#DIM 数
#DIMS 名

PRINTL
DRAWLINE
SETCOLOR 0xffcc44
PRINTFORM ■%CALLNAME:MASTER%
RESETCOLOR
PRINTFORML 　%性別名(MASTER)%%処女のタグ(MASTER)%　　口上：%口上タイプ(MASTER)%・%方言の名(MASTER)%（%口上の使い方の名()%）
SIF 呼び方の行(MASTER) != ""
	PRINTFORML 　%呼び方の行(MASTER)%
DRAWLINE

HTML_PRINT 能力表示_見出し("開始")
PRINTL
PRINTFORML 　{開始の月()}月1日（%季節名(暦の季節(0))%）に店を継ぐ
PRINTL

HTML_PRINT 能力表示_見出し("体型")
PRINTL
PRINTFORM 　身長 %小数表示(身長:MASTER:0)%cm　　体重 %小数表示(体重:MASTER:0)%kg　　B/W/H %小数表示(胸囲:MASTER:0)%cm
SIF 性別ビット(MASTER) & 6
	PRINTFORM (%カップ(MASTER)%)
PRINTFORML  / %小数表示(胴囲:MASTER:0)%cm / %小数表示(腰囲:MASTER:0)%cm
PRINTFORML 　%体格の行(MASTER)%
PRINTL

HTML_PRINT 能力表示_見出し("技能")
PRINTL
PRINT 　
FOR 技能, 0, 技能数
	PRINTFORM %ABLNAME:技能% Lv{ABL:MASTER:技能}　
NEXT
PRINTL
PRINTL

HTML_PRINT 能力表示_見出し("素質")
PRINTL
HTML_PRINT 能力表示_素質(MASTER)
PRINTL
PRINTL

HTML_PRINT 能力表示_見出し("服装")
PRINTL
名 '= CSTR:MASTER:服装
SIF 名 == ""
	名 '= "私服"
PRINTFORML 　%名%　%着ているものの文(MASTER)%　容姿 %容姿の文(MASTER)%
PRINTL

HTML_PRINT 能力表示_見出し("経験")
PRINTL
PRINT 　
FOR 部位, 0, 6
	SIF !(部位のある性別:部位 & 性別ビット(MASTER))
		CONTINUE
	PRINTFORM 感度%部位記号:部位% Lv{開発度_感度:MASTER:部位 / 開発度の一段}　
NEXT
PRINTFORML 耐性 Lv{開発度_耐性:MASTER:0 / 開発度の一段}　慣れ Lv{開発度_慣れ:MASTER:0 / 開発度の一段}
;回数が入っている行為だけ
数 = 0
FOR 行為, 0, 行為数
	SIF 行為名:行為 == "" || 経験回数:MASTER:行為 <= 0
		CONTINUE
	IF 数 == 0
		PRINT 　行為の回数：
	ELSEIF 数 % 6 == 0
		PRINTL
		PRINT 　　　　　　
	ENDIF
	PRINTFORM %行為名:行為% {経験回数:MASTER:行為}回　
	数 += 1
NEXT
SIF 数 == 0
	PRINT 　行為の回数：まだ何もない
PRINTL
DRAWLINE
PRINTL [1] 名前　　[2] 性別　　[3] 性格（口上タイプ）　　[4] 使用口上
PRINTL [5] 体型　　[6] 技能　　[7] 素質　　[8] 好物　　[9] 服装　　[10] 経験　　[11] 呼び方　　[12] 開始の月
PRINTL [0] これで始める


;0.1 単位の整数を「158.0」の形に
@小数表示(値)
#FUNCTIONS
#DIM 値

RETURNF @"{値 / 10}.{値 % 10}"


;口上の使い方の名（→変数定義.ERH 口上の使い方）。口上なし（主人公のあり／なし）なら「（口上なし）」を添える
@口上の使い方の名
#FUNCTIONS
#DIMS 名

名 '= "固有＋汎用"
SIF 口上の使い方 == 1
	名 '= "固有のみ"
SIF 口上の使い方 == 2
	名 '= "汎用のみ"
SIF CFLAG:MASTER:口上なし
	名 += "（口上なし）"
RETURNF 名


;================================ [1] 名前 ================================
;era標準と同じく NAME と CALLNAME を別に聞く。呼び名はキャラが主人公を呼ぶときの名。空なら名前と同じ
@主人公作成_名前
#DIMS 入力名

PRINTFORML 名前を決めてください（いま：%NAME:MASTER%。そのまま決定で変えない）
INPUTS
入力名 '= RESULTS
IF 入力名 != ""
	NAME:MASTER = %入力名%
	CALLNAME:MASTER = %入力名%
ENDIF
PRINTFORML 呼び名を決めてください（いま：%CALLNAME:MASTER%。そのまま決定で名前と同じ）
INPUTS
入力名 '= RESULTS
IF 入力名 != ""
	CALLNAME:MASTER = %入力名%
ELSE
	CALLNAME:MASTER = %NAME:MASTER%
ENDIF


;================================ [12] 開始の月 ================================
;1日目の月を決める（→画面イメージ「暦」）。押したら決まって画面に戻る
@主人公作成_開始の月
#DIM 月

PRINTL
DRAWLINE
PRINTFORML 店を継ぐ月を決めてください（1日目はその月の1日。いま：{開始の月()}月）
FOR 月, 1, 13
	PRINTFORM [{月}] {月}月　　
	SIF 月 % 6 == 0
		PRINTL
NEXT
PRINTL [0] 戻る
INPUT
SIF RESULT >= 1 && RESULT <= 12
	開始月 = RESULT


;================================ [2] 性別 ================================
;素質タグで持つ。不正なら女（→設計メモ「キャラCSV仕様」）
@主人公作成_性別

PRINTFORML 性別を選んでください（いま：%性別名(MASTER)%）
PRINTL [1] 男　　[2] 女　　[3] ふたなり　　[4] 性別なし
INPUT
TALENT:MASTER:男 = 0
TALENT:MASTER:女 = 0
TALENT:MASTER:ふたなり = 0
TALENT:MASTER:性別なし = 0
SELECTCASE RESULT
	CASE 1
		TALENT:MASTER:男 = 1
	CASE 3
		TALENT:MASTER:ふたなり = 1
	CASE 4
		TALENT:MASTER:性別なし = 1
	CASEELSE
		TALENT:MASTER:女 = 1
ENDSELECT


;================================ [4] 使用口上 ================================
;設定 [5] からも同じ画面（→一日.ERB @設定画面）
@主人公作成_使用口上

PRINTL
PRINTFORML 使用口上　いま：%口上の使い方の名()%
PRINTL [1] 固有のみ　　　　固有口上（ERB/口上/あなた口上/ 直下）だけ。無い局面は黙る
PRINTL [2] 固有＋汎用　　　固有があればそれ、無ければタイプ_性別 → タイプ の汎用
PRINTL [3] 汎用のみ　　　　固有を使わない。タイプ_性別 → タイプ
PRINTFORML [4] 口上のあり／なし　　いま：%口上の状態(MASTER)%　　押すたびに反転（なしなら [1]〜[3] は効かない）
PRINTL [0] 戻る
