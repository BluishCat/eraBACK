			CASE 1
				RESULTS '= "「お尻、服の上から失礼〜」"
			CASE 2
				RESULTS '= "「中に手、入れるよ？」"
			CASEELSE
				RESULTS '= "「直に触るね……いい手触り」"
		ENDSELECT
	ENDIF
ENDIF


