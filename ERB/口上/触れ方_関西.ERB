;---- 元気 ----
@口上_触れ方_元気_関西(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分
#DIM 群

RESULTS '= ""
群 = 触れ方の群(行為)
IF 向き == 0
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「ちょ、布越しとか焦らしすぎやん……」"
			CASE 2
				RESULTS '= "「あ、中まで入ってきた……！　ちょ、早いて」"
			CASEELSE
				RESULTS '= "「うわ、直接……！　そこ、あかんて」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもわかってまうやん……なぁ、もっと」"
			CASE 2
				RESULTS '= "「ちょ、手ぇ入ってるやん……あったか」"
			CASEELSE
				RESULTS '= "「ひゃっ、じかに……！　ちょっと強いて」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻？　服の上からでもエッチやん」"
			CASE 2
				RESULTS '= "「あ、中に……手ぇ、つっこむの早ない？」"
			CASEELSE
				RESULTS '= "「うわ、直に……ひゃっ、冷たっ」"
		ENDSELECT
	ENDIF
ELSE
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「布の上からでも熱いの、わかるで」"
			CASE 2
				RESULTS '= "「ん、中……すご、もう熱いやん」"
			CASEELSE
				RESULTS '= "「じかやとやばいなぁ……全部わかってまうわ」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもやわらか〜」"
			CASE 2
				RESULTS '= "「中に手ぇ、入れてもた……ふふ、あったかい」"
			CASEELSE
				RESULTS '= "「直接やと……やば、すべすべや」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻、服の上から失礼〜」"
			CASE 2
				RESULTS '= "「中に手ぇ、入れるで？」"
			CASEELSE
				RESULTS '= "「直に触るで……ええ手触り」"
		ENDSELECT
	ENDIF
ENDIF


