;呼ぶ順：キャラ別 → タイプ_方言（主人公は タイプ_主人公_方言）→ 標準語（触れ方.ERB）。空なら標準語に落ちる。
;性別では分けない。手書き（元気・奔放＝「〜ばい」、世話焼き＝「〜けんね」、上品・真面目・内気は丁寧語に溶かす、クール・無口は語尾だけ）。

;---- 元気 ----
@口上_触れ方_元気_博多(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分
#DIM 群

RESULTS '= ""
群 = 触れ方の群(行為)
IF 向き == 0
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「ちょ、布越しとか焦らしすぎたい……」"
			CASE 2
				RESULTS '= "「あ、中まで入ってきた……！　ちょ、早かって」"
			CASEELSE
				RESULTS '= "「うわ、直接……！　そこ、やばかばい」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもわかっちゃうたい……ねぇ、もっと」"
			CASE 2
				RESULTS '= "「ちょ、手ぇ入っとるばい……あったか」"
			CASEELSE
				RESULTS '= "「ひゃっ、じかに……！　ちょっと強かって」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻？　服の上からでもエッチたい」"
			CASE 2
				RESULTS '= "「あ、中に……手、つっこむの早くなか？」"
			CASEELSE
				RESULTS '= "「うわ、直に……ひゃっ、冷たっ」"
		ENDSELECT
	ENDIF
ELSE
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「布の上からでも熱いの、わかるばい」"
			CASE 2
				RESULTS '= "「ん、中……すご、もう熱かたい」"
			CASEELSE
				RESULTS '= "「じかやとやばかね……全部わかっちゃうたい」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもやわらか〜」"
			CASE 2
				RESULTS '= "「中に手、入れてしもうた……ふふ、あったかい」"
			CASEELSE
				RESULTS '= "「直接やと……やば、すべすべたい」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻、服の上から失礼〜」"
			CASE 2
				RESULTS '= "「中に手、入れるばい？」"
			CASEELSE
				RESULTS '= "「直に触るばい……よか手触り」"
		ENDSELECT
	ENDIF
ENDIF


