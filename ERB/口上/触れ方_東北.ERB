;触れ方で変わる口上・東北版（2026-10-15 ユーザ指定「作って」。標準語版は 触れ方.ERB。構成は同じ）。
;呼ぶ順：キャラ別 → タイプ_方言（主人公は タイプ_主人公_方言）→ 標準語（触れ方.ERB）。空なら標準語に落ちる。
;性別では分けない。標準語版の台詞を規則で変換して作った（「だべ」「〜ねぇ」「あったけぇ」など。上品・真面目・内気は「〜だす」の丁寧体、クール・無口は語尾と語彙だけ）。

;---- 元気 ----
@口上_触れ方_元気_東北(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分
#DIM 群

RESULTS '= ""
群 = 触れ方の群(行為)
IF 向き == 0
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「ちょ、布越しとか焦らしすぎだべ……」"
			CASE 2
				RESULTS '= "「あ、中まで入ってきた……！　ちょ、早いって」"
			CASEELSE
				RESULTS '= "「うわ、直接……！　そこ、やべぇって」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもわかっちゃうだべ……ね、もっと」"
			CASE 2
				RESULTS '= "「ちょ、手ぇ入ってら……あったけぇ」"
			CASEELSE
				RESULTS '= "「ひゃっ、じかに……！　ちっと強いべ」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻？　服の上からでもエッチだべ」"
			CASE 2
				RESULTS '= "「あ、中に……手、つっこむの早くねぇ？」"
			CASEELSE
				RESULTS '= "「うわ、直に……ひゃっ、つめでっ」"
		ENDSELECT
	ENDIF
ELSE
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「布の上からでもあっちぇの、わかるよ」"
			CASE 2
				RESULTS '= "「ん、中……すご、もうあっちぇだべ」"
			CASEELSE
				RESULTS '= "「じかだとやべぇね……全部わかっちゃう」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもやわっこい〜」"
			CASE 2
				RESULTS '= "「中に手、入れちゃった……ふふ、あったけぇ」"
			CASEELSE
				RESULTS '= "「直接だと……やば、すべすべ」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻、服の上から失礼〜」"
			CASE 2
				RESULTS '= "「中に手、入れるよ？」"
			CASEELSE
				RESULTS '= "「直に触るね……いい手触り」"
		ENDSELECT
	ENDIF
ENDIF


