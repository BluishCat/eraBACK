;---- 元気 ----
@口上_触れ方_元気_広島(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分
#DIM 群

RESULTS '= ""
群 = 触れ方の群(行為)
IF 向き == 0
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「ちょ、布越しとか焦らしすぎじゃん……」"
			CASE 2
				RESULTS '= "「あ、中まで入ってきた……！　ちょ、早いって」"
			CASEELSE
				RESULTS '= "「うわ、直接……！　そこ、ぶちやばいって」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもわかっちゃうじゃん……ね、もっと」"
			CASE 2
				RESULTS '= "「ちょ、手ぇ入っとる……あったか」"
			CASEELSE
				RESULTS '= "「ひゃっ、じかに……！　ちいと強いけぇ」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻？　服の上からでもエッチじゃん」"
			CASE 2
				RESULTS '= "「あ、中に……手、つっこむの早くない？」"
			CASEELSE
				RESULTS '= "「うわ、直に……ひゃっ、冷たっ」"
		ENDSELECT
	ENDIF
ELSE
	IF 群 == 0
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「布の上からでも熱いの、わかるよ」"
			CASE 2
				RESULTS '= "「ん、中……すご、もう熱いじゃん」"
			CASEELSE
				RESULTS '= "「じかだとぶちやばいね……全部わかっちゃう」"
		ENDSELECT
	ELSEIF 群 == 1
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「服の上からでもやわらか〜」"
			CASE 2
				RESULTS '= "「中に手、入れちゃった……ふふ、あったかい」"
			CASEELSE
				RESULTS '= "「直接だと……やば、すべすべ」"
		ENDSELECT
	ELSEIF 群 == 2
		SELECTCASE 区分
			CASE 1
				RESULTS '= "「お尻、服の上から失礼〜」"
			CASE 2
				RESULTS '= "「中に手、入れるよ？」"
			CASEELSE
				RESULTS '= "「直に触るね……ええ手触り」"
		ENDSELECT
	ENDIF
ENDIF


