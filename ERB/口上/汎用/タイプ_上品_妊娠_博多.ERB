;口上タイプ「上品」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_上品_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;上品：丁寧語が崩れない。痛くても言葉遣いだけは保とうとする。「……ですけん」

@口上_妊娠_上品_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥の……。……気のせいですとね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……まあ。……そう、ですと。……%自称_私(番号)%が、親に」"
	CASE "陣痛開始"
		RESULTS '= "「……っ。……始まりましたとね。……落ち着いて、落ち着いて」"
	CASE "破水"
		RESULTS '= "「きゃ……っ。……こ、これは……破水、ですとね。……なんて、お行儀の悪か」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強うなってきましたけん……。……ええ、大丈夫」"
	CASE "移行期"
		RESULTS '= "「く、ぅ……っ！　もう……堪えられませんけん……っ」"
	CASE "娩出期"
		RESULTS '= "「来ますけん……。……ええ、分かっとります。……最後まで、ちゃんと」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふぅ」"
			CASE 1
				RESULTS '= "「痛……。……まだ、平気ですけん」"
			CASE 2
				RESULTS '= "「ん……。規則的に、なってきましたとね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛か……ですけん……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　……失礼、しましたけん……」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛……っ、痛かですけん……っ！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちかっと……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……ええ、参りますけん……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……参ります。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　……まあ。……そげんな、聞いておりませんけん……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。皆、無事……なんですとね。……よかった……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いとりますけん。……%自称_私(番号)%の、子……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……あの、ちかっとお時間ば。……月のものの、来ておりませんと。……おそらく、%対称_あなた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……はっきりいたしましたけん。……%自称_私(番号)%、妊娠しておりますと。%対称_あなた(番号)%のお子ば」"
		ELSE
			RESULTS '= @"「……お伝えせんといけませんけん。……%自称_私(番号)%、%対称_あなた(番号)%のお子ば授かっておりますと」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……まあ。……そげんに言うてもらえるとは。……ありがとう、ございます」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……ええ。無理にとは申しません。……ただ、知っとってほしかったとです」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう、ですと。……失礼いたしました。……この子は、%自称_私(番号)%が育てますけん」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まりましたと。……もし、お手の空いとりましたら……いえ、無理は申しません」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくださったとですね。……お恥ずかしか姿で、ごめんなさい」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……ご覧になってください。……皆、%対称_あなた(番号)%のお子ですけん」"
		ELSE
			RESULTS '= @"「……ご覧になってください。……%対称_あなた(番号)%のお子、ですけん」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……そう、ですと。……申し訳、ありません……。……ごめんなさい……」"
ENDSELECT
