;口上タイプ「奔放」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_奔放_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;奔放：物怖じせず、痛みも笑い飛ばそうとする。関西弁の「ほれ」「上等や」。一人称は「うち」

@口上_妊娠_奔放_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今の、なんやろ。……ま、ええか」"
	CASE "妊娠発覚"
		RESULTS '= "「あー……やっぱりな。誰の子かなぁ、なんて。ふふ、上等や」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……お、始まった？　ええよ、来ぃや」"
	CASE "破水"
		RESULTS '= "「うわ、出た……ふふ、派手に破水してもた。もう戻られへんなぁ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……ちょっと、本気出してきたやん……ん、ええよ」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　ああもう、腰が……！　出す、出すから……！」"
	CASE "娩出期"
		RESULTS '= @"「来た……！　ふふ……ええわ、%自称_うち(番号)%の全部、見せたる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだまだ」"
			CASE 1
				RESULTS '= "「いたた……ふふ、こんなもん？」"
			CASE 2
				RESULTS '= "「ん……はぁ。規則的になってきたなぁ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、く……っ！　はぁ……」"
			CASE 1
				RESULTS '= "「痛っ……ふふ、笑われへんなぁ、これは……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、抜けた……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああぁっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「ぐぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛い痛い痛い……っ！　上等や……！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょい……」"
			CASE 2
				RESULTS '= "「うぐっ……！　はぁ、はぁ……来い……っ」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「まだ終わらせへんで……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くで……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　あはは……仕込みすぎたんちゃうか……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふふ、一気に賑やかになったやん……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。ふふ……元気に泣いてる。%自称_うち(番号)%の子やなぁ」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「なあ、ちょっと。……生理、来てへんねん。……ふふ、たぶん%対称_あんた(番号)%のやで？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。妊娠してる。……%対称_あんた(番号)%の子。ふふ、どないする？」"
		ELSE
			RESULTS '= @"「言うとくで。%自称_うち(番号)%、妊娠してるん。……%対称_あんた(番号)%の子や。責任、取れる？」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……あら。そんな顔するんや。……ふふ、ええやん。気に入った」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「ふふ、固まってる。……ええよ、別に。%自称_うち(番号)%が勝手に産むだけやし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……へえ。そう来るんや。……ええわ。%対称_あんた(番号)%の子ちゃうことにしたる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「いたた……始まったで。……来る？　%自称_うち(番号)%の一番すごいところ、見せたるけど」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たんやな。……はぁ、はぁ……ふふ、目、逸らさんといてや」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見ぃや。%対称_あんた(番号)%の子ら。……ふふ、責任重大やなぁ？」"
		ELSE
			RESULTS '= @"「……見ぃや。%対称_あんた(番号)%の子。……ふふ、似てるやん」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……はは。……そっか。……ごめんな、こんな母親で」"
ENDSELECT
