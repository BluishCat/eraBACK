#DIM 番号
#DIM 行為
#DIM 向き
#DIM 段
#DIM 受け

RESULTS '= ""
受け = 向き != 1
SELECTCASE 行為の分類:行為
	;愛撫
	CASE 2
		IF 受け
			IF 段 == 1
				RESULTS '= "（小さく頷いた）"
			ELSE
				RESULTS '= "「……っ、……だ、め……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん……」"
			ELSE
				RESULTS '= "「……は、……っ」"
			ENDIF
		ENDIF
	;奉仕
	CASE 3
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ん。……もっと」"
			ELSE
				RESULTS '= "「……っ、……もう……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん、……」"
			ELSE
				RESULTS '= "「……んっ、……っ」"
			ENDIF
		ENDIF
	;Ｖ系
	CASE 4
