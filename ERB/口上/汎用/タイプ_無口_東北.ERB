				RESULTS '= "「……ん……っ」"
			ELSE
				RESULTS '= "（唇を噛んで、声を殺した）"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ふ、……ぅ」"
			ELSE
				RESULTS '= "「……っ、……く……っ」"
			ENDIF
		ENDIF
	;Ａ系
	CASE 5
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ぅ、……ん」"
			ELSE
				RESULTS '= "「……っ、……あ……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん、……」"
			ELSE
				RESULTS '= "「……っ、……はっ」"
			ENDIF
		ENDIF
	;特殊
	CASE 6
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ん。……もっと」"
			ELSE
				RESULTS '= "「……あ、……っ！」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "（わずかに口元を緩めた）"
			ELSE
				RESULTS '= "「……はぁ……っ」"
			ENDIF
		ENDIF
ENDSELECT


