;口上タイプ「甘え」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_甘え_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;甘え：べったり寄りかかる。誰かに傍にいてほしい。博多弁の「ねぇ」「いや」「離れんで」「〜と？」「〜けん」

@口上_妊娠_甘え_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今、お腹の……。……なんやろ」"
	CASE "妊娠発覚"
		RESULTS '= "「……え。……赤ちゃん……？　ねぇ……どげんしよう……一人じゃ、いやばい……」"
	CASE "陣痛開始"
		RESULTS '= "「痛……っ。……始まってしもうた……。ねぇ、傍におって……お願い……」"
	CASE "破水"
		RESULTS '= "「ひっ……い、いや、なんか出た……。ねぇ、怖か……離れんで……」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……痛か……痛かよぉ……。手、握っとって……」"
	CASE "移行期"
		RESULTS '= "「うぅ……っ！　いや、もう、いやぁ……出したか……っ」"
	CASE "娩出期"
		RESULTS '= "「来る……出てくる……。ねぇ、見とって……ちゃんと、見とって……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。ふー、ふー……」"
			CASE 1
				RESULTS '= "「痛……。……ねぇ、まだ大丈夫やろ……？」"
			CASE 2
				RESULTS '= "「ん……。……はぁ。抜けた……」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ、痛か……」"
			CASE 1
				RESULTS '= "「はぁ、はぁ……ねぇ、行かんで……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　いや、いやぁ……！」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ぐすっ……」"
			CASE 2
				RESULTS '= "「痛か痛か痛か……っ！　助けて……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちかっと……やろ……？」"
			CASE 2
				RESULTS '= "「うぐぅ……！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……？　いや……でも……んんんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……見とって……！　んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　いや……もう終わったと思うたとに……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな……無事……？　ねぇ、抱っこさせて……」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いとう。……ねぇ、この子、抱っこさせて……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ねぇ。……生理、来とらんと。……たぶん……%対称_あなた(番号)%の……」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……やっぱり、そうやった。……赤ちゃん、おる。……%対称_あなた(番号)%の……」"
		ELSE
			RESULTS '= @"「……ねぇ、聞いて。……赤ちゃん、できとった。……%対称_あなた(番号)%のばい……」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ほんと……？　……よかった……。ねぇ……ずっと、傍におってくれると……？」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……そっか。……うん。……でも、一人にせんでね……ね……？」"
	CASE "報告_突き放された"
		RESULTS '= "「……え……。……いや……そげんの……いやばい……」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「痛……っ。……始まってしもうた……。ねぇ、来て……傍におって……お願い……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくれたと……。……ねぇ、手……握っとって……離さんで……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て……。%対称_あなた(番号)%の子……。ねぇ……みんなで一緒に……おってくれると……？」"
		ELSE
			RESULTS '= @"「……見て……。%対称_あなた(番号)%の子ばい……。ねぇ……一緒に、おってくれると……？」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……いや。……いやばい……。ねぇ……おらんごとなってしもうた……？　いやぁ……」"
ENDSELECT
