;口上タイプ「甘え」の妊娠・出産の口上の東北弁（素質 方言_東北 が付いているとき、タイプ_甘え_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;甘え：べったり寄りかかる。誰かに傍にいてほしい。東北弁の「んだ」「〜だべ」「〜っちゃ」「〜ねぇ」「えらく」「めんこい」「〜さ」。一人称は「あたし」を「おら」に変える

@口上_妊娠_甘え_東北(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今、お腹が……。……なんだべ」"
	CASE "妊娠発覚"
		RESULTS '= "「……え。……赤ちゃん……？　ねぇ……どうすべ……一人じゃ、やんだべ……」"
	CASE "陣痛開始"
		RESULTS '= "「痛……っ。……始まっちゃった……。ねぇ、傍にいて……お願い……」"
	CASE "破水"
		RESULTS '= "「ひっ……や、やんだ、何か出た……。ねぇ、怖い……離れねで……」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……いでぇ……いでぇよぉ……。手、握ってて……」"
	CASE "移行期"
		RESULTS '= "「うぅ……っ！　やんだ、もう、やんだぁ……出したい……っ」"
	CASE "娩出期"
		RESULTS '= "「来る……出てくる……。ねぇ、見てて……ちゃんと、見てて……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。ふー、ふー……」"
			CASE 1
				RESULTS '= "「痛……。……ねぇ、まだだいじょぶだべね……？」"
			CASE 2
				RESULTS '= "「ん……。……はぁ。抜けた……」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ、いでぇ……」"
			CASE 1
				RESULTS '= "「はぁ、はぁ……ねぇ、行かねで……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　やんだ、やんだぁ……！」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ぐすっ……」"
			CASE 2
				RESULTS '= "「いでぇいでぇいでぇ……っ！　助けて……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちっと……だべね……？」"
			CASE 2
				RESULTS '= "「うぐぅ……！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……？　やんだ……んだども……んんんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……見てて……！　んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　やんだ……もう終わったと思ったのに……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな……無事……？　ねぇ、抱っこさせて……」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いてる。……ねぇ、この子、抱っこさせて……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= "「……ねぇ。……生理、来てねぇの。……たぶん……おめさんの……」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= "「……やっぱり、んだった。……赤ちゃん、いる。……おめさんの……」"
		ELSE
			RESULTS '= "「……ねぇ、聞いて。……赤ちゃん、できてた。……おめさんの、だべ……」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ほんと……？　……よかった……。ねぇ……ずっと、傍にいてける……？」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……んだが。……うん。……んだども、一人にしねで……ね……？」"
	CASE "報告_突き放された"
		RESULTS '= "「……え……。……やんだ……そったなの……やんだべ……」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「痛……っ。……始まっちゃった……。ねぇ、来て……傍にいて……お願い……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てけたんだ……。……ねぇ、手……握ってて……離さねで……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……見て……。おめさんの子……。ねぇ……みんなで一緒に……いてける……？」"
		ELSE
			RESULTS '= "「……見て……。おめさんの子だべ……。ねぇ……一緒に、いてける……？」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……やんだ。……やんだべ……。ねぇ……いなくなっちゃった……？　やんだぁ……」"
ENDSELECT
