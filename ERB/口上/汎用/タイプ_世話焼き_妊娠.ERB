;口上タイプ「世話焼き」の妊娠・出産の口上（素質 口上_世話焼き のキャラ）。書き方は タイプ_元気_妊娠.ERB と同じ
;世話焼き：面倒見がよく、痛い最中でも周りを気遣う。姉御肌。「大丈夫」「心配しないの」

@口上_妊娠_世話焼き(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥で何か……気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……そう。%対称_あんた(番号)%、来てくれたのね。……ちゃんと、育ててあげるから」"
	CASE "陣痛開始"
		RESULTS '= "「いた……っ。……ああ、始まったのね。慌てない、慌てない」"
	CASE "破水"
		RESULTS '= "「あら……破水ね。……大丈夫よ、心配しないの。こういうこともあるわ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……強くなってきた……。うん、順調ってことね」"
	CASE "移行期"
		RESULTS '= "「う、く……っ！　もう、いきみたくて……はぁ、はぁ、あともう少し……」"
	CASE "娩出期"
		RESULTS '= "「来た……！　いいわよ、お母さんがちゃんと出してあげるからね……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだ大丈夫」"
			CASE 1
				RESULTS '= "「いた……ふー、ふー……はい、抜けた」"
			CASE 2
				RESULTS '= "「ん……。心配しないで、これが普通なの」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ、……大丈夫、大丈夫……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ごめん、うるさいわね……」"
			CASE 2
				RESULTS '= "「痛い……っ！　……ふぅ、ふぅ……もう少し、よね……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……待っててね……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人ね……待たせてごめんね……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くわよ……おいで……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= @"「え……まだ……？　%対称_あんた(番号)%、そこにいたの……もう、言ってくれればいいのに……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな無事ね……。よしよし、お母さんはここよ」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。よく頑張ったわね……%対称_あんた(番号)%も、%自称_あたし(番号)%も。おいで」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと、%対称_あんた(番号)%。……生理が来てないのよ。……たぶん、%対称_あんた(番号)%の子」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。……妊娠してる。%対称_あんた(番号)%の子よ。……ちゃんと聞いてなさい」"
		ELSE
			RESULTS '= @"「……言っておくわね。%自称_あたし(番号)%、妊娠してるの。……%対称_あんた(番号)%の子よ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……何よ、そんな顔して。……ふふ。……ちゃんと育てるわよ、二人で」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……まあ、いいわ。急に言われたって困るわよね。……ゆっくり考えなさい」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう。……分かった。……いいわ、%自称_あたし(番号)%一人で育てる。%対称_あんた(番号)%には頼らない」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったみたい。……大丈夫、%自称_あたし(番号)%は大丈夫だから。……でも、来てくれるなら嬉しい」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たの。……はぁ……ほら、そこに座ってなさい。心配しなくていいから」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……ほら、見て。……%対称_あんた(番号)%の子たちよ。……ちゃんと抱いてあげて」"
		ELSE
			RESULTS '= @"「……ほら、見て。……%対称_あんた(番号)%の子よ。……ちゃんと抱いてあげて」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ごめんね。……守ってあげられなくて。……ごめんね……」"
ENDSELECT
