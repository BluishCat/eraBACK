;口上タイプ「奔放」の妊娠・出産の口上の広島弁（素質 方言_広島 が付いているとき、タイプ_奔放_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;奔放：物怖じせず、痛みも笑い飛ばそうとする。広島弁の「ほれ」「〜じゃけぇ」「〜とる」「ぶち」「ええ」「いけん」「〜ちゃる」。一人称は「あたし」を「うち」に変える

@口上_妊娠_奔放_広島(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今の、なんじゃろ。……ま、いっか」"
	CASE "妊娠発覚"
		RESULTS '= "「あー……やっぱりね。誰の子かなぁ、なんて。ふふ、上等じゃない」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……お、始まった？　ええよ、来んさいよ」"
	CASE "破水"
		RESULTS '= "「うわ、出た……ふふ、派手に破水しちゃった。もう戻れんわね」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……ちいと、本気出してきたじゃない……ん、ええわよ」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　ああもう、腰が……！　出す、出すけぇ……！」"
	CASE "娩出期"
		RESULTS '= @"「来た……！　ふふ……ええわ、%自称_うち(番号)%の全部、見せちゃる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだまだ」"
			CASE 1
				RESULTS '= "「いたた……ふふ、こんなもん？」"
			CASE 2
				RESULTS '= "「ん……はぁ。規則的になってきたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、く……っ！　はぁ……」"
			CASE 1
				RESULTS '= "「痛っ……ふふ、笑えんわね、これは……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、抜けた……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああぁっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「ぐぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛い痛い痛い……っ！　上等よ……！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょい……」"
			CASE 2
				RESULTS '= "「うぐっ……！　はぁ、はぁ……来い……っ」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「まだ終わらせんわよ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くわよ……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　あはは……仕込みすぎたかしら……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふふ、一気に賑やかになったじゃない……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。ふふ……元気に泣いとる。%自称_うち(番号)%の子ね」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「ねえ、ちいと。……生理、来とらんの。……ふふ、たぶん%対称_あんた(番号)%んよ？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。妊娠しとる。……%対称_あんた(番号)%の子。ふふ、どうする？」"
		ELSE
			RESULTS '= @"「言っとくわね。%自称_うち(番号)%、妊娠しとるの。……%対称_あんた(番号)%の子よ。責任、取れる？」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……あら。そんな顔するんじゃ。……ふふ、ええじゃない。気に入った」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「ふふ、固まっとる。……ええわよ、別に。%自称_うち(番号)%が勝手に産むだけだし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……へえ。そう来るんじゃ。……ええわ。%対称_あんた(番号)%の子じゃないことにしちゃる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「いたた……始まったわ。……来る？　%自称_うち(番号)%の一番ぶちすごいところ、見せちゃるけど」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たんね。……はぁ、はぁ……ふふ、目、逸らさんでよ」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見んさいよ。%対称_あんた(番号)%の子たち。……ふふ、責任重大じゃない？」"
		ELSE
			RESULTS '= @"「……見んさいよ。%対称_あんた(番号)%の子。……ふふ、似とるじゃない」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……はは。……そっか。……ごめんね、こんな母親で」"
ENDSELECT
