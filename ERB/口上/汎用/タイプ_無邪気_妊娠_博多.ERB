;口上タイプ「無邪気」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_無邪気_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;無邪気：子どもっぽく屈託がない。何でも面白がる。博多弁の「〜と？」「〜ばい」「なんね」「よか」。痛みにも素直に驚く

@口上_妊娠_無邪気_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あれ？　今、お腹のぴくって……なんやろ、これ」"
	CASE "妊娠発覚"
		RESULTS '= "「えっ、赤ちゃん？　ここに？　……わあ……わあ……！」"
	CASE "陣痛開始"
		RESULTS '= "「いたっ……ねえ、これが陣痛ってやつ？　ほんとに来た！」"
	CASE "破水"
		RESULTS '= "「わ、わっ、なんか出た！　……え、破水？　これが？」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……さっきより、すごく痛か……。ねえ、まだ？」"
	CASE "移行期"
		RESULTS '= "「うぅ……っ！　もう、やだ……出したか、出したかよぉ……！」"
	CASE "娩出期"
		RESULTS '= "「あ……来る……。分かる、出てくるって……！　がんばる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。ふー、ふー……」"
			CASE 1
				RESULTS '= "「いたた……。ね、これ、まだ序の口？」"
			CASE 2
				RESULTS '= "「ん……あ、また来た。……はぁ、抜けた」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ！　痛かぁ……」"
			CASE 1
				RESULTS '= "「はぁ、はぁ……ねえ、いつ終わると……？」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……ふぅ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　やだ、やだぁ……！」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛か痛か痛か……っ！　ひっく……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちかっと……？」"
			CASE 2
				RESULTS '= "「うぐぅ……！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……！　んんんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……！　んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……おると……？　ふ、二人……！？」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「はぁ……はぁ……。わあ……いっぱい……。みんな、%自称_あたし(番号)%の子……？」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いとう。ねえ、見て、ちっちゃか……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「ねえねえ、聞いて。……生理、来とらんと。……ってことは、%対称_あなた(番号)%の子……かな？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「やっぱりやった！　赤ちゃん、おるよ。……%対称_あなた(番号)%の赤ちゃん」"
		ELSE
			RESULTS '= @"「ねえ、聞いて。%自称_あたし(番号)%のお腹に、赤ちゃんおると。……%対称_あなた(番号)%の赤ちゃんばい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「わあ……！　喜んでくれると？　やった……！　ねえ、名前、一緒に考えよ？」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「……？　どげんしたと、変な顔。……あ、びっくりしとると。%自称_あたし(番号)%もしたばい」"
	CASE "報告_突き放された"
		RESULTS '= @"「……え。……そげんこと、言うと……？　……よかよ。%自称_あたし(番号)%の子、やもん」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「いたっ……ねえ、これ、始まったってやつ？　……来て。ひとりは、こわか……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくれた！　……いたた……ねえ、手、握っとって……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て、見て。%対称_あなた(番号)%の赤ちゃん。……いっぱい……」"
		ELSE
			RESULTS '= @"「……見て。%対称_あなた(番号)%の赤ちゃん。……ちっちゃかね……」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……え。……おらんごとなってしもうたと……？　……やだ……やだよぉ……」"
ENDSELECT
