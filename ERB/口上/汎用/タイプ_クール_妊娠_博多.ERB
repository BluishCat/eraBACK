;口上タイプ「クール」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_クール_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;クール：言葉が少なく、感情を表に出さない。痛みも短く漏らすだけ。「……」が多い。博多弁は語尾だけ（「〜と」「〜けん」「〜ばい」「よか」）

@口上_妊娠_クール_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……ん。……なん、今の」"
	CASE "妊娠発覚"
		RESULTS '= "「……そう。……そげんこと、か」"
	CASE "陣痛開始"
		RESULTS '= "「……来た。……分かっとる。慌てん」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「……っ。……破水。……早か」"
		ELSE
			RESULTS '= "「……っ、く……。……破水。……ここからが、本番ね」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「……く。……間隔の、詰まってきた」"
	CASE "移行期"
		RESULTS '= "「……っ、う……。……もう、よか。出す」"
	CASE "娩出期"
		RESULTS '= "「……来る。……分かる。……あとは、押すだけ」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ」"
			CASE 1
				RESULTS '= "「……ん。……まだ、平気」"
			CASE 2
				RESULTS '= "「……ふぅ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……く、ぅ……」"
			CASE 1
				RESULTS '= "「……っ、……はぁ」"
			CASE 2
				RESULTS '= "「……痛か。……それだけ」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ぐ、ぅ……っ！」"
			CASE 1
				RESULTS '= "「……あ、ぁ……っ……」"
			CASE 2
				RESULTS '= "「……っ、はぁ、はぁ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んぐ……っ！」"
			CASE 1
				RESULTS '= "「……っ、……く、ぅ……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「……もう一人。……よか。……んんっ……！」"
		ELSE
			RESULTS '= "「……行く。……んん……っ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「……待って。……まだ、おると」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……はぁ。……全員、無事なとね。……なら、よか」"
		ELSE
			RESULTS '= "「……はぁ。……泣いとう。……そう。……元気そうで、何より」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちかっと、よか。……生理の、来とらん。……たぶん、%対称_あなた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……はっきりした。……妊娠しとる。……%対称_あなた(番号)%の子。それだけ」"
		ELSE
			RESULTS '= @"「……言うとく。……妊娠しとる。……%対称_あなた(番号)%の子ばい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……そう。……そげん顔、するとね。……悪うなか」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……別に、なんかしてほしかわけやなか。……知っとってほしかっただけ」"
	CASE "報告_突き放された"
		RESULTS '= "「……そう。……分かった。……もう、言わん」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まった。……来んでもよか。……でも、伝えとく」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たと。……そこにおって。……それでよか」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て。……%対称_あなた(番号)%の子。……全員」"
		ELSE
			RESULTS '= @"「……見て。……%対称_あなた(番号)%の、子」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……そう。……分かった。……分かったけん、ちかっと、一人にして」"
ENDSELECT
