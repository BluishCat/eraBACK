;口上タイプ「クール」の妊娠・出産の口上の広島弁（素質 方言_広島 が付いているとき、タイプ_クール_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;クール：言葉が少なく、感情を表に出さない。痛みも短く漏らすだけ。「……」が多い。広島弁は語尾だけ（「〜じゃ」「〜とる」「〜ん」「ええ」「ほうか」「〜ど」）

@口上_妊娠_クール_広島(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……ん。……何、今の」"
	CASE "妊娠発覚"
		RESULTS '= "「……ほう。……そういうこと、か」"
	CASE "陣痛開始"
		RESULTS '= "「……来た。……分かっとる。慌てない」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「……っ。……破水。……早い」"
		ELSE
			RESULTS '= "「……っ、く……。……破水。……ここからが、本番ね」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「……く。……間隔が、詰まってきた」"
	CASE "移行期"
		RESULTS '= "「……っ、う……。……もう、ええ。出す」"
	CASE "娩出期"
		RESULTS '= "「……来る。……分かる。……あとは、押すだけ」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ」"
			CASE 1
				RESULTS '= "「……ん。……まだ、平気」"
			CASE 2
				RESULTS '= "「……ふぅ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……く、ぅ……」"
			CASE 1
				RESULTS '= "「……っ、……はぁ」"
			CASE 2
				RESULTS '= "「……痛い。……それだけ」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ぐ、ぅ……っ！」"
			CASE 1
				RESULTS '= "「……あ、ぁ……っ……」"
			CASE 2
				RESULTS '= "「……っ、はぁ、はぁ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んぐ……っ！」"
			CASE 1
				RESULTS '= "「……っ、……く、ぅ……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「……もう一人。……ええ。……んんっ……！」"
		ELSE
			RESULTS '= "「……行く。……んん……っ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「……待って。……まだ、おるの」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……はぁ。……全員、無事なんね。……なら、ええ」"
		ELSE
			RESULTS '= "「……はぁ。……泣いとる。……ほう。……元気そうで、何より」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちいと、ええ。……生理が、来とらん。……たぶん、%対称_あんた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……はっきりした。……妊娠しとる。……%対称_あんた(番号)%の子。それだけ」"
		ELSE
			RESULTS '= @"「……言っておく。……妊娠しとる。……%対称_あんた(番号)%の子よ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ほう。……そんな顔、するんね。……悪くない」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……別に、何かしてほしいわけじゃない。……知っておいてほしかっただけ」"
	CASE "報告_突き放された"
		RESULTS '= "「……ほう。……分かった。……もう、言わん」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まった。……来なくてもええ。……でも、伝えておく」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たの。……そこに居て。……それでええ」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て。……%対称_あんた(番号)%の子。……全員」"
		ELSE
			RESULTS '= @"「……見て。……%対称_あんた(番号)%の、子」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ほう。……分かった。……分かったけぇ、ちいと、一人にして」"
ENDSELECT
