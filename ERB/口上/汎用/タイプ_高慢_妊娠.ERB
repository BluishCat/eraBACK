;口上タイプ「高慢」の妊娠・出産の口上（素質 口上_高慢 のキャラ）。書き方は タイプ_元気_妊娠.ERB と同じ
;高慢：見下して命令する。痛みに屈するのを悔しがる。「私を誰だと」「……く」

@口上_妊娠_高慢(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……？　今の、何。……ふん、気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……ふん。……この%自称_私(番号)%が、母親ですって。……いいわ、望むところよ」"
	CASE "陣痛開始"
		RESULTS '= @"「……っ。始まったのね。……いいわ。%自称_私(番号)%を誰だと思っているの」"
	CASE "破水"
		RESULTS '= "「なっ……！　……破水ですって？　……こんな、みっともない……っ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強くなってきた……く……この程度で……」"
	CASE "移行期"
		RESULTS '= @"「ぐ、ぅ……っ！　……く、そ……こんな……%自称_私(番号)%が……っ」"
	CASE "娩出期"
		RESULTS '= @"「来る……。……いいわ。%自称_私(番号)%の子よ。堂々と、出てきなさい……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふん」"
			CASE 1
				RESULTS '= "「痛……。……この程度、何でもないわ」"
			CASE 2
				RESULTS '= "「く……。……ふぅ。抜けたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ！　……見るんじゃないわよ……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……悔しい……」"
			CASE 2
				RESULTS '= @"「痛い……っ！　……%自称_私(番号)%が、こんな……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もう少し、よ……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……来なさい……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……いいわ、出てきなさい……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……行くわよ。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　……聞いてないわよ、そんなこと……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「はぁ……はぁ……。ふん……全員、無事なのね。……当然よ。%自称_私(番号)%の子だもの」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いてる。……いい声じゃない。%自称_私(番号)%の子よ」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと。……生理が来ないの。……言うまでもないけど、%対称_あなた(番号)%のよ」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。妊娠してる。……%対称_あなた(番号)%の子よ。光栄に思いなさい」"
		ELSE
			RESULTS '= @"「……聞きなさい。%自称_私(番号)%、妊娠してるの。……%対称_あなた(番号)%の子よ。感謝しなさい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ふん。当然の反応ね。……でも、まあ。……悪くないわ、その顔」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「何よ、その顔。……いいわ。%自称_私(番号)%が産むと決めたんだから、%対称_あなた(番号)%は黙って見ていなさい」"
	CASE "報告_突き放された"
		RESULTS '= @"「……何ですって。……いいわ。%対称_あなた(番号)%なんかいなくても、%自称_私(番号)%が立派に育てる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったわ。……来なさい。%自称_私(番号)%の子が生まれるところを、見せてあげる」"
	CASE "立ち会いに来た"
		RESULTS '= "「……遅いわよ。……はぁ、はぁ……そこに居なさい。……離れないで」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見なさい。%対称_あなた(番号)%の子よ。……全員、無事。当然ね」"
		ELSE
			RESULTS '= @"「……見なさい。%対称_あなた(番号)%の子よ。……いい顔でしょう。%自称_私(番号)%の子だもの」"
		ENDIF
	CASE "流産"
		RESULTS '= @"「……何よ。……何よ、これ。……そんな……%自称_私(番号)%が……っ」"
ENDSELECT
