;妊娠の話（→妊娠.ERB @妊娠の話）。番号＝喋る NPC、相手＝妊婦
@口上_妊娠の話_元気_関西(番号, 局面, 相手)
#DIM 番号
#DIMS 局面
#DIM 相手

RESULTS '= ""
SELECTCASE 局面
	CASE "気づいた"
		RESULTS '= "「あれっ、お腹……。え、もしかして？　ほんまに？」"
	CASE "相手の腹"
		SELECTCASE 腹段階(相手)
			CASE 4
				RESULTS '= "「もう臨月やん！　いつ生まれてもおかしないんやろ？　ほら座って座って」"
			CASE 3
				RESULTS '= "「お腹、でっかなったなぁ。重ない？　……なあ、触ってええ？」"
			CASEELSE
				RESULTS '= "「お腹、目立ってきたやん。……無理せんときや？」"
		ENDSELECT
	CASE "自分の腹"
		SELECTCASE 腹段階(番号)
			CASE 4
				RESULTS '= "「もうすぐなんよなぁ。……あはは、ちょっとだけ、びびってる」"
			CASE 3
				RESULTS '= "「見てやこの腹！　でっかいやろ。……重いけど、蹴られるとさ、なんか笑ってまうねん」"
			CASEELSE
				RESULTS '= @"「見て、だいぶ出てきたやろ。……%自称_うち(番号)%、ほんまに母親になるんやなぁ」"
		ENDSELECT
ENDSELECT



