@口上_一言_元気_関西(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「あはは、飲みすぎたー……あれ、床が回ってる」"
	CASE "妊娠"
		RESULTS '= "「気づいた？　……あは、そういうこと。まあ、なんとかなるわ」"
	CASE "あなたの妊娠"
		RESULTS '= "「お腹、目立ってきたなぁ。……無理せんときや？」"
	CASE "不満"
		RESULTS '= "「うーん、いまいち……もっとなんかないん？」"
	CASE "恋"
		RESULTS '= @"「……%対称_あんた(番号)%が来ると、なんか元気出る。……なんでやろ」"
	CASE "友達"
		RESULTS '= "「お、来た来た！　今日も付き合ってや」"
	CASE "酔い"
		RESULTS '= "「あは、ええ感じに回ってきた。……もう一杯いっとく？」"
	CASE "満足"
		RESULTS '= "「ええ店やん！　また来るわ」"
