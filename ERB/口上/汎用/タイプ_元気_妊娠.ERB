;口上タイプ「元気」の妊娠・出産の口上（→設計メモ「口上のフック構造」「口上の窓口」）。
;素質 口上_元気 のキャラと、口上タイプの素質が無い（既定）キャラが使う。妊娠するのは母だけなので性別の段は無い。
;
;キャラ別に書くなら ERB/口上/<キャラ番号>_<名前>/ に同じ引数で @口上_妊娠_<キャラ番号>(番号, 局面) を書く。
;台詞を RESULTS に返す（空なら次の段へ。共通で空なら何も出ない）。番号は喋る母、局面は文字列：
;  着床（稀）／妊娠発覚／陣痛開始／破水／活動期／移行期／娩出期／波_本格化／波_活動期／波_移行期／波_娩出期／いきみ（児ごと）／多胎に気づく／出産直後／流産
;  あなたの子を妊娠した NPC だけ（→立ち会い.ERB。2026-09-21）：妊娠の報告（兆し）／妊娠の確信の報告（妊娠の報告済:番号:0 >= 1 なら兆しを告げてある）／
;  報告_喜ばれた／報告_戸惑われた／報告_突き放された／立ち会いの知らせ（陣痛が始まってあなたを呼ぶ）／立ち会いに来た（あなたが傍に来た）／出産直後_父へ（赤ん坊を抱いてあなたに）
;分岐に使える値：胎児数:番号:0、分娩済:番号:0（何人目か−1）、健診済:番号:0、出産回数:番号:0。一行、長くても二行まで
;元気：明るくて口数が多い。痛くても軽口を叩こうとする。「〜じゃん」「よーし」

@口上_妊娠_元気(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん？　今、お腹の奥がちくっと……気のせいかな」"
	CASE "妊娠発覚"
		RESULTS '= "「……えっ。えっ、うそ。まじで？　……ま、まあ、なるようになるか！」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……来た、来たよこれ。よーし、頑張ろうじゃん」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「わ、わっ、何これ……あ、破水ってやつ？　ちょっと、早くない？」"
		ELSE
			RESULTS '= "「うわっ、出た……！　破水じゃんこれ……いたた、痛いの増したし！」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……さっきより全然痛いんだけど……まだ序の口とか言わないでよ」"
	CASE "移行期"
		RESULTS '= "「う、ぐ……やば、腰が……割れる……！　もう、出したい……！」"
	CASE "娩出期"
		RESULTS '= "「来た……もう、出てくる……！　いいよ、こっちも本気出すから……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、はい、また来た。ふー、ふー……」"
			CASE 1
				RESULTS '= "「いたた……。ま、これくらいなら、まだ余裕、余裕」"
			CASE 2
				RESULTS '= "「ふぅー……。うん、だいぶ規則正しくなってきたじゃん」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「うっ……く、はぁ、はぁ……痛っ……」"
			CASE 1
				RESULTS '= "「……っ、ぐぅ……ちょ、これ、笑えないって……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……ふー……ふー……よし、抜けた」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　ぐ、う……」"
			CASE 1
				RESULTS '= "「痛い痛い痛い……！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「うぅ……っ！　……もう、勘弁してよぉ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんーーっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ、ふぅーっ……もうちょい、もうちょい……！」"
			CASE 2
				RESULTS '= "「うぐぅっ……！　……はぁ、来る、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……！　よーし、こいっ……んんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……！　せーの……んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え、ちょっと……まだ？　うそでしょ、もう一人いるの!?」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。やった……。全員、無事……？　……よかった、ほんとに」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……やった……。ねえ、聞こえる？　泣いてるよ……%自称_あたし(番号)%の子」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ねえ、ちょっといい？　生理、来てないんだ。……たぶん、%対称_あんた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「やっぱりだった。妊娠してる。……%対称_あんた(番号)%の子だよ。ちゃんと覚えといてね」"
		ELSE
			RESULTS '= @"「えーと……言うね。%自称_あたし(番号)%、妊娠してる。……%対称_あんた(番号)%の子、だよ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……えっ、喜んでくれるの？　……ふ、ふーん。……よーし、じゃあ、頑張るか！」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「まあ、そうなるよね。……いいよいいよ、%自称_あたし(番号)%もまだ整理できてないし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……あー、そう。……そっか。……分かった。もういい、%自称_あたし(番号)%が育てるから」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「いたた……来た、来たよ。……ねえ、来てくれる？　一人だとちょっとさ……」"
	CASE "立ち会いに来た"
		RESULTS '= @"「……来てくれたんだ。……はぁ、はぁ……よーし、%対称_あんた(番号)%が居るなら余裕、余裕」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て。%対称_あんた(番号)%の子だよ。……いっぱい居るじゃん。あはは……」"
		ELSE
			RESULTS '= @"「……見て。……%対称_あんた(番号)%の子だよ。……ちっちゃいね」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……なんで。……ねえ、なんでよ……。ごめん……ごめんね……」"
ENDSELECT
