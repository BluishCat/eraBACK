;口上タイプ「世話焼き」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_世話焼き_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;世話焼き：面倒見がよく、痛い最中でも周りを気遣う。関西弁の「大丈夫」「心配せんでええ」。一人称は「うち」

@口上_妊娠_世話焼き_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥で何か……気のせいやな」"
	CASE "妊娠発覚"
		RESULTS '= @"「……そう。%対称_あんた(番号)%、来てくれたんやな。……ちゃんと、育ててあげるから」"
	CASE "陣痛開始"
		RESULTS '= "「いた……っ。……ああ、始まったんやな。慌てん、慌てん」"
	CASE "破水"
		RESULTS '= "「あら……破水やな。……大丈夫や、心配せんでええ。こういうこともあるわ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……強うなってきた……。うん、順調ってことやな」"
	CASE "移行期"
		RESULTS '= "「う、く……っ！　もう、いきみとうて……はぁ、はぁ、あともうちょい……」"
	CASE "娩出期"
		RESULTS '= "「来た……！　ええで、お母さんがちゃんと出したるからな……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだ大丈夫」"
			CASE 1
				RESULTS '= "「いた……ふー、ふー……はい、抜けた」"
			CASE 2
				RESULTS '= "「ん……。心配せんといて、これが普通なんよ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ、……大丈夫、大丈夫……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ごめん、うるさいなぁ……」"
			CASE 2
				RESULTS '= "「痛い……っ！　……ふぅ、ふぅ……もうちょいやんな……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……待っててな……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人やな……待たせてごめんな……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くで……おいで……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= @"「え……まだ……？　%対称_あんた(番号)%、そこにおったん……もう、言うてくれたらええのに……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな無事やな……。よしよし、お母さんはここやで」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。よぉ頑張ったなぁ……%対称_あんた(番号)%も、%自称_うち(番号)%も。おいで」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと、%対称_あんた(番号)%。……生理が来てへんのよ。……たぶん、%対称_あんた(番号)%の子」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。……妊娠してる。%対称_あんた(番号)%の子やで。……ちゃんと聞いときや」"
		ELSE
			RESULTS '= @"「……言うとくな。%自称_うち(番号)%、妊娠してるんよ。……%対称_あんた(番号)%の子や」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……何や、そんな顔して。……ふふ。……ちゃんと育てるで、二人で」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……まあ、ええわ。急に言われたって困るわな。……ゆっくり考え」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう。……分かった。……ええわ、%自称_うち(番号)%一人で育てる。%対称_あんた(番号)%には頼らへん」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったみたい。……大丈夫、%自称_うち(番号)%は大丈夫やから。……でも、来てくれるなら嬉しい」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たんか。……はぁ……ほれ、そこに座っとき。心配せんでええから」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……ほれ、見て。……%対称_あんた(番号)%の子らやで。……ちゃんと抱いたって」"
		ELSE
			RESULTS '= @"「……ほれ、見て。……%対称_あんた(番号)%の子やで。……ちゃんと抱いたって」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ごめんな。……守ってあげられへんかって。……ごめんな……」"
ENDSELECT
