;口上タイプ「甘え」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_甘え_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;甘え：べったり寄りかかる。誰かに傍にいてほしい。関西弁の「なぁ」「いやや」「離れんといて」

@口上_妊娠_甘え_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今、お腹が……。……なんやろ」"
	CASE "妊娠発覚"
		RESULTS '= "「……え。……赤ちゃん……？　なぁ……どないしよ……一人やと、いやや……」"
	CASE "陣痛開始"
		RESULTS '= "「痛……っ。……始まってもた……。なぁ、傍におって……お願い……」"
	CASE "破水"
		RESULTS '= "「ひっ……い、いやや、なんか出た……。なぁ、怖い……離れんといて……」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……痛い……痛いよぉ……。手ぇ、握っといて……」"
	CASE "移行期"
		RESULTS '= "「うぅ……っ！　いやや、もう、いややぁ……出したい……っ」"
	CASE "娩出期"
		RESULTS '= "「来る……出てくる……。なぁ、見ててぇ……ちゃんと、見ててぇ……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。ふー、ふー……」"
			CASE 1
				RESULTS '= "「痛……。……なぁ、まだ大丈夫やんな……？」"
			CASE 2
				RESULTS '= "「ん……。……はぁ。抜けた……」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ、痛い……」"
			CASE 1
				RESULTS '= "「はぁ、はぁ……なぁ、行かんといて……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　いやや、いややぁ……！」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ぐすっ……」"
			CASE 2
				RESULTS '= "「痛い痛い痛い……っ！　助けてぇ……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょっと……やんな……？」"
			CASE 2
				RESULTS '= "「うぐぅ……！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……？　いやや……でも……んんんんーーっ！」"
		ELSE
			RESULTS '= "「いくで……見ててぇ……！　んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　いやや……もう終わった思たのに……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな……無事……？　なぁ、抱っこさせてぇ……」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いてる。……なぁ、この子、抱っこさせてぇ……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……なぁ。……生理、来てへんの。……たぶん……%対称_あんた(番号)%の……」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……やっぱり、そうやった。……赤ちゃん、おる。……%対称_あんた(番号)%の……」"
		ELSE
			RESULTS '= @"「……なぁ、聞いてぇ。……赤ちゃん、できてた。……%対称_あんた(番号)%の、やで……」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ほんま……？　……よかった……。なぁ……ずっと、傍におってくれる……？」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……そっか。……うん。……でも、一人にせんといて……な……？」"
	CASE "報告_突き放された"
		RESULTS '= "「……え……。……いやや……そんなん……いややぁ……」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「痛……っ。……始まってもた……。なぁ、来てぇ……傍におって……お願い……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくれたんや……。……なぁ、手ぇ……握っといて……離さんといて……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て……。%対称_あんた(番号)%の子……。なぁ……みんなで一緒に……おってくれる……？」"
		ELSE
			RESULTS '= @"「……見て……。%対称_あんた(番号)%の子やで……。なぁ……一緒に、おってくれる……？」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……いやや。……いややぁ……。なぁ……おらんようなってもた……？　いややぁ……」"
ENDSELECT
