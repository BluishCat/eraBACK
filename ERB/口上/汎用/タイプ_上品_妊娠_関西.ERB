;口上タイプ「上品」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_上品_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;上品：丁寧語が崩れない。痛くても言葉遣いだけは保とうとする。京ことば寄りの「〜どす」「〜え」「あきまへん」。一人称は「うち」

@口上_妊娠_上品_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥が……。……気のせいどすなぁ」"
	CASE "妊娠発覚"
		RESULTS '= @"「……まあ。……そう、どすか。……%自称_うち(番号)%が、母に」"
	CASE "陣痛開始"
		RESULTS '= "「……っ。……始まりましたんやなぁ。……落ち着いて、落ち着いて」"
	CASE "破水"
		RESULTS '= "「きゃ……っ。……こ、これは……破水、どすなぁ。……なんて、はしたない」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強うなってきましたえ……。……ええ、大丈夫」"
	CASE "移行期"
		RESULTS '= "「く、ぅ……っ！　もう……堪えられまへん……っ」"
	CASE "娩出期"
		RESULTS '= "「来ますえ……。……ええ、分かってます。……最後まで、ちゃんと」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふぅ」"
			CASE 1
				RESULTS '= "「痛……。……まだ、平気どす」"
			CASE 2
				RESULTS '= "「ん……。規則的になってきましたなぁ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛い……どす……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　……失礼、しました……」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛……っ、痛うおす……っ！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょっと……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……ええ、参りますえ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……参ります。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　……まあ。……そんな、聞いてまへん……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな、無事……なんどすなぁ。……よかった……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いてはりますえ。……%自称_うち(番号)%の、子……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……あの、ちょっとお時間を。……月のものが、来ておらしまへんのどす。……おそらく、%対称_あんた(番号)%はんの」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……はっきりしましたえ。……%自称_うち(番号)%、妊娠しております。%対称_あんた(番号)%はんのお子を」"
		ELSE
			RESULTS '= @"「……お伝えせななりまへん。……%自称_うち(番号)%、%対称_あんた(番号)%はんのお子を授かっております」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……まあ。……そないに言うてもらえるなんて。……おおきに、ありがとうございます」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……ええ。無理にとは言いまへん。……ただ、知っといてもらいたかったんどす」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう、どすか。……失礼いたしました。……この子は、%自称_うち(番号)%が育てますえ」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まりましたんどす。……もし、お手が空いておりましたら……いえ、無理は言いまへん」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくれはったんどすなぁ。……お恥ずかしい姿で、堪忍え」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見とくれやす。……みんな、%対称_あんた(番号)%はんのお子どすえ」"
		ELSE
			RESULTS '= @"「……見とくれやす。……%対称_あんた(番号)%はんのお子、どすえ」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……そう、どすか。……申し訳、ありまへん……。……堪忍え……」"
ENDSELECT
