;口上タイプ「元気」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_元気_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;元気：明るくて口数が多い。痛くても軽口を叩こうとする。博多弁の「〜ばい」「〜と？」「〜けん」「よーし」

@口上_妊娠_元気_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん？　今、お腹の奥がちくっと……気のせいかな」"
	CASE "妊娠発覚"
		RESULTS '= "「……えっ。えっ、うそ。ほんなこつ？　……ま、まあ、なるようになるっちゃ！」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……来た、来たばい、これ。よーし、頑張ろうやん」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「わ、わっ、なんこれ……あ、破水ってやつ？　ちかっと、早うなか？」"
		ELSE
			RESULTS '= "「うわっ、出た……！　破水やんこれ……いたた、痛かのが増したばい！」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……さっきより全然痛かっちゃけど……まだ序の口とか言わんでよ」"
	CASE "移行期"
		RESULTS '= "「う、ぐ……やばか、腰が……割れる……！　もう、出したか……！」"
	CASE "娩出期"
		RESULTS '= "「来た……もう、出てくる……！　よかよ、こっちも本気出すけん……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、はい、また来た。ふー、ふー……」"
			CASE 1
				RESULTS '= "「いたた……。ま、これくらいなら、まだ余裕、余裕」"
			CASE 2
				RESULTS '= "「ふぅー……。うん、だいぶ規則正しゅうなってきたやん」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「うっ……く、はぁ、はぁ……痛っ……」"
			CASE 1
				RESULTS '= "「……っ、ぐぅ……ちょ、これ、笑えんちゃ……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……ふー……ふー……よし、抜けた」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　ぐ、う……」"
			CASE 1
				RESULTS '= "「痛か痛か痛か……！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「うぅ……っ！　……もう、勘弁してよぉ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんーーっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ、ふぅーっ……もうちかっと、もうちかっと……！」"
			CASE 2
				RESULTS '= "「うぐぅっ……！　……はぁ、来る、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……！　よーし、こいっ……んんんーーっ！」"
		ELSE
			RESULTS '= "「いくばい……！　せーの……んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え、ちょっと……まだ？　うそやろ、もう一人おると!?」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。やった……。全員、無事……？　……よかった、ほんなこつ」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……やった……。ねえ、聞こえる？　泣いとうよ……%自称_あたし(番号)%の子」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ねえ、ちかっとよか？　生理、来とらんと。……たぶん、%対称_あんた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「やっぱりやった。妊娠しとう。……%対称_あんた(番号)%の子ばい。ちゃんと覚えときよ」"
		ELSE
			RESULTS '= @"「えーと……言うばい。%自称_あたし(番号)%、妊娠しとう。……%対称_あんた(番号)%の子、たい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……えっ、喜んでくれると？　……ふ、ふーん。……よーし、ほんなら、頑張るばい！」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「まあ、そうなるよね。……よかよか、%自称_あたし(番号)%もまだ整理できとらんし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……あー、そう。……そっか。……分かった。もうよか、%自称_あたし(番号)%が育てるけん」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「いたた……来た、来たばい。……ねえ、来てくれる？　一人やとちかっとさ……」"
	CASE "立ち会いに来た"
		RESULTS '= @"「……来てくれたとね。……はぁ、はぁ……よーし、%対称_あんた(番号)%がおるなら余裕、余裕」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て。%対称_あんた(番号)%の子ばい。……いっぱいおるやん。あはは……」"
		ELSE
			RESULTS '= @"「……見て。……%対称_あんた(番号)%の子ばい。……ちっちゃかね」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……なんで。……ねえ、なんでよ……。ごめん……ごめんね……」"
ENDSELECT
