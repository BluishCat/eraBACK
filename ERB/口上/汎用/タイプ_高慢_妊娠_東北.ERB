;口上タイプ「高慢」の妊娠・出産の口上の東北弁（素質 方言_東北 が付いているとき、タイプ_高慢_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;高慢：見下して命令する。痛みに屈するのを悔しがる。東北弁の「〜しなせ」「〜だべ」「んだ」「おめさん」「〜ねぇ」「〜してけろ」「ほれ」

@口上_妊娠_高慢_東北(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……？　今の、何。……ふん、気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= "「……ふん。……このわだしが、母親ですって。……いいわ、望むところよ」"
	CASE "陣痛開始"
		RESULTS '= "「……っ。始まったのね。……いいわ。わだしを誰だと思っているの」"
	CASE "破水"
		RESULTS '= "「なっ……！　……破水ですって？　……こったな、みっともねぇ……っ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強くなってきた……く……この程度で……」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　……く、そ……こったな……わだしが……っ」"
	CASE "娩出期"
		RESULTS '= "「来る……。……いいわ。わだしの子よ。堂々と、出てきなせ……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふん」"
			CASE 1
				RESULTS '= "「痛……。……この程度、何でもねぇわ」"
			CASE 2
				RESULTS '= "「く……。……ふぅ。抜けたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ！　……見るんでねぇわよ……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……悔しい……」"
			CASE 2
				RESULTS '= "「いでぇ……っ！　……わだしが、こったな……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちっと、よ……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……来なせ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……いいわ、出てきなせ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……行くわよ。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　……聞いてねぇわよ、そったなこと……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふん……全員、無事なのね。……当然よ。わだしの子だもの」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いてる。……いい声でねぇ。わだしの子よ」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= "「……ちっと。……生理が来ねぇの。……言うまでもねぇけんど、おめさんのよ」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= "「はっきりしたわ。妊娠してる。……おめさんの子よ。光栄に思いなせ」"
		ELSE
			RESULTS '= "「……聞きなせ。わだし、妊娠してるの。……おめさんの子よ。感謝しなせ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ふん。当然の反応ね。……んだども、まあ。……悪くねぇわ、その顔」"
	CASE "報告_戸惑われた"
		RESULTS '= "「何よ、その顔。……いいわ。わだしが産むと決めたんだがら、おめさんは黙って見ていなせ」"
	CASE "報告_突き放された"
		RESULTS '= "「……何ですって。……いいわ。おめさんなんかいなくても、わだしが立派に育てる」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まったわ。……来なせ。わだしの子が生まれるところを、見せてやる」"
	CASE "立ち会いに来た"
		RESULTS '= "「……遅いわよ。……はぁ、はぁ……そこさ居なせ。……離れねで」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……見なせ。おめさんの子よ。……全員、無事。当然ね」"
		ELSE
			RESULTS '= "「……見なせ。おめさんの子よ。……いい顔だべ。わだしの子だもの」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……何よ。……何よ、これ。……そったな……わだしが……っ」"
ENDSELECT
