;口上タイプ「甘え」の妊娠・出産の口上（素質 口上_甘え のキャラ）。書き方は タイプ_元気_妊娠.ERB と同じ
;甘え：べったり寄りかかる。誰かに傍にいてほしい。「ねぇ」「やだ」「離れないで」

@口上_妊娠_甘え(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今、お腹が……。……なんだろ」"
	CASE "妊娠発覚"
		RESULTS '= "「……え。……赤ちゃん……？　ねぇ……どうしよう……一人じゃ、やだよ……」"
	CASE "陣痛開始"
		RESULTS '= "「痛……っ。……始まっちゃった……。ねぇ、傍にいて……お願い……」"
	CASE "破水"
		RESULTS '= "「ひっ……や、やだ、何か出た……。ねぇ、怖い……離れないで……」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……痛い……痛いよぉ……。手、握ってて……」"
	CASE "移行期"
		RESULTS '= "「うぅ……っ！　やだ、もう、やだぁ……出したい……っ」"
	CASE "娩出期"
		RESULTS '= "「来る……出てくる……。ねぇ、見てて……ちゃんと、見てて……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。ふー、ふー……」"
			CASE 1
				RESULTS '= "「痛……。……ねぇ、まだ大丈夫だよね……？」"
			CASE 2
				RESULTS '= "「ん……。……はぁ。抜けた……」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ、痛い……」"
			CASE 1
				RESULTS '= "「はぁ、はぁ……ねぇ、行かないで……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　やだ、やだぁ……！」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ぐすっ……」"
			CASE 2
				RESULTS '= "「痛い痛い痛い……っ！　助けて……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もう少し……だよね……？」"
			CASE 2
				RESULTS '= "「うぐぅ……！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……？　やだ……でも……んんんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……見てて……！　んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　やだ……もう終わったと思ったのに……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな……無事……？　ねぇ、抱っこさせて……」"
		ELSE
			RESULTS '= "「はぁ……はぁ……。……泣いてる。……ねぇ、この子、抱っこさせて……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ねぇ。……生理、来てないの。……たぶん……%対称_あなた(番号)%の……」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……やっぱり、そうだった。……赤ちゃん、いる。……%対称_あなた(番号)%の……」"
		ELSE
			RESULTS '= @"「……ねぇ、聞いて。……赤ちゃん、できてた。……%対称_あなた(番号)%の、だよ……」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ほんと……？　……よかった……。ねぇ……ずっと、傍にいてくれる……？」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……そっか。……うん。……でも、一人にしないで……ね……？」"
	CASE "報告_突き放された"
		RESULTS '= "「……え……。……やだ……そんなの……やだよ……」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「痛……っ。……始まっちゃった……。ねぇ、来て……傍にいて……お願い……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくれたんだ……。……ねぇ、手……握ってて……離さないで……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て……。%対称_あなた(番号)%の子……。ねぇ……みんなで一緒に……いてくれる……？」"
		ELSE
			RESULTS '= @"「……見て……。%対称_あなた(番号)%の子だよ……。ねぇ……一緒に、いてくれる……？」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……やだ。……やだよ……。ねぇ……いなくなっちゃった……？　やだぁ……」"
ENDSELECT
