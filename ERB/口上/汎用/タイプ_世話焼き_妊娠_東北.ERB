;口上タイプ「世話焼き」の妊娠・出産の口上の東北弁（素質 方言_東北 が付いているとき、タイプ_世話焼き_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;世話焼き：面倒見がよく、痛い最中でも周りを気遣う。姉御肌。東北弁の「〜しなせ」「〜してけろ」「〜だべ」「んだ」「〜ねぇ」「〜がら」「大丈夫＝だいじょぶ」。一人称は「あたし」を「おら」に変える

@口上_妊娠_世話焼き_東北(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥で何か……気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= "「……んだ。おめ、来てけたのね。……ちゃんと、育ててやるがら」"
	CASE "陣痛開始"
		RESULTS '= "「いた……っ。……ああ、始まったのね。慌てねぇ、慌てねぇ」"
	CASE "破水"
		RESULTS '= "「あら……破水ね。……だいじょぶよ、心配しねぇの。こういうこともあるわ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……強くなってきた……。うん、順調ってことね」"
	CASE "移行期"
		RESULTS '= "「う、く……っ！　もう、いきみたくて……はぁ、はぁ、あともうちっと……」"
	CASE "娩出期"
		RESULTS '= "「来た……！　いいわよ、お母さんがちゃんと出してやるがらね……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだだいじょぶ」"
			CASE 1
				RESULTS '= "「いた……ふー、ふー……はい、抜けた」"
			CASE 2
				RESULTS '= "「ん……。心配しねで、これが普通なの」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ、……だいじょぶ、だいじょぶ……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ごめん、うるせぇわね……」"
			CASE 2
				RESULTS '= "「いでぇ……っ！　……ふぅ、ふぅ……もうちっと、よね……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……待っててね……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人ね……待たせてごめんね……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くわよ……おいで……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……まだ……？　おめ、そこさいたの……もう、言ってくれればいいのに……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな無事ね……。よしよし、お母さんはここよ」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。よく頑張ったわね……おめも、%自称_おら(番号)%も。おいで」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= "「……ちっと、おめ。……生理が来てねぇのよ。……たぶん、おめの子」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= "「はっきりしたわ。……妊娠してる。おめの子よ。……ちゃんと聞いてなせ」"
		ELSE
			RESULTS '= @"「……言っておくわね。%自称_おら(番号)%、妊娠してるの。……おめの子よ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……何よ、そったな顔して。……ふふ。……ちゃんと育てるわよ、二人で」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……まあ、いいわ。急に言われたって困るわよね。……ゆっくり考えなせ」"
	CASE "報告_突き放された"
		RESULTS '= @"「……んだ。……分かった。……いいわ、%自称_おら(番号)%一人で育てる。おめには頼らねぇ」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったみたい。……だいじょぶ、%自称_おら(番号)%はだいじょぶだがら。……んだども、来てけるなら嬉しい」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たの。……はぁ……ほれ、そこさ座ってなせ。心配しなくていいがら」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……ほれ、見て。……おめの子たちよ。……ちゃんと抱いてあげて」"
		ELSE
			RESULTS '= "「……ほれ、見て。……おめの子よ。……ちゃんと抱いてあげて」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ごめんね。……守ってあげられなくて。……ごめんね……」"
ENDSELECT
