;口上タイプ「上品」の妊娠・出産の口上（素質 口上_上品 のキャラ）。書き方は タイプ_元気_妊娠.ERB と同じ
;上品：丁寧語が崩れない。お嬢様。痛くても言葉遣いだけは保とうとする。「……ですわ」

@口上_妊娠_上品(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥が……。……気のせいですわね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……まあ。……そう、ですの。……%自称_わたくし(番号)%が、母に」"
	CASE "陣痛開始"
		RESULTS '= "「……っ。……始まりましたのね。……落ち着いて、落ち着いて」"
	CASE "破水"
		RESULTS '= "「きゃ……っ。……こ、これは……破水、ですわね。……なんて、はしたない」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強く、なってきましたわ……。……ええ、大丈夫」"
	CASE "移行期"
		RESULTS '= "「く、ぅ……っ！　もう……堪えられませんわ……っ」"
	CASE "娩出期"
		RESULTS '= "「来ますわ……。……ええ、分かっています。……最後まで、ちゃんと」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふぅ」"
			CASE 1
				RESULTS '= "「痛……。……まだ、平気ですわ」"
			CASE 2
				RESULTS '= "「ん……。規則的に、なってきましたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛い……ですわ……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　……失礼、しましたわ……」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛……っ、痛いですわ……っ！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もう少し……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……ええ、参りますわ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……参ります。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　……まあ。……そんな、聞いておりませんわ……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。皆、無事……なのですね。……よかった……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いていますわ。……%自称_わたくし(番号)%の、子……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……あの、少しお時間を。……月のものが、来ておりませんの。……おそらく、%対称_あなた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……はっきりいたしましたわ。……%自称_わたくし(番号)%、妊娠しております。%対称_あなた(番号)%のお子を」"
		ELSE
			RESULTS '= @"「……お伝えしなければなりませんわ。……%自称_わたくし(番号)%、%対称_あなた(番号)%のお子を授かっております」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……まあ。……そのように言っていただけるなんて。……ありがとう、ございます」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……ええ。無理にとは申しません。……ただ、知っていていただきたかったのです」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう、ですの。……失礼いたしました。……この子は、%自称_わたくし(番号)%が育てますわ」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まりましたの。……もし、お手が空いていましたら……いえ、無理は申しません」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくださったのですね。……お恥ずかしい姿で、ごめんなさい」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……ご覧になって。……皆、%対称_あなた(番号)%のお子ですわ」"
		ELSE
			RESULTS '= @"「……ご覧になって。……%対称_あなた(番号)%のお子、ですわ」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……そう、ですの。……申し訳、ありません……。……ごめんなさい……」"
ENDSELECT
