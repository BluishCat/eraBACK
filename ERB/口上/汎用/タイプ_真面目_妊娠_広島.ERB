;口上タイプ「真面目」の妊娠・出産の口上の広島弁（素質 方言_広島 が付いているとき、タイプ_真面目_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;真面目：堅くて責任感が強い。敬語は崩さない。取り乱すことを恥じる。「……いけません」「すみません」。広島弁は丁寧語に溶かす（「〜ですけぇ」「〜とります」「〜てつかぁさい」「〜んのです」「いけんのに」）

@口上_妊娠_真面目_広島(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……？　今、お腹の奥で……。……いえ、気のせいでしょう」"
	CASE "妊娠発覚"
		RESULTS '= "「……ほうですか。……ええ。……責任は、持ちます。ちゃんと」"
	CASE "陣痛開始"
		RESULTS '= "「……っ。……始まりましたね。……手順どおりに。落ち着いて」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「……っ、これは……破水……。……予定より早い。……でも、慌てません」"
		ELSE
			RESULTS '= "「……っ、う……。破水、ですね。……順番どおりです。……次は、いよいよ」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強うなってきました……。……ええ、これが正常です」"
	CASE "移行期"
		RESULTS '= "「く、ぅ……っ！　……すみません、もう……堪えられ……っ」"
	CASE "娩出期"
		RESULTS '= "「来ます……。……はい。……最後まで、やり遂げます」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふぅ」"
			CASE 1
				RESULTS '= "「痛……。……まだ、大丈夫です」"
			CASE 2
				RESULTS '= "「ん……。間隔が、揃ってきましたね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ。……すみません、声が……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　……く……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛い……っ！　……すみません……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちいと……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……はい、分かりました……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……行きます。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　まだ……？　……そんな。……確認して、おくべきでした……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。全員、無事……ですね。……よかった……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いとりますね。……%自称_私(番号)%の、子……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちいと、お話があります。……生理が、来ていません。……おそらく、%対称_あなた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしました。妊娠しとります。……%対称_あなた(番号)%の子です。ご報告まで」"
		ELSE
			RESULTS '= @"「……お伝えしておきます。%自称_私(番号)%は妊娠しとります。……%対称_あなた(番号)%の子です」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……そう言っていただけると……。ありがとうございます。……きちんと、育てます」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……ええ。急なことですけぇ。……どうするかは、追って相談させてつかぁさい」"
	CASE "報告_突き放された"
		RESULTS '= @"「……ほうですか。……分かりました。……責任は、%自称_私(番号)%が持ちます。もう結構です」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……始まりました。……ご報告だけ。……来ていただけるなら、心強いです」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てくださったのですね。……はぁ、はぁ……取り乱さんよう、努めます」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見てつかぁさい。……%対称_あなた(番号)%の子です。全員、無事に」"
		ELSE
			RESULTS '= @"「……見てつかぁさい。……%対称_あなた(番号)%の子です。……無事に、産めました」"
		ENDIF
	CASE "流産"
		RESULTS '= @"「……%自称_私(番号)%の、せいです。……ちゃんと、守れなくて。……すみません……」"
ENDSELECT
