;口上タイプ「奔放」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_奔放_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;奔放：物怖じせず、痛みも笑い飛ばそうとする。博多弁の「ほら」「上等」「〜ばい」「〜と？」

@口上_妊娠_奔放_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今の、なんやろ。……ま、よかたい」"
	CASE "妊娠発覚"
		RESULTS '= "「あー……やっぱりね。誰の子かなぁ、なんて。ふふ、上等たい」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……お、始まったと？　よかよ、来んしゃい」"
	CASE "破水"
		RESULTS '= "「うわ、出た……ふふ、派手に破水してしもうた。もう戻れんね」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……ちかっと、本気出してきたやん……ん、よかよ」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　ああもう、腰が……！　出す、出すけん……！」"
	CASE "娩出期"
		RESULTS '= @"「来た……！　ふふ……よか、%自称_あたし(番号)%の全部、見せてあげる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだまだ」"
			CASE 1
				RESULTS '= "「いたた……ふふ、こげんもん？」"
			CASE 2
				RESULTS '= "「ん……はぁ。規則的になってきたね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、く……っ！　はぁ……」"
			CASE 1
				RESULTS '= "「痛っ……ふふ、笑えんね、これは……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、抜けた……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああぁっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「ぐぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛か痛か痛か……っ！　上等ばい……！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちかっと……」"
			CASE 2
				RESULTS '= "「うぐっ……！　はぁ、はぁ……来んしゃい……っ」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「まだ終わらせんばい……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くばい……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　あはは……仕込みすぎたかいな……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふふ、一気に賑やかになったやん……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。ふふ……元気に泣いとう。%自称_あたし(番号)%の子ね」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「ねえ、ちかっと。……生理、来とらんと。……ふふ、たぶん%対称_あんた(番号)%のばい？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたばい。妊娠しとう。……%対称_あんた(番号)%の子。ふふ、どげんすると？」"
		ELSE
			RESULTS '= @"「言うとくね。%自称_あたし(番号)%、妊娠しとうと。……%対称_あんた(番号)%の子ばい。責任、取れると？」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……あら。そげん顔するとね。……ふふ、よかやん。気に入った」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「ふふ、固まっとう。……よかよ、別に。%自称_あたし(番号)%が勝手に産むだけやし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……へえ。そう来るとね。……よか。%対称_あんた(番号)%の子やなかことにしてあげる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「いたた……始まったばい。……来る？　%自称_あたし(番号)%の一番すごかとこ、見せてあげるけど」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たとね。……はぁ、はぁ……ふふ、目、逸らさんでよ」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見なっせ。%対称_あんた(番号)%の子たち。……ふふ、責任重大やなかと？」"
		ELSE
			RESULTS '= @"「……見なっせ。%対称_あんた(番号)%の子。……ふふ、似とうやん」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……はは。……そっか。……ごめんね、こげん母親で」"
ENDSELECT
