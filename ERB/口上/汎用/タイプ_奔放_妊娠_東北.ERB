;口上タイプ「奔放」の妊娠・出産の口上の東北弁（素質 方言_東北 が付いているとき、タイプ_奔放_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;奔放：物怖じせず、痛みも笑い飛ばそうとする。東北弁の「んだ」「〜だべ」「〜すべ」「〜ねぇ」「えらく」「めんこい」「ほれ」「〜さ」。一人称は「あたし」を「おら」に変える

@口上_妊娠_奔放_東北(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今の、なんだべ。……ま、いっか」"
	CASE "妊娠発覚"
		RESULTS '= "「あー……やっぱりね。誰の子かなぁ、なんて。ふふ、上等でねぇ」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……お、始まった？　いいべ、来なせよ」"
	CASE "破水"
		RESULTS '= "「うわ、出た……ふふ、派手に破水しちゃった。もう戻れねぇわね」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……ちっと、本気出してきたでねぇが……ん、いいわよ」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　ああもう、腰が……！　出す、出すがら……！」"
	CASE "娩出期"
		RESULTS '= @"「来た……！　ふふ……いいわ、%自称_おら(番号)%の全部、見せてやる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだまだ」"
			CASE 1
				RESULTS '= "「いたた……ふふ、こったなもん？」"
			CASE 2
				RESULTS '= "「ん……はぁ。規則的になってきたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、く……っ！　はぁ……」"
			CASE 1
				RESULTS '= "「痛っ……ふふ、笑えねぇわね、これは……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、抜けた……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああぁっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「ぐぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「いでぇいでぇいでぇ……っ！　上等よ……！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょい……」"
			CASE 2
				RESULTS '= "「うぐっ……！　はぁ、はぁ……来い……っ」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「まだ終わらせねぇわよ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くわよ……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　あはは……仕込みすぎたかしら……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふふ、一気に賑やかになったでねぇが……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。ふふ……元気に泣いてる。%自称_おら(番号)%の子ね」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= "「ねえ、ちっと。……生理、来てねぇの。……ふふ、たぶんおめのよ？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= "「はっきりしたわ。妊娠してる。……おめの子。ふふ、どうする？」"
		ELSE
			RESULTS '= @"「言っとくわね。%自称_おら(番号)%、妊娠してるの。……おめの子よ。責任、取れる？」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……あら。そったな顔するんだ。……ふふ、いいでねぇが。気に入った」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「ふふ、固まってる。……いいわよ、別に。%自称_おら(番号)%が勝手に産むだけだし」"
	CASE "報告_突き放された"
		RESULTS '= "「……へえ。そう来るんだ。……いいわ。おめの子でねぇことにしてやる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「いたた……始まったわ。……来る？　%自称_おら(番号)%の一番すげぇところ、見せてやるけんど」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たのね。……はぁ、はぁ……ふふ、目、逸らさねでよ」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……見なせよ。おめの子たち。……ふふ、責任重大でねぇ？」"
		ELSE
			RESULTS '= "「……見なせよ。おめの子。……ふふ、似てるでねぇが」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……はは。……んだが。……ごめんね、こったな母親で」"
ENDSELECT
