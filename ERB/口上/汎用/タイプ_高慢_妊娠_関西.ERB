;口上タイプ「高慢」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_高慢_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;高慢：見下して命令する。痛みに屈するのを悔しがる。関西弁の「私を誰やと思てんの」「〜しなはれ」「……く」

@口上_妊娠_高慢_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……？　今の、何。……ふん、気のせいやな」"
	CASE "妊娠発覚"
		RESULTS '= @"「……ふん。……この%自称_私(番号)%が、母親やて。……ええわ、望むところや」"
	CASE "陣痛開始"
		RESULTS '= @"「……っ。始まったんやな。……ええわ。%自称_私(番号)%を誰やと思てるの」"
	CASE "破水"
		RESULTS '= "「なっ……！　……破水やて？　……こんな、みっともない……っ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強うなってきた……く……この程度で……」"
	CASE "移行期"
		RESULTS '= @"「ぐ、ぅ……っ！　……く、そ……こんな……%自称_私(番号)%が……っ」"
	CASE "娩出期"
		RESULTS '= @"「来る……。……ええわ。%自称_私(番号)%の子や。堂々と、出てきなはれ……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふん」"
			CASE 1
				RESULTS '= "「痛……。……この程度、なんともないわ」"
			CASE 2
				RESULTS '= "「く……。……ふぅ。抜けたな」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ！　……見んといて……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……悔しい……」"
			CASE 2
				RESULTS '= @"「痛い……っ！　……%自称_私(番号)%が、こんな……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょい、や……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……来なはれ……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……ええわ、出てきなはれ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……行くで。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　……聞いてへんわ、そんなこと……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「はぁ……はぁ……。ふん……全員、無事なんやな。……当然や。%自称_私(番号)%の子やもん」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いてる。……ええ声やん。%自称_私(番号)%の子や」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと。……生理が来ぃひんの。……言うまでもないけど、%対称_あんた(番号)%のやで」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。妊娠してる。……%対称_あんた(番号)%の子や。光栄に思いなはれ」"
		ELSE
			RESULTS '= @"「……聞きなはれ。%自称_私(番号)%、妊娠してるんや。……%対称_あんた(番号)%の子やで。感謝しなはれ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ふん。当然の反応やな。……でも、まあ。……悪うないわ、その顔」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「何やの、その顔。……ええわ。%自称_私(番号)%が産むて決めたんやから、%対称_あんた(番号)%は黙って見とき」"
	CASE "報告_突き放された"
		RESULTS '= @"「……何やて。……ええわ。%対称_あんた(番号)%なんかおらんでも、%自称_私(番号)%が立派に育てたるわ」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったで。……来なはれ。%自称_私(番号)%の子が生まれるとこ、見せたるわ」"
	CASE "立ち会いに来た"
		RESULTS '= "「……遅いわ。……はぁ、はぁ……そこに居なはれ。……離れんといて」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見なはれ。%対称_あんた(番号)%の子や。……全員、無事。当然やな」"
		ELSE
			RESULTS '= @"「……見なはれ。%対称_あんた(番号)%の子や。……ええ顔やろ。%自称_私(番号)%の子やもん」"
		ENDIF
	CASE "流産"
		RESULTS '= @"「……何やの。……何やの、これ。……そんな……%自称_私(番号)%が……っ」"
ENDSELECT
