;口上タイプ「高慢」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_高慢_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;高慢：見下して命令する。痛みに屈するのを悔しがる。博多弁の「私ば誰やと思っとると」「〜ばい」「〜けん」「……く」

@口上_妊娠_高慢_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「……？　今の、なん。……ふん、気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……ふん。……この%自称_私(番号)%が、母親ですと。……よか、望むところばい」"
	CASE "陣痛開始"
		RESULTS '= @"「……っ。始まったとね。……よか。%自称_私(番号)%ば誰やと思っとると」"
	CASE "破水"
		RESULTS '= "「なっ……！　……破水ですと？　……こげん、みっともなか……っ」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……。強うなってきた……く……この程度で……」"
	CASE "移行期"
		RESULTS '= @"「ぐ、ぅ……っ！　……く、そ……こげん……%自称_私(番号)%が……っ」"
	CASE "娩出期"
		RESULTS '= @"「来る……。……よか。%自称_私(番号)%の子ばい。堂々と、出てきんしゃい……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……ふん」"
			CASE 1
				RESULTS '= "「痛……。……この程度、なんでもなか」"
			CASE 2
				RESULTS '= "「く……。……ふぅ。抜けたね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛か……っ！　……見るんやなかよ……っ」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……悔しか……」"
			CASE 2
				RESULTS '= @"「痛か……っ！　……%自称_私(番号)%が、こげん……っ」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちかっと、ばい……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ……来んしゃい……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人……よか、出てきんしゃい……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「……行くばい。……んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　……聞いとらんばい、そげんこと……っ」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「はぁ……はぁ……。ふん……全員、無事なとね。……当然ばい。%自称_私(番号)%の子やもん」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。……泣いとう。……よか声やなか。%自称_私(番号)%の子ばい」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと。……生理の来んと。……言うまでもなかけど、%対称_あなた(番号)%のばい」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたばい。妊娠しとる。……%対称_あなた(番号)%の子ばい。光栄に思いんしゃい」"
		ELSE
			RESULTS '= @"「……聞きんしゃい。%自称_私(番号)%、妊娠しとると。……%対称_あなた(番号)%の子ばい。感謝しんしゃい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……ふん。当然の反応ね。……でも、まあ。……悪うなか、その顔」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「なんね、その顔。……よか。%自称_私(番号)%の産むと決めたとやけん、%対称_あなた(番号)%は黙って見とりんしゃい」"
	CASE "報告_突き放された"
		RESULTS '= @"「……なんですと。……よか。%対称_あなた(番号)%なんかおらんでも、%自称_私(番号)%の立派に育てるばい」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったばい。……来んしゃい。%自称_私(番号)%の子の生まれるとこば、見せてあげる」"
	CASE "立ち会いに来た"
		RESULTS '= "「……遅かばい。……はぁ、はぁ……そこにおりんしゃい。……離れんで」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見んしゃい。%対称_あなた(番号)%の子ばい。……全員、無事。当然ばい」"
		ELSE
			RESULTS '= @"「……見んしゃい。%対称_あなた(番号)%の子ばい。……よか顔やろ。%自称_私(番号)%の子やもん」"
		ENDIF
	CASE "流産"
		RESULTS '= @"「……なんね。……なんね、これ。……そげん……%自称_私(番号)%が……っ」"
ENDSELECT
