;口上タイプ「元気」の妊娠・出産の口上の関西弁（素質 方言_関西 が付いているとき、タイプ_元気_妊娠 の手前に呼ばれる。2026-10-01）。
;書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語の @口上_妊娠_元気 に落ちる。一人称は「うち」
;元気：明るくて口数が多い。痛くても軽口を叩こうとする。関西弁の「〜やん」「よっしゃ」

@口上_妊娠_元気_関西(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん？　今、お腹の奥がちくっと……気のせいかな」"
	CASE "妊娠発覚"
		RESULTS '= "「……えっ。えっ、うそ。ほんまに？　……ま、まあ、なるようになるわ！」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……来た、来たで、これ。よっしゃ、頑張ろか」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「わ、わっ、何これ……あ、破水ってやつ？　ちょっと、早ない？」"
		ELSE
			RESULTS '= "「うわっ、出た……！　破水やん、これ……いたた、痛いの増したし！」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……さっきより全然痛いねんけど……まだ序の口とか言わんといてや」"
	CASE "移行期"
		RESULTS '= "「う、ぐ……やば、腰が……割れる……！　もう、出したい……！」"
	CASE "娩出期"
		RESULTS '= "「来た……もう、出てくる……！　ええで、こっちも本気出すからな……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、はい、また来た。ふー、ふー……」"
			CASE 1
				RESULTS '= "「いたた……。ま、これくらいなら、まだ余裕、余裕」"
			CASE 2
				RESULTS '= "「ふぅー……。うん、だいぶ規則正しなってきたなぁ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「うっ……く、はぁ、はぁ……痛っ……」"
			CASE 1
				RESULTS '= "「……っ、ぐぅ……ちょ、これ、笑われへんて……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……ふー……ふー……よし、抜けた」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　ぐ、う……」"
			CASE 1
				RESULTS '= "「痛い痛い痛い……！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「うぅ……っ！　……もう、堪忍してぇ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんーーっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ、ふぅーっ……もうちょい、もうちょい……！」"
			CASE 2
				RESULTS '= "「うぐぅっ……！　……はぁ、来る、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もういっかい……！　よっしゃ、こいっ……んんんーーっ！」"
		ELSE
			RESULTS '= "「いくで……！　せーの……んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え、ちょっと……まだ？　うそやろ、もう一人おるん!?」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。やった……。全員、無事……？　……よかった、ほんまに」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……やった……。なあ、聞こえる？　泣いてるで……%自称_うち(番号)%の子」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……なあ、ちょっとええ？　生理、来てないねん。……たぶん、%対称_あんた(番号)%の」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「やっぱりやった。妊娠してる。……%対称_あんた(番号)%の子やで。ちゃんと覚えときや」"
		ELSE
			RESULTS '= @"「えーと……言うで。%自称_うち(番号)%、妊娠してる。……%対称_あんた(番号)%の子、や」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……えっ、喜んでくれるん？　……ふ、ふーん。……よっしゃ、ほな、頑張るか！」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「まあ、そうなるわな。……ええよええよ、%自称_うち(番号)%もまだ整理できてへんし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……あー、そう。……そっか。……分かった。もうええ、%自称_うち(番号)%が育てるから」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「いたた……来た、来たで。……なあ、来てくれる？　一人やとちょっとさ……」"
	CASE "立ち会いに来た"
		RESULTS '= @"「……来てくれたんや。……はぁ、はぁ……よっしゃ、%対称_あんた(番号)%がおるなら余裕、余裕」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見て。%対称_あんた(番号)%の子やで。……いっぱいおるやん。あはは……」"
		ELSE
			RESULTS '= @"「……見て。……%対称_あんた(番号)%の子やで。……ちっちゃいなぁ」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……なんで。……なあ、なんでなん……。ごめん……ごめんな……」"
ENDSELECT
