;口上タイプ「内気」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_内気_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;内気：声が小さく、ためらいがち。「あの……」「ご、ごめんなさい」。痛みに負けると言葉が途切れる。博多弁は丁寧語に溶かす（「〜ですけん」「〜とです」）

@口上_妊娠_内気_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あ……れ……？　今、なんか……」"
	CASE "妊娠発覚"
		RESULTS '= @"「え……あ、あの……わ、%自称_わたし(番号)%……ど、どげんしよう……」"
	CASE "陣痛開始"
		RESULTS '= "「い、痛……っ。あの……これ、もしかして……」"
	CASE "破水"
		RESULTS '= "「ひっ……あ、あの……な、なんか、出て……ど、どげんしよう……」"
	CASE "活動期"
		RESULTS '= "「は、はぁ……痛か……。ご、ごめんなさい、声、出てしもうて……」"
	CASE "移行期"
		RESULTS '= "「う、うぅ……っ、もう、だめ……我慢、できん……っ」"
	CASE "娩出期"
		RESULTS '= "「あ、あ……出て、くる……。こ、怖か……でも……」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ。……だ、大丈夫、です……」"
			CASE 1
				RESULTS '= "「ん……ぅ……。は、はい……ふぅ……」"
			CASE 2
				RESULTS '= "「い、痛……。ま、まだ、平気……」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、ぅ……っ、痛か……っ」"
			CASE 1
				RESULTS '= "「はぁ……はぁ……ご、ごめんなさい……」"
			CASE 2
				RESULTS '= "「ひ、ぅ……っ……ふー、ふー……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　い、いや……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　……はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛か……痛かです……っ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　は、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅ……ふぅ……っ、く……」"
			CASE 2
				RESULTS '= "「あ、ぅ……っ！　……も、もうちかっと……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「も、もう一度……。……んんん……っ！」"
		ELSE
			RESULTS '= "「い、いきます……。……んんんん……っ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え……？　あ、あの……まだ……？　う、うそ……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。み、みんな……無事……？　……よかった……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。あ……泣いとう……。わ、%自称_わたし(番号)%の……赤ちゃん……」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「あ、あの……。せ、生理の……来とらんで……。た、たぶん……%対称_あなた(番号)%の……」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「……や、やっぱり……妊娠、しとりました……。%対称_あなた(番号)%の……赤ちゃん……」"
		ELSE
			RESULTS '= @"「あ、あの……言わんといけんで……。わ、%自称_わたし(番号)%……妊娠……しとって……%対称_あなた(番号)%の……」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……え……。よ、喜んでくれると……ですか……？　……よかった……」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……ご、ごめんなさい。急に……。し、知っとってほしかった、だけで……」"
	CASE "報告_突き放された"
		RESULTS '= "「……っ。……そう、ですよね……。ご、ごめんなさい……もう、言いません……」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「……あの……始まってしもうて……。こ、来てほしか、なんて……言えんけど……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来て、くれたとですか……。……はぁ、はぁ……ご、ごめんなさい、こげん姿で……」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……み、見てください……。%対称_あなた(番号)%の……赤ちゃん、です……。みんな……」"
		ELSE
			RESULTS '= @"「……み、見てください……。%対称_あなた(番号)%の……赤ちゃん、です……」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ぁ……。……ご、ごめんなさい……ごめんなさい……っ」"
ENDSELECT
