;口上タイプ「奔放」の妊娠・出産の口上（素質 口上_奔放 のキャラ）。書き方は タイプ_元気_妊娠.ERB と同じ
;奔放：物怖じせず、痛みも笑い飛ばそうとする。「ほら」「上等」

@口上_妊娠_奔放(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん……？　今の、なんだろ。……ま、いっか」"
	CASE "妊娠発覚"
		RESULTS '= "「あー……やっぱりね。誰の子かなぁ、なんて。ふふ、上等じゃない」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……お、始まった？　いいよ、来なさいよ」"
	CASE "破水"
		RESULTS '= "「うわ、出た……ふふ、派手に破水しちゃった。もう戻れないわね」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……ちょっと、本気出してきたじゃない……ん、いいわよ」"
	CASE "移行期"
		RESULTS '= "「ぐ、ぅ……っ！　ああもう、腰が……！　出す、出すから……！」"
	CASE "娩出期"
		RESULTS '= @"「来た……！　ふふ……いいわ、%自称_あたし(番号)%の全部、見せてあげる……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだまだ」"
			CASE 1
				RESULTS '= "「いたた……ふふ、こんなもん？」"
			CASE 2
				RESULTS '= "「ん……はぁ。規則的になってきたわね」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「う、く……っ！　はぁ……」"
			CASE 1
				RESULTS '= "「痛っ……ふふ、笑えないわね、これは……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、抜けた……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああぁっ……！　く、そ……っ」"
			CASE 1
				RESULTS '= "「ぐぅぅ……っ！　はぁ、はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「痛い痛い痛い……っ！　上等よ……！」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんっ……！　はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……もうちょい……」"
			CASE 2
				RESULTS '= "「うぐっ……！　はぁ、はぁ……来い……っ」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「まだ終わらせないわよ……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くわよ……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「は……？　まだ……？　あはは……仕込みすぎたかしら……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。ふふ、一気に賑やかになったじゃない……」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。ふふ……元気に泣いてる。%自称_あたし(番号)%の子ね」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「ねえ、ちょっと。……生理、来てないの。……ふふ、たぶん%対称_あんた(番号)%のよ？」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたわ。妊娠してる。……%対称_あんた(番号)%の子。ふふ、どうする？」"
		ELSE
			RESULTS '= @"「言っとくわね。%自称_あたし(番号)%、妊娠してるの。……%対称_あんた(番号)%の子よ。責任、取れる？」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……あら。そんな顔するんだ。……ふふ、いいじゃない。気に入った」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「ふふ、固まってる。……いいわよ、別に。%自称_あたし(番号)%が勝手に産むだけだし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……へえ。そう来るんだ。……いいわ。%対称_あんた(番号)%の子じゃないことにしてあげる」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「いたた……始まったわ。……来る？　%自称_あたし(番号)%の一番すごいところ、見せてあげるけど」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たのね。……はぁ、はぁ……ふふ、目、逸らさないでよ」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……見なさいよ。%対称_あんた(番号)%の子たち。……ふふ、責任重大じゃない？」"
		ELSE
			RESULTS '= @"「……見なさいよ。%対称_あんた(番号)%の子。……ふふ、似てるじゃない」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……はは。……そっか。……ごめんね、こんな母親で」"
ENDSELECT
