;主役の段の下に出る一言（→主役.ERB @主役の一言）。タイプ別の共通。2026-09-15
;呼ぶ順：口上_一言_{キャラ番号} → 口上_一言_{タイプ}_{性別} →（ふたなりは _女）→ 口上_一言_{タイプ}。空を返せば次へ落ちる
;状況は @一言の状況 で一つに絞る（上から順に当たったもの）：
;  泥酔／妊娠（本人の腹がふっくら以上で主人公が気づいている）／あなたの妊娠（主人公の腹がふっくら以上で本人が気づいている。→画面イメージ「妊娠の話」）
;  ／不満（満足度が中立の幅を下回る）／恋（主人公への恋愛が段6以上）／友達（友情が段5以上）
;  ／酔い（ほろ酔い以上）／満足（満足度が中立の幅を超える）／勤務中（スタッフが働いている）／初対面（友情が段1以下）／ふだん
;書き手は RESULTS に台詞を返す。女言葉・男言葉は避ける（性別ファイルが無いとここに全員が落ちる）

@一言の状況(番号)
#FUNCTIONS
#DIM 番号

SIF BASE:番号:酔い >= 泥酔の線
	RETURNF "泥酔"
SIF 腹が見えているか(番号, MASTER)
	RETURNF "妊娠"
SIF 腹が見えているか(MASTER, 番号)
	RETURNF "あなたの妊娠"
SIF 満足度:番号:0 < 0 - 中立の幅
	RETURNF "不満"
SIF 好感度の段(好感度_恋愛:番号:0) >= 6
	RETURNF "恋"
SIF 好感度の段(好感度_友情:番号:0) >= 5
	RETURNF "友達"
SIF BASE:番号:酔い >= ほろ酔いの線
	RETURNF "酔い"
SIF 満足度:番号:0 > 中立の幅
	RETURNF "満足"
SIF スタッフ:番号:0 && 勤務中:番号:0
	RETURNF "勤務中"
SIF 好感度の段(好感度_友情:番号:0) <= 1
	RETURNF "初対面"
RETURNF "ふだん"


@口上_一言_クール(番号)
#DIM 番号

RESULTS '= ""
SELECTCASE 一言の状況(番号)
	CASE "泥酔"
		RESULTS '= "「……飲みすぎた。……放っておいて」"
	CASE "妊娠"
		RESULTS '= "「……見ないで。……分かってるから」"
	CASE "あなたの妊娠"
		RESULTS '= "「……お腹、大きくなったね。……座ってなよ」"
	CASE "不満"
		RESULTS '= "「……この店、どうかと思う」"
	CASE "恋"
		RESULTS '= "「……別に。……いや、……何でもない」"
	CASE "友達"
		RESULTS '= @"「……%対称_あなた(番号)%が居るなら、悪くない」"
	CASE "酔い"
		RESULTS '= "「……少し、回ってきた。……いい気分」"
	CASE "満足"
		RESULTS '= "「……悪くない店ね、ここ」"
	CASE "勤務中"
		RESULTS '= "「……仕事中。……用があるなら手短に」"
	CASE "初対面"
		RESULTS '= "「……何か？」"
	CASEELSE
		RESULTS '= "「……ん。……別に」"
ENDSELECT


