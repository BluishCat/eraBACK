;口上タイプ「世話焼き」の妊娠・出産の口上の博多弁（素質 方言_博多 が付いているとき、タイプ_世話焼き_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;世話焼き：面倒見がよく、痛い最中でも周りを気遣う。姉御肌。博多弁の「大丈夫ばい」「心配せんと」「〜しなっせ」

@口上_妊娠_世話焼き_博多(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「あら……？　今、お腹の奥で何か……気のせいね」"
	CASE "妊娠発覚"
		RESULTS '= @"「……そう。%対称_あんた(番号)%、来てくれたとね。……ちゃんと、育てちゃるけん」"
	CASE "陣痛開始"
		RESULTS '= "「いた……っ。……ああ、始まったとね。慌てん、慌てん」"
	CASE "破水"
		RESULTS '= "「あら……破水ね。……大丈夫ばい、心配せんと。こげんこともあるばい」"
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……強うなってきた……。うん、順調ってことたい」"
	CASE "移行期"
		RESULTS '= "「う、く……っ！　もう、いきみたかて……はぁ、はぁ、あともうちかっと……」"
	CASE "娩出期"
		RESULTS '= "「来た……！　よかよ、お母さんがちゃんと出しちゃるけんね……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、ふぅ。まだ大丈夫」"
			CASE 1
				RESULTS '= "「いた……ふー、ふー……はい、抜けた」"
			CASE 2
				RESULTS '= "「ん……。心配せんでよか、これが普通たい」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「く、ぅ……っ、はぁ……」"
			CASE 1
				RESULTS '= "「痛……っ、……大丈夫、大丈夫……」"
			CASE 2
				RESULTS '= "「ふぅーっ、ふぅーっ……はぁ、はぁ……」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「あああっ……！　く……っ」"
			CASE 1
				RESULTS '= "「うぅぅ……っ！　はぁ、はぁ……ごめん、うるさかね……」"
			CASE 2
				RESULTS '= "「痛か……っ！　……ふぅ、ふぅ……もうちかっと、やんね……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ……く、ぅ……待っとってね……」"
			CASE 2
				RESULTS '= "「うぐ……っ！　……はぁ、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一人ね……待たせてごめんね……！　んんんーーっ！」"
		ELSE
			RESULTS '= "「行くばい……おいで……！　んんんんーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= @"「え……まだ……？　%対称_あんた(番号)%、そこにおったとね……もう、言うてくれればよかとに……」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。みんな無事ね……。よしよし、お母さんはここばい」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……。よう頑張ったね……%対称_あんた(番号)%も、%自称_あたし(番号)%も。おいで」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= @"「……ちょっと、%対称_あんた(番号)%。……生理が来とらんとよ。……たぶん、%対称_あんた(番号)%の子」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= @"「はっきりしたばい。……妊娠しとう。%対称_あんた(番号)%の子ばい。……ちゃんと聞いときなっせ」"
		ELSE
			RESULTS '= @"「……言うとくね。%自称_あたし(番号)%、妊娠しとうと。……%対称_あんた(番号)%の子ばい」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……なんね、そげん顔して。……ふふ。……ちゃんと育てるばい、二人で」"
	CASE "報告_戸惑われた"
		RESULTS '= "「……まあ、よかたい。急に言われたって困るやろね。……ゆっくり考えなっせ」"
	CASE "報告_突き放された"
		RESULTS '= @"「……そう。……分かった。……よか、%自称_あたし(番号)%一人で育てる。%対称_あんた(番号)%には頼らん」"
	CASE "立ち会いの知らせ"
		RESULTS '= @"「……始まったごたる。……大丈夫、%自称_あたし(番号)%は大丈夫やけん。……でも、来てくれるなら嬉しか」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来たとね。……はぁ……ほら、そこに座っときなっせ。心配せんでよかけん」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= @"「……ほら、見て。……%対称_あんた(番号)%の子たちばい。……ちゃんと抱いてあげて」"
		ELSE
			RESULTS '= @"「……ほら、見て。……%対称_あんた(番号)%の子ばい。……ちゃんと抱いてあげて」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……ごめんね。……守ってあげられんで。……ごめんね……」"
ENDSELECT
