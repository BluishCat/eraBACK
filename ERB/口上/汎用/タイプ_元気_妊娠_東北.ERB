;口上タイプ「元気」の妊娠・出産の口上の東北弁（素質 方言_東北 が付いているとき、タイプ_元気_妊娠 の手前に呼ばれる。2026-10-01）。書き方と局面は タイプ_元気_妊娠.ERB と同じ。空なら標準語に落ちる
;元気：明るくて口数が多い。痛くても軽口を叩こうとする。東北弁の「んだ」「〜だべ」「〜っちゃ」「〜ねぇ」「えらく」「めんこい」「〜けんど」「〜さ」。一人称は「あたし」を「おら」に変える

@口上_妊娠_元気_東北(番号, 局面)
#DIM 番号
#DIMS 局面

RESULTS '= ""
SELECTCASE 局面
	CASE "着床"
		RESULTS '= "「ん？　今、お腹の奥がちくっと……気のせいだべか」"
	CASE "妊娠発覚"
		RESULTS '= "「……えっ。えっ、うそ。まじで？　……ま、まあ、なるようになるか！」"
	CASE "陣痛開始"
		RESULTS '= "「いたた……来た、来たよこれ。よーし、頑張ろうっちゃ」"
	CASE "破水"
		;前期破水（陣痛より先）か、陣痛の途中の適時破水か
		IF 陣痛:番号:0 <= 1
			RESULTS '= "「わ、わっ、何これ……あ、破水ってやつ？　ちっと、早くねぇ？」"
		ELSE
			RESULTS '= "「うわっ、出た……！　破水っちゃこれ……いたた、いでぇの増したし！」"
		ENDIF
	CASE "活動期"
		RESULTS '= "「はぁ、はぁ……さっきより全然いでぇんだけんど……まだ序の口とか言わねでよ」"
	CASE "移行期"
		RESULTS '= "「う、ぐ……やば、腰が……割れる……！　もう、出したい……！」"
	CASE "娩出期"
		RESULTS '= "「来た……もう、出てくる……！　いいべ、こっちも本気出すがら……！」"
	CASE "波_本格化"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「……っ、はい、また来た。ふー、ふー……」"
			CASE 1
				RESULTS '= "「いたた……。ま、これくらいなら、まだ余裕、余裕」"
			CASE 2
				RESULTS '= "「ふぅー……。うん、だいぶ規則正しくなってきたっちゃ」"
		ENDSELECT
	CASE "波_活動期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「うっ……く、はぁ、はぁ……痛っ……」"
			CASE 1
				RESULTS '= "「……っ、ぐぅ……ちょ、これ、笑えねぇって……」"
			CASE 2
				RESULTS '= "「はぁ……はぁ……ふー……ふー……よし、抜けた」"
		ENDSELECT
	CASE "波_移行期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「ああああっ……！　ぐ、う……」"
			CASE 1
				RESULTS '= "「いでぇいでぇいでぇ……！　はぁ、はぁ……」"
			CASE 2
				RESULTS '= "「うぅ……っ！　……もう、勘弁してよぉ……」"
		ENDSELECT
	CASE "波_娩出期"
		SELECTCASE RAND(3)
			CASE 0
				RESULTS '= "「んんんーーっ……！　はぁっ、はぁっ……」"
			CASE 1
				RESULTS '= "「ふぅーっ、ふぅーっ……もうちょい、もうちょい……！」"
			CASE 2
				RESULTS '= "「うぐぅっ……！　……はぁ、来る、来る……」"
		ENDSELECT
	CASE "いきみ"
		IF 分娩済:番号:0 >= 1
			RESULTS '= "「もう一回……！　よーし、こいっ……んんんーーっ！」"
		ELSE
			RESULTS '= "「いくよ……！　せーの……んんんんーーーっ！」"
		ENDIF
	CASE "多胎に気づく"
		RESULTS '= "「え、ちっと……まだ？　うそだべ、もう一人いるの!?」"
	CASE "出産直後"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「はぁ……はぁ……。やった……。全員、無事……？　……よかった、ほんとに」"
		ELSE
			RESULTS '= @"「はぁ……はぁ……やった……。ねえ、聞こえる？　泣いてるよ……%自称_おら(番号)%の子」"
		ENDIF
	CASE "妊娠の報告"
		RESULTS '= "「……ねえ、ちっといい？　生理、来てねぇんだ。……たぶん、おめの」"
	CASE "妊娠の確信の報告"
		IF 妊娠の報告済:番号:0 >= 1
			RESULTS '= "「やっぱりだった。妊娠してる。……おめの子だべ。ちゃんと覚えといてね」"
		ELSE
			RESULTS '= @"「えーと……言うね。%自称_おら(番号)%、妊娠してる。……おめの子、だべ」"
		ENDIF
	CASE "報告_喜ばれた"
		RESULTS '= "「……えっ、喜んでくれるの？　……ふ、ふーん。……よーし、んだら、頑張るか！」"
	CASE "報告_戸惑われた"
		RESULTS '= @"「まあ、そうなるよね。……いいよいいべ、%自称_おら(番号)%もまだ整理できてねぇし」"
	CASE "報告_突き放された"
		RESULTS '= @"「……あー、んだ。……んだが。……分かった。もういい、%自称_おら(番号)%が育てるがら」"
	CASE "立ち会いの知らせ"
		RESULTS '= "「いたた……来た、来たよ。……ねえ、来てける？　一人だとちっとさ……」"
	CASE "立ち会いに来た"
		RESULTS '= "「……来てけたんだ。……はぁ、はぁ……よーし、おめが居るなら余裕、余裕」"
	CASE "出産直後_父へ"
		IF 胎児数:番号:0 >= 2
			RESULTS '= "「……見て。おめの子だべ。……いっぺ居るっちゃ。あはは……」"
		ELSE
			RESULTS '= "「……見て。……おめの子だべ。……ちっちゃいね」"
		ENDIF
	CASE "流産"
		RESULTS '= "「……なして。……ねえ、なしてよ……。ごめん……ごめんね……」"
ENDSELECT
