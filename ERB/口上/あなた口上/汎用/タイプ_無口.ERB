;盛り上がり版（主人公の台詞・共通。段 1=昂ぶり 2=高まり。段が 0 のときは呼ばれず、空なら 口上_行為 に落ちる。書き方は タイプ_元気_女.ERB の @口上_盛り上がり_元気_女 と同じ）
;分類（2 愛撫・3 奉仕・4 Ｖ系・5 Ａ系・6 特殊）ごとに受ける側／動く側で一つ。向き 0 は主人公が動く側、1・2 は受ける側。会話・見せる・脱衣・浴室は返さない
@口上_盛り上がり_無口_主人公(番号, 行為, 向き, 段)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 段
#DIM 受け

RESULTS '= ""
受け = 向き != 0
SELECTCASE 行為の分類:行為
	;愛撫
	CASE 2
		IF 受け
			IF 段 == 1
				RESULTS '= "（小さく頷いた）"
			ELSE
				RESULTS '= "「……っ、……だ、め……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん……」"
			ELSE
				RESULTS '= "「……は、……っ」"
			ENDIF
		ENDIF
	;奉仕
	CASE 3
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ん。……もっと」"
			ELSE
				RESULTS '= "「……っ、……もう……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん、……」"
			ELSE
				RESULTS '= "「……んっ、……っ」"
			ENDIF
		ENDIF
	;Ｖ系
	CASE 4
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ん……っ」"
			ELSE
				RESULTS '= "（唇を噛んで、声を殺した）"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ふ、……ぅ」"
			ELSE
				RESULTS '= "「……っ、……く……っ」"
			ENDIF
		ENDIF
	;Ａ系
	CASE 5
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ぅ、……ん」"
			ELSE
				RESULTS '= "「……っ、……あ……っ」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "「……ん、……」"
			ELSE
				RESULTS '= "「……っ、……はっ」"
			ENDIF
		ENDIF
	;特殊
	CASE 6
		IF 受け
			IF 段 == 1
				RESULTS '= "「……ん。……もっと」"
			ELSE
				RESULTS '= "「……あ、……っ！」"
			ENDIF
		ELSE
			IF 段 == 1
				RESULTS '= "（わずかに口元を緩めた）"
			ELSE
				RESULTS '= "「……はぁ……っ」"
			ENDIF
		ENDIF
ENDSELECT


;連続絶頂版（主人公の台詞・共通。同じ個室で 2 回目以降に達したとき、口上_絶頂 より先に呼ばれる。空なら 口上_絶頂 に落ちる）。回数＝この個室で続けて達した回数（2 回目は 2）。部位 0=口 1=胸 2=クリトリス 3=膣 4=尻 5=射精
@口上_連続絶頂_無口_主人公(番号, 部位, 回数)
#DIM 番号
#DIM 部位
#DIM 回数

RESULTS '= ""
IF 部位 == 5
	RESULTS '= "「……っ、……また……っ」"
ELSEIF 回数 == 2
	RESULTS '= "「……っ、……また……っ」"
ELSE
	RESULTS '= "（肩で息をしながら、顔を伏せた）"
ENDIF


