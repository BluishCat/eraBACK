甲 = 衣類の番号(着ている名(番号, 枠))
SIF 甲 < 0
	RETURNF -1
RETURNF 衣類の枠:甲


;個室の中で、その側の服・下着の上から手で触れる行為か（2026-10-15 ユーザ指定「個室内にも」「文だけ分ける」。出る行為・効果値は変えない）。
;手で触れる行為（愛撫・胸愛撫・乳首責め・アナル愛撫・胸／股間を触らせる・手淫する／させる）で、触れる部位の服・下着が着たままのとき。
;着ている服が手の入る服（はだけ可・めくり可・ずらし可）か下着なら、触れられる側が昂ぶっていれば めくる・ずらす（従来の見出し）、昂ぶっていなければ上から。膣に入れる行為・舐める行為・搾乳・亀頭責めなどは含めない
@服の上から触れるか(行為, 側)
#FUNCTION
#DIM 行為
#DIM 側

SIF !手で触れる行為か(行為)
	RETURNF 0
SIF 側 < 0 || 側 > 1
	RETURNF 0
SIF !(行為の使用:行為:(1 - 側) & (1 << 部位_手))
	RETURNF 0
SIF 昂ぶりか(個室の番号(側))
	RETURNF 0
RETURNF 服の上からの文(行為, 側) != ""

;手で触れる行為か（服の上から触れる・触れ方の口上の対象。愛撫20・胸愛撫21・乳首責め22・アナル愛撫28・胸を触らせる30・股間を触らせる31・手淫する40・手淫させる45）
@手で触れる行為か(行為)
#FUNCTION
#DIM 行為

RETURNF 行為 == 20 || 行為 == 21 || 行為 == 22 || 行為 == 28 || 行為 == 30 || 行為 == 31 || 行為 == 40 || 行為 == 45

;触れ方の口上の群。0＝股間（20・31・40・45）／1＝胸（21・22・30）／2＝尻（28）
@触れ方の群(行為)
#FUNCTION
#DIM 行為

SIF 行為 == 28
	RETURNF 2
SIF 行為 == 21 || 行為 == 22 || 行為 == 30
	RETURNF 1
RETURNF 0

;触れ方の区分（口上用）。0＝対象外の行為／1＝服の上から／2＝つっこんで（服の中に手を入れる・下着をずらす）／3＝覆うものが無く直接。触られる側（客＝0、主人公＝1）の服で決める
@触れ方の区分(行為)
#FUNCTION
#DIM 行為
#DIM 側

SIF !手で触れる行為か(行為)
	RETURNF 0
側 = 0
SIF 行為 == 30 || 行為 == 31 || 行為 == 45
	側 = 1
SIF 服の上から触れるか(行為, 側)
	RETURNF 1
SIF 服の上からの文(行為, 側) != ""
	RETURNF 2
RETURNF 3

;いまの場面の触れ方の口上の使い方（0＝出さない 1＝全部 2＝反応の台詞だけ。→変数定義.ERH 触れ方の口上の使用）。個室の外を呼んでいる最中は 外の触れ方の口上の使用
@触れ方の口上のモード
#FUNCTION

SIF 外の触れ方中
	RETURNF 外の触れ方の口上の使用
RETURNF 触れ方の口上の使用


;服・布・直接・下着など、触れ方（服の上から／直接）そのものを説明する台詞か。反応のモードで出さない
@触れ方の説明台詞か(文)
#FUNCTION
#DIMS 文
#DIMS 語, 32
#DIM 数
#DIM 甲

SPLIT "服/布/直接/直に/じか/下着/ずら/めく/スカート/ブラ/ショーツ/パンツ/シャツ/裾/襟/肌着/上から/越し", "/", 語
数 = RESULT
FOR 甲, 0, 数
	SIF STRFIND(文, 語:甲) >= 0
		RETURNF 1
NEXT
RETURNF 0


;触れ方の口上を出す（相手＝番号の口上）。キャラ番号 → タイプ_方言 → タイプ の順で呼び、出せたら 1、無ければ 0 を返す（RESULT）。個室の行為・個室の外のセクハラ／触らせるで共通
@触れ方の口上を出す(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分

CALL 触れ方の口上を引く(番号, 行為, 向き, 区分)
SIF RESULT != 1
	RETURN 0
PRINTFORML 　%RESULTS%
RETURN 1

;触れ方の口上を RESULTS に引く（出さない）。キャラ番号 → タイプ_方言 → タイプ。引けたら 1、無ければ 0（NPC 同士の場面は 客.ERB @NPC同士の触れ方の口上 が 見える で出す）
@触れ方の口上を引く(番号, 行為, 向き, 区分)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分

RESULTS '= ""
SIF !触れ方の口上のモード() || CFLAG:番号:口上なし
	RETURN 0
CALL 触れ方の口上を呼ぶ(番号, 行為, 向き, 区分, TOSTR(番号))
;方言が付いていれば タイプ_方言 を先に（無ければ標準語のタイプへ。→ERB/口上/触れ方_{方言}.ERB）
IF RESULTS == "" && 方言の接尾(番号) != ""
	CALL 触れ方の口上を呼ぶ(番号, 行為, 向き, 区分, @"%口上タイプ(番号)%%方言の接尾(番号)%")
ENDIF
IF RESULTS == ""
	CALL 触れ方の口上を呼ぶ(番号, 行為, 向き, 区分, 口上タイプ(番号))
ENDIF
SIF RESULTS == ""
	RETURN 0
;反応だけのモードでは、服・布・直接などに触れる説明台詞は出さない
IF 触れ方の口上のモード() == 2 && 触れ方の説明台詞か(RESULTS)
	RESULTS '= ""
	RETURN 0
ENDIF
RETURN 1

;主人公の触れ方の口上を出す。固有 → タイプ_主人公_方言 → タイプ_主人公（口上の使い方に従う）。出せたら 1、無ければ 0
@主人公の触れ方の口上を出す(行為, 向き, 区分)
#DIM 行為
#DIM 向き
#DIM 区分

RESULTS '= ""
SIF !触れ方の口上のモード() || CFLAG:MASTER:口上なし
	RETURN 0
IF 口上の使い方 != 2
	CALL 触れ方の口上を呼ぶ(MASTER, 行為, 向き, 区分, TOSTR(MASTER))
ENDIF
IF RESULTS == "" && 口上の使い方 != 1 && 方言の接尾(MASTER) != ""
	CALL 触れ方の口上を呼ぶ(MASTER, 行為, 向き, 区分, @"%口上タイプ(MASTER)%_主人公%方言の接尾(MASTER)%")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1
	CALL 触れ方の口上を呼ぶ(MASTER, 行為, 向き, 区分, @"%口上タイプ(MASTER)%_主人公")
ENDIF
IF RESULTS == ""
	RETURN 0
ENDIF
IF 触れ方の口上のモード() == 2 && 触れ方の説明台詞か(RESULTS)
	RESULTS '= ""
	RETURN 0
ENDIF
SETCOLOR 150, 200, 255
PRINTFORML 　%RESULTS%
RESETCOLOR
RETURN 1

;個室の外で手の触れ方の口上を出す（セクハラ・触らせる。2026-10-15 ユーザ指定「個室の外のぶんも」）。手＝セクハラ名の番号（5 尻・6 胸・7 股間。ほかは出さない）、番号＝相手（NPC）。
;向き 0＝相手が触られる（セクハラする）／1＝相手が主人公に触る（触らせる・客が主人公に触る）。触られる側の服で区分を決め、相手 → 主人公の順に出す（個室と同じ）。
;個室の行為番号に置き換えて同じ口上を呼ぶ（手7＝股間→20／6＝胸→21／5＝尻→28）
@外の触れ方の口上(番号, 手, 向き)
#DIM 番号
#DIM 手
#DIM 向き
#DIM 行為
#DIM 下か
#DIM 触られた
#DIM 区分

SELECTCASE 手
	CASE 5
		行為 = 28
	CASE 6
		行為 = 21
	CASE セクハラ_股間
		行為 = 20
	CASEELSE
		RETURN 0
ENDSELECT
下か = 手 != 6
触られた = MASTER
SIF 向き == 0
	触られた = 番号
区分 = 外の触れ方の区分(触れ方の段(触られた, 下か))
外の触れ方中 = 1
CALL 触れ方の口上を出す(番号, 行為, 向き, 区分)
CALL 主人公の触れ方の口上を出す(行為, 向き, 区分)
外の触れ方中 = 0

;個室の外の触れ方の段（行為文.ERB @触れ方の段）を口上の区分に直す。1＝服の上から／2＝つっこんで／3＝直接
@外の触れ方の区分(段)
#FUNCTION
#DIM 段

;段 0＝直に 1＝下着の上から 2＝服の中に手を入れて 3＝服の上から
SIF 段 == 0
	RETURNF 3
SIF 段 == 2
	RETURNF 2
RETURNF 1

;触れ方の口上（ERB/口上/触れ方.ERB の 口上_触れ方_{名}）を呼ぶ。名＝キャラ番号／タイプ（主人公は タイプ_主人公）。無ければ空
@触れ方の口上を呼ぶ(番号, 行為, 向き, 区分, 名)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 区分
#DIMS 名

RESULTS '= ""
TRYCCALLFORM 口上_触れ方_%名%(番号, 行為, 向き, 区分)
CATCH
ENDCATCH


;「ブラウスとスカートの上から」。触れる部位（胸＝上、下＝クリ・膣・尻・男性器・性器）を覆っているいちばん外のもの（服、無ければ下着）。覆うものが無ければ ""
@服の上からの文(行為, 側)
#FUNCTIONS
#DIM 行為
#DIM 側
#DIM 使用
#DIM 番号
#DIMS 上の物
#DIMS 下の物
#DIMS 出力

使用 = 行為の使用:行為:側
番号 = 個室の番号(側)
上の物 '= ""
下の物 '= ""
IF 使用 & (1 << 部位_胸)
	IF 服の状態:側:服_上
		上の物 '= 着ている名(番号, 服_上)
	ELSEIF 服の状態:側:服_上の下着
		上の物 '= 着ている名(番号, 服_上の下着)
	ENDIF
ENDIF
IF 使用 & 0b1111100
	IF 服の状態:側:服_下
		下の物 '= 着ている名(番号, 服_下)
	ELSEIF 服の状態:側:服_下の下着
		下の物 '= 着ている名(番号, 服_下の下着)
	ENDIF
ENDIF
;上下一体（ワンピース・水着）は同じ名前が上下に出るので一つにする
SIF 上の物 == 下の物
	下の物 '= ""
出力 '= 上の物
IF 出力 != "" && 下の物 != ""
	出力 += "と" + 下の物
ELSEIF 下の物 != ""
	出力 '= 下の物
ENDIF
SIF 出力 == ""
	RETURNF ""
RETURNF 出力 + "の上から"


;行為の見出しに添える語（「健二のプリーツスカートをめくり、ショーツをずらして」）。着たまま使う服（はだけ・めくり・下ろし・ずらし）と、残っている下着。無ければ ""
;上下一体で胸も下も使うなら「ドレスをめくり」の一つに畳む。上下の下着を両方ずらすなら「ブラとショーツをずらし」（一体なら一つ）
@服のずらし文(行為, 側)
#FUNCTIONS
#DIM 行為
#DIM 側
#DIM 使用
#DIM 番号
#DIM 語, 4
#DIMS 物, 4
#DIM 数
#DIM 甲
#DIM 上を使う
#DIM 下を使う
#DIMS 名
#DIMS 出力

;服の上から触れる行為なら「ブラウスとスカートの上から」の一つに畳む
IF 服の上から触れるか(行為, 側)
	RETURNF 服の上からの文(行為, 側)
ENDIF
使用 = 行為の使用:行為:側
番号 = 個室の番号(側)
上を使う = (使用 & (1 << 1)) != 0
下を使う = (使用 & 0b1111100) != 0
数 = 0
IF 上を使う && 服の状態:側:服_上
	物:数 '= 着ている名(番号, 服_上)
	語:数 = 語_はだけ
	数 += 1
ENDIF
IF 下を使う && 服の状態:側:服_下
	名 '= 着ている名(番号, 服_下)
	;上下一体で上にも出ていれば、その一つを下の語にする
	IF 数 > 0
		SIF 物:(数 - 1) == 名
			数 -= 1
	ENDIF
	物:数 '= 名
	IF 服の性質か(番号, 服_下, 性質_めくり可)
		語:数 = 語_めくり
	ELSEIF 服の枠(番号, 服_下) == 枠_ズボン
		語:数 = 語_下ろし
	ELSE
		語:数 = 語_ずらし
	ENDIF
	数 += 1
ENDIF
名 '= ""
SIF 上を使う && 服の状態:側:服_上の下着
	名 '= 着ている名(番号, 服_上の下着)
IF 下を使う && 服の状態:側:服_下の下着
	IF 名 == ""
		名 '= 着ている名(番号, 服_下の下着)
	ELSEIF 名 != 着ている名(番号, 服_下の下着)
		名 += "と" + 着ている名(番号, 服_下の下着)
	ENDIF
ENDIF
IF 名 != ""
	物:数 '= 名
	語:数 = 語_ずらし
	数 += 1
ENDIF
SIF 数 == 0
	RETURNF ""
出力 '= ""
FOR 甲, 0, 数
	IF 甲 == 数 - 1
		出力 += 物:甲 + "を" + ずらしの末:(語:甲)
	ELSE
		出力 += 物:甲 + "を" + ずらしの中:(語:甲) + "、"
	ENDIF
NEXT
RETURNF 出力


;脱衣の行為が脱がせる側（0=客 1=主人公）と枠（0=上の服 1=下の服 2=下着 3=全部 4=足元＝靴下と靴）
@脱衣の側(行為)
#FUNCTION
#DIM 行為

SIF 行為 == 行為_足元を脱がす
	RETURNF 0
SIF 行為 == 行為_足元を脱ぐ
	RETURNF 1
SIF 行為 < 行為_脱衣の始め + 4
	RETURNF 0
RETURNF 1

@脱衣の枠(行為)
#FUNCTION
#DIM 行為

SIF 行為 == 行為_足元を脱がす || 行為 == 行為_足元を脱ぐ
	RETURNF 4
SIF 行為 == 行為_全部脱がされる
	RETURNF 3
RETURNF (行為 - 行為_脱衣の始め) % 4


;どちらかの体に汚れがあるか（拭うが出る条件）
@汚れがあるか
#FUNCTION
#DIM 側
#DIM 甲

FOR 側, 0, 2
	FOR 甲, 0, 部位の数
		SIF 体の汚れ:側:甲
			RETURNF 1
	NEXT
NEXT
RETURNF 0


;脱ぐものがあるか
@脱衣ができるか(行為)
#FUNCTION
#DIM 行為
#DIM 側

側 = 脱衣の側(行為)
SELECTCASE 脱衣の枠(行為)
	CASE 0
		RETURNF 服の状態:側:服_上
	CASE 1
		;上下一体なら上の服と一緒に脱げる
		SIF 服の枠(個室の番号(側), 服_上) == 枠_上下一体
			RETURNF 0
		RETURNF 服の状態:側:服_下
	CASE 2
		RETURNF 服の状態:側:服_上の下着 || 服の状態:側:服_下の下着
	CASE 4
		RETURNF 服の状態:側:服_靴下 || 服の状態:側:服_靴
ENDSELECT
RETURNF 服の状態:側:服_上 || 服の状態:側:服_下 || 服の状態:側:服_上の下着 || 服の状態:側:服_下の下着 || 服の状態:側:服_靴下 || 服の状態:側:服_靴


;脱衣の手。服の状態を変え、脱いだものの名前を 脱いだ物 に残す（文は @脱衣の文。文はこの後に出るので、脱ぐ前の名前をここで取る）
@脱衣をする(行為)
#DIM 行為
#DIM 側
#DIM 番号
#DIM 枠

側 = 脱衣の側(行為)
番号 = 個室の番号(側)
SELECTCASE 脱衣の枠(行為)
	CASE 0
		脱いだ物 '= 着ている名(番号, 服_上)
		服の状態:側:服_上 = 0
		SIF 服の枠(番号, 服_上) == 枠_上下一体
			服の状態:側:服_下 = 0
	CASE 1
		脱いだ物 '= 着ている名(番号, 服_下)
		服の状態:側:服_下 = 0
	CASE 2
		脱いだ物 '= 脱ぐ下着の名(側)
		服の状態:側:服_上の下着 = 0
		服の状態:側:服_下の下着 = 0
	CASE 4
		脱いだ物 '= 脱ぐ足元の名(側)
		服の状態:側:服_靴下 = 0
		服の状態:側:服_靴 = 0
	CASEELSE
		脱いだ物 '= "残っていた服を全部"
		FOR 枠, 0, 服の枠数
			服の状態:側:枠 = 0
		NEXT
ENDSELECT

;その側が着ている下着の名前（「ブラとショーツ」。一体なら一つ。無ければ "下着"）
@脱ぐ下着の名(側)
#FUNCTIONS
#DIM 側
#DIM 番号
#DIMS 上
#DIMS 下

番号 = 個室の番号(側)
上 '= ""
SIF 服の状態:側:服_上の下着
	上 '= 着ている名(番号, 服_上の下着)
下 '= ""
SIF 服の状態:側:服_下の下着
	下 '= 着ている名(番号, 服_下の下着)
SIF 上 == "" && 下 == ""
	RETURNF "下着"
SIF 上 == "" || 上 == 下
	RETURNF 下
SIF 下 == ""
	RETURNF 上
RETURNF 上 + "と" + 下

;その側が履いている足元の名前（「ニーソックスとブーツ」。片方なら一つ。無ければ "靴"）
@脱ぐ足元の名(側)
#FUNCTIONS
#DIM 側
#DIM 番号
#DIMS 下
#DIMS 履物

番号 = 個室の番号(側)
下 '= ""
SIF 服の状態:側:服_靴下
	下 '= 着ている名(番号, 服_靴下)
履物 '= ""
SIF 服の状態:側:服_靴
	履物 '= 着ている名(番号, 服_靴)
SIF 下 == "" && 履物 == ""
	RETURNF "靴"
SIF 下 == ""
	RETURNF 履物
SIF 履物 == ""
	RETURNF 下
RETURNF 下 + "と" + 履物


;見せる系の手で脱ぐものが残っているか。脱いで見せる手（下着を見せる）は上下の服のどちらかが残っていること。他の見せる手は脱ぐことが要らない
@見せるで脱げるか(行為)
#FUNCTION
#DIM 行為

SIF 行為 == 12
	RETURNF 服の状態:1:服_上 || 服の状態:1:服_下
RETURNF 1


;着替えを見せるが出るか。衣装棚に、いま着ている組と違う組があるか、同じ組しか無いときは主人公が脱いでいるものがある（着直せる）
@着替えられるか
#FUNCTION
#DIM 甲
#DIM あった
#DIMS 今

;（FUNCTION の中では CALL が使えないので @組の候補を集める は呼ばず、棚にある組を衣装台帳から直に見る）
今 '= 着ている組の名(MASTER)
あった = 0
FOR 甲, 0, 衣装数
	SIF !棚にあるか(衣装名:甲)
		CONTINUE
	SIF 衣装名:甲 != 今
		RETURNF 1
	あった = 1
NEXT
SIF !あった
	RETURNF 0
FOR 甲, 0, 服の枠数
	SIF 着ている名(MASTER, 甲) != "" && !服の状態:1:甲
		RETURNF 1
NEXT
RETURNF 0


;着替えを見せるで、何に着替えるかを棚から選ぶ（@一式で着替える と同じ。主人公は同意の判定なし）。選べば CSTR 着せた服装 を替え、その組の名前のある枠を全部着た状態にする（@個室に入る と同じ）。
;着替えた組 に名前を残す。やめれば RESULT＝0
@着替えの組を選ぶ
#DIM 甲
#DIM 数
#DIMS 名

PRINTL
PRINTFORML 何に着替えて見せる？（いま：%着ている組の名(MASTER)%）
CALL 組の候補を集める(1)
数 = RESULT
FOR 甲, 0, 数
	CALL 選択肢を並べる(甲, 甲 + 1, 組の候補:甲, 組の候補:甲 == 着ている組の名(MASTER), 4, "")
NEXT
PRINTL
PRINTL 　[0] やめる
INPUT
SIF RESULT < 1 || RESULT > 数
	RETURN 0
名 '= 組の候補:(RESULT - 1)
CALL 部位ごとの指定を消す(MASTER)
CSTR:MASTER:着せた服装 = %名%
FOR 甲, 0, 服の枠数
	服の状態:1:甲 = 着ている名(MASTER, 甲) != ""
NEXT
着替えた組 '= 名
RETURN 1


;個室の中で着替えるときの服の状態の合わせ方（[着替える]＝[1052]。2026-10-16 ユーザ「どこでも着替えられるように」。時間は使わず、相手は何も言わない）。
;服の状態は個室の中だけの持ち物（CSTR とは別）なので、着替えの関数（@部位を着せる／@一式で着替える／@元の服に戻す）が 着替え前を控える → 変えたあと 個室の服を合わせる を呼ぶ。
;名前が変わった枠は着る（名前が無くなれば着ていない）。変わらない枠は脱いだまま・着たままを引き継ぐ。強制枠＝名前が同じでもその枠は着る（部位を選び直して着直す）／服の枠数ならどの枠も着る（一式）／-1 は無し
@着替え前を控える(番号)
#DIM 番号
#DIM 甲

FOR 甲, 0, 服の枠数
	着替え前の名:甲 '= 着ている名(番号, 甲)
NEXT

@個室の服を合わせる(番号, 強制枠)
#DIM 番号
#DIM 強制枠
#DIM 側
#DIM 甲

側 = 個室の側(番号)
SIF 側 < 0
	RETURN 0
FOR 甲, 0, 服の枠数
	IF 着ている名(番号, 甲) != 着替え前の名:甲 || 甲 == 強制枠 || 強制枠 >= 服の枠数
		服の状態:側:甲 = 着ている名(番号, 甲) != ""
	ENDIF
NEXT


;見せる系の手で自分が脱ぐ。下着を見せる＝上下の服、秘部を見せる＝下の服と下の下着、自慰して見せる＝下の服
@見せるで脱ぐ(行為)
#DIM 行為

SELECTCASE 行為
	CASE 12
		服の状態:1:服_上 = 0
		服の状態:1:服_下 = 0
	CASE 13
		服の状態:1:服_下 = 0
		服の状態:1:服_下の下着 = 0
	CASE 14
		服の状態:1:服_下 = 0
ENDSELECT


;脱衣の地の文（行為ごとの @行為文_ が無いとき）。名前は @脱衣をする が 脱いだ物 に残したもの（「さくらのブラウスを脱がせた」「ブラとショーツを脱いだ」）
@脱衣の文(行為, 相手)
#DIM 行為
#DIM 相手
#DIMS 物

物 '= 脱いだ物
SIF 物 == ""
	物 '= "服"
;全部は「残っていた服を全部」なので「を」を重ねない（「服を全部を脱がせた」になっていた。2026-09-22）
SIF 脱衣の枠(行為) != 3
	物 += "を"
IF 行為 == 行為_全部脱がされる
	PRINTFORML %CALLNAME:相手%に%物%脱がされた
ELSEIF 脱衣の側(行為) == 0
	PRINTFORML %CALLNAME:相手%の%物%脱がせた
ELSE
	PRINTFORML %物%脱いだ
ENDIF


;拭う。二人の汚れ（とローション）を全部消す（時間は食わない）
@拭う(相手)
#DIM 相手
#DIM 側

FOR 側, 0, 2
	CALL 汚れを落とす(側)
NEXT
PRINTFORML 【拭う】
PRINTFORML %CALLNAME:相手%と自分の体を拭った


;その側の体の汚れとローションを全部消す（拭う・湯に浸かる・洗う）
@汚れを落とす(側)
#DIM 側
#DIM 甲

FOR 甲, 0, 部位の数
	体の汚れ:側:甲 = 0
NEXT
ローション:側 = 0


;浴室の行為の状態の変化（値は @行為の値を入れる がいつもどおり入れる）。湯は二人、洗うは洗われた側、ローションは塗られた側
@浴室の行為(行為, 相手)
#DIM 行為
#DIM 相手

SELECTCASE 行為
	CASE 行為_湯に浸かる
		;湯に入れば体勢は解ける（拘束は残る）。膣に残っている精液も流れる（自宅の風呂の「体を洗う」と同じ → 妊娠.ERB @膣を洗う）
		CALL モードを種別で消す(0)
		CALL 汚れを落とす(0)
		CALL 汚れを落とす(1)
		CALL 膣を洗う(相手)
		CALL 膣を洗う(MASTER)
	CASE 行為_体を洗う
		CALL 汚れを落とす(0)
		CALL 膣を洗う(相手)
	CASE 行為_体を洗わせる
		CALL 汚れを落とす(1)
		CALL 膣を洗う(MASTER)
	CASE 行為_ローションを塗る
		ローション:0 = 1
	CASE 行為_ローションを塗らせる
		ローション:1 = 1
ENDSELECT


;============================ 母乳 ============================
;母乳体質の者だけ Base 母乳 が動く（溜まるのは妊娠.ERB @母乳の日替わり）。→設計メモ「母乳」、画面イメージ「個室の中」の母乳

;搾乳する／授乳させる は相手が、搾乳させる／授乳する は主人公が出す側。母乳体質で量が 0 でないときだけ出る。それ以外の行為は常に 1
@母乳が出せるか(行為)
#FUNCTION
#DIM 行為
#DIM 出す側

出す側 = 母乳を出す側(行為)
SIF 出す側 < 0
	RETURNF 1
RETURNF TALENT:出す側:母乳体質 && BASE:出す側:母乳 > 0


;その行為で母乳を出す側の番号。搾乳・授乳でなければ -1
@母乳を出す側(行為)
#FUNCTION
#DIM 行為

SIF 行為名:行為 == "搾乳する" || 行為名:行為 == "授乳させる"
	RETURNF 裏の相手:MASTER:0
SIF 行為名:行為 == "搾乳させる" || 行為名:行為 == "授乳する" || 行為名:行為 == "授乳手淫"
	RETURNF MASTER
RETURNF -1


;搾乳は空にする（汚れなし）、授乳は 授乳の量 だけ減る
@母乳の行為(行為, 相手)
#DIM 行為
#DIM 相手
#DIM 出す側
#DIM 飲む側

出す側 = 母乳を出す側(行為)
SIF 出す側 < 0
	RETURN 0
IF STRFIND(行為名:行為, "搾乳") == 0
	BASE:出す側:母乳 = 0
	IF 出す側 == MASTER
		PRINTFORML %CALLNAME:相手%に%胸の語(MASTER)%を搾られ、母乳を出し切った
	ELSE
		PRINTFORML %CALLNAME:相手%の%胸の語(相手)%を搾り、母乳を出し切った
	ENDIF
ELSE
	飲む側 = MASTER
	SIF 出す側 == MASTER
		飲む側 = 相手
	BASE:出す側:母乳 -= 授乳の量
	SIF BASE:出す側:母乳 < 0
		BASE:出す側:母乳 = 0
	IF 出す側 == MASTER
		PRINTFORML %CALLNAME:相手%に乳首を含ませ、母乳を飲ませた
	ELSE
		PRINTFORML %CALLNAME:相手%の乳首を含み、母乳を飲んだ
	ENDIF
ENDIF


;張っている者の胸をその行為が使っていれば噴く。触れていた相手の部位にも付く
@噴乳を見る(番号, 行為, 側)
#DIM 番号
#DIM 行為
#DIM 側
#DIM 部位

SIF !母乳が張っているか(番号)
	RETURN 0
SIF !(使う部位(番号, 行為, 側) & (1 << 部位_胸))
	RETURN 0
;搾乳・授乳は自分で出しているので噴かない
SIF 母乳を出す側(行為) >= 0
	RETURN 0
部位 = 最初の部位(使う部位(相手の番号(番号), 行為, 1 - 側))
CALL 噴乳(番号, 部位)


;噴く。量が減り、自分の胸と（あれば）相手の部位に母乳の汚れ。回数は 噴乳回数
@噴乳(番号, 相手の部位)
#DIM 番号
#DIM 相手の部位
#DIM 側

BASE:番号:母乳 -= 噴乳の量
SIF BASE:番号:母乳 < 0
	BASE:番号:母乳 = 0
噴乳回数:番号:0 += 1
側 = 個室の側(番号)
IF 側 >= 0
	体の汚れ:側:部位_胸 |= 汚れ_母乳
	SIF 相手の部位 >= 0
		体の汚れ:(1 - 側):相手の部位 |= 汚れ_母乳
ENDIF
IF 噴乳回数:番号:0 == 1
	PRINTFORML %CALLNAME:番号%の胸から、初めて母乳が噴き出した
ELSE
	PRINTFORML %CALLNAME:番号%の胸から母乳が噴き出した
ENDIF


;射精した人の男性器を受けている相手の部位に精液が付く。フェラ→口、手淫→手、パイズリ→胸、素股・外出し→性器、Ａ挿入→尻。
