		CONTINUE
	IF 数 == 0
		;文や前の人の行と離す（行間をあける。2026-09-30 ユーザ指定）
		PRINTL 
		PRINTS "　"
		IF 番号 == MASTER
			PRINTS "あなた"
		ELSE
			PRINTS CALLNAME:番号
		ENDIF
		PRINTL 
	ENDIF
	;値は一つ一行（縦に並べる。2026-10-01 ユーザ指定「コマンドの結果のパラメータ変化は縦に並べて」）。値の名は全角4文字ぶんに揃える
	PRINTS "　　"
	数 += 1
	IF 項目 < 6 && (達した部位:枠 & (1 << 項目))
		SETCOLOR 絶頂の色
		PRINTFORM %値の名(項目), 8, LEFT%{控え値:枠:項目}→
		IF 項目 == 部位_男性器
			IF 空打ちした:枠 == 2
				PRINTS "ドライ"
			ELSEIF 空打ちした:枠
				PRINTS "空打ち"
			ELSEIF 強く達した部位:枠 & (1 << 項目)
				PRINTS "大量射精"
			ELSE
				PRINTS "射精"
			ENDIF
		ELSE
			IF 強く達した部位:枠 & (1 << 項目)
				PRINTS "強絶頂"
			ELSE
				PRINTS "絶頂"
			ENDIF
		ENDIF
		RESETCOLOR
		PRINTL 
		CONTINUE
	ENDIF
	IF 差 > 0
		SETCOLOR 増える色
	ELSE
		SETCOLOR 減る色
	ENDIF
	;0 からの上がりは「+20」だけ（「+20(→20)」と二度言わない）。体力など 12 以降は常に行き先も出す
	IF 項目 < 12 && 控え値:枠:項目 == 0
		PRINTFORM %値の名(項目), 8, LEFT%%符号付き(差)%
	ELSEIF 項目 == 17
		PRINTFORM %値の名(項目), 8, LEFT%%符号付き(差)%(→%金額(今)%円)
	ELSE
		PRINTFORM %値の名(項目), 8, LEFT%%符号付き(差)%(→{今})
	ENDIF
	RESETCOLOR
	PRINTL 
NEXT
SIF 数 > 0
	変化を出した = 1


;絶頂・射精したとき、その場で「★ ○○は膣で絶頂！」を出し、変化の行で「絶頂」と出すための印を付ける。部位 0〜4 は絶頂、5 は射精
@達したと知らせる(番号, 部位)
#DIM 番号
#DIM 部位
#DIM 枠
#DIMS 激しさ

枠 = 0
SIF 番号 == MASTER
	枠 = 1
;三人の場面の同席側は 3（対象の枠 0 に混ぜない。同時絶頂の判定は 0 と 1 だけを見る）
SIF 裏の同席:MASTER:0 > 0 && 番号 == 裏の同席:MASTER:0
	枠 = 3
達した部位:枠 |= 1 << 部位
SIF 今回の強絶頂
	強く達した部位:枠 |= 1 << 部位
SIF 今回の空打ち
	空打ちした:枠 = 1 + 今回のドライ
;主人公はコマンド全体の枠（2。→USERCOM.ERB @USERCOM_本体）にも印を付ける。自慰のように行為の枠を通らない手でも「絶頂」と出す
IF 番号 == MASTER
	達した部位:2 |= 1 << 部位
	SIF 今回の強絶頂
		強く達した部位:2 |= 1 << 部位
ENDIF
PRINTL 
SETCOLOR 絶頂の色
PRINTS "　★ "
IF 番号 == MASTER
	PRINTS "あなたは"
ELSE
	PRINTS CALLNAME:番号
	PRINTS "は"
ENDIF
IF 部位 == 部位_男性器
	IF 今回の空打ち && 今回のドライ
		PRINTL ドライで達した！　何も出ないまま、中が痙攣している
	ELSEIF 今回の空打ち
		PRINTL 達したが、出るものは無かった（空打ち）
	ELSEIF 今回の強絶頂
		PRINTL 大量に射精した！
	ELSE
		PRINTL 射精した！
	ENDIF
ELSE
	激しさ '= ""
	SIF 今回の強絶頂
		激しさ '= "激しく"
	SELECTCASE 部位
		CASE 0
			PRINTFORML 口で%激しさ%絶頂した！
		CASE 1
			PRINTFORML 胸で%激しさ%絶頂した！
		CASE 2
			PRINTFORML クリトリスで%激しさ%絶頂した！
		CASE 3
			PRINTFORML 膣で%激しさ%絶頂した！
		CASE 4
			PRINTFORML 尻で%激しさ%絶頂した！
	ENDSELECT
ENDIF
RESETCOLOR


;勃起を上げる（→@行為の値を入れる。erablue_resort の勃起度上昇 に倣う。2026-09-24 ユーザ指摘）
@勃起を上げる(番号, 量)
#DIM 番号
#DIM 量

SIF 量 <= 0
	RETURN 0
;入った量に 勃起の上がり率％ を掛ける（個室・セクハラ・見て昂ぶる・欲情の分すべて共通）
量 = 量 * 勃起の上がり率 / 100
PALAM:番号:勃起 += 量
SIF PALAM:番号:勃起 > PALAM上限
	PALAM:番号:勃起 = PALAM上限


;勃起を下げる（一手ごとの自然減衰と、射精後の落ち着きに使う。→@行為をする、@射精を見る）
@勃起を下げる(番号, 量)
#DIM 番号
#DIM 量

SIF 量 <= 0
	RETURN 0
PALAM:番号:勃起 -= 量
SIF PALAM:番号:勃起 < 0
	PALAM:番号:勃起 = 0


;セクハラで部位に快感を足した後の昂ぶり（欲情・勃起・潤滑・理性）。個室の @行為の値を入れる と同じ比率で動かす
;欲情＝快感の1割、勃起＝男性器そのものならフル・他の部位は1/5・欲情が上がった分の1/5。部位は触れられた部位（その人が持つ部位だけ渡す。→行動.ERB @セクハラする、客.ERB @セクハラを受ける）
@触れられて昂ぶる(番号, 部位)
#DIM 番号
#DIM 部位
#DIM 欲情の入り

欲情の入り = 体質の倍率(番号, セクハラの快感 / 10, GETNUM(TALENT, "快感に素直"), GETNUM(TALENT, "快感の否定"))
CALL その場の値を足す(番号, 8, 欲情の入り)
IF 部位のある性別:部位_男性器 & 性別ビット(番号)
	IF 部位 == 部位_男性器
		CALL 勃起を上げる(番号, セクハラの快感)
	ELSE
		CALL 勃起を上げる(番号, セクハラの快感 / 5)
	ENDIF
	CALL 勃起を上げる(番号, 欲情の入り / 5)
ENDIF
CALL 性の値を整える(番号)


;見た目の刺激で欲情が上がる。相手の露出度（客.ERB @目の保養 と同じ式）と、見えていれば相手の勃起の高まりを見て、一手ごとにわずかに乗る
;（→@行為をする。2026-09-24 ユーザ指定「露出の高い服や裸、勃起している様子を見ることで欲情は変動する？」。数は仮）
@見て昂ぶる(番号, 相手, 相手の側)
#DIM 番号
#DIM 相手
#DIM 相手の側
#DIM 値

値 = (露出度(相手) - 露出の基礎) / 目の保養の割
SIF (部位のある性別:部位_男性器 & 性別ビット(相手)) && 性器が見えるか(相手の側)
	値 += PALAM:相手:勃起 / 勃起を見る割
SIF 値 <= 0
	RETURN 0
CALL その場の値を足す(番号, 8, 値)
CALL 性の値を整える(番号)


;欲情から出す値：潤滑（女性器のある性別）＝欲情/2、理性＝上限−酔い−欲情/2。勃起は別（→@勃起を上げる）
@性の値を整える(番号)
#DIM 番号

IF 性別ビット(番号) & 6
	;濡れやすい／濡れにくい で欲情からの付き方が変わる
	;絶頂のたび積んだ余韻（@絶頂で濡れる）が上に乗る。絶頂で欲情が半分になっても潤滑は下がらない
	PALAM:番号:潤滑 = 体質の倍率(番号, PALAM:番号:欲情 / 2 + 潤滑の余韻:番号:0, GETNUM(TALENT, "濡れやすい"), GETNUM(TALENT, "濡れにくい"))
	SIF PALAM:番号:潤滑 > PALAM上限
		PALAM:番号:潤滑 = PALAM上限
ELSE
	PALAM:番号:潤滑 = 0
ENDIF
;勃起は欲情から出す即時計算をやめ、行為ごとに独立して上下する値にした（→@勃起を上げる／@勃起を下げる。2026-09-24 ユーザ指摘「erablueに比べて勃起が上がりにくい、上がってなくても挿入できる」）。ここでは持たない性別を0に戻すだけ
SIF !(性別ビット(番号) & 5)
	PALAM:番号:勃起 = 0
CALL 理性を出す(番号)


;絶頂（射精も）で膣のある側が濡れる。欲情を減らす行の直前に呼ぶ（→変数定義.ERH 絶頂の潤滑）。上限は潤滑がPALAM上限で頭打ちになる分まで
@絶頂で濡れる(番号)
#DIM 番号

SIF !(性別ビット(番号) & 6)
	RETURN 0
潤滑の余韻:番号:0 += 絶頂の潤滑
SIF 潤滑の余韻:番号:0 > PALAM上限
	潤滑の余韻:番号:0 = PALAM上限


;理性＝上限−酔い−欲情/2（→設計メモ「行為の値」。酔いが動いたときと行為の後に呼ぶ）
@理性を出す(番号)
#DIM 番号

PALAM:番号:理性 = 理性の上限 - BASE:番号:酔い - PALAM:番号:欲情 / 2
SIF PALAM:番号:理性 < 0
	PALAM:番号:理性 = 0


;一手の文。分類ごとの一文と、初めてなら添える
;見出しに添える服の一言を、この個室でまだ出していなければ 1（出したことにする）。出していれば 0
@服の文を初めて出すか(側, 文)
#FUNCTION
#DIM 側
#DIMS 文

SIF STRFIND(出した服の文:側, "|" + 文 + "|") >= 0
	RETURNF 0
出した服の文:側 += "|" + 文 + "|"
RETURNF 1


@行為の文(行為, 相手)
#DIM 行為
#DIM 相手
#DIMS 文0
#DIMS 文1

PRINTFORM 【%行為名:行為%】
今回の触れ方口上 = 0
;着たまま使う服や下着があれば、ずらして（erablue_resort の「下着をずらして露出させた」「服を捲り上げて露出させた」→ 画面イメージ「個室の中」の脱衣と汚れ）。
;同じ一言は一度だけ（毎手「…の上から」と出るのはだるい。2026-10-27 ユーザ指摘）。脱ぐ・見せるで服が変わったら出し直す
IF 行為の分類:行為 != 分類_脱衣 && 行為の分類:行為 != 分類_見せる
	文0 '= 服のずらし文(行為, 0)
	文1 '= 服のずらし文(行為, 1)
	SIF 文0 != "" && 服の文を初めて出すか(0, 文0)
		PRINTFORM （%CALLNAME:相手%の%文0%）
	SIF 文1 != "" && 服の文を初めて出すか(1, 文1)
		PRINTFORM （%文1%）
ELSE
	出した服の文:0 '= ""
	出した服の文:1 '= ""
ENDIF
PRINTL 
;行為ごとの地の文があればそれ（ERB/行為文.ERB の @行為文_{番号}）。無ければ分類と向きで一文
;（→画面イメージ「個室の中」の行為の文）
TRYCCALLFORM 行為文_{行為}(相手, 行為の向き:行為)
CATCH
CALL 行為の共通文(行為, 相手)
ENDCATCH
;破瓜（この手で処女が散った）なら地の文を添え、散った側の口上は行為の口上でなく破瓜の口上（→「処女・童貞」）
CALL 破瓜の文(行為, 相手)
;受け手の様子を一文足す（愛撫・奉仕・Ｖ系・Ａ系。盛り上がるほど出やすい。→ERB/追い文.ERB）
CALL 行為の追い文(行為, 相手)
;相手の口上（キャラ別 → 口上タイプ別 → 無ければ出さない）。気絶して眠っていれば口上は無い（→気絶.ERB）
IF 気絶中:相手:0
	PRINTFORML （%CALLNAME:相手%は眠ったまま）
ELSEIF 破瓜か(行為, 相手) == 1
	CALL 破瓜の口上(相手)
ELSE
	CALL 行為の口上(相手, 行為, 行為の向き:行為)
ENDIF
;主人公の口上（固有 → 口上タイプ_主人公 → 無ければ出さない。2026-09-15）
IF 破瓜か(行為, 相手) == 2
	CALL 主人公の破瓜の口上
ELSE
	CALL 主人公の行為の口上(行為, 行為の向き:行為)
ENDIF
;性癖に当たる手なら反応の一言（相手→主人公の順。→ERB/性癖.ERB）
CALL 性癖の反応(相手, 行為, 0)
CALL 性癖の反応(MASTER, 行為, 1)
;処女・Ａ処女・童貞は、この手で挿入の回数が 1 になったとき失う（→「処女・童貞」）
CALL 喪失の文(行為, 相手)


;行為ごとの地の文が無いときの一文。分類と向き（0＝主人公が客に、1＝客が主人公に、2＝双方）で
@行為の共通文(行為, 相手)
#DIM 行為
#DIM 相手

SELECTCASE 行為の分類:行為
	CASE 0
		PRINTFORML %CALLNAME:相手%と二人きりの時間を過ごした
	CASE 1
		PRINTFORML %CALLNAME:相手%の目の前で見せた
	CASE 2
		IF 行為の向き:行為 == 1
			PRINTFORML %CALLNAME:相手%に触らせた
		ELSEIF 行為の向き:行為 == 2
			PRINTFORML %CALLNAME:相手%と互いに触れ合った
		ELSE
			PRINTFORML %CALLNAME:相手%の体に触れた
		ENDIF
	CASE 3
		IF 行為の向き:行為 == 1
			PRINTFORML %CALLNAME:相手%に奉仕させた
		ELSEIF 行為の向き:行為 == 2
			PRINTFORML %CALLNAME:相手%と擦り合わせた
		ELSE
			PRINTFORML %CALLNAME:相手%に奉仕した
		ENDIF
	CASE 4, 5
		IF 行為の向き:行為 == 1
			PRINTFORML %CALLNAME:相手%に貫かれた
		ELSE
			PRINTFORML %CALLNAME:相手%と体を重ねた
		ENDIF
	CASE 分類_脱衣
		CALL 脱衣の文(行為, 相手)
	CASEELSE
		IF 拘束か(行為)
			IF 行為の向き:行為 == 1
				PRINTFORML %CALLNAME:相手%に自由を奪われた
			ELSE
				PRINTFORML %CALLNAME:相手%の自由を奪った
			ENDIF
		ELSEIF 行為の向き:行為 == 1
			PRINTFORML %CALLNAME:相手%にされた
		ELSE
			PRINTFORML %CALLNAME:相手%にした
		ENDIF
ENDSELECT


;相手の口上。段で落とす（→設計メモ「口上の窓口」、画面イメージ「個室の中」の行為の文）：
;口上_行為_{キャラ番号}(番号, 行為, 向き) → 口上_行為_{タイプ}_{性別}(…) → 口上_行為_{タイプ}(…) → 何も出さない。
;性別は 男／女／ふたなり／性別なし。**ふたなりは _ふたなり が無いか空なら _女 に落ちる**（女のファイルが挿入する側の行為も持つ。2026-09-14 ユーザ指定）、性別なしは共通へ。
;どの段も空を返せば次の段に落ちる（キャラ別が空でも落ちる。2026-09-14 ユーザ指定）。
;書き手は RESULTS に台詞を返す。空なら次の段へ。入口の規約は公開後に変えない
@行為の口上(番号, 行為, 向き)
#DIM 番号
#DIM 行為
#DIM 向き
#DIM 段
#DIM 区分
#DIMS タイプ
#DIMS 性別
#DIMS 方言

;どの段も、無いか空を返せば次の段に落ちる（キャラ別が空でも落ちる。2026-09-14 ユーザ指定「空の場合はタイプ別に」）
;盛り上がりの段が 1 以上なら、各段で先に 口上_盛り上がり_… を呼び、空ならその段のいまの口上に落ちる（2026-10-01 ユーザ指定。→画面イメージ「個室の中」の盛り上がりで変わる口上）
