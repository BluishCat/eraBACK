FOR 枠, 0, 服の枠数
	IF 側 >= 0
		着ている:枠 = 服の状態:側:枠
	ELSE
		着ている:枠 = 着ている名(番号, 枠) != ""
	ENDIF
NEXT
出力 '= ""
IF !着ている:服_上 && !着ている:服_下 && !着ている:服_上の下着 && !着ている:服_下の下着
	出力 '= "[全裸]"
ELSE
	;服。上下一体は上の枠で一つだけ出す
	SIF 着ている:服_上
		出力 += 枠の表示(番号, 服_上)
	SIF 着ている:服_下 && 服の枠(番号, 服_上) != 枠_上下一体
		出力 += 枠の表示(番号, 服_下)
	;下着。脱いだものは ノーブラ／肌着なし／ノーパン
	IF 着ている:服_上の下着
		出力 += 枠の表示(番号, 服_上の下着)
	ELSEIF 性別ビット(番号) & 6
		出力 += "[ノーブラ]"
	ELSE
		出力 += "[肌着なし]"
	ENDIF
	IF 着ている:服_下の下着
		SIF 服の枠(番号, 服_上の下着) != 枠_上下一体の下着 || !着ている:服_上の下着
			出力 += 枠の表示(番号, 服_下の下着)
	ELSE
		出力 += "[ノーパン]"
	ENDIF
ENDIF
;靴下・靴
SIF 着ている:服_靴下
	出力 += 枠の表示(番号, 服_靴下)
SIF 着ている:服_靴
	出力 += 枠の表示(番号, 服_靴)
;小物（・区切り）
名 '= 小物の名(番号)
IF 名 != ""
	SPLIT 名, "・", 小物
	数 = RESULT
	FOR 甲, 0, 数
		SIF 小物:甲 != ""
			出力 += "[" + 小物:甲 + "]"
	NEXT
ENDIF
RETURNF 出力


;「[ブラウス（はだけ可）]」。その枠に着ているものの名前と、性質があれば括弧
@枠の表示(番号, 枠)
#FUNCTIONS
#DIM 番号
#DIM 枠
#DIM 甲
#DIMS 名
#DIMS 性質

名 '= 着ている名(番号, 枠)
SIF 名 == ""
	RETURNF ""
性質 '= ""
FOR 甲, 0, 3
	SIF !服の性質か(番号, 枠, 甲)
		CONTINUE
	SIF 性質 != ""
		性質 += "・"
	性質 += 性質の名:甲
NEXT
RETURNF "[" + 名 + 性質の括弧(性質) + "]"


;「（はだけ可）」。空なら ""
@性質の括弧(文)
#FUNCTIONS
#DIMS 文

SIF 文 == ""
	RETURNF ""
RETURNF "（" + 文 + "）"
