IF RESULT == 1
	PRINTFORML 　%RESULTS%
	RETURN 0
ENDIF
;手で触れる行為は、触れ方（服の上から／つっこんで／直接）の口上を先に呼ぶ。高まり（盛り上がりの段 2）のときは譲る（→ERB/口上/触れ方.ERB。2026-10-15）
区分 = 触れ方の区分(行為)
;同じ触れ方（群と区分）では二度目から言わない。服が変わって区分が変わったら言う（2026-10-27 ユーザ指摘「毎回出るのもだるい」）
IF 区分 > 0 && 段 < 2 && 触れ方の口上済:0:(触れ方の群(行為)) != 区分
	CALL 触れ方の口上を出す(番号, 行為, 向き, 区分)
	IF RESULT == 1
		触れ方の口上済:0:(触れ方の群(行為)) = 区分
		今回の触れ方口上 = 1
		RETURN 0
	ENDIF
ENDIF
CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, TOSTR(番号))
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
方言 '= 方言の接尾(番号)
;方言が付いていれば、各段で先に _方言 付きを呼ぶ（2026-10-01 ユーザ指定。→設計メモ「口上の方言」）
IF RESULTS == "" && 方言 != ""
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, @"%タイプ%_%性別%%方言%")
ENDIF
IF RESULTS == ""
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, @"%タイプ%_%性別%")
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && 方言 != ""
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, @"%タイプ%_女%方言%")
ENDIF
IF RESULTS == "" && 性別 == "ふたなり"
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, @"%タイプ%_女")
ENDIF
IF RESULTS == "" && 方言 != ""
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, @"%タイプ%%方言%")
ENDIF
IF RESULTS == ""
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, タイプ)
ENDIF
SIF RESULTS != ""
	PRINTFORML 　%RESULTS%


;一つの段（キャラ別／タイプ_性別／…）の行為の口上を呼ぶ。名は 口上_行為_ の後ろの部分（キャラ番号・タイプ_性別・タイプ…）。
