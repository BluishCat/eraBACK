IF RESULTS == ""
	CALL 絶頂の口上を呼ぶ(番号, 部位, 回数, @"%タイプ%_%性別%")
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && 方言 != ""
	CALL 絶頂の口上を呼ぶ(番号, 部位, 回数, @"%タイプ%_女%方言%")
