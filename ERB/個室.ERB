;================================ 体位を変える（2026-09-28 memo「体位変更と挿入状態の派生コマンドが混ざっていてわかりにくい」） ================================
;Ｖ系・Ａ系の体位そのもの（要るモード無し）をサブメニューにまとめた入口（→個室.ERB @行為の行）。
;種別：0=Ｖ系する 1=Ｖ系させる 2=Ａ系する 3=Ａ系させる。いまの体勢と同じ体位は 行為ができるか で既に外れている（衝突するモード）
@体位を選ぶ(種別)
#DIM 種別
#DIM 分類
#DIM 向き
#DIM 行為
#DIM 候補, 32
#DIM 数
#DIM 甲

分類 = 4
SIF 種別 >= 2
	分類 = 5
向き = 種別 % 2

数 = 0
FOR 行為, 0, 行為数
	SIF 行為名:行為 == "" || 行為の分類:行為 != 分類 || 行為の向き:行為 != 向き || 行為の要るモード:行為 != "" || !行為ができるか(行為, いまの系統())
		CONTINUE
	SIF 数 >= 32
		BREAK
	候補:数 = 行為
	数 += 1
NEXT
SIF 数 == 0
	RETURN 0

PRINTL
PRINTL 体位を選んでください
FOR 甲, 0, 数
	PRINTFORM 　[{甲}] %行為名:(候補:甲)%
	SIF (甲 % 4) == 3 || 甲 == 数 - 1
		PRINTL
NEXT
PRINTL 　[99] やめる
INPUT
SIF RESULT < 0 || RESULT >= 数
	RETURN 0
CALL 行為をする(候補:RESULT)
RETURN 1


;================================ 要望（memo「erablueみたいに、行為の際にNPCから要望をいってきたりするように」。2026-09-24） ================================
;一手の終わりに、相手が次にしてほしい行為をねだってくることがある。向きは問わない（相手がする側／される側どちらの行為も対象）。
;対象は愛撫・奉仕・Ｖ系・Ａ系・特殊・浴室（会話・見せる・脱衣は対象外）。裏の好み（系統名＋「好き」）に合う行為ほど出やすい。
;断っても何も残らない（好感度等は動かさない）。応じれば普段どおり一手消費してその行為を行う（RETURN：1＝応じて一手消費した）
@要望を出す(相手)
#DIM 相手
#DIM 行為

SIF !要望が起きるか(相手)
	RETURN 0
行為 = 要望の行為を選ぶ(相手, 0)
SIF 行為 < 0
	RETURN 0
PRINTL
PRINTFORML %CALLNAME:相手%が%行為名:行為%をねだっている
PRINTL 　[0] 応える　[1] 断る
INPUT
;画面に残っている［終える］を押したときは、ねだりを断って場面を終える（応えたことにして続行しない）
IF RESULT == 終えるボタン
	CALL 個室を終える
	RETURN 1
ENDIF
SIF RESULT != 0
	RETURN 0
;入力の間に場面が終わっていたら（相手がもういない）続行しない
SIF 裏の相手:MASTER:0 != 相手
	RETURN 1
CALL 行為をする(行為)
RETURN 1


;要望が起きる確率（欲情が高いほど出やすい）
@要望が起きるか(相手)
#FUNCTION
#DIM 相手
#DIM 率

率 = 要望の基本率
SIF 昂ぶりか(相手)
	率 += 要望の基本率
RETURNF RAND:100 < 率


;要望する行為を選ぶ。いま選べる行為（行為ができるか）のうち、要望の対象になる分類だけが候補。
;裏の好み（系統名＋「好き」）に合う行為は 裏の好みの重み ぶん候補に重ねる（客.ERB @指名する商品 と同じ作り）。無ければ -1
;主導：1 なら相手がする側の手（向き 1＝させる・2＝双方）だけ（なすがまま。→@なすがまま）。0 なら向きは問わない
@要望の行為を選ぶ(相手, 主導)
#FUNCTION
#DIM 相手
#DIM 主導
#DIM 行為
#DIM 候補, 256
#DIM 数
#DIM 重み
#DIM 回

数 = 0
FOR 行為, 0, 行為数
	SIF 行為名:行為 == "" || !要望の分類か(行為の分類:行為) || !行為ができるか(行為, いまの系統())
		CONTINUE
	SIF 主導 && 行為の向き:行為 == 0
		CONTINUE
	;裏の好みと性癖はそれぞれ重みを足す（どちらも無ければ 1。相手は台帳の側 0。→ERB/性癖.ERB）
	重み = 0
	SIF 裏の好みか(相手, 行為の系統:行為)
		重み += 裏の好みの重み
	SIF 当たる性癖(相手, 行為, 0) >= 0
		重み += 性癖の重み
	SIF 重み == 0
		重み = 1
	FOR 回, 0, 重み
		SIF 数 >= 256
			BREAK
		候補:数 = 行為
		数 += 1
	NEXT
NEXT
SIF 数 == 0
	RETURNF -1
RETURNF 候補:(RAND:数)


;要望の対象になる分類か（愛撫・奉仕・Ｖ系・Ａ系・特殊・浴室。会話・見せる・脱衣は対象外）
@要望の分類か(分類)
#FUNCTION
#DIM 分類

RETURNF 分類 == 2 || 分類 == 3 || 分類 == 4 || 分類 == 5 || 分類 == 6 || 分類 == 8


;================================ なすがまま（逢引。2026-10-03 ユーザ指定「逢引中に「なすがまま」コマンドを追加」） ================================
;あなたは選ばず、相手が自分で次の手を選んで なすがままの手数 手続ける（erablue_resort の「なすがまま」＝５回連続で相手がオートコマンドで動く、に倣う）。
;選ぶ手は 相手がする側（向き 1・2）の、要望と同じ分類のうち いま選べるもの。選び方（裏の好みの重ね）は要望と同じ（→@要望の行為を選ぶ）。
;途中で止まる：選べる手が無くなった／見つかって反応が出た／場面が終わった。一手ごとに WAIT で止まり（流れて読めなくなるので。2026-10-03 ユーザ指摘）、要望だけは省く

;なすがままで選べる手が一つでもあるか（出る条件。選べないコマンドは出さない）
@なすがままができるか
#FUNCTION
#DIM 行為

SIF 裏の相手:MASTER:0 <= 0
	RETURNF 0
FOR 行為, 0, 行為数
	SIF 行為名:行為 != "" && 行為の向き:行為 != 0 && 要望の分類か(行為の分類:行為) && 行為ができるか(行為, いまの系統())
		RETURNF 1
NEXT
RETURNF 0


;押すたびに続ける手数。設定（設定メニュー [7]）の値。未設定（0）は 1 手
@なすがままの手数
#FUNCTION
RETURNF MAX(1, MIN(設定_なすがまま手数, なすがままの手数の上限))


@なすがまま
#DIM 相手
#DIM 何手目
#DIM 手数
#DIM 行為
#DIM 続けた

相手 = 裏の相手:MASTER:0
SIF 相手 <= 0 || 裏の商品:MASTER:0 != 商品_逢引
	RETURN 0
IF !なすがままができるか()
	PRINTL いまはできない
	WAIT
	RETURN 0
ENDIF

PRINTL
PRINTFORML あなたは%CALLNAME:相手%に身を任せた
なすがまま中 = 1
手数 = なすがままの手数()
FOR 何手目, 0, 手数
	行為 = 要望の行為を選ぶ(相手, 1)
	IF 行為 < 0
		PRINTL
		PRINTL （これ以上、続けられる手がない）
		BREAK
	ENDIF
	;一手ごとの区切り（どの手の文・変化かが分かるように見出しを置く）
	PRINTL
	IF 手数 > 1
		PRINTFORML ──── なすがまま {何手目 + 1}/{手数}：%行為名:行為% ────
	ELSE
		PRINTFORML ──── なすがまま：%行為名:行為% ────
	ENDIF
	CALL 行為をする(行為)
	;場面が終わったか、見つかって反応が出た（@行為をする が なすがまま中 を 0 に戻す）なら続けない
	SIF 裏の相手:MASTER:0 != 相手 || !なすがまま中
		BREAK
	;一手ごとに止まる（流れて読めなくなるので）。最後の一手は下の WAIT で止まる
	SIF 何手目 < 手数 - 1
		WAIT
NEXT
;反応が出ていれば その中で WAIT 済み
続けた = なすがまま中
なすがまま中 = 0
SIF 続けた
	WAIT


;台帳の値をその場の値に。側：0=受け手 1=提供側（→画面イメージ「個室の中」の仮の式）
@行為の値を入れる(番号, 行為, 側)
#DIM 番号
#DIM 行為
#DIM 側
#DIM 部位
#DIM 入り
#DIM 幅
#DIM される
#DIM もう一方
#DIM 欲情の入り

;快感は部位に。感度が上がるほど入りやすい（感度1000で2倍）
入り = 0
部位 = 実際の部位(番号, 行為の部位:行為:側)
IF 部位 >= 0 && 行為の快感:行為 > 0
	入り = 行為の快感:行為 * (100 + 開発度_感度:番号:部位 / 10) / 100
	入り = 体質の倍率(番号, 入り, 敏感の始め + 部位, 鈍感の始め + 部位)
	;性癖に当たる手なら ×性癖の強/性癖の弱（→ERB/性癖.ERB）
	入り = 性癖で掛ける(番号, 行為, 側, 入り)
	;ローションまみれなら滑って入りやすい（主人公の室だけ。→画面イメージ「個室の浴室と、ローション・プレイマット」）
	SIF 個室の側(番号) == 側 && ローション:側
		入り = 入り * ローションの倍率 / 100
	CALL その場の値を足す(番号, 部位, 入り)
	;勃起は独立に管理する（→@勃起を上げる、erablue_resort 参考。2026-09-24 ユーザ指摘）。
	;自分が男性器を持てば入った快感が上昇に（男性器そのものはフル、他の部位はその1/5）。もう一方が男性器を持てば、この快感の1/5がそちらの勃起にも（見て昂ぶる分）
	IF 部位のある性別:部位_男性器 & 性別ビット(番号)
		IF 部位 == 部位_男性器
			CALL 勃起を上げる(番号, 入り)
		ELSE
			CALL 勃起を上げる(番号, 入り / 5)
		ENDIF
	ENDIF
	もう一方 = 裏の相手:MASTER:0
	SIF 側 == 0
		もう一方 = MASTER
	SIF 部位のある性別:部位_男性器 & 性別ビット(もう一方)
		CALL 勃起を上げる(もう一方, 入り / 5)
ENDIF
;苦痛と羞恥は「される側」にだけ（向き 0＝受け手、1＝提供側、2＝両方）。耐性・慣れで減る（下限は半分）
される = 行為の向き:行為 == 2 || (行為の向き:行為 == 0 && 側 == 0) || (行為の向き:行為 == 1 && 側 == 1)
IF される && 行為の苦痛:行為 > 0
	幅 = 行為の苦痛:行為 * (100 - 開発度_耐性:番号:0 / 10) / 100
	SIF 幅 < 行為の苦痛:行為 / 2
		幅 = 行為の苦痛:行為 / 2
	幅 = 体質の倍率(番号, 幅, GETNUM(TALENT, "痛みに弱い"), GETNUM(TALENT, "痛みに強い"))
	CALL その場の値を足す(番号, 6, 幅)
ENDIF
IF される && 行為の羞恥:行為 > 0
	幅 = 行為の羞恥:行為 * (100 - 開発度_慣れ:番号:0 / 10) / 100
	SIF 幅 < 行為の羞恥:行為 / 2
		幅 = 行為の羞恥:行為 / 2
	幅 = 体質の倍率(番号, 幅, GETNUM(TALENT, "恥じらい"), GETNUM(TALENT, "恥薄い"))
	;脱衣・見せるは、脱ぐ前から露出が高いほど恥ずかしくない（→画面イメージ「個室の中」の露出度。全部着て ×1、下着姿から ×0.4）
	SIF 行為の分類:行為 == 分類_脱衣 || 行為の分類:行為 == 分類_見せる
		幅 = 幅 * (1000 - 脱ぐ前の露出度:側) / 露出の羞恥の幅
	CALL その場の値を足す(番号, 7, 幅)
ENDIF
;欲情は直接の分に、その手で入った快感の1割。快感に素直／快感の否定で伸びが変わる
欲情の入り = 体質の倍率(番号, 行為の欲情:行為 + 入り / 10, GETNUM(TALENT, "快感に素直"), GETNUM(TALENT, "快感の否定"))
;性癖に当たる手は欲情も ×性癖の強/性癖の弱（快感の分は上で掛け済みなので、ここは直接の分も含めて掛ける）
欲情の入り = 性癖で掛ける(番号, 行為, 側, 欲情の入り)
