;主人公が入っている個室（→画面イメージ「個室の中」）。行為を一手ずつ選んで積む。
;商品が場面の枠、行為がその中の操作（→設計メモ「系統・商品・行為は別の層」）。
;その場の値（PALAM 12本）はここでだけ動き、出るときに開発度へ残して消える（→設計メモ「行為の値」）。
;スタッフだけの室にはこの画面は無い（→設計メモ「他室の進行」、客.ERB の @裏を終える）

@SHOW_USERCOM_個室
#DIM サイド行数
#DIM 開始行
#DIM 相手
#DIM 商品
#DIM 残り
#DIM 分類
#DIM 甲

相手 = 裏の相手:MASTER:0
商品 = 裏の商品:MASTER:0
残り = 裏の終わり:MASTER:0 - (経過日数 * 1440 + 現在時刻)
SIF 残り < 0
	残り = 0

DRAWLINE
開始行 = LINECOUNT
CALL サイド領域描画
HTML_PRINT RESULTS, 1
サイド行数 = RESULT

CALL ヘッダ
;場所名の行は世界と場所の情報だけ（場面のことは載せない。2026-09-13 ユーザ指摘）
PRINTFORML %GET_PLACE_NAME(CFLAG:MASTER:現在位置)%
CALL 本文罫線
CALL 同室者表示
CALL 主役の段
CALL あなたの段
;場面：商品名（相手）と残り時間、続いている状態を一行ずつ、それぞれに [✕]（erablue_resort の H状態表示の形 → 画面イメージ「個室の中」）
SETCOLOR 255, 150, 200
IF 商品 == 商品_夜這い
	;夜這い（商品も時間も無い → 夜這い.ERB）
	PRINTFORM 　夜這い（%CALLNAME:相手%）
ELSEIF 商品 == 商品_舞台
	;お迎え棒の場面（→「舞台の場面」）。見ている客の数を添える
	PRINTFORM 　地下ステージ（%CALLNAME:相手%）　客 {客の数(地下ホールの位置)}人が見ている
ELSEIF 商品 == 商品_処女の舞台
	;処女オークションの舞台（→「舞台の場面」）。落札額を添える
	PRINTFORM 　地下ステージ（%CALLNAME:相手%）　客 {客の数(地下ホールの位置)}人が見ている　落札 %TOSTR(処女の落札額, "#,0")%円
ELSEIF 商品 == 商品_プレイルーム
	;後付け施設のプレイルーム（商品も時間も無い → 施設.ERB）
	PRINTFORM 　プレイルーム（%CALLNAME:相手%）
ELSEIF 商品 < 0
	;自宅の風呂と、後付け施設の浴場と、逢引（商品も時間も無い）。三人の場面なら同席側を添える（→見つかる.ERB）
	PRINTFORM 　%GET_PLACE_NAME(CFLAG:MASTER:現在位置)%（%CALLNAME:相手%）
	SIF 裏の同席:MASTER:0 > 0
		PRINTFORM 　同席：%CALLNAME:(裏の同席:MASTER:0)%
ELSE
	PRINTFORM 　%商品名:商品%（%CALLNAME:相手%）　あと{残り}分
ENDIF
;相手が気絶して眠っていれば添える（→気絶.ERB）
SIF 気絶中:相手:0
	PRINTFORM 　%CALLNAME:相手%は気絶して眠っている
PRINTL 
RESETCOLOR
CALL 状態の行

;分類ごとにカテゴリ（並びは 分類の順。脱衣は見せるの次）。この商品で出ない分類は見出しごと出さない
FOR 甲, 0, 行為分類数
	分類 = 分類の順:甲
	SIF !分類が出るか(分類, いまの系統())
		CONTINUE
	CALL カテゴリ罫線(行為分類名:分類, 行為カテゴリ + 分類)
	SIF RESULT
		CALL 行為の行(分類, いまの系統())
	PRINTL 
NEXT
CALL カテゴリ罫線("その他", 2)
IF RESULT
	PRINTFORM 　[{終えるボタン}] 終える　　[{着替えるボタン}] 着替える
	;逢引だけ、相手に任せて続けられる（→@なすがまま）
	SIF 商品 == 商品_逢引 && なすがままができるか()
		PRINTFORM 　　[{なすがままボタン}] なすがまま
	;三人の場面だけ、対象を替えられる（→見つかる.ERB @対象を替える）
	SIF 裏の同席:MASTER:0 > 0
		PRINTFORM 　　[{対象を替えるボタン}] 対象を替える（%CALLNAME:相手%→%CALLNAME:(裏の同席:MASTER:0)%）
	PRINTL 
ENDIF

WHILE LINECOUNT - 開始行 < サイド行数
	PRINTL 
WEND
CALL 本文罫線
PRINTL 　[1900] 設定　　[1901] ロード　　[1902] 遊び方
CALL コマンド履歴表示


;その分類で、この商品の系統で出る行為を並べる。
;Ｖ系・Ａ系（分類4・5）の体位そのもの（要るモード無し）は個別に出さず、向きごとに「体位を変える」1個にまとめる
;（2026-09-28 memo「体位変更と挿入状態の派生コマンドが混ざっていてわかりにくい」→ @体位を選ぶ でサブメニューを出す）
@行為の行(分類, 系統)
#DIM 分類
#DIM 系統
#DIM 行為
#DIM 数
#DIM 幅
#DIM 一つ
#DIM 向き
#DIM 体位あり, 2

;5つごとでは「背面座位Ａさせる」のような長い名前で右端が切れたので、幅で折る（半角換算。組み幅は全角60＝120）。2026-09-15
数 = 0
幅 = 0
体位あり:0 = 0
体位あり:1 = 0
FOR 行為, 0, 行為数
	SIF 行為名:行為 == "" || 行為の分類:行為 != 分類 || !行為ができるか(行為, 系統)
		CONTINUE
	IF (分類 == 4 || 分類 == 5) && 行為の要るモード:行為 == ""
		体位あり:(行為の向き:行為) = 1
		CONTINUE
	ENDIF
	;「　[1234] 」＝9 と名前と後ろの全角空白 2。STRLENS は全角を 2 と数える（STRLENSU は 1。実測 2026-09-15）
	一つ = 11 + STRLENS(行為名:行為)
	IF 数 > 0 && 幅 + 一つ > 116
		PRINTL
		幅 = 0
	ENDIF
	PRINTFORM 　[{行為ボタン + 行為}] %行為名:行為%
	幅 += 一つ
	数 += 1
NEXT
IF 分類 == 4 || 分類 == 5
	FOR 向き, 0, 2
		SIF !体位あり:向き
			CONTINUE
		一つ = 11 + STRLENS(体位を変えるの名(分類, 向き))
		IF 数 > 0 && 幅 + 一つ > 116
			PRINTL
			幅 = 0
		ENDIF
		PRINTFORM 　[{体位ボタン + 体位ボタン種別(分類, 向き)}] %体位を変えるの名(分類, 向き)%
		幅 += 一つ
		数 += 1
	NEXT
ENDIF
SIF 数 > 0
	PRINTL


;体位を変えるボタンの種別番号（0=Ｖ系する 1=Ｖ系させる 2=Ａ系する 3=Ａ系させる）
@体位ボタン種別(分類, 向き)
#FUNCTION
#DIM 分類
#DIM 向き

RETURNF (分類 == 5) * 2 + 向き


;体位を変えるボタンの名前
@体位を変えるの名(分類, 向き)
#FUNCTIONS
#DIM 分類
#DIM 向き

IF 分類 == 5
	SIF 向き == 1
		RETURNF "Ａ体位を変える（させる）"
	RETURNF "Ａ体位を変える"
ENDIF
SIF 向き == 1
	RETURNF "体位を変える（させる）"
RETURNF "体位を変える"


;いまの場面の系統。商品があればその系統、自宅の風呂（商品 -1）なら 系統_自宅の風呂、夜這い（商品 -2）なら 系統_夜這い
@いまの系統
#FUNCTION

SIF 裏の商品:MASTER:0 == 商品_夜這い
	RETURNF 系統_夜這い
SIF 裏の商品:MASTER:0 == 商品_舞台 || 裏の商品:MASTER:0 == 商品_処女の舞台
	RETURNF 系統_舞台
SIF 裏の商品:MASTER:0 == 商品_プレイルーム
	RETURNF 系統_プレイルーム
SIF 裏の商品:MASTER:0 == 商品_逢引
	RETURNF 系統_逢引
SIF 裏の商品:MASTER:0 < 0
	RETURNF 系統_自宅の風呂
RETURNF 商品系統:(裏の商品:MASTER:0)


;その分類の行為が一つでも出るか
@分類が出るか(分類, 系統)
#FUNCTION
#DIM 分類
#DIM 系統
#DIM 行為

FOR 行為, 0, 行為数
	SIF 行為名:行為 != "" && 行為の分類:行為 == 分類 && 行為ができるか(行為, 系統)
		RETURNF 1
NEXT
RETURNF 0


;主人公の個室でその行為ができるか：商品の系統で出て、二人がその部位を持っていて、
;派生なら要るモードの最中で、使う部位が別のモードに取られていない
;（部位の無い者にはその行為は出ない。erablue_resort の COM_ABLE と同じ。クンニは女性器のある相手にだけ）
@行為ができるか(行為, 系統)
#FUNCTION
#DIM 行為
#DIM 系統
#DIM 側
#DIM 衝突

SIF !行為が出るか(行為, 系統)
	RETURNF 0
;設定で隠した行為（一覧・要望・なすがまま・体位の選び先、どれもここを通る。→@コマンド表示設定）
SIF 設定_行為隠し:行為
	RETURNF 0
SIF 使う部位(裏の相手:MASTER:0, 行為, 0) < 0 || 使う部位(MASTER, 行為, 1) < 0
	RETURNF 0
SIF 行為の要るモード:行為 != "" && !モード中か(行為の要るモード:行為)
	RETURNF 0
;搾乳・授乳は出す側が母乳体質で量があるときだけ（→設計メモ「母乳」）
SIF !母乳が出せるか(行為)
	RETURNF 0
;気絶して眠っている相手には、会話と、相手がする側の手（向き 1＝客が主人公に、2＝双方）は出ない（→気絶.ERB）
SIF 気絶中:(裏の相手:MASTER:0):0 && (行為の分類:行為 == 0 || 行為の向き:行為 != 0)
	RETURNF 0
;一手ごとに体力・気力を払う。主人公に足りなければ出ない（拭うは払わない。→設計メモ「体力と気力」）
SIF 行為 != 行為_拭う && (!払えるか(一手の体力, 一手の気力))
	RETURNF 0
;設備が要る行為は、[109] 設備を買う で買っていなければ出ない（→画面イメージ「ショップ」の設備）
SIF 行為の要る設備:行為 >= 0 && !個室の設備:(行為の要る設備:行為)
	RETURNF 0
;脱衣は脱ぐものが無ければ出ない。拭う（分類は浴室）は汚れが無ければ出ない。服が邪魔ならその行為は出ない（見せるは自分で脱ぐ手なので除く）
SIF 行為の分類:行為 == 分類_脱衣 && !脱衣ができるか(行為)
	RETURNF 0
SIF 行為 == 行為_拭う && !汚れがあるか()
	RETURNF 0
SIF 行為の分類:行為 != 分類_脱衣 && 行為の分類:行為 != 分類_見せる && (服が邪魔か(行為, 0) || 服が邪魔か(行為, 1))
	RETURNF 0
;見せるの手で脱ぐ服がもう無ければ出ない（脱いだ後に「服を脱いで下着姿に」は言えない。2026-09-30 ユーザ指定）
SIF 行為の分類:行為 == 分類_見せる && !見せるで脱げるか(行為)
	RETURNF 0
;着替えを見せるは、替えられる組が棚に無ければ出ない（裸なら着られる。→@着替えられるか）
SIF 行為 == 行為_着替えを見せる && !着替えられるか()
	RETURNF 0
;Ｖ挿入・Ａ挿入を新たに立てる行為は、勃起・潤滑が足りなければ出ない（→@挿入に足りるか）
SIF !挿入に足りるか(行為)
	RETURNF 0
FOR 側, 0, 2
	衝突 = 衝突するモード(行為, 側)
	SIF 衝突 < 0
		CONTINUE
	;いまの体勢そのものはもう一度は選べない。続く行為なら別の体勢に変えられる（衝突した方が消える）。一度きりの手は部位が空いていないと出ない。
	;拘束（縄・ギャグ・目隠し）が取っている部位は、解くまで誰も使えない
	SIF 衝突 == 行為 || 行為のモード:行為 == "" || 拘束か(衝突)
		RETURNF 0
NEXT
RETURNF 1


;Ｖ挿入・Ａ挿入をモードとして新たに立てる行為（正常位など。続く派生は対象外）が、勃起・潤滑の線に足りているか。
;提供側がＰ（男性器）を使うときだけその勃起を見る（Ｐを使わない提供側＝道具挿入は勃起を問わない）。
;潤滑は受け手がＶ（膣）を使うときだけ見る。潤滑は女性器のある性別にしか値が入らないので、Ａ挿入は勃起だけで見る（2026-09-24 ユーザ指定）
@挿入に足りるか(行為)
#FUNCTION
#DIM 行為
#DIM 側
#DIM 番号
#DIM 提供
#DIM 受け手膣

SIF 行為のモード:行為 != "Ｖ挿入" && 行為のモード:行為 != "Ｖ挿入される" && 行為のモード:行為 != "Ａ挿入" && 行為のモード:行為 != "Ａ挿入される"
	RETURNF 1

提供 = -1
受け手膣 = -1
FOR 側, 0, 2
	番号 = 裏の相手:MASTER:0
	SIF 側 == 1
		番号 = MASTER
	SIF 行為の使用:行為:側 & (1 << 部位_男性器)
		提供 = 番号
	SIF 行為の使用:行為:側 & (1 << 部位_膣)
		受け手膣 = 番号
NEXT

SIF 提供 >= 0 && PALAM:提供:勃起 < 勃起の線
	RETURNF 0
SIF 受け手膣 >= 0 && PALAM:受け手膣:潤滑 < 愛液の線
	RETURNF 0
RETURNF 1


;その人がその行為で使う部位のビット（G は実際の部位に）。要る部位が無ければ -1
@使う部位(番号, 行為, 側)
#FUNCTION
#DIM 番号
#DIM 行為
#DIM 側
#DIM 部位
#DIM 実
#DIM 結果

結果 = 0
FOR 部位, 0, 部位の数
	SIF !(行為の使用:行為:側 & (1 << 部位))
		CONTINUE
	IF 部位 == 部位_手 || 部位 == 部位_目
		実 = 部位
	ELSE
		実 = 実際の部位(番号, 部位)
	ENDIF
	SIF 実 < 0
		RETURNF -1
	結果 |= 1 << 実
NEXT
RETURNF 結果


;その行為が使う部位を、別の行為（モード）が取っていればその行為番号。無ければ -1。
;派生が要るモードの部位を使うのは衝突ではない
@衝突するモード(行為, 側)
#FUNCTION
#DIM 行為
#DIM 側
#DIM 部位
#DIM 使用
#DIM 相手
#DIM 番号

相手 = 裏の相手:MASTER:0
SIF 側 == 1
	相手 = MASTER
使用 = 使う部位(相手, 行為, 側)
SIF 使用 <= 0
	RETURNF -1
FOR 部位, 0, 部位の数
	SIF !(使用 & (1 << 部位)) || 部位の使用:側:部位 == 0
		CONTINUE
	番号 = 部位の使用:側:部位 - 1
	SIF 番号 == 行為
		RETURNF 番号
	SIF 行為の要るモード:行為 != "" && 行為のモード:番号 == 行為の要るモード:行為
		CONTINUE
	RETURNF 番号
NEXT
RETURNF -1


;そのモード名の体勢が続いているか
@モード中か(名前)
#FUNCTION
#DIMS 名前
#DIM 側
#DIM 部位

FOR 側, 0, 2
	FOR 部位, 0, 部位の数
		SIF 部位の使用:側:部位 > 0 && 行為のモード:(部位の使用:側:部位 - 1) == 名前
			RETURNF 1
	NEXT
NEXT
RETURNF 0


;いま続いている体勢（行為番号）を 続く行為:0〜 に集めて数を返す。重複なし
@モードを集める
#FUNCTION
#DIM 側
#DIM 部位
#DIM 数
#DIM 甲
#DIM 既

数 = 0
FOR 側, 0, 2
	FOR 部位, 0, 部位の数
		SIF 部位の使用:側:部位 == 0
			CONTINUE
		既 = 0
		FOR 甲, 0, 数
			SIF 続く行為:甲 == 部位の使用:側:部位 - 1
				既 = 1
		NEXT
		SIF 既
			CONTINUE
		続く行為:数 = 部位の使用:側:部位 - 1
		数 += 1
	NEXT
NEXT
RETURNF 数


@モードの数
#FUNCTION

RETURNF モードを集める()


;拘束（分類が特殊のモード）か
@拘束か(行為)
#FUNCTION
#DIM 行為

SIF 行為 < 0
	RETURNF 0
RETURNF 行為のモード:行為 != "" && 行為の分類:行為 == 分類_特殊


;続いている体勢のうち、拘束（1）か体勢（0）の数
@モードの数_種別(拘束)
#FUNCTION
#DIM 拘束
#DIM 数
#DIM 甲
#DIM 結果

数 = モードを集める()
結果 = 0
FOR 甲, 0, 数
	SIF 拘束か(続く行為:甲) == 拘束
		結果 += 1
NEXT
RETURNF 結果


;続いている状態の行（eraTOWN の @H状態表示 の文体。誰が誰に何をしているかの一文を［　］で、♥ と [✕]。2026-09-13 ユーザ指定）。
;挿入：「あなたは健二の膣に正常位で挿入している」「あなたは健二に正常位で膣を貫かれている」。奉仕・愛撫：「あなたは健二にフェラをしている」。
;拘束：「健二は縄をつけられている」。行末の [✕] は 解除ボタン＋並び順（@モードを集める の順。押したときも同じ順で集め直す）
@状態の行
#DIM 数
#DIM 甲
#DIM 行為
#DIM 相手
#DIM 向き
#DIMS 文
#DIMS 名

数 = モードを集める()
SIF 数 == 0
	RETURN 0
相手 = 裏の相手:MASTER:0
FOR 甲, 0, 数
	行為 = 続く行為:甲
	向き = 行為の向き:行為
	名 '= 状態の名(行為)
	IF 拘束か(行為)
		IF 向き == 1
			文 '= @"あなたは%名%をつけられている"
		ELSE
			文 '= @"%CALLNAME:相手%は%名%をつけられている"
		ENDIF
	ELSEIF 行為の分類:行為 == 4 || 行為の分類:行為 == 5
		IF 向き == 1
			文 '= @"あなたは%CALLNAME:相手%に%名%で%挿入の部位(行為)%を貫かれている"
		ELSE
			文 '= @"あなたは%CALLNAME:相手%の%挿入の部位(行為)%に%名%で挿入している"
		ENDIF
	ELSEIF 向き == 1
		文 '= @"%CALLNAME:相手%はあなたに%名%をしている"
	ELSEIF 向き == 2
		文 '= @"あなたと%CALLNAME:相手%は%名%をしている"
	ELSE
		文 '= @"あなたは%CALLNAME:相手%に%名%をしている"
	ENDIF
	SETCOLOR 255, 150, 200
	PRINTFORM 　[%文% %UNICODE(0x2665)%]
	PRINTBUTTON "[✕]", 解除ボタン + 甲
	RESETCOLOR
	PRINTL 
NEXT


;状態の文に使う名。体位は 行為名 から「させる」「アナル」「Ａさせる」を除く（正常位）、拘束は 縄／ギャグ／目隠し、それ以外はモード名から「される」を除く
@状態の名(行為)
#FUNCTIONS
#DIM 行為
#DIMS 名

IF 行為の分類:行為 == 4 || 行為の分類:行為 == 5
	名 '= 行為名:行為
	名 '= REPLACE(名, "Ａさせる", "")
	名 '= REPLACE(名, "させる", "")
	名 '= REPLACE(名, "アナル", "")
	RETURNF 名
ENDIF
名 '= 行為のモード:行為
SELECTCASE 名
	CASE "縛られる"
		RETURNF "縄"
	CASE "目隠しされる"
