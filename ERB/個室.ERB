	部位 = 3
	失う '= "処女"
ELSEIF 挿入の行為か(行為, "Ａ挿入") || 挿入の行為か(行為, "Ａ挿入される")
	部位 = 4
	失う '= "Ａ処女"
ENDIF
SIF 部位 < 0
	RETURN 0
名 '= 行為のモード:行為
SIF 名 == ""
	名 '= 行為の要るモード:行為
;男性器の無い側の「童貞」は出さない（ふたなり同士など、部位の無い側に回数が付く形は無いはずだが念のため）
IF STRFIND(名, "される") >= 0
	;主人公が受ける
	IF 挿入された回数(MASTER, 部位) == 1
		CALL 初めての相手を記す(MASTER, 部位, 相手)
		SIF !黙る
			PRINTFORML （自分は%失う%を失った）
	ENDIF
	IF 挿入した回数(相手) == 1 && (部位のある性別:5 & 性別ビット(相手))
		初めての相手_童貞:相手:0 = 初めての相手の値(MASTER)
		CALL 初物を頂く(MASTER)
		SIF !黙る
			PRINTFORML （%CALLNAME:相手%は童貞を失った）
	ENDIF
ELSE
	IF 挿入された回数(相手, 部位) == 1
		CALL 初めての相手を記す(相手, 部位, MASTER)
		SIF !黙る
			PRINTFORML （%CALLNAME:相手%は%失う%を失った）
	ENDIF
	IF 挿入した回数(MASTER) == 1 && (部位のある性別:5 & 性別ビット(MASTER))
		初めての相手_童貞:MASTER:0 = 初めての相手の値(相手)
		CALL 初物を頂く(相手)
		SIF !黙る
			PRINTFORML （自分は童貞を失った）
	ENDIF
ENDIF


;[✕]。並び順の一つだけをやめる
