	CATCH
	ENDCATCH
ENDIF


;喘ぎ声中心の口上（2026-10-16 ユーザ指定「行為時の口上に喘ぎ声中心のものも追加し、バリエーションを出したい」「喘ぎ声だけのパターンも」）。
;個室の行為で、喘ぐ側（@喘ぐ側か）のとき 喘ぎの率（盛り上がりの段ごと）で通常の口上の代わりに出す。出せたら RESULTS に台詞を入れて 1、通常の口上に任せるなら 0（RESULT）。
;話者＝番号（側 0＝客、1＝主人公。主人公は番号 MASTER）。呼ぶ順：
;  口上_喘ぎ_{キャラ番号}(番号, 行為, 向き, 段)（主人公は口上の使い方が「汎用のみ」のとき飛ばす）
;  → そのキャラが 口上_行為_{キャラ番号} を自分で書いている行為なら出さない（通常の口上に任せる。主人公は「固有のみ」なら汎用に落とさない）
;  → 喘ぎだけの率 の割で 口上_喘ぎだけ_{型}_{男／女}(番号, 群, 段)（言葉の無い版。ERB/口上/汎用/喘ぎだけ.ERB）
;  → 口上_喘ぎ_{タイプ}_{男／女}(番号, 行為, 向き, 段)（ERB/口上/汎用/タイプ_◯◯_喘ぎ.ERB）。ふたなり・性別なしは女
;方言版は無い（喘ぎは方言で変わらない）。口上なし（CFLAG）は呼ぶ側（@行為の口上／@主人公の行為の口上）が先に見る
@喘ぎの口上を引く(番号, 側, 行為, 向き, 段)
#DIM 番号
#DIM 側
#DIM 行為
#DIM 向き
#DIM 段
#DIM 群
#DIMS タイプ
#DIMS 性別
#DIMS 型

RESULTS '= ""
群 = 喘ぎの群(行為)
SIF !喘ぐ側か(側, 行為, 向き)
	RETURN 0
SIF RAND:100 >= 喘ぎの率:段
	RETURN 0
;キャラ別（主人公の固有は 口上の使い方 が 汎用のみ のとき使わない）
IF 側 == 0 || 口上の使い方 != 2
	TRYCCALLFORM 口上_喘ぎ_%TOSTR(番号)%(番号, 行為, 向き, 段)
	CATCH
	ENDCATCH
	SIF RESULTS != ""
		RETURN 1
	;自分で書いた行為の口上があるなら、汎用の喘ぎで上書きしない
	CALL 行為の口上を呼ぶ(番号, 行為, 向き, 段, TOSTR(番号))
	SIF RESULTS != ""
		RETURN 0
ENDIF
SIF 側 == 1 && 口上の使い方 == 1
	RETURN 0
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
SIF 性別 != "男"
	性別 '= "女"
RESULTS '= ""
IF RAND:100 < 喘ぎだけの率
	型 '= 喘ぎの型(タイプ)
	TRYCCALLFORM 口上_喘ぎだけ_%型%_%性別%(番号, 群, 段)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == ""
	TRYCCALLFORM 口上_喘ぎ_%タイプ%_%性別%(番号, 行為, 向き, 段)
	CATCH
	ENDCATCH
ENDIF
SIF RESULTS == ""
	RETURN 0
RETURN 1

;喘ぎの群（口上用）。-1＝喘ぎの対象外（会話・見せる・脱衣・特殊・抱きしめる・浴室の洗う系）／0 愛撫（ローション・マット・全身で擦るも）／1 奉仕／2 Ｖ系／3 Ａ系／4 キス（23・24・38）
@喘ぎの群(行為)
#FUNCTION
#DIM 行為

SELECTCASE 行為
	CASE 23, 24, 38
		RETURNF 4
	CASE 39
		RETURNF -1
	CASE 183 TO 188
		RETURNF 0
ENDSELECT
SELECTCASE 行為の分類:行為
	CASE 2
		RETURNF 0
	CASE 3
		RETURNF 1
	CASE 4
		RETURNF 2
	CASE 5
		RETURNF 3
ENDSELECT
RETURNF -1

;その側（0＝客、1＝主人公）が喘ぐか。触られる・される側（向き 0＝客／1＝主人公／2＝双方）。挿入（Ｖ系・Ａ系）とキスは向きによらず双方
@喘ぐ側か(側, 行為, 向き)
#FUNCTION
#DIM 側
#DIM 行為
#DIM 向き
#DIM 群

群 = 喘ぎの群(行為)
SIF 群 < 0
	RETURNF 0
SIF 群 >= 2 || 向き == 2
	RETURNF 1
RETURNF 向き == 側

;喘ぎだけの棚の型。賑やか（元気・奔放・無邪気・甘え）／控えめ（内気・クール・無口）／並（そのほか）
@喘ぎの型(タイプ)
#FUNCTIONS
#DIMS タイプ

SELECTCASE タイプ
	CASE "元気", "奔放", "無邪気", "甘え"
		RETURNF "賑やか"
	CASE "内気", "クール", "無口"
		RETURNF "控えめ"
ENDSELECT
RETURNF "並"


;主人公の口上。相手と同じ段構え（2026-09-15 ユーザ指定「主人公用のタイプ別を別に書く」「あなたも性別を気にするように」）：
;固有 口上_行為_0（`ERB/口上/あなた口上/` の直下）→ 口上_行為_{タイプ}_主人公_{性別} → ふたなりは _主人公_女 → 口上_行為_{タイプ}_主人公（共通。`ERB/口上/あなた口上/汎用/`）→ 何も出さない。
;主人公の口上は `ERB/口上/あなた口上/` にまとめる（2026-09-15 ユーザ指定。直下が固有、汎用/ がタイプ別）。
;相手向けのタイプ別（_女／_男／共通）は客の側から書いた台詞なので、主人公には落とさない
@主人公の行為の口上(行為, 向き)
#DIM 行為
#DIM 向き
#DIM 段
#DIM 区分
#DIMS タイプ
#DIMS 性別
#DIMS 方言

;口上の使い方（0=固有＋汎用 1=固有のみ 2=汎用のみ。2026-09-15）で段を飛ばす。固有のみで固有が無い局面は黙る
;盛り上がりの段は相手の口上と同じ（@行為の口上を呼ぶ が各段で先に 口上_盛り上がり_… を呼ぶ。2026-10-01）
RESULTS '= ""
SIF CFLAG:MASTER:口上なし
	RETURN 0
段 = 盛り上がりの段(MASTER)
;喘ぎ声中心の口上（相手と同じ。固有は 口上_喘ぎ_0。→@喘ぎの口上を引く。2026-10-16）
CALL 喘ぎの口上を引く(MASTER, 1, 行為, 向き, 段)
IF RESULT == 1
	SETCOLOR 150, 200, 255
	PRINTFORML 　%RESULTS%
	RESETCOLOR
	RETURN 0
ENDIF
;触れ方の口上（相手と同じ。→ERB/口上/触れ方.ERB。2026-10-15）
区分 = 触れ方の区分(行為)
;相手と同じ（区分が変わったときだけ）。さらに相手がこの一手で言ったなら重ねない（お互いに「服の上から」と言い合わない）
IF 区分 > 0 && 段 < 2 && !今回の触れ方口上 && 触れ方の口上済:1:(触れ方の群(行為)) != 区分
	CALL 主人公の触れ方の口上を出す(行為, 向き, 区分)
	IF RESULT == 1
		触れ方の口上済:1:(触れ方の群(行為)) = 区分
		RETURN 0
	ENDIF
ENDIF
IF 口上の使い方 != 2
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, TOSTR(MASTER))
ENDIF
タイプ '= 口上タイプ(MASTER)
性別 '= 性別名(MASTER)
方言 '= 方言の接尾(MASTER)
IF RESULTS == "" && 口上の使い方 != 1 && 方言 != ""
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公_%性別%%方言%")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公_%性別%")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1 && 性別 == "ふたなり" && 方言 != ""
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公_女%方言%")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1 && 性別 == "ふたなり"
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公_女")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1 && 方言 != ""
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公%方言%")
ENDIF
IF RESULTS == "" && 口上の使い方 != 1
	CALL 行為の口上を呼ぶ(MASTER, 行為, 向き, 段, @"%タイプ%_主人公")
ENDIF
IF RESULTS != ""
	SETCOLOR 150, 200, 255
	PRINTFORML 　%RESULTS%
	RESETCOLOR
ENDIF


;口上タイプの名前（素質 口上_元気／クール／内気／奔放 の「口上_」を除いた部分）。
;付いていなければ既定（口上の既定タイプ）、複数なら既定に戻す（→設計メモ「口上タイプは専用の素質タグで持つ」）
@口上タイプ(番号)
#FUNCTIONS
#DIM 番号
#DIM 素質
#DIM 数
#DIMS 名

数 = 0
名 '= ""
FOR 素質, 0, 100
	SIF !TALENT:番号:素質 || TALENTNAME:素質 == "" || STRFIND(TALENTNAME:素質, "口上_") != 0
		CONTINUE
	数 += 1
	名 '= SUBSTRINGU(TALENTNAME:素質, 3, -1)
NEXT
SIF 数 != 1
	RETURNF 口上の既定タイプ
RETURNF 名


;方言の素質か（名前が 方言_ で始まる。方言素質の始め〜終わり）
@方言の素質か(素質)
#FUNCTION
#DIM 素質

SIF 素質 < 方言素質の始め || 素質 > 方言素質の終わり || TALENTNAME:素質 == ""
	RETURNF 0
RETURNF STRFIND(TALENTNAME:素質, "方言_") == 0


;方言の名前（素質 方言_関西 の「方言_」を除いた部分。→口上のファイル名と関数名の末尾の _関西）。
;付いていなければ空（標準語）、複数付いていても空（口上タイプと同じ。排他は施術と設定の画面で守る）
@口上の方言(番号)
#FUNCTIONS
#DIM 番号
#DIM 素質
#DIM 数
#DIMS 名

数 = 0
名 '= ""
FOR 素質, 方言素質の始め, 方言素質の終わり + 1
	SIF !TALENT:番号:素質 || !方言の素質か(素質)
		CONTINUE
	数 += 1
	名 '= SUBSTRINGU(TALENTNAME:素質, 3, -1)
NEXT
SIF 数 != 1
	RETURNF ""
RETURNF 名


;口上の関数名に付ける方言の接尾。方言なら「_関西」、標準語なら空
@方言の接尾(番号)
#FUNCTIONS
#DIM 番号

SIF 口上の方言(番号) == ""
	RETURNF ""
RETURNF @"_%口上の方言(番号)%"


;主人公の口上タイプを選ぶ（開始時と設定 [4]。2026-09-15 ユーザ指定「タイプも選び、固有があればそちらを。なければタイプのを」）。
;番号は Talent.csv の素質番号そのまま（怪しい店の素質と同じ）。排他なので付けると今のものは消える。それ以外の入力なら変えない。
;いまのものは色を変える（付いている色）
@口上タイプを選ぶ(番号)
#DIM 番号
#DIM 素質
#DIM 数

PRINTFORML %CALLNAME:番号%の口上タイプ（番号。[0] で変えない）　いま：%口上タイプ(番号)%
数 = 0
FOR 素質, 0, 100
	SIF !口上タイプの素質か(素質)
		CONTINUE
	CALL 選択肢を並べる(数, 素質, 施術の素質の名(素質), TALENT:番号:素質, 4, "")
	数 += 1
NEXT
;変えない（2026-10-27 ユーザ指摘。それまでは一覧にない番号を入れるしか手が無かった）。そのまま方言の選択へ進む
CALL 選択肢を並べる(数, 0, "変えない", 0, 4, "")
PRINTL 
INPUT
素質 = RESULT
IF 口上タイプの素質か(素質)
	FOR 数, 0, 100
		SIF 口上タイプの素質か(数)
			TALENT:番号:数 = 0
	NEXT
	TALENT:番号:素質 = 1
	PRINTFORML 口上タイプを %口上タイプ(番号)% にした
ENDIF
;続けて方言（2026-10-01）。付ける方言が無ければ何も出さない
CALL 方言を選ぶ(番号)


;主人公の方言を選ぶ（口上タイプの続き）。番号は Talent.csv の素質番号そのまま。付いているものを選ぶと外れて標準語に戻る。[0] 標準語（方言を外す）は一覧の最後に出す（2026-10-27 ユーザ指摘「方言を選ばざるを得ない。標準の選択肢がない」。それまでは「それ以外の入力なら変えない」ことしか書いておらず、標準語のままにする手が見えなかった）。それ以外の入力なら変えない。
;方言の素質が一つも無ければ何も出さない
@方言を選ぶ(番号)
#DIM 番号
#DIM 素質
#DIM 数

数 = 0
FOR 素質, 方言素質の始め, 方言素質の終わり + 1
	SIF 方言の素質か(素質)
		数 += 1
NEXT
SIF 数 == 0
	RETURN 0
PRINTFORML %CALLNAME:番号%の方言（番号。[0] で標準語。それ以外で変えない）　いま：%方言の名(番号)%
数 = 0
FOR 素質, 方言素質の始め, 方言素質の終わり + 1
	SIF !方言の素質か(素質)
		CONTINUE
	CALL 選択肢を並べる(数, 素質, 施術の素質の名(素質), TALENT:番号:素質, 4, "")
	数 += 1
NEXT
;標準語（方言なし）。いま方言が付いていなければ色が付く
CALL 選択肢を並べる(数, 0, "標準語", 口上の方言(番号) == "", 4, "")
PRINTL
INPUT
素質 = RESULT
;[0] 標準語：付いている方言を全部外す
IF 素質 == 0
	FOR 数, 方言素質の始め, 方言素質の終わり + 1
		TALENT:番号:数 = 0
	NEXT
	PRINTFORML 方言を %方言の名(番号)% にした
	RETURN 0
ENDIF
SIF !方言の素質か(素質)
	RETURN 0
IF TALENT:番号:素質
	TALENT:番号:素質 = 0
ELSE
	FOR 数, 方言素質の始め, 方言素質の終わり + 1
		TALENT:番号:数 = 0
	NEXT
	TALENT:番号:素質 = 1
ENDIF
PRINTFORML 方言を %方言の名(番号)% にした


;画面に出す方言の名。付いていなければ「標準語」
@方言の名(番号)
#FUNCTIONS
#DIM 番号

SIF 口上の方言(番号) == ""
	RETURNF "標準語"
RETURNF 口上の方言(番号)


;［終える］。時間が残っていても出る。結果は @裏を終える（客.ERB）が入れる。自宅の風呂は @自宅の風呂を終える
;静か＝1 は文と WAIT を出さずに閉じる（主人公が体力切れで気絶するとき → 気絶.ERB @主人公が気絶する）
@個室を終える(静か = 0)
#DIM 静か
#DIM 相手

相手 = 裏の相手:MASTER:0
SIF 相手 <= 0
	RETURN 0
SIF !静か
	PRINTL
IF 裏の商品:MASTER:0 == 商品_夜這い
	SIF !静か
		PRINTL ここまでにした
	CALL 夜這いを終える
ELSEIF 裏の商品:MASTER:0 == 商品_舞台
	;中に出さないまま降りた。ショーはお流れ（→「舞台の場面」）
	SIF !静か
		PRINTL 舞台を降りた
	CALL 舞台をお流れにする
ELSEIF 裏の商品:MASTER:0 == 商品_処女の舞台
	;処女オークションの舞台。処女でなくなっていれば成立、処女のままなら不成立（→「舞台の場面」）
	SIF !静か
		PRINTL 舞台を降りた
	CALL 処女の舞台を閉じる
ELSEIF 裏の商品:MASTER:0 == 商品_プレイルーム
	;後付け施設のプレイルーム（→施設.ERB）
	SIF !静か
		PRINTL ここまでにした
	CALL プレイルームを終える
ELSEIF 裏の商品:MASTER:0 == 商品_逢引
	;逢引（→行動.ERB「逢引」）
	SIF !静か
		PRINTL ここまでにした
	CALL 逢引を終える
ELSEIF 裏の商品:MASTER:0 < 0
	SIF !静か
		PRINTL 風呂から上がった
	CALL 自宅の風呂を終える
ELSE
	SIF !静か
		PRINTL ここまでにした
	CALL 裏を終える(MASTER, 相手, 裏の商品:MASTER:0)
ENDIF
SIF !静か
	WAIT


;================================ 舞台の場面（お迎え棒。2026-09-21 →画面イメージ「出産ショー」お迎え棒の場面） ================================
;出産ショーのお迎え棒で主人公が関わる2つ（自分でお迎え棒＝演者が NPC・相手が主人公／主人公が演者・相手が客）は、地下ステージで個室の場面を開く。
;商品なし（裏の商品 −3）。出るのは浴室以外の全部。金・同意・時間切れ・商品回数・売上は無い。一手ごとに演者の羞恥（公開の分）。
;演者の中に出た時点で終わり（妊娠.ERB @膣内射精 が `舞台で注がれた` を立て、コマンドの後に @舞台の場面の見張り が閉じて陣痛へ）。
;中に出さずに [1500] 終える／05:00 の強制就寝はお流れ（演者の旗を下ろし、NPC は持ち場か席へ）

;場面を開く。演者（出産ショー中・処女オークション中）は先に立てておく（NPC なら 客.ERB @舞台に上げる、主人公なら 行動.ERB @主人公の出産ショー／@主人公の処女オークション）。
;商品は 商品_舞台（お迎え棒）か 商品_処女の舞台（処女オークション）
@舞台の場面を開く(相手, 商品)
#DIM 相手
#DIM 商品

裏の相手:MASTER:0 = 相手
裏の相手:相手:0 = MASTER
裏の商品:MASTER:0 = 商品
裏の商品:相手:0 = 商品
;時間切れは無い（裏のティックは個室の場所でしか回らないが、念のため遠くに置く）
裏の終わり:MASTER:0 = 経過日数 * 1440 + 現在時刻 + 100000
裏の終わり:相手:0 = 裏の終わり:MASTER:0
舞台で注がれた = 0
CALL 個室に入る
SAVESTR:モード = 個室


;場面を閉じる。その場の値は残る（→@一日の開発度。自宅の風呂と同じ）。相手を RESULT で返す
@舞台の場面を閉じる
#DIM 相手

相手 = 裏の相手:MASTER:0
SIF 相手 <= 0
	RETURN 0
CALL モードを全部消す
CALL 個室に入る
裏の相手:MASTER:0 = 0
裏の相手:相手:0 = 0
裏の商品:MASTER:0 = 0
裏の商品:相手:0 = 0
裏の終わり:MASTER:0 = -1
裏の終わり:相手:0 = -1
舞台で注がれた = 0
SAVESTR:モード = 店
RETURN 相手


;一手ごとの公開の分。演者（主人公でも NPC でも。出産ショー中か処女オークション中）の羞恥
@舞台の一手
#DIM 演者

演者 = 出産ショー中の人()
SIF 演者 < 0
	演者 = 処女オークション中の人()
SIF 演者 < 0
	RETURN 0
PALAM:演者:羞恥 += 舞台の一手の羞恥
SIF PALAM:演者:羞恥 > PALAM上限
	PALAM:演者:羞恥 = PALAM上限


;地下ホールのその場の裏の一手ごとの人目の分。主人公と相手の羞恥（舞台の一手の羞恥と同じ幅）
@地下ホールの一手
#DIM 相手

相手 = 裏の相手:MASTER:0
PALAM:MASTER:羞恥 += 舞台の一手の羞恥
SIF PALAM:MASTER:羞恥 > PALAM上限
	PALAM:MASTER:羞恥 = PALAM上限
SIF 相手 <= 0
	RETURN 0
PALAM:相手:羞恥 += 舞台の一手の羞恥
SIF PALAM:相手:羞恥 > PALAM上限
	PALAM:相手:羞恥 = PALAM上限


;お流れ。中に出さずに終えた／05:00。演者の旗を下ろし、NPC の演者は持ち場か席へ、上げた客は地下ホールへ。その日はもう打診しない（打診日は聞いたときに入れてある）
@舞台をお流れにする
#DIM 演者
#DIM 相手

演者 = 出産ショー中の人()
CALL 舞台の場面を閉じる
相手 = RESULT
PRINTL 陣痛は起きなかった。ショーはお流れになった
IF 演者 == MASTER
	出産ショー中:MASTER:0 = 0
	CALL 演目を終える(相手)
	SIF 相手 > 0
		CFLAG:相手:現在位置 = 地下ホールの位置
ELSEIF 演者 > 0
	CALL 出産ショーを流す(演者)
ENDIF


;コマンドの後（→USERCOM.ERB @USERCOM）。演者の中に出ていれば場面を閉じて陣痛へ。演者が NPC なら見るか聞く、主人公ならそのまま舞台に残る
@舞台の場面の見張り
#DIM 演者
#DIM 相手

SIF 裏の相手:MASTER:0 <= 0 || 裏の商品:MASTER:0 != 商品_舞台 || !舞台で注がれた
	RETURN 0
演者 = 出産ショー中の人()
CALL 舞台の場面を閉じる
相手 = RESULT
PRINTL
PRINTL 注がれた腹が、ほどなくして硬く張りはじめた――陣痛だ
IF 演者 == MASTER
	CALL 演目を終える(相手)
	SIF 相手 > 0
		CFLAG:相手:現在位置 = 地下ホールの位置
	CALL 陣痛開始(MASTER)
	PRINTL 舞台の上で、客の目の前で産むことにした。大きな腹が客席の目に晒される
	WAIT
ELSEIF 演者 > 0
	CALL 陣痛開始(演者)
	WAIT
	CALL 出産ショーを見るか(演者)
	SIF RESULT
		CALL 出産ショーを見届ける(演者)
ENDIF


;処女オークションの舞台を閉じる（主人公が演者 → 行動.ERB「処女オークション（主人公）」）。落札者が射精した一手（→@行為をする）、[1500] 終える、05:00 から。
