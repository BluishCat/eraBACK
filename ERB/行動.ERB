PRINTL [ 0] やめる
FOR 商品, 0, 商品数
	;仕事の同意は商品ではないので勧められない
	SIF !商品が出るか(商品) || 商品仕事:商品
		CONTINUE
	;出す者には主人公自身が常に居るので、払えれば勧められる（→設計メモ「提供する側」。2026-09-13 に直した）
	IF 商品値段:商品 > 今日使える額:相手:0
		PRINTFORML 　　　 %系統名:(商品系統:商品), 8, LEFT%%商品名:商品, 18, LEFT%%金額(商品値段:商品, 7)%円（払えない）
	ELSE
		PRINTFORML [{商品 + 1, 2, RIGHT}] %系統名:(商品系統:商品), 8, LEFT%%商品名:商品, 18, LEFT%%金額(商品値段:商品, 7)%円
		数 += 1
	ENDIF
NEXT
IF 数 == 0
	PRINTL
	PRINTL 勧められるものが無い
	WAIT
	RETURN -1
ENDIF
