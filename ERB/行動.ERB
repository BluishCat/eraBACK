	WAIT
	RETURN 0
ENDIF

CALL 勧める商品を選ぶ(相手)
商品 = RESULT
SIF 商品 < 0
	RETURN 0
;地下ホールの客で、その場で受けられる商品なら個室へは行かず席のまま
その場 = (地下あり && CFLAG:相手:現在位置 == 地下ホールの位置 && その場の商品か(商品))
IF !その場 && 空き個室() <= 0
	PRINTL この商品は個室が要るが、個室が空いていない
	WAIT
	RETURN 0
ENDIF
CALL 出す者を選ぶ(商品, 相手)
出す者 = RESULT
SIF 出す者 < 0
	RETURN 0

CALL 体力気力を減らす(MASTER, 0, 勧めるの気力)
IF その場
	部屋 = 地下ホールの位置
ELSE
	部屋 = 空き個室()
ENDIF

PRINTL
PRINTFORML %CALLNAME:相手%に「%商品名:商品%」はどうかと勧めた
;金を払えば誰でも受けられる（→設計メモ「裏メニュー」）
CALL 裏に入る(相手, 出す者, 商品, 部屋)
IF その場
	PRINTFORML %CALLNAME:出す者%が%CALLNAME:相手%の席に付いた。そのまま席の奥で「%商品名:商品%」が始まった
ELSE
	PRINTFORML %CALLNAME:出す者%が%CALLNAME:相手%を個室へ連れていった
ENDIF
CALL 時間を進める(勧めるの分)
CALL 結果で止まる


;================================ 雇う ================================
;募集ではなく常連からの引き抜き（→設計メモ「スタッフ」）。同じキャラが客にもスタッフにもなるので立場の区別は持たない。
;人数の上限は寮の部屋数（一人一部屋で住み込む）。給料はキャラ側の条件で決まり、雇う前に見える。
;受けるかどうかは友情で決まる。シフトはまだ無いので、雇っても働かない

;日給。基本＋技能の合計×刻み（→設計メモ「スタッフ」）
;体力と気力を減らす。0 で止める（個室の一手・絶頂・裏の仕事の系統ぶん・勤務 → 変数定義.ERH「裏の仕事で減る体力・気力」）
;気力で払いきれない分は体力から引く（era の通例。2026-10-06 ユーザ指定）。気力が 0 になったら文で知らせる
;体力がここで尽きたら気絶する（→気絶.ERB）。NPC はその場で、主人公はコマンドの切れ目で（印を立てるだけ → @主人公の体力切れを見る）
;引数名を 体力・気力 にすると BASE:番号:体力 の添字が引数の値になる（ローカル変数が CSV の名前を隠す）
@体力気力を減らす(番号, 減る体力, 減る気力)
#DIM 番号
#DIM 減る体力
#DIM 減る気力
#DIM 気力の前
#DIM 不足
#DIM 払った気力

気力の前 = BASE:番号:気力
不足 = MAX(減る気力 - 気力の前, 0)
払った気力 = 減る気力 - 不足
減る体力 += 不足

BASE:番号:体力 -= 減る体力
SIF BASE:番号:体力 < 0
	BASE:番号:体力 = 0
BASE:番号:気力 -= 払った気力
SIF BASE:番号:気力 < 0
	BASE:番号:気力 = 0
CALL 消耗を積む(番号, 減る体力, 払った気力)

;気力が尽きた（0 になった）ことと、足りない分が体力から引かれたことを知らせる。
;すでに 0 のまま足りない分だけ引かれたときは主人公にだけ（NPC は尽きた瞬間だけ。個室の最中は変化の表が体力の減りを出す）
IF 減る気力 > 0 && BASE:番号:気力 <= 0
	IF 番号 == MASTER
		IF 気力の前 > 0
			PRINTL 気力が尽きた……
		ENDIF
		IF 不足 > 0 && 裏の相手:MASTER:0 <= 0
			PRINTFORML 　気力が足りない分は体力から引かれた（体力 -{不足}）
		ENDIF
	ELSEIF 気力の前 > 0 && 実キャラ:番号:0
		CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%の気力が尽きた")
	ENDIF
ENDIF

SIF 番号 != MASTER && BASE:番号:体力 <= 0
	CALL 気絶する(番号)
;主人公はコマンドの途中で倒れず、印だけ立てる（切れ目で気絶 → 気絶.ERB @主人公の体力切れを見る）
SIF 番号 == MASTER && 減る体力 > 0 && BASE:番号:体力 <= 0
	主人公の体力切れ = 1


;主人公がこの消耗を払えるか。気力で足りない分は体力から引かれ、体力が 0 で止まるので、体力が残っていれば（0 ぴったりにならなくても）実行できる
;（2026-10-06 ユーザ指定「体力が０ぴったりにならなくてもコマンドは実行可能に」）。体力が 0 になれば倒れるだけ（→気絶.ERB）。
;0 のときだけ呼び元が「気力が足りない」などと出して選ばせない。引数は消耗の見積もりで、今は判定に使わない（呼び元の形を変えないため残してある）
@払えるか(要る体力, 要る気力)
#FUNCTION
#DIM 要る体力
#DIM 要る気力

RETURNF BASE:MASTER:体力 > 0


;減らした量が溜まり、成長の一段ごとに上限が伸びる（→変数定義.ERH「体力・気力の成長」。2026-10-01 ユーザ指定）。
;引数が 0 でも呼んでよい。気絶は上限が伸びたあとで判定する
@消耗を積む(番号, 減る体力, 減る気力)
#DIM 番号
#DIM 減る体力
#DIM 減る気力

SIF 減る体力 > 0
	体力の消耗:番号:0 += 減る体力
SIF 減る気力 > 0
	気力の消耗:番号:0 += 減る気力
SIF 体力の消耗:番号:0 >= 成長の一段
	CALL 上限を伸ばす(番号, 0)
SIF 気力の消耗:番号:0 >= 成長の一段
	CALL 上限を伸ばす(番号, 1)


;射精で精力を減らす。残りが量に満たなければ残りを使い切り（0 で止め）、実際に減らした量を積んで成長させる（→変数定義.ERH「体力・気力の成長」）。射精の4か所（個室・自慰・夜這い・舞台）から呼ぶ
@精力を減らす(番号, 量)
#DIM 番号
#DIM 量

量 = MIN(量, BASE:番号:精力)
SIF 量 <= 0
	RETURN 0
BASE:番号:精力 -= 量
精力の消耗:番号:0 += 量
SIF 精力の消耗:番号:0 >= 成長の一段
	CALL 上限を伸ばす(番号, 3)


;対象は BASE の添字 0=体力 1=気力 3=精力。積んだ消耗を段に換えて MAXBASE に足す。上限で止まる（止まっても消耗は使ったことにして捨てる）
@上限を伸ばす(番号, 対象)
#DIM 番号
#DIM 対象
#DIM 段
#DIM 伸び

IF 対象 == 0
	段 = 体力の消耗:番号:0 / 成長の一段
	体力の消耗:番号:0 -= 段 * 成長の一段
ELSEIF 対象 == 1
	段 = 気力の消耗:番号:0 / 成長の一段
	気力の消耗:番号:0 -= 段 * 成長の一段
ELSE
	段 = 精力の消耗:番号:0 / 成長の一段
	精力の消耗:番号:0 -= 段 * 成長の一段
ENDIF

伸び = LIMIT(段 * 成長の幅, 0, 成長の上限 - MAXBASE:番号:対象)
SIF 伸び <= 0
	RETURN 0
MAXBASE:番号:対象 += 伸び
BASE:番号:対象 += 伸び
SIF 番号 == MASTER && 対象 == 0
	PRINTFORML 体力の上限が {MAXBASE:番号:対象} になった
SIF 番号 == MASTER && 対象 == 1
	PRINTFORML 気力の上限が {MAXBASE:番号:対象} になった
SIF 番号 == MASTER && 対象 == 3
	PRINTFORML 精力の上限が {MAXBASE:番号:対象} になった


@給料(番号)
#FUNCTION
#DIM 番号
#DIM 技能
#DIM 合計

合計 = 0
FOR 技能, 0, 技能数
	合計 += ABL:番号:技能
NEXT
RETURNF 給料の基本 + 合計 * 給料の刻み


;空いている寮の部屋。無ければ0
@空き部屋
#FUNCTION
#DIM 部屋
#DIM 番号
#DIM 埋まり

FOR 部屋, 410, 410 + 寮の部屋数
	埋まり = 0
	FOR 番号, 1, キャラ枠
		IF 実キャラ:番号:0 && スタッフ:番号:0 && 寮の部屋:番号:0 == 部屋
			埋まり = 1
			BREAK
		ENDIF
	NEXT
	SIF !埋まり
		RETURNF 部屋
NEXT
RETURNF 0


;================================ 同棲 ================================
;（→画面イメージ「同棲」。2026-09-16 ユーザ指定「自宅で同棲できるように（一定以上の関係のNPC(スタッフも客も)に打診しOKをもらったら）。解除もできるように」）
;同棲している人は自宅2階の空き部屋（511〜513）に住む。スタッフは寮の部屋を空ける（寮の枠が一つ空く）。
;客はこれまでどおり店に来る（家から出かけ、帰れば自分の部屋へ）。スタッフは家から出勤し、上がれば自分の部屋へ。
;夜這い・添い寝・一緒に眠るは寮の部屋と同じに効く（→夜這い.ERB、気絶.ERB）

;その人の住まい。同棲していれば自宅の部屋、スタッフなら寮の部屋、客なら 0（店の外の自分の家。世界から外れる）
@住まい(番号)
#FUNCTION
#DIM 番号

SIF 同棲:番号:0 > 0
	RETURNF 同棲:番号:0
SIF スタッフ:番号:0
	RETURNF 寮の部屋:番号:0
RETURNF 0


;店の外の自分の家に居るか（来店・連れ立ち・呼び寄せの「店に居ない」の判定）。同棲している人は自宅の自分の部屋に居れば家
@家に居るか(番号)
#FUNCTION
#DIM 番号

SIF CFLAG:番号:現在位置 == 0
	RETURNF 1
RETURNF 同棲:番号:0 > 0 && CFLAG:番号:現在位置 == 同棲:番号:0


;空いている自宅の部屋。無ければ 0
@空いている家の部屋
#FUNCTION
#DIM 部屋

FOR 部屋, 同棲の部屋の先頭, 同棲の部屋の先頭 + 同棲の部屋数
	SIF 部屋の主(部屋) == 0
		RETURNF 部屋
NEXT
RETURNF 0


;その部屋に住んでいる人。居なければ 0（場所名「〇〇の部屋」→マップ/場所名.ERB）
@部屋の主(部屋)
#FUNCTION
#DIM 部屋
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && 同棲:番号:0 == 部屋
		RETURNF 番号
NEXT
RETURNF 0


;同棲している人数（サイドの店タブ）
@同棲の人数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && 同棲:番号:0 > 0
		数 += 1
NEXT
RETURNF 数


;持ちかけられるか：まだ同棲しておらず、その人→主人公の恋愛の段が 同棲に要る恋の段 に届き、家に空き部屋があり、今日断られていない
@同棲を持ちかけられるか(番号)
#FUNCTION
#DIM 番号

SIF 同棲:番号:0 > 0 || 同棲を断られた日:番号:0 == 経過日数 + 1
	RETURNF 0
SIF 好感度の段(好感度_恋愛:番号:0) < 同棲に要る恋の段
	RETURNF 0
RETURNF 空いている家の部屋() > 0


;解消できるか：同棲していて、スタッフなら寮に空きがある（戻る部屋が無ければ番号なし）
@同棲を解消できるか(番号)
#FUNCTION
#DIM 番号

SIF 同棲:番号:0 <= 0
	RETURNF 0
RETURNF !スタッフ:番号:0 || 空き部屋() > 0


;主役の段の二行目に出す（→主役.ERB @主役へのコマンド行）。どこに居る相手にも出る
@同棲の行(番号)
#DIM 番号

SIF 同棲を解消できるか(番号)
	CALL 主役へのコマンドの行(1123, "同棲を解消する", 0)
SIF 同棲を持ちかけられるか(番号)
	CALL 主役へのコマンドの行(1122, "同棲を持ちかける", 同棲の気力)


;[1122]。通れば自宅の空き部屋に住む（スタッフは寮の部屋を空ける）。断られたらその日はもう持ちかけられない。時間と気力は返らない
@同棲を持ちかける(相手)
#DIM 相手
#DIM 部屋

IF !払えるか(0, 同棲の気力)
	PRINTL 気力が足りない（体力でも補えない）
	WAIT
	RETURN 0
ENDIF
部屋 = 空いている家の部屋()
IF 部屋 == 0
	PRINTL 家に空き部屋が無い
	WAIT
	RETURN 0
ENDIF
CALL 体力気力を減らす(MASTER, 0, 同棲の気力)

PRINTL 
PRINTFORML %CALLNAME:相手%に、うちで一緒に暮らさないかと持ちかけた
IF RAND(100) >= 同棲の通る率:(好感度の段(好感度_恋愛:相手:0))
	同棲を断られた日:相手:0 = 経過日数 + 1
	PRINTFORML %性別で言う(相手, "「……ごめんなさい。まだ、そこまでは決められないわ」", "「……悪い。まだ、そこまでは決められない」")%
	CALL 記憶に残す(相手, @"%CALLNAME:MASTER%に同棲を持ちかけられて断った")
ELSE
	同棲:相手:0 = 部屋
	SIF スタッフ:相手:0
		寮の部屋:相手:0 = 0
	PRINTFORML %性別で言う(相手, "「……うん。一緒に暮らしましょう」", "「……ああ。一緒に暮らそう」")%
	PRINTFORML %CALLNAME:相手%と同棲することになった。自宅の%GET_PLACE_NAME(部屋)%に住む
	CALL 記憶に残す(相手, @"%CALLNAME:MASTER%と同棲を始めた")
	CALL 出来事を記す(@"%CALLNAME:相手%と同棲を始めた")
ENDIF
CALL 時間を進める(同棲の分)
CALL 結果で止まる


;[1123]。スタッフは寮の空き部屋へ、客は店の外の自分の家へ。自宅に居れば出ていく（店に居る・連れているならその場のまま）。恋愛から 同棲の解消の傷
@同棲を解消する(相手)
#DIM 相手
#DIM 部屋
#DIM 位置

部屋 = 0
IF スタッフ:相手:0
	部屋 = 空き部屋()
	IF 部屋 == 0
		PRINTL 寮に空き部屋が無い
		WAIT
		RETURN 0
	ENDIF
ENDIF

PRINTL 
PRINTFORML %CALLNAME:相手%に、同棲をやめようと切り出した
PRINTFORML %性別で言う(相手, "「……そう。分かったわ」", "「……そうか。分かった」")%
同棲:相手:0 = 0
寮の部屋:相手:0 = 部屋
好感度_恋愛:相手:0 -= 同棲の解消の傷
SIF 好感度_恋愛:相手:0 < 0
	好感度_恋愛:相手:0 = 0
CALL 記憶に残す(相手, @"%CALLNAME:MASTER%との同棲をやめた")
CALL 出来事を記す(@"%CALLNAME:相手%との同棲をやめた")
位置 = CFLAG:相手:現在位置
IF 同行キャラ != 相手 && 位置 >= 500 && 位置 < 600
	CFLAG:相手:現在位置 = 住まい(相手)
	IF スタッフ:相手:0
		PRINTFORML %CALLNAME:相手%は荷物をまとめて寮へ移った
	ELSE
		PRINTFORML %CALLNAME:相手%は荷物をまとめて出ていった
	ENDIF
ENDIF
CALL 時間を進める(同棲の分)
CALL 結果で止まる


;================================ 逢引 ================================
;主役の段の三行目に出す（[1126]）。人目のない場所（→施設.ERB @二人きりか）で、体か恋愛の段が届く相手にだけ。
;通れば個室と同じ行為の一覧を、いまの場所で開く（→個室.ERB「逢引」）。断られても選択は消えない（気力と時間が掛かるので、続けて誘うのは割に合わない）

;誘えるか：気絶・陣痛・演目中でない、二人きり、関係の下限（→変数定義.ERH「逢引」）。勤務中のスタッフにも誘える。相手から誘われるほうも同じ（2026-10-15 ユーザ指定 → 客.ERB @逢引のティック）
@逢引に誘えるか(番号)
#FUNCTION
#DIM 番号

SIF 番号 <= 0 || !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
	RETURNF 0
