PRINTL 
PRINTFORML %CALLNAME:相手%に、うちで働かないかと持ちかけた（日給 %金額(給料(相手))%円）
;好感度が足りなければ断られる。時間と気力は返らない
IF 好感度の段(好感度_友情:相手:0) < 雇うのに要る段
	PRINTFORML 「……ごめんなさい。まだそこまでは」
ELSE
	スタッフ:相手:0 = 1
	寮の部屋:相手:0 = 部屋
	PRINTFORML %性別で言う(相手, "「いいわよ。世話になるわね」", "「いいよ。世話になる」")%
	PRINTFORML %CALLNAME:相手%を雇った。%GET_PLACE_NAME(部屋)%に住む
ENDIF
CALL 時間を進める(雇うの分)
CALL 結果で止まる


;================================ 連絡先 ================================
;好感度が上がって連絡先を交換すると、スマホで呼べる（→設計メモ「客」。呼べる＝来店時間の制約を外せる）。
;呼び寄せる（能力）の正規ルート側。こちらは無料だが、連絡先が要り、不満の相手は来ない（→画面イメージ「怪しい店」の連絡先）
@連絡先を交換する(相手)
#DIM 相手

IF 連絡先:相手:0
	PRINTL もう交換している
	WAIT
	RETURN 0
ENDIF
IF !払えるか(0, 連絡先の気力)
	PRINTL 気力が足りない（体力でも補えない）
	WAIT
	RETURN 0
ENDIF
CALL 体力気力を減らす(MASTER, 0, 連絡先の気力)

PRINTL 
PRINTFORML %CALLNAME:相手%に連絡先を聞いた
;友情の段が足りなければ断られる。傷は無い（雇うと同じ形）
IF 好感度の段(好感度_友情:相手:0) < 連絡先に要る段
	PRINTL 「……また今度ね」
ELSE
	連絡先:相手:0 = 1
	PRINTFORML %性別で言う(相手, "「いいわよ」", "「いいよ」")%%CALLNAME:相手%と連絡先を交換した
ENDIF
CALL 時間を進める(連絡先の分)
CALL 結果で止まる


;［その他］の入口。営業中で、連絡先があって店に居ない者が居るとき
@スマホで呼ぶ_入口

SIF !営業中(現在時刻) || スマホで呼べる者の数() <= 0
	RETURN 0
CALL コマンドを並べる(1008, "スマホで呼ぶ")


@スマホで呼べるか(番号)
#FUNCTION
#DIM 番号

RETURNF 連絡先:番号:0 && 呼べるか(番号)


@スマホで呼べる者の数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF スマホで呼べるか(番号)
		数 += 1
NEXT
RETURNF 数


;無料・時間なし。不満の相手は来ない（不満の客は来にくい、の線）。来店の流れは 呼び寄せる と同じ（→怪しい店.ERB）
@スマホで呼ぶ
#DIM 番号
#DIM 数

PRINTL
PRINTL 誰を呼びますか（キャラ番号。[0] でやめる）
数 = 0
FOR 番号, 1, キャラ枠
	SIF !スマホで呼べるか(番号)
		CONTINUE
	SIF 数 > 0 && 数 % 4 == 0
		PRINTL
	PRINTFORM [{番号, 3}] %CALLNAME:番号, 10, LEFT%
	数 += 1
NEXT
PRINTL
PRINTL [  0] やめる
INPUT
番号 = RESULT
SIF 番号 < 0 || 番号 >= キャラ枠 || !スマホで呼べるか(番号)
	RETURN 0

IF 満足度:番号:0 < 0
	PRINTFORML %CALLNAME:番号%からは「今日はやめておく」と返ってきた
	WAIT
	RETURN 0
ENDIF
CFLAG:番号:現在位置 = 0
来店予定:番号:0 = 経過日数 * 1440 + 現在時刻 + 呼ぶの分
PRINTFORML %CALLNAME:番号%に連絡した。{呼ぶの分 / 60}時間ほどで来る
WAIT


;================================ 訪ねてくる ================================
;（→画面イメージ「訪ねてくる」。2026-09-22 ユーザ指定「自宅にいると、スタッフやある程度親交のある人が訪ねてくるように」
;　→「玄関に来る。同居人の場合は部屋まで来る」→「時間経過で帰るのではなく、その場で対応を選択する形に」）
;主人公が自宅に居る間、親交のある人（友情か恋愛の高い方が 連れて行くに要る段 以上）が訪ねてくる。
;ティックで引き当てて旗を立て（@訪ねてくるを引く）、コマンドの後に 迎え入れる／帰ってもらう を聞く（@来客を聞く。出産ショーの打診と同じ型）。
;迎え入れれば連れている状態（同行.ERB と同じ。断られない・気力なし）。帰ってもらえば傷なし。
;スタッフは寮の部屋から、客は店の外の家から玄関へ。同居人は自宅の自分の部屋から主人公の居る部屋へ（呼び鈴なし）

;その人→主人公の 友情か恋愛の段の高い方
@親交の段(番号)
#FUNCTION
#DIM 番号
#DIM 段

段 = 好感度の段(好感度_友情:番号:0)
SIF 好感度の段(好感度_恋愛:番号:0) > 段
	段 = 好感度の段(好感度_恋愛:番号:0)
RETURNF 段


;今、訪ねてこられる人か。家（寮の部屋・店の外・自宅の自分の部屋）に居て、今日の来店予定が無く、今日まだ来ていない
@訪ねてこられるか(番号)
#FUNCTION
#DIM 番号

SIF !実キャラ:番号:0 || 番号 == 同行キャラ || 気絶中:番号:0 || 裏の相手:番号:0 > 0
	RETURNF 0
SIF 舞台に立っているか(番号) || 分娩で休んでいるか(番号)
	RETURNF 0
SIF 訪ねた日:番号:0 == 経過日数 + 1 || 来店予定:番号:0 >= 0
	RETURNF 0
SIF 親交の段(番号) < 連れて行くに要る段
	RETURNF 0
;同棲している人は自分の部屋、スタッフは寮の部屋（勤務中でない）、客は店の外の家
IF 同棲:番号:0 > 0
	RETURNF CFLAG:番号:現在位置 == 同棲:番号:0
ELSEIF スタッフ:番号:0
	RETURNF !勤務中:番号:0 && CFLAG:番号:現在位置 == 寮の部屋:番号:0
ENDIF
RETURNF CFLAG:番号:現在位置 == 0


;ティックごと（→客.ERB @ティック処理）。主人公が自宅に居て起きているとき、候補を一人ずつ引く。引き当てたら旗を立てて終わり（一度に一人）
@訪ねてくるを引く
#DIM 番号
#DIM 位置

SIF 来客の候補 > 0 || 同行キャラ > 0 || 裏の相手:MASTER:0 > 0 || 主人公が眠っている
	RETURN 0
位置 = CFLAG:MASTER:現在位置
;自宅の中。風呂・トイレに居るときは来ない
SIF 位置 < 500 || 位置 >= 600 || 位置 == 502 || 位置 == 503
	RETURN 0
SIF 現在時刻 < 訪問の始め || 現在時刻 >= 訪問の終い
	RETURN 0
FOR 番号, 1, キャラ枠
	SIF !訪ねてこられるか(番号)
		CONTINUE
	IF RAND:1000 < 訪ねてくる率 * (親交の段(番号) - 連れて行くに要る段 + 1)
		来客の候補 = 番号
		RETURN 0
	ENDIF
NEXT


;コマンドの後（→USERCOM.ERB @USERCOM）。旗が立っていれば条件を見直して聞く。主人公が個室の最中・05:00 なら旗を残して次へ
@来客を聞く
#DIM 相手
#DIM 位置

SIF 来客の候補 <= 0
	RETURN 0
SIF 裏の相手:MASTER:0 > 0 || 強制就寝 || 主人公が眠っている
	RETURN 0
相手 = 来客の候補
来客の候補 = 0
位置 = CFLAG:MASTER:現在位置
SIF 位置 < 500 || 位置 >= 600 || 位置 == 502 || 位置 == 503
	RETURN 0
SIF 同行キャラ > 0 || !訪ねてこられるか(相手)
	RETURN 0
;聞いたらその日はもう来ない（迎え入れても帰ってもらっても）
訪ねた日:相手:0 = 経過日数 + 1

PRINTL 
IF 同棲:相手:0 > 0 && 鍵がかかっているか(位置)
	;主人公が私室に鍵をかけていれば、同居人も入ってこられずに戸を叩く（玄関に来たときと同じ聞き方。→鍵.ERB）
	PRINTFORML 戸を叩く音がした。鍵を開けて見ると、%CALLNAME:相手%が立っていた
	CALL 訪問の口上(相手, 0)
ELSEIF 同棲:相手:0 > 0
	PRINTFORML %CALLNAME:相手%が部屋に入ってきた
	CALL 訪問の口上(相手, 1)
ELSE
	PRINTFORML 呼び鈴が鳴った。玄関に出ると、%CALLNAME:相手%が立っていた
	CALL 訪問の口上(相手, 0)
ENDIF
PRINTL どうしますか
PRINTL [0] 迎え入れる　　[1] 帰ってもらう
INPUT
IF RESULT == 1
	IF 同棲:相手:0 > 0
		PRINTL 「ごめん、あとでね」
	ELSE
		PRINTL 「ごめん、今日はちょっと」
	ENDIF
	CALL 訪問の口上(相手, 2)
	IF 同棲:相手:0 > 0
		PRINTFORML %CALLNAME:相手%は自分の部屋へ戻った
	ELSEIF スタッフ:相手:0
		PRINTFORML %CALLNAME:相手%は寮へ帰った
	ELSE
		PRINTFORML %CALLNAME:相手%は帰っていった
	ENDIF
	CALL 記憶に残す(相手, @"%CALLNAME:MASTER%の家を訪ねたが、帰された")
	CALL 出来事を記す(@"%CALLNAME:相手%が訪ねてきた（帰ってもらった）")
ELSE
	PRINTL 「いらっしゃい」
	;以後は連れている状態（→同行.ERB）。付いていく（追跡）とは同時に持たない
	同行キャラ = 相手
	同行の開始 = 経過日数 * 1440 + 現在時刻
	追跡キャラ = 0
	CFLAG:相手:現在位置 = 位置
	;迎え入れたら私室の戸は開いている（→鍵.ERB）
	SIF 位置 == 私室の位置
		私室の鍵 = 0
	PRINTFORML %CALLNAME:相手%を迎え入れた
	CALL 記憶に残す(相手, @"%CALLNAME:MASTER%の家を訪ねた")
	CALL 出来事を記す(@"%CALLNAME:相手%が訪ねてきた")
ENDIF
WAIT


;来訪の口上（キャラ別 → タイプ別_性別 → タイプ別）。場面 0=玄関に来た 1=同居人が部屋に来た 2=帰される。着替えの口上と同じ落ち方
@訪問の口上(番号, 場面)
#DIM 番号
#DIM 場面
#DIMS タイプ
#DIMS 性別
#DIMS 方言

RESULTS '= ""
SIF CFLAG:番号:口上なし
	RETURN 0
TRYCCALLFORM 口上_訪問_{番号}(番号, 場面)
CATCH
ENDCATCH
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
方言 '= 方言の接尾(番号)
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM 口上_訪問_%タイプ%_%性別%%方言%(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == ""
	TRYCCALLFORM 口上_訪問_%タイプ%_%性別%(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && 方言 != ""
	TRYCCALLFORM 口上_訪問_%タイプ%_女%方言%(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 性別 == "ふたなり"
	TRYCCALLFORM 口上_訪問_%タイプ%_女(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM 口上_訪問_%タイプ%%方言%(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == ""
	TRYCCALLFORM 口上_訪問_%タイプ%(番号, 場面)
	CATCH
	ENDCATCH
ENDIF
SIF RESULTS != ""
	PRINTFORML 　%RESULTS%


;================================ 休憩 ================================
;落ち着ける場所なら1時間休める（2026-09-12 にユーザ指定）。睡眠ほどは戻らないが、寝られない時間帯の手当てになる。
;落ち着けるのは 客の目が無い裏方（バックヤード・控室・事務室）／自宅の部屋／寮の部屋。
;ホール・カウンター・舞台・厨房・玄関・階段・トイレ・店の外は落ち着かない
@落ち着ける(位置)
#FUNCTION
#DIM 位置

;店（画面0）
SIF 位置 == 5 || 位置 == 7 || 位置 == 14
	RETURNF 1
;後付け施設の休憩室（→施設.ERB）
SIF 場所の施設(位置) == 施設_休憩室
	RETURNF 1
;寮の部屋
SIF 位置 >= 410 && 位置 < 410 + 寮の部屋数
	RETURNF 1
;自宅のリビング・客間・私室
SIF 位置 == 505 || 位置 == 507 || 位置 == 私室の位置
	RETURNF 1
RETURNF 0


;コマンドの行。落ち着ける場所でだけ出す
@休憩する_入口

SIF !落ち着ける(CFLAG:MASTER:現在位置)
	RETURN 0
SIF BASE:MASTER:体力 >= MAXBASE:MASTER:体力 && BASE:MASTER:気力 >= MAXBASE:MASTER:気力
	RETURN 0
CALL コマンドを並べる(1032, "休憩する")


;自宅の風呂で体を洗う。膣に留まっている精液が流れる（子宮に届いた分は流せない → 妊娠.ERB @膣を洗う）。
;個室の汚れは室を出た時点で消えているので、ここで落とすものは膣の分だけ
@体を洗う

CALL 時間を進める(洗うの分)
CALL 膣を洗う(MASTER)
IF RESULT
	PRINTL 風呂で体を洗った。中に出されたものも、洗い流せるだけ流した
ELSE
	PRINTL 風呂で体を洗った
ENDIF
CALL 結果で止まる


@休憩する

IF !落ち着ける(CFLAG:MASTER:現在位置)
	PRINTL ここでは落ち着いて休めない
	WAIT
	RETURN 0
ENDIF
IF BASE:MASTER:体力 >= MAXBASE:MASTER:体力 && BASE:MASTER:気力 >= MAXBASE:MASTER:気力
	PRINTL 休む必要がない
	WAIT
	RETURN 0
ENDIF

;回復早い／回復遅い（→Talent.csv の体質）
BASE:MASTER:体力 += 体質の倍率(MASTER, 休憩の体力, GETNUM(TALENT, "回復早い"), GETNUM(TALENT, "回復遅い"))
SIF BASE:MASTER:体力 > MAXBASE:MASTER:体力
	BASE:MASTER:体力 = MAXBASE:MASTER:体力
BASE:MASTER:気力 += 体質の倍率(MASTER, 休憩の気力, GETNUM(TALENT, "回復早い"), GETNUM(TALENT, "回復遅い"))
SIF BASE:MASTER:気力 > MAXBASE:MASTER:気力
	BASE:MASTER:気力 = MAXBASE:MASTER:気力

PRINTL 
PRINTL しばらく腰を下ろして休んだ。
CALL 時間を進める(休憩の分)
;止める前に変化を出す（@USERCOM_本体 に任せると WAIT の後になる。出した印は立つので重ねては出ない）
CALL 変化を出す(MASTER, 2)
WAIT


;================================ 迷惑客を収める ================================
;居合わせただけでは効かない。現場へ行って行動として選ぶ（→設計メモ「迷惑客」）。警備Lvで成否が決まる

;コマンドの行。迷惑客が同じ場所に居るときだけ出す
@客を収める_入口

SIF 迷惑客の場所 <= 0 || CFLAG:MASTER:現在位置 != 迷惑客の場所
	RETURN 0
SIF 酔いすぎ(MASTER) || BASE:MASTER:体力 < 収めるの体力
	RETURN 0
CALL コマンドを並べる(1031, "客を収める")


@客を収める
#DIM 率

IF 迷惑客の場所 <= 0 || CFLAG:MASTER:現在位置 != 迷惑客の場所
	PRINTL ここで絡んでいる客は居ない
	WAIT
	RETURN 0
ENDIF
IF 酔いすぎ(MASTER)
	PRINTL 酔って止めに入れない
	WAIT
	RETURN 0
ENDIF
IF BASE:MASTER:体力 < 収めるの体力
	PRINTL 体力が足りない
	WAIT
	RETURN 0
ENDIF

CALL 体力気力を減らす(MASTER, 収めるの体力, 0)
率 = 収めるの成功率 + ABL:MASTER:警備 * 20

PRINTL 
IF RAND(100) < 率
	CALL 見える(迷惑客の場所, "絡んでいた客をなだめ、店の外まで送り出した", "ホールの騒ぎが収まったようだ")
	迷惑客の場所 = 0
ELSE
	PRINTL 割って入ったが、相手は聞く耳を持たない
ENDIF
CALL 経験を入れる(技能_警備, 接客の経験)
CALL 時間を進める(収めるの分)
CALL 結果で止まる


;================================ 広報 ================================
;事務室から発信する（現代なのでスマホ。→設計メモ「割り振りの形」）。
;効くのは客の量だけで、評判は上げない。迎える準備がなければ汚れて満足度が落ちる（＝「広報は諸刃」）

;コマンドの行。できないときは番号なしで出す
@広告を打つ_入口

SIF 広報の効き > 0 || MONEY:MASTER < 広報の費用 || !払えるか(0, 広報の気力)
	RETURN 0
CALL コマンドを並べる(1024, "広告を打つ")


@広告を打つ

IF 広報の効き > 0
	PRINTL 今日はもう打ってある
	WAIT
	RETURN 0
ENDIF
IF MONEY:MASTER < 広報の費用
	PRINTL 所持金が足りない
	WAIT
	RETURN 0
ENDIF
IF !払えるか(0, 広報の気力)
	PRINTL 気力が足りない（体力でも補えない）
	WAIT
	RETURN 0
ENDIF

MONEY:MASTER -= 広報の費用
今日の広報費 += 広報の費用
CALL 体力気力を減らす(MASTER, 0, 広報の気力)
広報の効き = 広報の幅 + ABL:MASTER:広報 * 10

PRINTL 
PRINTFORML 広告を出した（%金額(広報の費用)%円）
PRINTFORML 明日の客足が {広報の効き}％ 増える見込みだ
CALL 経験を入れる(技能_広報, 接客の経験)
CALL 時間を進める(広報の分)
CALL 結果で止まる


;================================ 掃除 ================================
;店の汚れは客が居るだけで溜まり、目につくと客の満足度が下がる（→設計メモ「経済の輪」）。
;主人公はその場所を掃除できる。スタッフの清掃（汚れの高い場所へ自動で向かう）はこれから

;汚れを足す。上限と0で止める
@汚れを足す(場所, 量)
#DIM 場所
#DIM 量

SIF 場所 < 0 || 場所 >= 100
	RETURN 0
汚れ:場所 += 量
SIF 汚れ:場所 > 汚れの上限
	汚れ:場所 = 汚れの上限
SIF 汚れ:場所 < 0
	汚れ:場所 = 0


;場所名の行に付ける出来事（2026-09-21 ユーザ指定「場所情報に、そこで行われているイベントがあればそれを表示するように」→画面イメージ「店の画面」の場所名の行）。
;その場所から見える舞台（居る舞台も）に立っている人を一人ずつ：出産ショー中なら「（〇〇の出産ショー）」、舞台の仕事に就いているスタッフなら「（〇〇のストリップ）」
@出来事のタグ(場所)
#FUNCTIONS
#DIM 場所
#DIM 舞台
#DIM 番号
#DIM 仕事
#DIMS 出力
#DIMS 名

出力 '= ""
舞台 = -1
IF 場所 == 4 || 舞台が見えるか(場所, 4)
	舞台 = 4
ELSEIF 場所 == 地下ステージの位置 || 舞台が見えるか(場所, 地下ステージの位置)
	舞台 = 地下ステージの位置
ENDIF
SIF 舞台 < 0
	RETURNF その場の裏のタグ(場所)
FOR 番号, 0, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 舞台
		CONTINUE
	IF 出産ショー中:番号:0
		IF 番号 == MASTER
			出力 += "（あなたの出産ショー）"
		ELSE
			出力 += "（" + CALLNAME:番号 + "の出産ショー）"
		ENDIF
		CONTINUE
	ENDIF
	IF 処女オークション中:番号:0
		IF 番号 == MASTER
			出力 += "（あなたの処女オークション）"
		ELSE
			出力 += "（" + CALLNAME:番号 + "の処女オークション）"
		ENDIF
		CONTINUE
	ENDIF
	SIF 番号 == MASTER || !スタッフ:番号:0 || !勤務中:番号:0 || 気絶中:番号:0
		CONTINUE
	仕事 = シフト:番号:営業曜日
	SIF 仕事 <= 0 || 仕事の場所:仕事 != 舞台
		CONTINUE
	名 '= 仕事名:仕事
	;地下歌・地下演奏は「歌」「演奏」
	SIF 仕事 == 13 || 仕事 == 15
		名 '= SUBSTRINGU(名, 2, 2)
	出力 += "（" + CALLNAME:番号 + "の" + 名 + "）"
NEXT
RETURNF 出力 + その場の裏のタグ(場所)


;地下ホールのその場の裏の組を「（けんた×あかり「本番」）」の形で並べる。地下ホール以外・地下が無ければ空。
;主人公が提供する組は主人公が場面の画面に居て場所名の行を見ないので出さない（@出来事のタグ から呼ぶ）
@その場の裏のタグ(場所)
#FUNCTIONS
#DIM 場所
#DIM 番号
#DIM 相手
#DIM 客
#DIM 提供
#DIMS 出力

出力 '= ""
SIF !地下あり || 場所 != 地下ホールの位置
	RETURNF ""
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 場所 || 裏の相手:番号:0 <= 0 || 裏の商品:番号:0 < 0
		CONTINUE
	相手 = 裏の相手:番号:0
	;組は番号の小さい方から一度だけ
	SIF 相手 < 番号
		CONTINUE
	;提供する側は勤務中のスタッフ。客はその相手
	IF スタッフ:番号:0 && 勤務中:番号:0
		客 = 相手
		提供 = 番号
	ELSE
		客 = 番号
		提供 = 相手
	ENDIF
	出力 += "（" + CALLNAME:客 + "×" + CALLNAME:提供 + "「" + 商品名:(裏の商品:番号:0) + "」）"
NEXT
RETURNF 出力


;汚れの様子。気になる線より下なら空文字（何も出さない）
@汚れのタグ(場所)
#FUNCTIONS
