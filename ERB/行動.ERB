#DIM 量
#DIM 反応した

SIF !自慰できるか()
	RETURN 0

;候補部位（口＝0 は自分では触れないので除く。部位の意味・性別対応は→個室.ERB @絶頂の文、変数定義.ERH 部位のある性別）
数 = 0
FOR 部位, 1, 6
	SIF !(部位のある性別:部位 & 性別ビット(MASTER))
		CONTINUE
	候補:数 = 部位
	数 += 1
NEXT
SIF 数 <= 0
	RETURN 0
部位 = 候補:(RAND(数))

IF CFLAG:MASTER:現在位置 / 100 == 5
	PRINTL 自室でゆったりと自分を慰めた……
ELSE
	PRINTL 人目を忍んで、こっそりと自分を慰めた……
ENDIF

;10分ずつ3回（計30分）進める。一回ごとにその分の快感と欲情が入り（合わせて絶頂の線）、第三者が来て見つかれば
;その時点で中断して反応する（絶頂しない。入った分だけ残る。→見つかる.ERB。2026-10-02 ユーザ指定「自慰は途中で割り込む」）
自慰中 = 1
見つけた者 = 0
反応した = 0
FOR 段, 0, 3
	量 = 射精の線 / 3
	SIF 段 == 2
		量 = 射精の線 - 射精の線 / 3 * 2
	CALL その場の値を足す(MASTER, 部位, 量)
	CALL その場の値を足す(MASTER, 8, 量)
	CALL 性の値を整える(MASTER)
	CALL 時間を進める(10)
	CALL 見つかった反応を見る
	IF RESULT
		反応した = 1
		BREAK
	ENDIF
	;高まり（二回目）と限界（三回目）の前触れ。絶頂のすぐ前に一行（→絶頂の描写.ERB）
	SIF 段 >= 1
		CALL 自慰の前触れ(部位, 段)
	;05:00 をまたいだら強制就寝。そこで切り上げて、絶頂まで済ませる
	SIF 強制就寝
		BREAK
NEXT
自慰中 = 0
CALL 見つかりを片付ける
;中断したなら絶頂しない（反応の中で WAIT 済み。動いた値は @USERCOM_本体 が出す）
SIF 反応した
	RETURN 0

IF 部位 == 部位_男性器
	CALL 自慰の射精を見る(MASTER)
ELSE
	CALL 自慰の絶頂を見る(MASTER, 部位)
ENDIF

;動いた値は止める前に縦に並べて出す（@USERCOM_本体 に任せると WAIT の後になる。出した印は立つので重ねては出ない）
CALL 変化を出す(MASTER, 2)
WAIT


;絶頂の演出（男性器以外）。開発度・PALAM・欲情・体力気力の処理は個室.ERB @絶頂を見る と同じ形、文だけ自慰用に差し替え
@自慰の絶頂を見る(番号, 部位)
#DIM 番号
#DIM 部位

;強さは快感を戻し欲情を減らす前に見る（→個室.ERB @絶頂の強さ。画面イメージ「強い絶頂と大量射精」）
今回の強絶頂 = 絶頂の強さ(番号, 部位) >= 強絶頂の線
開発度_感度:番号:部位 += PALAM:番号:部位 / 行為の開発
PALAM:番号:部位 = 0
CALL 絶頂で濡れる(番号)
PALAM:番号:欲情 /= 射精の欲情割
IF 今回の強絶頂
	CALL 体力気力を減らす(番号, 絶頂の体力 * 強絶頂の消耗, 絶頂の気力 * 強絶頂の消耗)
ELSE
	CALL 体力気力を減らす(番号, 絶頂の体力, 絶頂の気力)
ENDIF
CALL 性の値を整える(番号)
PRINTFORML %自慰の絶頂文(番号, 部位)%
IF 今回の強絶頂
	CALL 強い絶頂の文(番号, 部位)
	CALL 潮吹き(番号, 部位)
ENDIF
CALL 初めての絶頂(番号, 部位)
CALL 達したと知らせる(番号, 部位)
SIF 部位 == 部位_膣
	CALL 膣内絶頂(番号)
SIF 母乳が張っているか(番号)
	CALL 噴乳(番号, -1)
今回の強絶頂 = 0


;射精の簡易版（個室.ERB @射精を見る の簡略版。出す先は選ばず自分の手で受ける固定文）
@自慰の射精を見る(番号)
#DIM 番号
#DIM 量
#DIM 超過

量 = 射精の量
SIF TALENT:番号:絶倫
	量 = 射精の量 / 2
IF BASE:番号:精力 <= 0
	PRINTL もう出ないようだ
	PALAM:番号:快感_男性器 = 0
	RETURN 0
ENDIF
;大量射精（→個室.ERB @大量射精になるか。射精の線の手前の値で見るので、快感と欲情を戻す前に）
今回の強絶頂 = 大量射精になるか(番号, 量)
SIF 今回の強絶頂
	量 = 量 * 大量射精の精力 / 100
CALL 精力を減らす(番号, 量)
IF 今回の強絶頂
	CALL 体力気力を減らす(番号, 絶頂の体力 * 強絶頂の消耗, 絶頂の気力 * 強絶頂の消耗)
ELSE
	CALL 体力気力を減らす(番号, 絶頂の体力, 絶頂の気力)
ENDIF
開発度_感度:番号:部位_男性器 += PALAM:番号:快感_男性器 / 行為の開発
PALAM:番号:快感_男性器 = 0
CALL 絶頂で濡れる(番号)
PALAM:番号:欲情 /= 射精の欲情割
CALL 性の値を整える(番号)
超過 = PALAM:番号:勃起 - 勃起の線
SIF 超過 > 0
	CALL 勃起を下げる(番号, 超過 / 2)
PRINTFORML %自慰の絶頂文(番号, 部位_男性器)%
SIF 今回の強絶頂
	CALL 強い絶頂の文(番号, 部位_男性器)
CALL 初めての絶頂(番号, 部位_男性器)
CALL 達したと知らせる(番号, 部位_男性器)
今回の強絶頂 = 0
