#DIM 手
#DIM 相手
#DIM 通った

SELECTCASE 手
	CASE 0
		IF 通った
			PRINTFORML %CALLNAME:相手%をじっと見つめた。%CALLNAME:相手%は落ち着かなげに目を伏せた
		ELSE
			PRINTFORML %CALLNAME:相手%をじっと見つめた。「……なに？」と睨まれた
		ENDIF
