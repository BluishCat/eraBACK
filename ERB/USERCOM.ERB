	CASE 5500 TO 5500 + 追跡枠の数 - 1
		;追跡枠の［付いていく］。付いている最中ならやめる
		IF 追跡キャラ == 追跡枠:(RESULT - 5500)
			追跡キャラ = 0
		ELSE
			追跡キャラ = 追跡枠:(RESULT - 5500)
		ENDIF
