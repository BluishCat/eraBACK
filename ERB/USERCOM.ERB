ENDSELECT


;移動はコマンドの一種。時間を消費する（→設計メモ「建物」）
@移動(行き先)
#DIM 行き先
#DIMS 名前

;裏の最中は席を外せない（→設計メモ「提供する側」）
IF 裏の相手:MASTER:0 > 0
	PRINTL いまは席を外せない
	WAIT
	RETURN 0
ENDIF
;出産ショーの最中は舞台を降りられない（[1045] でやめられる → 行動.ERB「出産ショー（主人公）」）
IF 出産ショー中:MASTER:0
	PRINTL ショーの最中は舞台を降りられない（[1045] 舞台を降りる でやめられる）
	WAIT
	RETURN 0
ENDIF

名前 = %GET_PLACE_NAME(行き先)%

IF 名前 == ""
	PRINTL そこにはまだ何もない
	WAIT
	RETURN 0
ENDIF

;別の画面の場所（見取り図を切り替えてから選んだもの）は、出口を通って行く。出入口の番号そのものは下で扱う（私室へ戻る用）
IF 行き先 / 100 != CFLAG:MASTER:現在位置 / 100 && 入口の行き先画面(行き先) < 0
	CALL 画面をまたいで移動(行き先)
	RETURN 0
ENDIF

;画面をまたぐ入口。別の建物へ移る分だけ余計にかかる
SELECTCASE 行き先
	CASE 9
		;店の外へ
		CALL 移動する(300, 2)
		RETURN 0
	CASE 309
		;店に戻る
		CALL 移動する(8, 2)
		RETURN 0
	CASE 15
		;寮へ。店から直接つながっているので外出より軽い
		CALL 移動する(400, 1)
		RETURN 0
	CASE 409
		;店に戻る
		CALL 移動する(15, 1)
		RETURN 0
	CASE 1
		;自宅へ
		CALL 移動する(500, 1)
		RETURN 0
	CASE 509
		;店に戻る
		CALL 移動する(1, 1)
		RETURN 0
ENDSELECT

;すでにそこに居るなら何もしない。時間も使わない
IF 行き先 == CFLAG:MASTER:現在位置
	RETURN 0
ENDIF

;同じ建物の中は、経路を1手ずつ辿りながら誰かと出会わないか確かめて進む
CALL プレイヤー移動(行き先)


;別の画面の場所へ。いまの画面の出口を通り（店以外に居れば店へ戻り）、行き先の画面の入口から先は経路を1手ずつ辿る。
;出入口にかかる手数は従来の画面またぎと同じ（→隣接.ERB @戻る手数／@入る手数）。時間は行き先を選んだここから進む
@画面をまたいで移動(行き先)
#DIM 行き先
#DIM 元の画面
#DIM 先の画面

元の画面 = CFLAG:MASTER:現在位置 / 100
先の画面 = 行き先 / 100
;寮・自宅から店の外へは店を通らない（→隣接.ERB @直接外へ出るか）。店へ戻る分は無く、外への入る手数だけかかる
IF 元の画面 != 0 && 戻る手数(元の画面) > 0 && !直接外へ出るか(元の画面, 先の画面)
	CALL 移動する(戻る先(元の画面), 戻る手数(元の画面))
	SIF 強制就寝
		RETURN 0
ENDIF
IF 先の画面 != 0 && 入る手数(先の画面) > 0
	CALL 移動する(入る先(先の画面), 入る手数(先の画面))
	SIF 強制就寝
		RETURN 0
ENDIF
SIF 行き先 != CFLAG:MASTER:現在位置
	CALL プレイヤー移動(行き先)


;移動の画面から、どこに居ても自宅の私室まで一度に戻る（2026-09-15 ユーザ指定）。
;店の外・寮 → 店 → 自宅 → 私室 と @移動 を繋ぐので、手数と時間は一つずつ移動したのと同じ。途中で 05:00 が来ればそこで止まる
@私室へ戻る

;裏の最中は席を外せない（@移動 と同じ）
IF 裏の相手:MASTER:0 > 0
	PRINTL いまは席を外せない
	WAIT
	RETURN 0
ENDIF

SELECTCASE CFLAG:MASTER:現在位置 / 100
	CASE 3
		CALL 移動(309)
	CASE 4
		CALL 移動(409)
ENDSELECT
SIF 強制就寝
	RETURN 0
SIF CFLAG:MASTER:現在位置 / 100 == 0
	CALL 移動(1)
SIF 強制就寝
	RETURN 0
CALL 移動(私室の位置)


;プレイヤー自身の移動。経路を1手ずつ辿り、誰かと同じ部屋に来合わせたら足を止めるか確認する
;（→memo.md「移動中に誰かに遭遇」。erablue_resort の COMF400_移動.ERB に倣う）
;イベント側が直接呼ぶ @移動する は瞬間移動のまま変えない。ここはコマンド操作の移動だけに使う
@プレイヤー移動(行き先)
#DIM 行き先
#DIM 手数
#DIM 手
#DIM 場所
#DIM 進んだ手数
#DIM 聞かない
#DIM 手前
#DIMS 出会った

手数 = 移動経路(CFLAG:MASTER:現在位置, 行き先)
IF 手数 <= 0
	;経路が求まらないとき（表に無い場所どうし）は、従来どおり1手で直接移す
	CALL 移動する(行き先, 1)
	RETURN 0
ENDIF

進んだ手数 = 0
聞かない = 0
FOR 手, 0, 手数
	場所 = 経路:手
	進んだ手数 += 1
	;最後の一歩で鍵のかかった部屋に着くなら、戸の前でノックするかを聞く（→鍵.ERB。2026-10-09）。
	;やめれば戸の前まで来たぶんだけ、断られた・返事がなければノックしたぶんも使って手前に残る。開けてもらえたらそのまま入る（出会いは聞かない）
	IF 場所 == 行き先 && 鍵がかかっているか(場所)
		手前 = CFLAG:MASTER:現在位置
		SIF 手 > 0
			手前 = 経路:(手 - 1)
		CALL ノックする(場所)
		SELECTCASE RESULT
			CASE 0
				SIF 進んだ手数 > 1
					CALL 移動する(手前, 進んだ手数 - 1)
				RETURN 0
			CASE 2
				CALL 移動する(手前, 進んだ手数)
				RETURN 0
		ENDSELECT
		進んだ手数 += 1
		聞かない = 1
	ENDIF
	SIF 聞かない
		CONTINUE
	;目的地そのものは、着けばそこに居るのが見えるので聞かない（続ける先が無い。2026-10-15 ユーザ指摘）
	SIF 場所 == 行き先
		CONTINUE
	出会った '= 出会った相手(場所)
	SIF 出会った == ""
		CONTINUE
	PRINTFORML %GET_PLACE_NAME(場所)%で%出会った%と出会った
	PRINTL ……どうしますか？
	PRINTL [0] そのまま移動する
	PRINTL [1] 足を止める
	PRINTL
	PRINTL [9] そのまま移動する（このあとは聞かない）
	INPUT
	IF RESULT == 1
		CALL 移動する(場所, 進んだ手数)
		RETURN 0
	ELSEIF RESULT == 9
		聞かない = 1
	ENDIF
NEXT

CALL 移動する(行き先, 進んだ手数)


;場所に居合わせている実キャラの名前をまとめる。同行中・追跡中・気絶中は数えない
@出会った相手(場所)
#FUNCTIONS
#DIM 場所
#DIM 番号
#DIMS 出力

出力 '= ""
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	SIF CFLAG:番号:現在位置 != 場所
		CONTINUE
	SIF 番号 == 追跡キャラ || 番号 == 同行キャラ
		CONTINUE
	SIF 気絶中:番号:0
		CONTINUE
	IF 出力 != ""
		出力 += "、"
	ENDIF
	出力 += @"%CALLNAME:番号%"
NEXT
RETURNF 出力


;手数ぶんの時間を使って移す。手数が数えられないときは1手として扱う
@移動する(行き先, 手数)
#DIM 行き先
#DIM 手数

SIF 手数 < 1
	手数 = 1

;私室にかけた鍵は、私室を出れば開く（→鍵.ERB）
SIF 行き先 != CFLAG:MASTER:現在位置
	私室の鍵 = 0
CFLAG:MASTER:現在位置 = 行き先
;連れている相手も同じ場所へ（→同行.ERB）
CALL 同行で移動(行き先)
CALL 時間を進める(手数 * 一手の分数)
;店の外の施設なら対応してくれる人の一言、初めて入った部屋ならその説明（→導入.ERB @施設対応の一言／@初めての場所）。
;ここでは出さず、SHOW_USERCOM_店 の見出しの罫線の中で出す（2026-09-29 ユーザ指摘「枠外にしか見えない」）
入場の一言がまだ = 1


;時計は分で進み、世界（客の処理＝ティック）は10分の境目を跨ぐたびに動く（→設計メモ「世界と時間」）
;1手5分の移動なら、2手目で1ティック。5分の端数は時計に残る（18:05 と表示される）
;起きている間に一日の終わり（05:00）が来ると強制就寝が立ち、そこで打ち切る。実際に進んだ分を RESULT で返す
@時間を進める(分)
#DIM 分
#DIM 残り
#DIM 進む
#DIM 進んだ分

残り = 分
進んだ分 = 0

WHILE 残り > 0
	;次の10分の境目まで、残りの範囲で進む
	進む = 10 - 現在時刻 % 10
	SIF 進む > 残り
		進む = 残り
	現在時刻 += 進む
	残り -= 進む
	進んだ分 += 進む

	;境目に乗っていなければ、時計だけ進んで世界は動かない
	SIF 現在時刻 % 10 != 0
		CONTINUE

	;一日の終わり（05:00）。日付と曜日はここで変わる（0時では何も起きない → 設計メモ「世界と時間」）
	;起きている主人公が陣痛中か、傍で出産に付き添っているなら、産み終わるまで越えない（時計は 1740 を超えて進み、産み終えた後の最初の境目で日替わり・強制就寝。2026-10-17 ユーザ指定）。眠っていれば（起床時点 < 就寝時点）これまでどおり越える
	IF 現在時刻 >= 一日の終わり && (起床時点 < 就寝時点 || !出産中で日を越えないか())
		現在時刻 -= 1440
		経過日数 += 1
		曜日 = (曜日 + 1) % 7
		CALL 日替わり
		;起きていれば（最後に起きたのが最後に寝たより後）今日はここまで。起床の処理で眠っている間は寝続ける
		IF 起床時点 >= 就寝時点
			CALL ティック処理
			強制就寝 = 1
			BREAK
		ENDIF
	ENDIF
	CALL ティック処理
	;眠っている間に夜這いで目を覚まして受け入れた。眠りはここで打ち切り、個室の場面へ（→夜這い.ERB。仮眠・就寝が旗を見る）
	SIF 夜這いで起きた
		BREAK
WEND

;膣に精液のある者は、進めたぶんだけ子宮へ移る（→設計メモ「膣から子宮へ」）
CALL 精液の移行(進んだ分)
;陣痛中の者を進めたぶんだけ進める（1回30分まで。→設計メモ「陣痛と分娩」）
CALL 分娩の時間(進んだ分)
RETURN 進んだ分


