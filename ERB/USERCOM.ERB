;新しいものを先頭に。5件を超えた分は落ちる
@コマンド履歴に足す(名前)
#DIMS 名前
#DIM 番号

FOR 番号, 4, 0, -1
	コマンド履歴:番号 = %コマンド履歴:(番号 - 1)%
NEXT
コマンド履歴:0 = %名前%


;画面の一番下。「＜コマンド履歴：[注文をとる]－[移動]－[30分待つ]＞」。無ければ出さない
@コマンド履歴表示
#DIM 番号
#DIMS 出力

SIF コマンド履歴:0 == ""
	RETURN 0

;設定・ロードの行との間は1行あける（→画面イメージ）
PRINTL 
出力 '= "＜コマンド履歴："
FOR 番号, 0, 5
	SIF コマンド履歴:番号 == ""
		BREAK
	SIF 番号 > 0
		出力 += "－"
	出力 += "[" + コマンド履歴:番号 + "]"
NEXT
出力 += "＞"
PRINTSL 出力
