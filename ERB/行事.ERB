;行事（祝日・季節。→画面イメージ「行事」）
;台帳は CSV/台帳/行事.csv（SYSTEM.ERB @台帳を読む）。その晩の行事は 営業の行事（番号＋1。0＝無し）に開店で入れる（客.ERB @営業の日を組む）。
;日付は暦（→暦.ERB）の月日。範囲は同じ年の中だけ


;経過日数が 日数 の日の行事の番号。無ければ -1
@今日の行事(日数)
#FUNCTION
#DIM 日数
#DIM 品
#DIM 月日

月日 = 暦の月(日数) * 100 + 暦の日(日数)
FOR 品, 0, 行事数
	SIF 行事名:品 == ""
		CONTINUE
	SIF 月日 >= 行事の始め:品 && 月日 <= 行事の終わり:品
		RETURNF 品
NEXT
RETURNF -1


;開店で決める（その晩ずっと同じ。日をまたぐ営業でも一晩は同じ日付）
@営業の行事を決める

営業の行事 = 今日の行事(経過日数) + 1


;今夜の客足（％）。行事が無ければ 100
@行事の客足を引く
#FUNCTION

SIF 営業の行事 <= 0
	RETURNF 100
RETURNF 行事の客足:(営業の行事 - 1)


;「バレンタイン（客足 ×130％）」。日付から出す（開店前のサイドにも出すため、営業の行事ではなく暦を見る）。無ければ ""
@行事の行(日数)
#FUNCTIONS
#DIM 日数
#DIM 品

品 = 今日の行事(日数)
SIF 品 < 0
	RETURNF ""
RETURNF @"%行事名:品%（客足 ×{行事の客足:品}％）"


;今夜の気分がこれか（酔い／欲情／満足）
@行事の気分か(名)
#FUNCTION
#DIMS 名

SIF 営業の行事 <= 0
	RETURNF 0
RETURNF 行事の気分:(営業の行事 - 1) == 名


;酔いの上がり。酔いやすい行事の晩は 行事の酔いの倍率 ％
@行事の酔い(量)
#FUNCTION
#DIM 量

SIF 量 > 0 && 行事の気分か("酔い")
	RETURNF 量 * 行事の酔いの倍率 / 100
RETURNF 量


;満足の上がり。満足しやすい行事の晩は 行事の満足の倍率 ％
@行事の満足(幅)
#FUNCTION
#DIM 幅

SIF 幅 > 0 && 行事の気分か("満足")
	RETURNF 幅 * 行事の満足の倍率 / 100
RETURNF 幅


;客のティックごとの欲情の足し（欲情しやすい行事の晩だけ）
@行事の欲情
#FUNCTION

SIF 行事の気分か("欲情")
	RETURNF 行事の欲情の足し
RETURNF 0


;系統が今夜の行事の売れ筋か
@行事の売れ筋か(系統)
#FUNCTION
#DIMS 系統
#DIMS 欄, 16
#DIM 数
#DIM 品

SIF 営業の行事 <= 0 || 系統 == ""
	RETURNF 0
SPLIT 行事の売れ筋:(営業の行事 - 1), "・", 欄
数 = RESULT
FOR 品, 0, 数
	SIF 欄:品 == 系統
		RETURNF 1
NEXT
RETURNF 0


;季節の売れ筋（夏＝ビール・カクテル・ソフト／冬＝ウイスキー・ワイン・肉。春と秋は無し）
@季節の売れ筋か(系統)
#FUNCTION
#DIMS 系統
#DIM 季節

季節 = 暦の季節(経過日数)
IF 季節 == 1
	SIF 系統 == "ビール" || 系統 == "カクテル" || 系統 == "ソフト"
		RETURNF 1
ELSEIF 季節 == 3
	SIF 系統 == "ウイスキー" || 系統 == "ワイン" || 系統 == "肉"
		RETURNF 1
ENDIF
RETURNF 0


;客が選ぶ候補に重ねる分（行事の売れ筋＋季節の売れ筋）。好物の重みとは別に足す
@売れ筋の足し(系統)
#FUNCTION
#DIMS 系統
#DIM 足し

足し = 0
SIF 行事の売れ筋か(系統)
	足し += 行事の売れ筋の重み
SIF 季節の売れ筋か(系統)
	足し += 季節の売れ筋の重み
RETURNF 足し


;開店の知らせの続き。行事の晩なら一文と客足
@行事の知らせ

SIF 営業の行事 <= 0
	RETURN 0
SETCOLOR 0xffb0d0
PRINTFORM 　%行事の一文:(営業の行事 - 1)%（客足 ×{行事の客足:(営業の行事 - 1)}％）
RESETCOLOR
PRINTL


;来店した客がときどき一言。台帳の客の一言（／区切り）から一つ。誰が言っても同じ短文（口上ではない）
@行事の一言(番号)
#DIM 番号
#DIMS 欄, 16
#DIMS 文
#DIM 数

SIF 営業の行事 <= 0 || 行事の一言:(営業の行事 - 1) == ""
	RETURN 0
SIF RAND(100) >= 行事の一言の率
	RETURN 0
SPLIT 行事の一言:(営業の行事 - 1), "／", 欄
数 = RESULT
SIF 数 <= 0
	RETURN 0
文 '= 欄:(RAND:数)
CALL 入口まわりに見える(8, @"%CALLNAME:番号%「%文%」", @"玄関のほうで、%CALLNAME:番号%が何か言っている")
