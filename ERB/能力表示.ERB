#DIM 頁
#DIMS 出力
#DIM 件
#DIM 前
#DIM 先
#DIM 後

出力 '= @"　出産 {出産回数:番号:0}回　　子 {子供数:番号:0}人<br>"
前 = 出産回数:番号:0 - 出産記録数:番号:0
先 = 出産記録数:番号:0 - 1 - 頁 * 出産記録の一頁
後 = 先 - 出産記録の一頁 + 1
SIF 後 < 0
	後 = 0
FOR 件, 先, 後 - 1, -1
	出力 += @"　{前 + 件 + 1}回目　{出産記録_日:番号:件}日目 %時刻表示(出産記録_時刻:番号:件)%　%出産記録_場所:番号:件%<br>"
	出力 += @"　　父：%出産記録_父:番号:件%　　子：%出産記録_子:番号:件%%多胎の名(出産記録_人数:番号:件)%<br>"
	出力 += @"　　様子：%出産記録_様子:番号:件%<br>"
NEXT
;いちばん古い記録のページの終わりに、記録の無い分（記録を付ける前・枠から落ちた分）
SIF 前 > 0 && 頁 >= 出産記録の頁数(番号) - 1
	出力 += @"　（これより前の出産 {前}回は記録がありません）<br>"
RETURNF 出力
