;能力表示（別画面）。主役の段の［能力表示］（1025）で開く。
;サイドの「能力表示」タブは抜粋で、こちらが全部を出す画面（→画面イメージ「能力表示（別画面）」。2026-09-12 にユーザ指定）。
;サイドは出さず、本文の幅6000をいっぱいに使う（移動中と同じ作り。2026-09-14 に「広く要る画面はサイドを出さない」で再確認）。
;
;サイドに無いのは 体（Base 5本）・その場の値（PALAM 12本）・関係（好感度3軸と満足度）・技能の経験の数字。
;数字を出すかどうかは本来は開示の段階に従うが、買う仕組みがまだ無いのでいまは全部出す（→設計メモ「ステータス開示」）

@SHOW_USERCOM_能力
#DIM 番号

番号 = 能力表示の相手
;押した相手が店から居なくなっていたら主人公に落とす
SIF 番号 < 0 || 番号 >= キャラ枠 || !実キャラ:番号:0
	番号 = MASTER

;ページが無くなった（記録が消えた）ときに範囲外のままにしない
SIF 能力表示のページ >= 能力表示のページ数(番号)
	能力表示のページ = 0
CALL 能力表示を描く(番号)
IF 能力表示のページ == 0
	;スタッフと主人公は服装を変えられる（→画面イメージ「着替え」）
	IF 番号 == MASTER || スタッフ:番号:0
		PRINT [1047] 服装を変える
		PRINTS "　　"
	ENDIF
	;口上の あり／なし（→変数定義.ERH 口上なし）。全員に出す
	PRINTFORM [2940] 口上：%口上の状態(番号)%
	PRINTS "　　"
ENDIF
;ページが二つ以上あるときだけ（出産したことのある人。→画面イメージ「能力表示」）
IF 能力表示のページ数(番号) >= 2
	PRINTFORM [2941] ページ送り {能力表示のページ + 1}/{能力表示のページ数(番号)}（次：%能力表示のページ名(番号, 能力表示の次のページ(番号))%）
	PRINTS "　　"
ENDIF
PRINTL [1003] やめる


;ページの数。能力表示だけ、出産したことのある人は出産の記録がもう1枚
@能力表示のページ数(番号)
#FUNCTION
#DIM 番号

SIF 出産回数:番号:0 > 0 || 出産記録数:番号:0 > 0
	RETURNF 1 + 出産記録の頁数(番号)
RETURNF 1


;出産の記録のページ数（1ページ 出産記録の一頁 件。記録が無くても、出産回数があれば「記録がありません」の1ページ）
@出産記録の頁数(番号)
#FUNCTION
#DIM 番号
#DIM 頁

頁 = (出産記録数:番号:0 + 出産記録の一頁 - 1) / 出産記録の一頁
SIF 頁 < 1
	頁 = 1
RETURNF 頁


@能力表示の次のページ(番号)
#FUNCTION
#DIM 番号

RETURNF (能力表示のページ + 1) % 能力表示のページ数(番号)


@能力表示のページ名(番号, ページ)
#FUNCTIONS
#DIM 番号
#DIM ページ

SIF ページ <= 0
	RETURNF "能力表示"
SIF 出産記録の頁数(番号) >= 2
	RETURNF @"出産の記録 {ページ}/{出産記録の頁数(番号)}"
RETURNF "出産の記録"


;次のページへ（最後の次は最初）。[2941] と起床前の [3]
@能力表示のページを送る(番号)
#DIM 番号

能力表示のページ = 能力表示の次のページ(番号)


;口上を出すか（あり／なし）の表示
@口上の状態(番号)
#FUNCTIONS
#DIM 番号

SIF CFLAG:番号:口上なし
	RETURNF "なし"
RETURNF "あり"


;口上の あり／なし を反転する。能力表示の別画面 [2940]・起床前の［スタッフを見る］・設定 [5] の画面から。
;押した後の画面に状態が出るので、ここでは何も出さない
@口上を切り替える(番号)
#DIM 番号

CFLAG:番号:口上なし = !CFLAG:番号:口上なし


;本体。起床前メニューの「スタッフを見る」からも呼ぶので、番号の決め方と最後の行は呼ぶ側に置く（2026-09-14）
@能力表示を描く(番号)
#DIM 番号

DRAWLINE
HTML_PRINT 能力表示_名前行(番号)
PRINTL 
DRAWLINE

;2ページ目以降：出産の記録（名前行はそのまま。1ページ 出産記録の一頁 件）
IF 能力表示のページ >= 1 && 能力表示のページ数(番号) >= 2
	CALL 能力表示_節("出産の記録", 能力表示_出産の記録(番号, 能力表示のページ - 1))
	DRAWLINE
	RETURN 0
ENDIF

CALL 能力表示_節("情報", 能力表示_情報(番号))
;技能は開示の1段目、素質は3段目から（→画面イメージ「怪しい店」の見えるものの段。2026-09-14）
SIF 値が見えるか(番号, 1)
	CALL 能力表示_節("技能", 能力表示_技能(番号))
SIF 値が見えるか(番号, 3)
	CALL 能力表示_節("素質", 能力表示_素質(番号))
CALL 能力表示_節("服装", 能力_服装(番号))
CALL 能力表示_節("体", 能力表示_体(番号))
CALL 能力表示_節("その場の値（PALAM）", 能力表示_PALAM(番号))
CALL 能力表示_節("開発度", 能力_開発度(番号))
SIF 初めての相手_処女:番号:0 > 0 || 初めての相手_Ａ処女:番号:0 > 0 || 初めての相手_童貞:番号:0 > 0
	CALL 能力表示_節("初めての相手", 能力表示_初めての相手(番号))
;好感度・満足度ともバー＋段の名前は最初から見える（数字だけ開示。2026-09-23）ので主人公以外は常に出す
SIF 番号 != MASTER
	CALL 能力表示_節("関係", 能力表示_関係(番号))
SIF スタッフ:番号:0
	CALL 能力表示_節("裏の同意", 能力表示_同意(番号))
SIF 妊娠の確度(番号, MASTER) == 2
	CALL 能力表示_節("妊娠・出産", 能力表示_妊娠(番号))
SIF 膣の合計(番号) > 0 || 子宮の合計(番号) > 0
	CALL 能力表示_節("体内精液", 能力表示_体内精液(番号))

DRAWLINE


;節ひとつ。見出し → 中身 → 1行あける
@能力表示_節(名前, 中身)
#DIMS 名前
#DIMS 中身

HTML_PRINT 能力表示_見出し(名前)
PRINTL 
HTML_PRINT 中身
PRINTL 


;「□ 名前 □────」。サイドの節見出しと同じ形で、線は本文の組み幅（6000 ＝ 全角60文字）まで
@能力表示_見出し(名前)
#FUNCTIONS
#DIMS 名前
#DIMS 線

線 '= "─" * (60 - STRLENSU(名前))
RETURNF @"<font color='#C0C0C0'>□ %名前% □%線%</font>"


;■名前【客】　性別　（ほろ酔い）　　居場所　　残り滞在
@能力表示_名前行(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 残り

IF 番号 == MASTER
	出力 '= "<font color='#ffcc44'>■あなた</font>"
ELSE
	出力 '= "<font color='#ffcc44'>■" + CALLNAME:番号 + 立場のタグ(番号) + "</font>"
ENDIF
出力 += @"　%性別名(番号)%%処女のタグ(番号)%%酔いのタグ(番号)%%妊娠のタグ(番号)%%母乳のタグ(番号)%"
;周期のタグ。主人公は 安全日・生理中まで、他人は危険日・やや危険だけ（メイン画面の あなたの段／主役の段 と同じ。→主役.ERB）
IF 番号 == MASTER
	出力 += あなたの周期のタグ(番号)
ELSE
	出力 += 危険日のタグ(番号)
ENDIF
;キャラCSVのタグ（整理用の札）は名前の並びの後ろに
出力 += タグの表示(番号)
出力 += @"　　%GET_PLACE_NAME(CFLAG:番号:現在位置)%"
IF 番号 != MASTER && 退店予定:番号:0 >= 0
	残り = 退店予定:番号:0 - (経過日数 * 1440 + 現在時刻)
	SIF 残り < 0
		残り = 0
	出力 += @"　　残り滞在 あと{残り}分"
ENDIF
RETURNF 出力


;体型と、客なら来店の癖・今日使える額・注文
@能力表示_情報(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力

出力 '= @"　身長 {身長:番号:0 / 10}.{身長:番号:0 % 10}cm　　体重 {体重:番号:0 / 10}.{体重:番号:0 % 10}kg　　B/W/H {胸囲:番号:0 / 10}.{胸囲:番号:0 % 10}cm"
SIF 性別ビット(番号) & 6
	出力 += @"(%カップ(番号)%)"
出力 += @" / {胴囲:番号:0 / 10}.{胴囲:番号:0 % 10}cm / {腰囲:番号:0 / 10}.{腰囲:番号:0 % 10}cm<br>"
;体型・バスト・下半身の段（素質。→ERB/体格.ERB）
出力 += @"　%体格の行(番号)%<br>"
SIF 呼び方の行(番号) != ""
	出力 += @"　%呼び方の行(番号)%<br>"

IF 番号 != MASTER
	出力 += @"　来店の癖：%来店の癖(番号)%<br>"
	;客だけ。スタッフには出さない（→画面イメージ「会員の見える化」）
	SIF !スタッフ:番号:0
		出力 += @"　%会員状況の文(番号, 1)%<br>"
	IF CFLAG:番号:現在位置 > 0 && CFLAG:番号:現在位置 < 100
		出力 += @"　今日使える額 %金額(今日使える額:番号:0)%円"
		SIF 注文状態:番号:0 > 0
			出力 += @"　　注文：%料理名:(注文品目:番号:0)%（%注文の状態名(注文状態:番号:0)%）"
		出力 += "<br>"
	ENDIF
ELSE
	出力 += @"　所持金 %金額(MONEY:MASTER)%円<br>"
ENDIF
RETURNF 出力


;注文の状態（1待ち 2できあがり 3済）
@注文の状態名(状態)
#FUNCTIONS
#DIM 状態

SIF 状態 == 1
	RETURNF "待ち"
SIF 状態 == 2
	RETURNF "できあがり"
RETURNF "済"


;技能8つ。Lv とバーに加えて、次の Lv までの経験の数字も出す（サイドは数字なし）
@能力表示_技能(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 技能

出力 '= "　"
FOR 技能, 0, 技能数
	出力 += @"%ABLNAME:技能% Lv{ABL:番号:技能} %ゲージHTML(EXP:番号:技能 % 技能の一段, 技能の一段, 400, 50, "70A0D0", "203040")% {EXP:番号:技能 % 技能の一段}/{技能の一段}　　"
	SIF 技能 % 4 == 3
		出力 += "<br>　"
NEXT
RETURNF 出力


;素質は全部（サイドは性別と口上_ を外すが、ここは全能力表示なので外さない）
@能力表示_素質(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 素質
#DIM 数

出力 '= "　"
数 = 0
FOR 素質, 0, VARSIZE("TALENT")
	SIF !TALENT:番号:素質 || TALENTNAME:素質 == "" || 体格の素質か(素質)
		CONTINUE
	出力 += @"[%TALENTNAME:素質%]"
	数 += 1
NEXT
;体型の名札＝小柄・長身（身長から引く）と、体格の段の札（[巨乳][スレンダー][安産型]。普通は出さない）（→SYSTEM.ERB @体型の名札）
SIF 体型の名札(番号) != ""
	出力 += 体型の名札(番号)
	数 += 1
SIF 数 == 0
	出力 += "（なし）"
RETURNF 出力


;Base 5本。勃起（PALAM）は男性器のある性別だけ、精力も同じ
@能力表示_体(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力

出力 '= @"　体力 %ゲージHTML(BASE:番号:体力, MAXBASE:番号:体力, 500, 50, "40C060", "204028")% {BASE:番号:体力}/{MAXBASE:番号:体力}　　"
出力 += @"気力 %ゲージHTML(BASE:番号:気力, MAXBASE:番号:気力, 500, 50, "40C0C0", "204040")% {BASE:番号:気力}/{MAXBASE:番号:気力}　　"
出力 += @"酔い %酔いバー幅(番号, 500)% {BASE:番号:酔い}/{MAXBASE:番号:酔い}<br>"
出力 += @"　性欲 %ゲージHTML(BASE:番号:性欲, MAXBASE:番号:性欲, 500, 50, "D06080", "402028")% {BASE:番号:性欲}/{MAXBASE:番号:性欲}"
IF 性別ビット(番号) & 5
	出力 += @"　　精力 %ゲージHTML(BASE:番号:精力, MAXBASE:番号:精力, 500, 50, "60A0A0", "204040")% {BASE:番号:精力}/{MAXBASE:番号:精力}　　"
	出力 += @"勃起 %ゲージHTML(PALAM:番号:勃起, 勃起の上限, 500, 50, "A060D0", "302040")% {PALAM:番号:勃起}"
ENDIF
;母乳は母乳体質だけ（→設計メモ「母乳」）
SIF TALENT:番号:母乳体質
	出力 += @"<br>　母乳 %ゲージHTML(BASE:番号:母乳, MAXBASE:番号:母乳, 500, 50, "E0E0D0", "404038")% {BASE:番号:母乳}/{MAXBASE:番号:母乳}"
出力 += "<br>"
RETURNF 出力


;PALAM 12本。快感は性別に無い部位を出さない
@能力表示_PALAM(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力
#DIM 部位

出力 '= "　"
FOR 部位, 0, 6
	SIF !(部位のある性別:部位 & 性別ビット(番号))
		CONTINUE
	出力 += @"快%部位記号:部位% %PALAM値幅(番号, 部位, 300)%　　"
NEXT
出力 += "<br>　"
出力 += @"苦痛 %PALAM値幅(番号, 6, 300)%　　羞恥 %PALAM値幅(番号, 7, 300)%　　"
出力 += @"欲情 %PALAM値幅(番号, 8, 300)%　　"
;潤滑は膣のある性別だけ
SIF 性別ビット(番号) & 6
	出力 += @"潤滑 %PALAM値幅(番号, 9, 300)%　　"
出力 += @"理性 %ゲージHTML(PALAM:番号:理性, 理性の上限, 300, 50, "FFD060", "403018")% {PALAM:番号:理性}<br>"
RETURNF 出力


