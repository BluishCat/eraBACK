;妊娠・出産（→設計メモ「14. 妊娠・出産」。eraTOWN の PREGNANCY.ERB の機構を持ってきて、数値は仮）。
;入口は @膣内射精（個室.ERB の @射精を見る から。場面を問わない規則 → 画面イメージ「個室の中」の膣内射精）。
;日次は @妊娠の日替わり（客.ERB の @日替わり から全員ぶん）。
;
;段階：周期 → 受精（受精卵日数・着床所要日数・父親・胎児数）→ 5〜7日で着床（50％）→ 妊娠（妊娠日数）→ …
;父親はスロット8枚（父候補_相手／到達日／残量／膣）。膣内射精はまず膣に入り、時間で子宮（残量）へ移る（@精液の移行。洗えば膣の分は消える）。
;受精力＝残量×鮮度 が残る相手のうち到達日が最も古い者。
;数値を動かすだけで PRINT しない（描写は呼ぶ側 → 設計メモ「出力ゲート」）。例外は着床の稀な口上（主人公だけ）

;================================ 設定 ================================
;既定値。投入済でないセーブにだけ入れる（ユーザの変更は保持）。@EVENTFIRST と @EVENTLOAD から
@妊娠設定を入れる
SIF 設定_妊娠_投入済
	RETURN 0
設定_妊娠_投入済 = 1
設定_妊娠機能 = 1
設定_妊娠確率倍率 = 100
設定_妊娠期間倍率 = 100
設定_多胎率 = 3
設定_三つ子率 = 10
設定_確実妊娠 = 0
設定_産後回復日数 = 0
設定_流産率 = 100
設定_早産率 = 100
設定_早期破水率 = 40
設定_陣痛時間倍率 = 100


;妊娠機能を切ったとき。進行中の妊娠・着床待ち・子宮の精液を全員ぶん解除（産後の回復や出産の記録は残す）
@妊娠を全解除
#DIM 番号
#DIM 枠

FOR 番号, 0, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	SIF 妊娠日数:番号:0 > 0 || 受精卵日数:番号:0 > 0
		CALL 妊娠中断(番号)
	FOR 枠, 0, 父候補の数
		父候補_相手:番号:枠 = 0
		父候補_到達日:番号:枠 = 0
		父候補_残量:番号:枠 = 0
		父候補_膣:番号:枠 = 0
	NEXT
	精液移行タイマー:番号:0 = 0
NEXT


;================================ できるか ================================
;妊娠できる体か（性別と素質）。女・ふたなりは既定で妊娠する、男・性別なしはしない。素質 妊娠する／妊娠しない で上書き（両方なら性別どおり）
@妊娠する体か(番号)
#FUNCTION
#DIM 番号

IF TALENT:番号:妊娠する && !TALENT:番号:妊娠しない
	RETURNF 1
ELSEIF TALENT:番号:妊娠しない && !TALENT:番号:妊娠する
	RETURNF 0
ENDIF

RETURNF (性別ビット(番号) & 6) != 0


;いま受精できるか（体・妊娠中でない・着床待ちでない・避妊薬・産後回復）
@受精できるか(番号)
#FUNCTION
#DIM 番号

SIF !設定_妊娠機能
	RETURNF 0
SIF !妊娠する体か(番号)
	RETURNF 0
SIF 妊娠日数:番号:0 > 0
	RETURNF 0
SIF 受精卵日数:番号:0 > 0
	RETURNF 0
SIF 避妊薬残:番号:0 > 0
	RETURNF 0
SIF 産後回復:番号:0 > 0
	RETURNF 0
RETURNF 1


;================================ 周期 ================================
;登録時に周期をばらす（揃っていると不自然）
@周期を揃える(番号)
#DIM 番号

生理周期:番号:0 = RAND(周期の日数)


;施術「孕みやすさ」で動かす個体の受精率倍率（％）。未設定（0）は既定100％。可否（妊娠する体か）とは別（→設計メモ「ラインナップ」）
@受精しやすさ倍率(番号)
#FUNCTION
#DIM 番号

SIF 受精しやすさ倍率:番号:0 <= 0
	RETURNF 100
RETURNF 受精しやすさ倍率:番号:0


;周期の位置ごとの受精率（基礎％。着床率50％を織り込んで倍）
@周期の受精率(番号)
#FUNCTION
#DIM 番号

SELECTCASE 生理周期:番号:0
	CASE 12 TO 16
		RETURNF 120
	CASE 10, 11, 17, 18
		RETURNF 40
	CASE 7 TO 9, 19, 20
		RETURNF 12
ENDSELECT
RETURNF 4


;排卵期か
@排卵期か(番号)
#FUNCTION
#DIM 番号

RETURNF 生理周期:番号:0 >= 12 && 生理周期:番号:0 <= 16


;================================ 精液のスロット ================================
;膣内射精。母のスロットの父の枠に、まず膣の分として記す（同じ相手なら足す。空きが無ければ受精力が最も低い枠を潰す）。
;子宮へは時間で移る（@精液の移行）ので、ここでは受精判定をしない（→設計メモ「膣から子宮へ」）
@膣内射精(母, 父, 量)
#DIM 母
#DIM 父
#DIM 量
#DIM 枠
#DIM 選

SIF !(性別ビット(母) & 6)
	RETURN 0
;お迎え棒の場面で演者の中に出た。コマンドの後に場面を閉じて陣痛へ（→個室.ERB「舞台の場面」）
SIF 裏の商品:MASTER:0 == 商品_舞台 && 出産ショー中:母:0
	舞台で注がれた = 1
選 = -1
FOR 枠, 0, 父候補の数
	SIF 父候補_相手:母:枠 == 父 && 枠が使用中か(母, 枠)
		選 = 枠
NEXT
IF 選 < 0
	FOR 枠, 0, 父候補の数
		SIF !枠が使用中か(母, 枠)
			選 = 枠
	NEXT
ENDIF
IF 選 < 0
	選 = 0
	FOR 枠, 1, 父候補の数
		SIF 受精力(母, 枠) < 受精力(母, 選)
			選 = 枠
	NEXT
	父候補_残量:母:選 = 0
	父候補_膣:母:選 = 0
	父候補_到達日:母:選 = 0
ENDIF
父候補_相手:母:選 = 父
父候補_膣:母:選 += 量


;枠に何か残っているか（子宮か膣）
@枠が使用中か(母, 枠)
#FUNCTION
#DIM 母
#DIM 枠

RETURNF 父候補_残量:母:枠 > 0 || 父候補_膣:母:枠 > 0


;膣に留まっている分の合計
@膣の合計(母)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 計

計 = 0
FOR 枠, 0, 父候補の数
	計 += 父候補_膣:母:枠
NEXT
RETURNF 計


;子宮に残っている分の合計（量そのもの。鮮度を掛けた値は @受精力の合計）
@子宮の合計(母)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 計

計 = 0
FOR 枠, 0, 父候補の数
	計 += 父候補_残量:母:枠
NEXT
RETURNF 計


;量の名（eraTOWN の @精液量_名。一回の中出しが 100）
@精液量の名(量)
#FUNCTIONS
#DIM 量

SIF 量 >= 800
	RETURNF "大量"
SIF 量 >= 300
	RETURNF "中量"
RETURNF "少量"


;相手別の内訳「　健二の精液(少量)」を並べた文字列（eraTOWN の @精液内訳_文字列）。膣か＝1 なら膣の分、0 なら子宮の分
@精液の内訳(母, 膣か)
#FUNCTIONS
#DIM 母
#DIM 膣か
#DIM 枠
#DIM 量
#DIMS 出力

出力 '= ""
FOR 枠, 0, 父候補の数
	IF 膣か
		量 = 父候補_膣:母:枠
	ELSE
		量 = 父候補_残量:母:枠
	ENDIF
	SIF 量 <= 0
		CONTINUE
	出力 += @"　%CALLNAME:(父候補_相手:母:枠)%の精液(%精液量の名(量)%)"
NEXT
RETURNF 出力


;膣から子宮へ。枠ごとに膣の残りの 率％（最低1）を子宮へ移し、到達日を今日にして、届いた量ぶんの受精判定
@膣から子宮へ(母, 率)
#DIM 母
#DIM 率
#DIM 枠
#DIM 量

FOR 枠, 0, 父候補の数
	SIF 父候補_膣:母:枠 <= 0
		CONTINUE
	量 = 父候補_膣:母:枠 * 率 / 100
	SIF 量 < 1
		量 = 1
	SIF 量 > 父候補_膣:母:枠
		量 = 父候補_膣:母:枠
	父候補_膣:母:枠 -= 量
	父候補_残量:母:枠 += 量
	父候補_到達日:母:枠 = 経過日数
	CALL 受精を見る(母, 父候補_相手:母:枠, 0, 量)
NEXT


;時間が進んだぶん、膣に精液のある全員を進める（@時間を進める から）。移行の分 ごとに 移行の率％
@精液の移行(分)
#DIM 分
#DIM 母

FOR 母, 0, キャラ枠
	SIF !実キャラ:母:0
		CONTINUE
	IF 膣の合計(母) <= 0
		精液移行タイマー:母:0 = 0
		CONTINUE
	ENDIF
	精液移行タイマー:母:0 += 分
	WHILE 精液移行タイマー:母:0 >= 移行の分 && 膣の合計(母) > 0
		精液移行タイマー:母:0 -= 移行の分
		CALL 膣から子宮へ(母, 移行の率)
	WEND
NEXT


;膣内絶頂。膣の残りをまとめて子宮へ押し込む（@絶頂を見る から）
@膣内絶頂(母)
#DIM 母

SIF 膣の合計(母) <= 0
	RETURN 0
CALL 膣から子宮へ(母, 絶頂の押し込み)


;膣を洗う（入浴）。膣の分だけ消える。子宮に届いた分はそのまま。何か流したら RESULT に 1（RETURN で返す。末尾まで行くと 0 になる）
@膣を洗う(母)
#DIM 母
#DIM 枠
#DIM 流した

流した = 膣の合計(母) > 0
FOR 枠, 0, 父候補の数
	父候補_膣:母:枠 = 0
	IF 父候補_残量:母:枠 <= 0
		父候補_相手:母:枠 = 0
		父候補_到達日:母:枠 = 0
	ENDIF
NEXT
精液移行タイマー:母:0 = 0
RETURN 流した


;膣に残っている分が割（％）だけ外へ垂れる（秘貝開帳など、開いたとき）。子宮に届いた分は減らない。垂れた量を返す
@膣から垂れる(母, 割)
#DIM 母
#DIM 割
#DIM 枠
#DIM 量
#DIM 計

計 = 0
FOR 枠, 0, 父候補の数
	SIF 父候補_膣:母:枠 <= 0
		CONTINUE
	量 = 父候補_膣:母:枠 * 割 / 100
	父候補_膣:母:枠 -= 量
	計 += 量
	SIF 父候補_膣:母:枠 <= 0 && 父候補_残量:母:枠 <= 0
		父候補_相手:母:枠 = 0
NEXT
RETURN 計


;枠の受精力＝残量×鮮度。到達日から 当日100％ → 80 → 20 → 5 → 0
@受精力(母, 枠)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 日

SIF 父候補_残量:母:枠 <= 0
	RETURNF 0
日 = 経過日数 - 父候補_到達日:母:枠
SELECTCASE 日
	CASE IS <= 0
		RETURNF 父候補_残量:母:枠
	CASE 1
		RETURNF 父候補_残量:母:枠 * 80 / 100
	CASE 2
		RETURNF 父候補_残量:母:枠 * 20 / 100
	CASE 3
		RETURNF 父候補_残量:母:枠 * 5 / 100
ENDSELECT
RETURNF 0


;子宮に残っている精液の合計（受精力で）
@受精力の合計(母)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 計

計 = 0
FOR 枠, 0, 父候補の数
	計 += 受精力(母, 枠)
NEXT
RETURNF 計


;父親を選ぶ。受精力が残る相手のうち到達日が最も古い者。同日なら番号の若い方。居なければ -1
@父親を選ぶ(母)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 選

選 = -1
FOR 枠, 0, 父候補の数
	SIF 受精力(母, 枠) <= 0
		CONTINUE
	SIF 選 < 0 || 父候補_到達日:母:枠 < 父候補_到達日:母:選 || (父候補_到達日:母:枠 == 父候補_到達日:母:選 && 父候補_相手:母:枠 < 父候補_相手:母:選)
		選 = 枠
NEXT
SIF 選 < 0
	RETURNF -1
RETURNF 父候補_相手:母:選


;日替わりで残量が減る（毎日1/4に。尽きたら枠を空ける）
@精液が減る(母)
#DIM 母
#DIM 枠

FOR 枠, 0, 父候補の数
	SIF 父候補_残量:母:枠 <= 0
		CONTINUE
	父候補_残量:母:枠 /= 4
	IF 父候補_残量:母:枠 < 精液の下限
		父候補_残量:母:枠 = 0
		父候補_到達日:母:枠 = 0
		SIF 父候補_膣:母:枠 <= 0
			父候補_相手:母:枠 = 0
	ENDIF
NEXT


;================================ 受精・着床 ================================
;受精判定。残留＝1 なら排卵期の日次判定（受精力に応じた率、上限80％）、
;0 なら子宮に届いたとき（周期の率＋子宮に溜まっていれば +20。届いた量ぶんに按分＝率 × 量／精液の量。一回の中出しの合計で一回ぶん）
@受精を見る(母, 父, 残留, 量)
#DIM 母
#DIM 父
#DIM 残留
#DIM 量
#DIM 率

SIF !受精できるか(母)
	RETURN 0
IF 残留
	SIF !排卵期か(母)
		RETURN 0
	;子宮に何も残っていなければ受精しない（確実妊娠の設定でも）
	SIF 受精力の合計(母) <= 0
		RETURN 0
	率 = 受精力の合計(母) / 75
	SIF 率 > 80
		率 = 80
ELSE
	率 = 周期の受精率(母)
	SIF 受精力の合計(母) >= 精液の多い
		率 += 20
	SIF 量 > 0
		率 = 率 * 量 / 精液の量
ENDIF
率 = 率 * 設定_妊娠確率倍率 / 100
率 = 率 * 受精しやすさ倍率(母) / 100
SIF 設定_確実妊娠
	率 = 100
SIF 率 <= 0
	RETURN 0
SIF RAND(100) >= 率
	RETURN 0
;受精。ただちに妊娠にはならず着床待ち（本人も気づかない）。父親は先に届いた相手を優先
受精卵日数:母:0 = 1
着床所要日数:母:0 = 着床の日数 + RAND(3)
父不明:母:0 = 父候補の人数(母) >= 2
父親:母:0 = 父親を選ぶ(母)
SIF 父親:母:0 < 0
	父親:母:0 = 父
胎児数:母:0 = 胎児数を決める(母)


;受精のとき子宮に精液が残っている相手の数（受精力が残る枠）。二人以上なら誰の子か分からない（→@父の名）
@父候補の人数(母)
#FUNCTION
#DIM 母
#DIM 枠
#DIM 数

数 = 0
FOR 枠, 0, 父候補の数
	SIF 受精力(母, 枠) > 0
		数 += 1
NEXT
RETURNF 数


;胎児数。基礎 多胎率％、排卵誘発剤で +12、多胎歴（子供数＞出産回数）で +5、経産婦（出産2回以上）で +2。多胎のうち三つ子率％（誘発剤なら最低25）
@胎児数を決める(母)
#FUNCTION
#DIM 母
#DIM 率

率 = 設定_多胎率
SIF 排卵誘発剤残:母:0 > 0
	率 += 12
SIF 子供数:母:0 > 出産回数:母:0
	率 += 5
SIF 出産回数:母:0 >= 2
	率 += 2
SIF RAND(100) >= 率
	RETURNF 1
率 = 設定_三つ子率
SIF 排卵誘発剤残:母:0 > 0 && 率 < 25
	率 = 25
SIF RAND(100) < 率
	RETURNF 3
RETURNF 2


;着床（受精から5〜7日で一度だけ）。50％で妊娠の成立。失敗は静かに消える（描写なし。予定どおり生理が来るだけ）
@着床を見る(母)
#DIM 母
#DIM 率

;確率倍率が100を超える分は着床側にも（受精側は100で頭打ちなので）
率 = 着床率
SIF 設定_妊娠確率倍率 > 100
	率 = 着床率 * 設定_妊娠確率倍率 / 100
SIF 設定_確実妊娠
	率 = 100
IF RAND(100) < 率
	妊娠日数:母:0 = 1
	妊娠自覚:母:0 = 0
	;稀に着床をかすかに感じる（主人公だけ。自覚はまだ立てない）
	SIF 母 == MASTER && RAND(100) < 着床を感じる率
		CALL 妊娠の口上(母, "着床")
ELSE
	父親:母:0 = 0
	父不明:母:0 = 0
	胎児数:母:0 = 0
ENDIF
受精卵日数:母:0 = 0
着床所要日数:母:0 = 0


;================================ 日次 ================================
;一人ぶんの日替わり。@日替わり（客.ERB）から全員＋主人公に
@妊娠の日替わり(番号)
#DIM 番号

;母乳は性別によらず（素質で持たせた者も溜まる）
CALL 母乳の日替わり(番号)
SIF !(性別ビット(番号) & 6)
	RETURN 0
;客とスタッフは家で風呂に入ったことにする（膣の分が消える。主人公は自分で洗う → @体を洗う）
SIF 番号 != MASTER
	CALL 膣を洗う(番号)
CALL 精液が減る(番号)
SIF 避妊薬残:番号:0 > 0
	避妊薬残:番号:0 -= 1
SIF 排卵誘発剤残:番号:0 > 0
	排卵誘発剤残:番号:0 -= 1

SIF 育児日数:番号:0 > 0
	育児日数:番号:0 -= 1
SIF 妊娠日数:番号:0 <= 0
	CALL 体型の回復(番号)
IF 妊娠日数:番号:0 > 0
	;妊娠中は周期を進めない。分娩中は日数を進めない。日数を進めて腹の段階を見る。予定日の2日前に予兆、予定日で陣痛。
	;負荷（ストレス）による切迫流産・早産・臨月の誘発はその後で
	SIF 陣痛:番号:0 > 0
		RETURN 0
	妊娠日数:番号:0 += 1
	CALL 腹の段階を見る(番号)
	CALL 妊娠の体型(番号)
	SIF 番号 == MASTER && 妊娠日数:番号:0 == 予定日数(番号) - 2
		PRINTFORMW お腹が下がってきた気がする。……そろそろかもしれない
	IF 妊娠日数:番号:0 >= 予定日数(番号)
		CALL 陣痛開始(番号)
	ELSE
		CALL 妊娠のリスクを見る(番号)
	ENDIF
	;ここで陣痛が始まった NPC は分娩の場所へ移り、あなたの子なら知らせが立つ（→立ち会い.ERB）
	SIF 番号 != MASTER && 陣痛:番号:0 > 0
		CALL 産気づく_NPC(番号)
	RETURN 0
ENDIF
IF 産後回復:番号:0 > 0
	;回復期は周期を進めない。明けた日は生理直後（5日目）から
	産後回復:番号:0 -= 1
	SIF 産後回復:番号:0 == 0
		生理周期:番号:0 = 5
	RETURN 0
ENDIF
;着床待ちの間も周期は進める
生理周期:番号:0 = (生理周期:番号:0 + 1) % 周期の日数
IF 受精卵日数:番号:0 > 0
	受精卵日数:番号:0 += 1
	SIF 受精卵日数:番号:0 >= 着床所要日数:番号:0
		CALL 着床を見る(番号)
	RETURN 0
ENDIF
;排卵期は残留分からも受精しうる
CALL 受精を見る(番号, 父親を選ぶ(番号), 1, 0)


;================================ 妊娠の進み ================================
;予定日数。単胎40／双子37／三つ子35 × 設定の期間倍率（最低1日）
@予定日数(母)
#FUNCTION
#DIM 母
#DIM 日

日 = 40
SIF 胎児数:母:0 == 2
	日 = 37
SIF 胎児数:母:0 >= 3
	日 = 35
日 = 日 * 設定_妊娠期間倍率 / 100
SIF 日 < 1
	日 = 1
RETURNF 日


;分娩の文が出る相手か：主人公自身、あなたが傍に居る NPC（→立ち会い.ERB）、あなたが地下ホールか地下ステージに居るときの舞台の NPC（→客.ERB「出産ショー」）
@見られている分娩か(母)
#FUNCTION
#DIM 母

SIF 母 == MASTER
	RETURNF 1
SIF 舞台に立っているか(母)
	RETURNF 主人公が舞台を見ているか()
RETURNF 立ち会っているか(母)


;進行率（‰）。妊娠していなければ 0
@進行率(母)
#FUNCTION
#DIM 母

SIF 妊娠日数:母:0 <= 0
	RETURNF 0
RETURNF 妊娠日数:母:0 * 1000 / 予定日数(母)


;腹の段階は日数の比率から毎回出す（値としては持たない）。0 なし／1 まだ目立たない／2 ふっくら／3 大きい／4 臨月
@段階の日(母, 日)
#FUNCTION
#DIM 母
#DIM 日
#DIM 率

SIF 日 <= 0
	RETURNF 0
率 = 日 * 1000 / 予定日数(母)
SIF 率 >= 850
	RETURNF 4
SIF 率 >= 600
	RETURNF 3
SIF 率 >= 300
	RETURNF 2
SIF 率 >= 100
	RETURNF 1
RETURNF 0


@腹段階(母)
#FUNCTION
#DIM 母

RETURNF 段階の日(母, 妊娠日数:母:0)


@腹段階の名(段階)
#FUNCTIONS
#DIM 段階

SELECTCASE 段階
	CASE 1
		RETURNF "まだ目立たない"
	CASE 2
		RETURNF "ふっくら"
	CASE 3
		RETURNF "大きい"
	CASE 4
		RETURNF "臨月"
ENDSELECT
RETURNF ""


;段階が上がった日だけ処理。1 で気づき（自覚1。妊娠発覚の口上は主人公だけ）、2 以上で確信（自覚2）。
;あなたの子を妊娠した NPC は、気づいたら告げに来る（旗を立てるだけ。告げるのはあなたと居合わせたとき → 立ち会い.ERB @妊娠の報告を見る）
@腹の段階を見る(母)
#DIM 母
#DIM 前
#DIM 今

前 = 段階の日(母, 妊娠日数:母:0 - 1)
今 = 腹段階(母)
SIF 今 <= 前
	RETURN 0
IF 今 >= 1 && 妊娠自覚:母:0 == 0
	妊娠自覚:母:0 = 1
	IF 母 == MASTER
		;日替わり（05:00）の中で出る。行為などの結果表の直後に続かないよう一行あける
		PRINTL
		PRINTFORMW 生理が来ない。体が少し重い気がする……
		CALL 妊娠の口上(母, "妊娠発覚")
	ENDIF
	CALL 変化を記す(母, "妊娠の兆し")
	SIF 母 != MASTER && 父親:母:0 == MASTER
		妊娠の報告待ち:母:0 = 1
ENDIF
IF 今 >= 2 && 妊娠自覚:母:0 < 2
	妊娠自覚:母:0 = 2
	CALL 変化を記す(母, "妊娠がはっきりした")
	;兆しを告げる前に確信まで進めば確信だけ。突き放した相手はもう来ない
	SIF 母 != MASTER && 父親:母:0 == MASTER && 報告への返事:母:0 != 3
		妊娠の報告待ち:母:0 = 2
ENDIF


;================================ 露見 ================================
;腹が「ふっくら」以上の妊婦と同じ場所に居合わせた者が気づく（観測者ごとにビット）。ティックごとに（→設計メモ「露見」）。
;初めて気づいたときは、あなたがその場に居て起きていれば文と一言（→画面イメージ「妊娠の話」。眠っている人は気づかない。あなたが眠っている間はあなたは気づかず、NPC は黙って気づく）
@妊娠の露見
#DIM 母
#DIM 者
#DIM 位置
#DIM 起きている

起きている = !主人公が眠っている && 起床時点 >= 就寝時点
FOR 母, 0, キャラ枠
	SIF !実キャラ:母:0 || 妊娠日数:母:0 <= 0 || 腹段階(母) < 2
		CONTINUE
	位置 = CFLAG:母:現在位置
	SIF 位置 == 0
		CONTINUE
	FOR 者, 0, キャラ枠
		SIF 者 == 母 || !実キャラ:者:0 || CFLAG:者:現在位置 != 位置 || 気絶中:者:0
			CONTINUE
		SIF 者 == MASTER && !起きている
			CONTINUE
		SIF 露見ビット:母:(者 / 32) & (1 << (者 % 32))
			CONTINUE
		露見ビット:母:(者 / 32) |= 1 << (者 % 32)
		SIF 起きている && CFLAG:MASTER:現在位置 == 位置
			CALL 妊娠に気づいた文(者, 母)
	NEXT
NEXT


;初めて腹に目を留めたとき。あなたが気づいた側なら地の文だけ、NPC なら文と一言（局面「気づいた」）
@妊娠に気づいた文(者, 母)
#DIM 者
#DIM 母

IF 者 == MASTER
	IF 腹段階(母) >= 3
		PRINTFORML %CALLNAME:母%の腹が、はっきりと大きくなっているのに気づいた
	ELSE
		PRINTFORML %CALLNAME:母%の腹が、ふっくらしてきているのに気づいた
	ENDIF
	RETURN 0
ENDIF
IF 母 == MASTER
	PRINTFORML %CALLNAME:者%があなたの腹に目を留めた
ELSE
	PRINTFORML %CALLNAME:者%が%CALLNAME:母%の腹に目を留めた
ENDIF
CALL 妊娠の話(者, "気づいた", 母)


;腹の目立つ妊娠についての NPC の一言（→画面イメージ「妊娠の話」、口上/汎用/妊娠の話.ERB）。番号＝喋る NPC、相手＝妊婦。
;呼ぶ順は一言と同じ：口上_妊娠の話_{キャラ番号} → タイプ_性別 →（ふたなりは _女）→ タイプ。出れば止まる
@妊娠の話(番号, 局面, 相手)
#DIM 番号
#DIMS 局面
#DIM 相手
#DIMS タイプ
#DIMS 性別
#DIMS 方言

RESULTS '= ""
SIF CFLAG:番号:口上なし
	RETURN 0
TRYCCALLFORM 口上_妊娠の話_{番号}(番号, 局面, 相手)
CATCH
ENDCATCH
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
方言 '= 方言の接尾(番号)
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM 口上_妊娠の話_%タイプ%_%性別%%方言%(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == ""
	TRYCCALLFORM 口上_妊娠の話_%タイプ%_%性別%(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && 方言 != ""
	TRYCCALLFORM 口上_妊娠の話_%タイプ%_女%方言%(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 性別 == "ふたなり"
	TRYCCALLFORM 口上_妊娠の話_%タイプ%_女(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == "" && 方言 != ""
	TRYCCALLFORM 口上_妊娠の話_%タイプ%%方言%(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
IF RESULTS == ""
	TRYCCALLFORM 口上_妊娠の話_%タイプ%(番号, 局面, 相手)
	CATCH
	ENDCATCH
ENDIF
SIF RESULTS != ""
	PRINTFORMW 　%RESULTS%


;腹が目立って（ふっくら以上）、見た側が知っているか（露見ビット・告げられた）
@腹が見えているか(母, 者)
#FUNCTION
#DIM 母
#DIM 者

SIF 妊娠日数:母:0 <= 0 || 腹段階(母) < 2
	RETURNF 0
RETURNF 妊娠に気づいているか(母, 者)


;出産・中断で全員ぶん消す
@露見を消す(母)
#DIM 母
#DIM 甲

FOR 甲, 0, 16
	露見ビット:母:甲 = 0
NEXT


;観測者が母の妊娠に気づいているか。本人なら自覚
@妊娠に気づいているか(母, 者)
#FUNCTION
#DIM 母
#DIM 者

SIF 妊娠日数:母:0 <= 0
	RETURNF 0
SIF 母 == 者
	RETURNF 妊娠自覚:母:0 > 0
RETURNF (露見ビット:母:(者 / 32) & (1 << (者 % 32))) != 0


;観測者の確からしさ。0 知らない／1 疑っている／2 確信。
;兆し（妊娠自覚 1）は確定ではないので疑い。本人の自覚が確信（2）になるまで、告げられた側も疑いのまま（病院の健診か腹がふっくらで確信）
@妊娠の確度(母, 者)
#FUNCTION
#DIM 母
#DIM 者

SIF !妊娠に気づいているか(母, 者)
	RETURNF 0
SIF 妊娠自覚:母:0 < 2
	RETURNF 1
RETURNF 2


;================================ 陣痛・分娩 ================================
;主人公だけの地の文。スキップ中でも必ず止める（空なら何も出さず止めもしない）
@分娩の文(母, 文)
#DIM 母
#DIMS 文

SIF 母 != MASTER || 文 == ""
	RETURN 0
PRINTFORML %文%
FORCEWAIT


;娩出期の波ごとのいきみの地の文（主人公だけ。3本からランダム。病院なら介助の声が入る。口上の「波_娩出期」の前に出す）。
;最後の娩出（@出産 → @一児を産む）の前から、波に合わせてもう何度もいきんでいる、という流れにする
@いきむ(母)
#DIM 母

SELECTCASE RAND(3)
	CASE 0
		IF 介助か(母)
			CALL 分娩の文(母, "「いきんで！　そう、その調子です！」。医師の声に合わせて、息を詰めて腹に力を込めた")
		ELSE
			CALL 分娩の文(母, "波に合わせて息を詰め、腹に力を込めていきむ。頭が少しずつ下りてくるのが分かる")
		ENDIF
	CASE 1
		IF 介助か(母)
			CALL 分娩の文(母, "助産師に腰を支えられながら、波が来るたびに力いっぱいいきんだ")
		ELSE
			CALL 分娩の文(母, "歯を食いしばって、もう一度いきむ。股の間を押し広げられる感覚に、声が漏れた")
		ENDIF
	CASEELSE
		IF 介助か(母)
			CALL 分娩の文(母, "「頭が見えてきましたよ。息を吐いて、次の波でまたいきんで」。言われるまま、もう一度いきんだ")
		ELSE
			CALL 分娩の文(母, "いきんでは息をつき、また次の波に備える。終わりは、もうすぐそこだ")
		ENDIF
ENDSELECT


;娩出期の波のうち、前から今までの進みで跨いだ数（いきむ回数）。波の間隔は満了/48。
;満了に届いた回は、最後の波が娩出そのもの（@出産 の「いきみ」）なので1つ引く。1回の進みで出しすぎないよう4まで
@いきむ回数(前, 今, 満了)
#FUNCTION
#DIM 前
#DIM 今
#DIM 満了
#DIM 間隔
#DIM 回数

間隔 = 満了 / 48
SIF 間隔 < 1
	間隔 = 1
SIF 今 > 満了
	今 = 満了
回数 = 今 / 間隔 - 前 / 間隔
SIF 今 >= 満了
	回数 -= 1
SIF 回数 > 4
	回数 = 4
SIF 回数 < 0
	回数 = 0
RETURNF 回数


;分娩の到達値（陣痛開始から娩出までの分）。720分 × 設定の陣痛時間倍率
@分娩の満了
#FUNCTION
#DIM 倍

倍 = 設定_陣痛時間倍率
SIF 倍 <= 0
	倍 = 100
RETURNF 分娩の分 * 倍 / 100


;陣痛中の状態の文（ステータスの妊娠欄用）。陣痛中でなければ ""。
;段は @陣痛を進める の境界と同じ：1/6 本格化 → 1/2 活動期 → 3/4 移行期 → 5/6 娩出期。破水（済／前）・促進剤中・多胎の残りも添える
@陣痛の状態(母)
#FUNCTIONS
#DIM 母
#DIM 満了
#DIM 今
#DIMS 出力

SIF 陣痛:母:0 <= 0
	RETURNF ""
満了 = 分娩の満了()
今 = 陣痛:母:0
IF 今 >= 満了 * 5 / 6
	出力 '= "娩出期"
ELSEIF 今 >= 満了 * 3 / 4
	出力 '= "移行期"
ELSEIF 今 >= 満了 / 2
	出力 '= "活動期"
ELSEIF 今 >= 満了 / 6
	出力 '= "本格化"
ELSE
	出力 '= "始まったばかり"
ENDIF
出力 '= "陣痛中（" + 出力
IF 破水済:母:0
	出力 += "・破水済"
ELSE
	出力 += "・破水前"
ENDIF
SIF 促進剤中:母:0
	出力 += "・促進剤が効いている"
SIF 分娩残:母:0 >= 2
	出力 += @"・あと{分娩残:母:0}人"
出力 += "）"
RETURNF 出力


;陣痛開始。前期破水（設定_早期破水率）か陣痛先行かを決める
@陣痛開始(母)
#DIM 母

SIF 陣痛:母:0 > 0
	RETURN 0
陣痛:母:0 = 1
破水済:母:0 = 0
IF RAND(100) < 設定_早期破水率
	破水済:母:0 = 1
	CALL 分娩の文(母, "まだ痛みも来ていないのに、股の間から生温かいものがどっと溢れた……破水だ")
	SIF 母 == MASTER
		CALL 妊娠の口上(母, "破水")
	CALL 分娩の文(母, "それを追うように、下腹に規則的な痛みが始まった")
ELSE
	CALL 分娩の文(母, "下腹に規則的な痛み――陣痛が始まった")
	SIF 母 == MASTER
		CALL 妊娠の口上(母, "陣痛開始")
ENDIF


;時間が進んだぶん、陣痛中の全員を進める（@時間を進める から。1回30分まで）
@分娩の時間(分)
#DIM 分
#DIM 母

FOR 母, 0, キャラ枠
	SIF 実キャラ:母:0 && 陣痛:母:0 > 0
		CALL 陣痛を進める(母, 分)
NEXT


;陣痛の進行。満了の 1/6 本格化 → 1/2 活動期 → 3/4 移行期 → 5/6 娩出期 → 満了で娩出。破水後は1.3倍、陣痛促進剤が効いていればさらに1.3倍。
;境界の地の文・口上は主人公だけ。波の口上はフェーズごとに間隔（満了/8 → /12 → /24 → /48）。境界を出した回は波を出さない
@陣痛を進める(母, 分)
#DIM 母
#DIM 分
#DIM 前
#DIM 進む
#DIM 満了
#DIM 出した
#DIM 間隔
#DIM 波数
#DIM 番
#DIMS 波

SIF 陣痛:母:0 <= 0
	RETURN 0
IF 分娩残:母:0 > 0
	CALL 次の児を待つ(母, 分)
	RETURN 0
ENDIF
満了 = 分娩の満了()
前 = 陣痛:母:0
進む = 分
;30分の上限は、長い行動でフェーズの文を飛ばさないため。文が出るのは 主人公自身・傍で立ち会っているとき・舞台を見ているとき だけなので、
;誰も見ていない NPC は実時間で進める（2026-09-22 ユーザ指定。それまでは全員に掛かっていて、主人公が寝ると寮の NPC の陣痛が朝まで30分しか進まなかった）
SIF 進む > 分娩の一回 && 見られている分娩か(母)
	進む = 分娩の一回
SIF 破水済:母:0
	進む += 進む / 3
SIF 促進剤中:母:0
	進む += 進む / 3
陣痛:母:0 += 進む
出した = 0
IF 母 == MASTER
	;移行期以降は消耗が激しい
	IF 陣痛:母:0 >= 満了 * 3 / 4
		CALL 分娩で削る(母, 進む * 陣痛の消耗_後半 / 100)
	ELSE
		CALL 分娩で削る(母, 進む * 陣痛の消耗 / 100)
	ENDIF
	IF 前 < 満了 / 6 && 陣痛:母:0 >= 満了 / 6
		CALL 分娩の文(母, "陣痛の波が、一定の間隔で規則的に来るようになった")
		出した = 1
	ENDIF
	IF 前 < 満了 / 2 && 陣痛:母:0 >= 満了 / 2
		CALL 分娩の文(母, "陣痛の間隔が短くなり、痛みが強くなってきた")
		CALL 妊娠の口上(母, "活動期")
		出した = 1
	ENDIF
	IF 前 < 満了 * 3 / 4 && 陣痛:母:0 >= 満了 * 3 / 4
		CALL 分娩の文(母, "波がほとんど途切れない。腰が砕けそうな圧迫感の奥から、いきみたい衝動がこみ上げる")
		CALL 分娩の文(母, 分娩の体格の文(母, "移行期"))
		CALL 妊娠の口上(母, "移行期")
		出した = 1
	ENDIF
	IF 前 < 満了 * 5 / 6 && 陣痛:母:0 >= 満了 * 5 / 6
		CALL 分娩の文(母, "頭が産道を押し下げてくる。もう、いきむのを我慢できない")
		CALL 分娩の文(母, 分娩の体格の文(母, "娩出期"))
		CALL 妊娠の口上(母, "娩出期")
		出した = 1
	ENDIF
	;舞台の上なら境界ごとに客席の演出を一行（→行動.ERB「出産ショー（主人公）」）
	SIF 出した && 出産ショー中:母:0
		CALL 出産ショーの境界_主人公(前, 満了)
ELSEIF 出産ショー中:母:0
	;NPC が舞台で分娩中。境界の文は客.ERB「出産ショー」（主人公が地下ホールか地下ステージに居るときだけ見える）
	CALL 出産ショーの境界(母, 前, 満了)
	出した = RESULT
ELSEIF 立ち会っているか(母)
	;NPC が寝床（寮・自宅の部屋・病院）で分娩中で、あなたが傍に居る（→立ち会い.ERB）
	CALL 立ち会いの境界(母, 前, 満了)
	出した = RESULT
ENDIF
;陣痛先行なら満了の 19/24 で破水（適時破水。子宮口が全開に近い移行期の終わり。娩出期（5/6）の30分前＝破水の後すぐにいきむ流れ。2026-10-19 ユーザ指定。以前は 2/3 で、全開まで4時間も「破水済でいきまない」が続いた）
IF !破水済:母:0 && 陣痛:母:0 >= 満了 * 19 / 24
	破水済:母:0 = 1
	IF 母 == MASTER
		CALL 分娩の文(母, "一段と強い痛みとともに、股の間から生温かいものが溢れ出した……破水だ")
		CALL 妊娠の口上(母, "破水")
		SIF 出産ショー中:母:0
			CALL 分娩の文(母, "舞台を濡らした羊水に、客席から息を呑む音が聞こえた")
		出した = 1
	ELSEIF 出産ショー中:母:0
		CALL 出産ショーの文(母, @"%CALLNAME:母%の股から生温かいものが溢れ、舞台を濡らした――破水だ", "破水")
		出した = 1
	ELSEIF 立ち会っているか(母)
		CALL 立ち会いの文(母, @"%CALLNAME:母%の股から生温かいものが溢れ、%寝床の名(母)%を濡らした――破水だ", "破水")
		出した = 1
	ENDIF
ENDIF
;陣痛の波（本格化以降。潜伏期は間隔0なので見ない）。舞台の上の NPC・あなたが傍に居る NPC も同じ間隔で（文は客.ERB @出産ショーの波／立ち会い.ERB @立ち会いの波）
;娩出期は満了に届いた回も数える（届いた回は波を出さず産んでいたので、最後の進みが「いきまずに産む」になっていた。2026-10-19 ユーザ指摘）
IF (母 == MASTER || 出産ショー中:母:0 || 立ち会っているか(母)) && !出した
	間隔 = 0
	波 '= ""
	IF 陣痛:母:0 >= 満了 * 5 / 6
		間隔 = 満了 / 48
		波 '= "波_娩出期"
	ELSEIF 陣痛:母:0 >= 満了 * 3 / 4
		間隔 = 満了 / 24
		波 '= "波_移行期"
	ELSEIF 陣痛:母:0 >= 満了 / 2
		間隔 = 満了 / 12
		波 '= "波_活動期"
	ELSEIF 陣痛:母:0 >= 満了 / 6
		間隔 = 満了 / 8
		波 '= "波_本格化"
	ENDIF
	SIF 間隔 < 1 && 波 != ""
		間隔 = 1
	;波の数。娩出期は1回の進み（30分）で跨いだ波の数だけ（1回の進みで2波ぶん進んでも1回しか出ていなかった。2026-10-19 ユーザ指摘）。他の局面は従来どおり跨げば1回
	波数 = 0
	IF 間隔 > 0
		IF 波 == "波_娩出期"
			波数 = いきむ回数(前, 陣痛:母:0, 満了)
		ELSEIF 前 / 間隔 != 陣痛:母:0 / 間隔
			波数 = 1
		ENDIF
	ENDIF
	FOR 番, 0, 波数
		IF 母 == MASTER
			;娩出期の波ごとにいきむ（最後の一回だけにしない。2026-10-17 ユーザ指定）
			SIF 波 == "波_娩出期"
				CALL いきむ(母)
			CALL 妊娠の口上(母, 波)
		ELSEIF 出産ショー中:母:0
			CALL 出産ショーの波(母, 波)
		ELSE
			CALL 立ち会いの波(母, 波)
		ENDIF
	NEXT
ENDIF
SIF 陣痛:母:0 >= 満了
	CALL 出産(母)


;体力・気力を削る（0で止める）
@分娩で削る(母, 量)
#DIM 母
#DIM 量

BASE:母:体力 -= 量
SIF BASE:母:体力 < 0
	BASE:母:体力 = 0
BASE:母:気力 -= 量
SIF BASE:母:気力 < 0
	BASE:母:気力 = 0


;いま介助分娩か（病院に居るか）
@介助か(母)
#FUNCTION
#DIM 母

RETURNF CFLAG:母:現在位置 == 病院の場所


;出産。多胎は1児ずつ。児と児の間は小休止（プレイヤーは行動できる）。NPC は報告1行で一括
@出産(母)
#DIM 母
#DIM 介助

IF 母 != MASTER
	CALL 出産_NPC(母)
	RETURN 0
ENDIF
IF 分娩残:母:0 <= 0
	分娩残:母:0 = 胎児数:母:0
	SIF 分娩残:母:0 < 1
		分娩残:母:0 = 1
	分娩済:母:0 = 0
	産後回復:母:0 = 産後回復の日数(母)
ENDIF
CALL 妊娠の口上(母, "いきみ")
介助 = 介助か(母)
CALL 一児を産む(母, 介助)
;舞台の上なら客席の演出（→行動.ERB「出産ショー（主人公）」）
SIF 出産ショー中:母:0
	CALL 分娩の文(母, "産声が地下ホールに響き、客席がどっと沸いた")
分娩済:母:0 += 1
分娩残:母:0 -= 1
IF 分娩残:母:0 > 0
	CALL 次の児の小休止(母)
	RETURN 0
ENDIF
CALL 出産_完了(母)


;1児の娩出（地の文と消耗）
@一児を産む(母, 介助)
#DIM 母
#DIM 介助
#DIM 何人目

何人目 = 分娩済:母:0 + 1
IF 何人目 == 1
	IF 介助
		CALL 分娩の文(母, "医師と助産師の声に合わせていきむと、やがて元気な産声が分娩室に響いた")
		SIF 分娩残:母:0 <= 1
			CALL 分娩の文(母, "介助のおかげで、比較的落ち着いて産み終えた")
		CALL 分娩の文(母, 分娩の体格の文(母, "直後"))
	ELSE
		CALL 分娩の文(母, "いきみたくなる強烈な痛みが押し寄せる……もう、限界……！")
		CALL 分娩の文(母, "一際大きないきみとともに、新しい命を産み落とした")
		CALL 分娩の文(母, 分娩の体格の文(母, "直後"))
	ENDIF
	CALL 出産の消耗(母, 介助, 0)
ELSE
	IF 何人目 >= 3
		CALL 分娩の文(母, "息を継ぐ間もない。開ききった産道を次の子が下りてきて、休みきれない体が悲鳴を上げる")
	ELSE
		CALL 分娩の文(母, "一人目が通ったばかりの産道はまだ開いたままで、次の子はためらいなく下りてくる")
	ENDIF
	IF 介助
		CALL 分娩の文(母, "「息を吐いて――そこでもう一度」。医師の声に導かれ、残った力を振り絞った")
	ELSE
		CALL 分娩の文(母, "誰の手も借りられないまま、震える膝を立て直し、自分の呼吸だけを頼りにいきんだ")
	ENDIF
	CALL 分娩の文(母, @"ほどなくして、{何人目}人目の産声が上がった")
	CALL 出産の消耗(母, 介助, 1)
ENDIF


;次の児までの小休止。陣痛を満了の5〜10％手前に巻き戻し、猶予の終盤で次の児が破水する
@次の児の小休止(母)
#DIM 母
#DIM 満了
#DIM 幅
#DIM 何人目

満了 = 分娩の満了()
;破水（残り満了/16）から産むまでに波が続くよう、猶予は満了の8〜16％（2026-10-19 ユーザ指摘「破水しているのにまだいきまない」。5〜10％では破水の次の進みで産んでいた）
幅 = 満了 * 8 / 100
SIF 幅 < 8
	幅 = 8
陣痛:母:0 = 満了 - (幅 + RAND(幅))
SIF 陣痛:母:0 < 1
	陣痛:母:0 = 1
破水済:母:0 = 0
何人目 = 分娩済:母:0 + 1
IF 健診済:母:0
	CALL 分娩の文(母, "聞いていたとおりだった。緩みかけたお腹が、また少しずつ硬く張りつめてくる")
ELSEIF 何人目 == 2
	CALL 分娩の文(母, "――産み終えて安堵したのも束の間、引いたはずの陣痛がまたこみ上げてくる。……まだ、終わっていなかったのか")
	CALL 妊娠の口上(母, "多胎に気づく")
ELSE
	CALL 分娩の文(母, "終わったはずのお腹が、三度硬くなる。――まだ、終わっていなかった")
ENDIF
IF 分娩残:母:0 >= 2
	CALL 分娩の文(母, @"次の子が下りてくるまでには、まだ少し間がありそうだ。お腹にはあと{分娩残:母:0}人が残っている")
ELSE
	CALL 分娩の文(母, "次の子が下りてくるまでには、まだ少し間がありそうだ")
ENDIF


;小休止の進行。猶予を使い切ると次の児の娩出。小休止の間も体は削られる（娩出より軽い）
@次の児を待つ(母, 分)
#DIM 母
#DIM 分
#DIM 前
#DIM 進む
#DIM 満了
#DIM 出した
#DIM 間隔
#DIM 波数
#DIM 番

満了 = 分娩の満了()
進む = 分
SIF 進む > 分娩の一回
	進む = 分娩の一回
前 = 陣痛:母:0
陣痛:母:0 += 進む
SIF 陣痛:母:0 > 満了
	陣痛:母:0 = 満了
出した = 0
SIF 母 == MASTER
	CALL 分娩で削る(母, 進む * 陣痛の消耗 / 100)
間隔 = 満了 / 16
SIF 間隔 < 5
	間隔 = 5
IF !破水済:母:0 && 満了 - 陣痛:母:0 <= 間隔
	破水済:母:0 = 1
	IF 母 == MASTER
		CALL 分娩の文(母, "再び股の間から生温かいものが流れ出した。次の子を包む膜が破れたのだ。陣痛の波が一気に強まる")
		CALL 分娩の文(母, "……そろそろ、次の子が生まれる")
		出した = 1
	ENDIF
ENDIF
;いきむのは破水してから（破水の前は波が来ても息をついているだけ）。跨いだ波の数だけ、最後の波は娩出
IF 母 == MASTER && !出した && 破水済:母:0
	波数 = いきむ回数(前, 陣痛:母:0, 満了)
	FOR 番, 0, 波数
		CALL いきむ(母)
		CALL 妊娠の口上(母, "波_娩出期")
	NEXT
ENDIF
SIF 陣痛:母:0 >= 満了
	CALL 出産(母)


;全児娩出後。後産の締め、出産回数・子供数、育児、状態を消す
@出産_完了(母)
#DIM 母
#DIM 人数

人数 = 分娩済:母:0
SIF 人数 < 1
	人数 = 1
;記録は場所・舞台・介助の旗が生きているうちに（主人公は下で出産ショーの旗を下ろす）
CALL 出産を記す(母, 人数)
IF 母 == MASTER
	IF 人数 >= 2
		CALL 分娩の文(母, "やがて後産が下り、長かった分娩がようやく終わった")
		IF 健診済:母:0
			CALL 分娩の文(母, @"{人数}人の赤ん坊を、無事に産み終えた")
		ELSE
			CALL 分娩の文(母, @"結局、{人数}人もの赤ん坊を産んでいたのだ")
		ENDIF
	ENDIF
	;舞台の上なら後産の処理までがショー（→行動.ERB「出産ショー（主人公）」）
	IF 出産ショー中:母:0
		IF 人数 >= 2
			CALL 分娩の文(母, "落ちた胎盤を、係が手早く片付けた")
		ELSE
			CALL 分娩の文(母, "やがて後産が下り、胎盤が舞台に落ちた。係が手早く片付けた")
		ENDIF
	ENDIF
	CALL 妊娠の口上(母, "出産直後")
	SIF 出産ショー中:母:0
		CALL 主人公の出産ショーを終える(人数)
ENDIF
出産回数:母:0 += 1
子供数:母:0 += 人数
CALL 変化を記す(母, @"出産した（{人数}人）")
育児日数:母:0 = 育児の日数
CALL 出産で母乳が出る(母)
CALL 出産の体型(母)
CALL 妊娠を消す(母)


;================================ 出産の記録 ================================
;出産ごとに1件、母のほうに文字と数で残す（子は実体化しない。→設計メモ「妊娠・出産」、画面イメージ「能力表示」2ページ目）。
;@出産_完了 から（主人公・NPC の一括・立ち会い・出産ショーのどれもそこを通る）。人数＝産んだ児の数。
;場所と様子は産んだときの状態（妊娠を消す前・出産ショーの旗を下ろす前）から取る。満杯なら古い方を一つ落として詰める
@出産を記す(母, 人数)
#DIM 母
#DIM 人数
#DIM 件
#DIM 児
#DIMS 子の列
#DIMS 様子

IF 出産記録数:母:0 >= 出産記録の枠
	FOR 件, 1, 出産記録の枠
		出産記録_日:母:(件 - 1) = 出産記録_日:母:件
		出産記録_時刻:母:(件 - 1) = 出産記録_時刻:母:件
		出産記録_人数:母:(件 - 1) = 出産記録_人数:母:件
		出産記録_父:母:(件 - 1) '= 出産記録_父:母:件
		出産記録_子:母:(件 - 1) '= 出産記録_子:母:件
		出産記録_場所:母:(件 - 1) '= 出産記録_場所:母:件
		出産記録_様子:母:(件 - 1) '= 出産記録_様子:母:件
	NEXT
	出産記録数:母:0 = 出産記録の枠 - 1
ENDIF
件 = 出産記録数:母:0

子の列 '= ""
FOR 児, 0, 人数
	SIF 児 > 0
		子の列 += "・"
	子の列 += 子の性別を引く()
NEXT

;どう産んだか → 傍に居たか → 促進剤・早産
IF 出産ショー中:母:0
	様子 '= "出産ショー（舞台の上で、客の前で）"
ELSEIF 介助か(母)
	様子 '= "医師と助産師の介助"
ELSE
	様子 '= "介助なし"
ENDIF
IF 母 != MASTER
	IF 出産ショー中:母:0
		SIF 主人公が舞台を見ているか()
			様子 += "／あなたも見ていた"
	ELSEIF 立ち会っているか(母)
		様子 += "／あなたが立ち会った"
	ENDIF
ENDIF
SIF 促進剤中:母:0
	様子 += "／陣痛促進剤を使った"
SIF 進行率(母) > 0 && 進行率(母) < 早産の線
	様子 += "／早産"

出産記録_日:母:件 = 経過日数 + 1
出産記録_時刻:母:件 = 現在時刻
出産記録_人数:母:件 = 人数
出産記録_父:母:件 '= 父の名(母)
出産記録_子:母:件 '= 子の列
出産記録_場所:母:件 '= 出産の場所名(CFLAG:母:現在位置)
出産記録_様子:母:件 '= 様子
出産記録数:母:0 = 件 + 1


;子の性別を一人ぶん引く。ふたなりを 子の性別_ふたなり率 ％、残りを男女半々。性別なしは引かない
@子の性別を引く
#FUNCTIONS

SIF RAND(100) < 子の性別_ふたなり率
	RETURNF "ふたなり"
SIF RAND(2) == 0
	RETURNF "男"
RETURNF "女"


;記録と妊娠の節に出す父の名。分からなければ「わからない」。あなたなら「あなた」（内部の父親は変えない。口上の「あなたの子」はそちらを見る）
@父の名(母)
#FUNCTIONS
#DIM 母

SIF 父不明:母:0
	RETURNF "わからない"
SIF 父親:母:0 == MASTER && 母 != MASTER
	RETURNF "あなた"
RETURNF CALLNAME:(父親:母:0)


;産んだ場所の名。自宅の中は「自宅の私室」の形に（名前だけだと「私室」「リビング」でどこの家か分からない）
@出産の場所名(位置)
#FUNCTIONS
#DIM 位置

SIF GET_PLACE_NAME(位置) == ""
	RETURNF "どこか"
SIF 位置 / 100 == 5
	RETURNF @"自宅の%GET_PLACE_NAME(位置)%"
RETURNF GET_PLACE_NAME(位置)


;多胎の呼び名（単胎は空）
@多胎の名(人数)
#FUNCTIONS
#DIM 人数

SIF 人数 <= 1
	RETURNF ""
SIF 人数 == 2
	RETURNF "（双子）"
SIF 人数 == 3
	RETURNF "（三つ子）"
RETURNF @"（{人数}人）"


;================================ 母乳 ================================
;母乳体質の者だけ Base 母乳 が動く（→設計メモ「母乳」。噴乳・搾乳・授乳は個室.ERB）
;出産で母乳が出るようになる。もう母乳体質なら何もしない（元から持っていた者は授乳期間で外さない）。量は半分から
@出産で母乳が出る(母)
#DIM 母

SIF MAXBASE:母:母乳 <= 0
	MAXBASE:母:母乳 = 母乳の上限
IF !TALENT:母:母乳体質
	TALENT:母:母乳体質 = 1
	母乳_出産由来:母:0 = 1
	SIF 母 == MASTER
		PRINTFORMW 胸が張って、母乳が出るようになった
ENDIF
BASE:母:母乳 = MAXBASE:母:母乳 / 2


;日替わり。母乳体質なら溜まる。出産で付いた母乳体質は授乳期間（育児日数）が尽きたら外れる（2026-09-15 ユーザ指定）
@母乳の日替わり(番号)
#DIM 番号

SIF !TALENT:番号:母乳体質
	RETURN 0
IF 母乳_出産由来:番号:0 && 育児日数:番号:0 <= 0
	TALENT:番号:母乳体質 = 0
	母乳_出産由来:番号:0 = 0
	BASE:番号:母乳 = 0
	SIF 番号 == MASTER
		PRINTFORMW 授乳の時期が過ぎて、母乳が出なくなった
	RETURN 0
ENDIF
SIF MAXBASE:番号:母乳 <= 0
	MAXBASE:番号:母乳 = 母乳の上限
BASE:番号:母乳 += 母乳の日次
SIF BASE:番号:母乳 > MAXBASE:番号:母乳
	BASE:番号:母乳 = MAXBASE:番号:母乳


;張っているか（状態タグと噴乳の条件）
@母乳が張っているか(番号)
#FUNCTION
#DIM 番号

RETURNF TALENT:番号:母乳体質 && BASE:番号:母乳 >= 張りの線


;古いセーブに上限を入れる（→SYSTEM.ERB @EVENTLOAD）
@母乳の上限を入れる
#DIM 番号

FOR 番号, 0, CHARANUM
	SIF MAXBASE:番号:母乳 <= 0
		MAXBASE:番号:母乳 = 母乳の上限
NEXT


;NPC の出産。分割せず一括。報告1行と状態の更新だけ（→設計メモ「NPCは無音で進行する」）
@出産_NPC(母)
#DIM 母
#DIM 人数
#DIM あなたの子

;舞台で分娩中なら演出付き（→客.ERB「出産ショー」）
IF 出産ショー中:母:0
	CALL 出産ショーの出産(母)
	RETURN 0
ENDIF
;あなたが傍に居れば見届ける（→立ち会い.ERB）
IF 立ち会っているか(母)
	CALL 立ち会いの出産(母)
	RETURN 0
ENDIF
人数 = 胎児数:母:0
SIF 人数 < 1
	人数 = 1
あなたの子 = 父親:母:0 == MASTER
産後回復:母:0 = 産後回復の日数(母)
IF 人数 >= 2
	PRINTFORM %CALLNAME:母%は%出産の語(母)%{人数}人の子を産み、母親になった
ELSE
	PRINTFORM %CALLNAME:母%は%出産の語(母)%出産し、母親になった
ENDIF
IF あなたの子
	PRINTL 。あなたの子だ
	CALL 出来事を記す(@"%CALLNAME:母%があなたの子を産んだ（{人数}人）")
ELSE
	PRINTL 
ENDIF
WAIT
分娩済:母:0 = 人数
CALL 出産_完了(母)
;病院で産んだ客は家へ帰る（陣痛で移していた → 立ち会い.ERB @産気づく_NPC）
CALL 分娩の場所から帰す(母)


;1児あたりの消耗。一人目は 1/2・1/2、二人目以降は 1/6・1/5（産道が開いている分だけ体力は軽いが気力は残る）。介助は半分
@出産の消耗(母, 介助, 二人目以降)
#DIM 母
#DIM 介助
#DIM 二人目以降
#DIM 体
#DIM 気

IF 二人目以降
	体 = 6
	気 = 5
ELSE
	体 = 2
	気 = 2
ENDIF
IF 介助
	体 *= 2
	気 *= 2
ENDIF
BASE:母:体力 -= MAXBASE:母:体力 / 体
SIF BASE:母:体力 < 0
	BASE:母:体力 = 0
BASE:母:気力 -= MAXBASE:母:気力 / 気
SIF BASE:母:気力 < 0
	BASE:母:気力 = 0


;産後の回復日数。設定が正ならそれ、0 なら妊娠期間の 1/8（切り上げ）
@産後回復の日数(母)
#FUNCTION
#DIM 母

SIF 設定_産後回復日数 > 0
	RETURNF 設定_産後回復日数
RETURNF (予定日数(母) + 7) / 8


;妊娠の状態を消す。出産と中断（流産・アフターピル）で同じ処理に寄せる（→設計メモ「出産・中断で状態のリセットは同じ処理に寄せる」）。
;産後回復・出産回数・子供数・育児は呼ぶ側が先に入れる
@妊娠を消す(母)
#DIM 母

妊娠日数:母:0 = 0
陣痛:母:0 = 0
破水済:母:0 = 0
健診済:母:0 = 0
父親:母:0 = 0
父不明:母:0 = 0
胎児数:母:0 = 0
分娩残:母:0 = 0
分娩済:母:0 = 0
促進剤中:母:0 = 0
妊娠自覚:母:0 = 0
切迫流産度:母:0 = 0
最終母体負荷日:母:0 = 0
受精卵日数:母:0 = 0
着床所要日数:母:0 = 0
;告げに来る旗・立ち会いの旗も（→立ち会い.ERB）
妊娠の報告待ち:母:0 = 0
妊娠の報告済:母:0 = 0
報告への返事:母:0 = 0
立ち会いの知らせ:母:0 = 0
立ち会った:母:0 = 0
CALL 露見を消す(母)


;中断（流産・アフターピル）。回復期間は進行に応じて1〜6日、恒久変化なし
@妊娠中断(母)
#DIM 母

産後回復:母:0 = 1 + 進行率(母) * 5 / 1000
CALL 中断の体型(母)
CALL 妊娠を消す(母)


;================================ ストレスと切迫流産 ================================
;ストレスは体力・気力の裏返し（→設計メモ「体力と気力」）。どちらかが上限の ストレスの線％ を割っていれば溜まり、戻れば減る。日替わりで
@ストレスの日替わり(番号)
#DIM 番号
#DIM 前

前 = ストレス:番号:0
IF BASE:番号:体力 * 100 < MAXBASE:番号:体力 * ストレスの線 || BASE:番号:気力 * 100 < MAXBASE:番号:気力 * ストレスの線
	ストレス:番号:0 += ストレスの溜まり
	SIF ストレス:番号:0 > ストレスの上限
		ストレス:番号:0 = ストレスの上限
ELSE
	ストレス:番号:0 -= ストレスの減り
	SIF ストレス:番号:0 < 0
		ストレス:番号:0 = 0
ENDIF
;動いた分はリザルトのスタッフの行に（→一日.ERB @今日の結果を出す）
今日のストレス変動:番号:0 += ストレス:番号:0 - 前


;高ストレスか（上限の7割超）
@高ストレスか(番号)
#FUNCTION
#DIM 番号

RETURNF ストレス:番号:0 * 10 > ストレスの上限 * 7


;今日の母体負荷の強さ。入力は本人の状態（ストレス）だけ。店の側からは取らない（→設計メモ「切迫流産と流産」）
@負荷の強さ(母)
#FUNCTION
#DIM 母

RETURNF ストレス:母:0 * 負荷の最大 / ストレスの上限


;妊娠中の日次リスク。初期（進行率35％未満）は負荷で切迫流産度が上がる（着床直後ほど脆い）、
;35〜60％は安定期、60％〜臨月前は低確率の早産、臨月は負荷で陣痛が誘発される
@妊娠のリスクを見る(母)
#DIM 母
#DIM 強さ
#DIM 率
#DIM 前
#DIM 上がり

SIF 妊娠日数:母:0 <= 0 || 陣痛:母:0 > 0
	RETURN 0
率 = 進行率(母) / 10
強さ = 負荷の強さ(母)
IF 率 < 35
	IF 強さ > 0
		上がり = 強さ * (35 - 率) / 70
		SIF 胎児数:母:0 >= 2
			上がり += 4
		SIF 高ストレスか(母)
			上がり += 4
		上がり = 上がり * 設定_流産率 / 100
		前 = 切迫流産度:母:0
		切迫流産度:母:0 += 上がり
		最終母体負荷日:母:0 = 経過日数
		;閾値を跨いだ段だけ警告（主人公だけ）
		IF 母 == MASTER
			IF 前 < 30 && 切迫流産度:母:0 >= 30
				PRINTFORMW 下着に、わずかに血が付いていた……
			ELSEIF 前 < 60 && 切迫流産度:母:0 >= 60
				PRINTFORMW 下腹が鈍く痛む。無理をしてはいけない気がする
			ELSEIF 前 < 90 && 切迫流産度:母:0 >= 90
				PRINTFORMW 出血が止まらない。腹の痛みも強い……このままでは
			ENDIF
		ENDIF
		;多胎かつ高ストレスなら、ごく稀に直接流産
		SIF 胎児数:母:0 >= 2 && 高ストレスか(母) && RAND(100) < 直接流産の率 * 設定_流産率 / 100
			切迫流産度:母:0 = 100
		SIF 切迫流産度:母:0 >= 100
			CALL 流産(母)
	ELSEIF 最終母体負荷日:母:0 != 経過日数 - 1
		;前日に負荷が無ければ安静で治まる
		切迫流産度:母:0 -= 切迫流産の治まり
		SIF 切迫流産度:母:0 < 0
			切迫流産度:母:0 = 0
	ENDIF
	RETURN 0
ENDIF
SIF 率 < 60
	RETURN 0
CALL 陣痛の誘発を見る(母, 強さ)


;負荷で陣痛が誘発される。臨月（予定日の5日前以降）は予定日が近いほど、早産帯（60％〜）は臨月に近いほど（設定_早産率）
@陣痛の誘発を見る(母, 強さ)
#DIM 母
#DIM 強さ
#DIM 予定
#DIM 率

予定 = 予定日数(母)
IF 妊娠日数:母:0 >= 予定 - 5
	率 = 強さ + (妊娠日数:母:0 - (予定 - 5)) * 3
	SIF 胎児数:母:0 >= 2
		率 += 10
	IF RAND(100) < 率
		SIF 母 == MASTER
			PRINTFORMW 下腹に、これまでとは違う強い張りと差し込むような痛みが走った……！
		CALL 陣痛開始(母)
	ENDIF
ELSE
	SIF 設定_早産率 <= 0
		RETURN 0
	率 = 強さ * (進行率(母) / 10 - 60) / 40
	SIF 胎児数:母:0 >= 2
		率 += 5
	率 = 率 * 設定_早産率 / 100
	IF RAND(100) < 率
		SIF 母 == MASTER
			PRINTFORMW お腹が石のように張り、周期的な痛みが始まった……予定日にはまだ早いのに
		CALL 陣痛開始(母)
	ENDIF
ENDIF


;流産。体力・気力が1/3減り、ストレスが半分増える。回復期間は中断と同じ
@流産(母)
#DIM 母

IF 母 == MASTER
	PRINTFORMW 激しい腹痛のあと、大量の出血とともに、お腹の子は流れてしまった……
	CALL 妊娠の口上(母, "流産")
ENDIF
BASE:母:体力 -= BASE:母:体力 / 3
BASE:母:気力 -= BASE:母:気力 / 3
ストレス:母:0 += ストレス:母:0 / 2
SIF ストレス:母:0 > ストレスの上限
	ストレス:母:0 = ストレスの上限
流産回数:母:0 += 1
CALL 変化を記す(母, "流産した")
CALL 妊娠中断(母)


;================================ 体型の変化 ================================
;（→設計メモ「体型の変化」。内部は 0.1cm。妊娠中は毎日・冪等に〈妊娠前＋増分〉で上書き、産後・中断は回復目標へ日次で収束）
;回復目標_胸囲／胴囲／腰囲 は、妊娠中は「妊娠前サイズ」（遅延キャプチャ。0＝未保存）、産後は「回復目標」（恒久変化込み）に書き換わる

;進行率（‰）→ 一時増分（0.1cm）。区分線形補間。850‰ で頭打ち
@妊娠の増分(率, 胸か)
#FUNCTION
#DIM 率
#DIM 胸か
#DIM 甲
#DIM 乙
#DIM 丙
#DIM 丁

SIF 率 > 850
	率 = 850
SIF 率 <= 0
	RETURNF 0
;折れ点：100‰ 300‰ 600‰ 850‰ → 胸 +1.0 +2.0 +3.5 +5.0cm、胴 +3.0 +10.0 +18.0 +25.0cm
IF 率 <= 100
	甲 = 0
	乙 = 100
	IF 胸か
		丙 = 0
		丁 = 10
	ELSE
		丙 = 0
		丁 = 30
	ENDIF
ELSEIF 率 <= 300
	甲 = 100
	乙 = 300
	IF 胸か
		丙 = 10
		丁 = 20
	ELSE
		丙 = 30
		丁 = 100
	ENDIF
ELSEIF 率 <= 600
	甲 = 300
	乙 = 600
	IF 胸か
		丙 = 20
		丁 = 35
	ELSE
		丙 = 100
		丁 = 180
	ENDIF
ELSE
	甲 = 600
	乙 = 850
	IF 胸か
		丙 = 35
		丁 = 50
	ELSE
		丙 = 180
		丁 = 250
	ENDIF
ENDIF
RETURNF 丙 + (丁 - 丙) * (率 - 甲) / (乙 - 甲)


;妊娠中の3サイズ（毎日。冪等）。初回にまだ膨らんでいない値を妊娠前として保存する。腰囲は据え置き。体重も連動（胴囲の増分 1cm ≒ 0.3kg。仮）
@妊娠の体型(母)
#DIM 母
#DIM 率
#DIM 胸
#DIM 胴

IF 回復目標_胴囲:母:0 == 0
	回復目標_胸囲:母:0 = 胸囲:母:0
	回復目標_胴囲:母:0 = 胴囲:母:0
	回復目標_腰囲:母:0 = 腰囲:母:0
ENDIF
率 = 進行率(母)
胸 = 妊娠の増分(率, 1)
胴 = 妊娠の増分(率, 0)
;回復途中に再妊娠したときは、今より縮んで見えないように
SIF 回復目標_胸囲:母:0 + 胸 < 胸囲:母:0 && 胸囲:母:0 - 回復目標_胸囲:母:0 <= 50
	胸 = 胸囲:母:0 - 回復目標_胸囲:母:0
SIF 回復目標_胴囲:母:0 + 胴 < 胴囲:母:0 && 胴囲:母:0 - 回復目標_胴囲:母:0 <= 250
	胴 = 胴囲:母:0 - 回復目標_胴囲:母:0
体重:母:0 += (回復目標_胴囲:母:0 + 胴 - 胴囲:母:0) * 3 / 10
胸囲:母:0 = 回復目標_胸囲:母:0 + 胸
胴囲:母:0 = 回復目標_胴囲:母:0 + 胴
;胸が育てばバストの段も動く（体型は妊娠前の胴囲で見るので動かない。→ERB/体格.ERB）
CALL 体格の段を引き直す(母, 体格_バスト)


;出産直後。胴囲は妊娠前＋8.0cm まで即時にへこみ、回復目標を恒久変化込みに書き換える（胸 +2.0cm 上限150、腰 +1.5cm 上限140）
@出産の体型(母)
#DIM 母

SIF 回復目標_胴囲:母:0 == 0
	RETURN 0
IF 胴囲:母:0 > 回復目標_胴囲:母:0 + 80
	体重:母:0 -= (胴囲:母:0 - (回復目標_胴囲:母:0 + 80)) * 3 / 10
	胴囲:母:0 = 回復目標_胴囲:母:0 + 80
ENDIF
回復目標_胸囲:母:0 += 20
SIF 回復目標_胸囲:母:0 > 1500
	回復目標_胸囲:母:0 = 1500
回復目標_腰囲:母:0 += 15
SIF 回復目標_腰囲:母:0 > 1400
	回復目標_腰囲:母:0 = 1400


;中断（流産・アフターピル）。胴囲は同じくへこみ、回復目標は妊娠前のまま
@中断の体型(母)
#DIM 母

SIF 回復目標_胴囲:母:0 == 0
	RETURN 0
IF 胴囲:母:0 > 回復目標_胴囲:母:0 + 80
	体重:母:0 -= (胴囲:母:0 - (回復目標_胴囲:母:0 + 80)) * 3 / 10
	胴囲:母:0 = 回復目標_胴囲:母:0 + 80
ENDIF


;日次の回復（回復目標があって妊娠していない者だけ）。胴囲・腰囲は残り日数＋1で線形収束、胸囲は育児中は張りを維持し、終われば 1/4 ずつ。
;3つとも届いたら保存を捨てる＝回復完了
@体型の回復(母)
#DIM 母
#DIM 残り
#DIM 差

SIF 回復目標_胴囲:母:0 == 0 || 妊娠日数:母:0 > 0
	RETURN 0
残り = 育児日数:母:0
SIF 残り < 産後回復:母:0
	残り = 産後回復:母:0
差 = 回復目標_胴囲:母:0 - 胴囲:母:0
体重:母:0 += (差 / (残り + 1)) * 3 / 10
胴囲:母:0 += 差 / (残り + 1)
SIF ABS(回復目標_胴囲:母:0 - 胴囲:母:0) <= 5
	胴囲:母:0 = 回復目標_胴囲:母:0
差 = 回復目標_腰囲:母:0 - 腰囲:母:0
腰囲:母:0 += 差 / (残り + 1)
SIF ABS(回復目標_腰囲:母:0 - 腰囲:母:0) <= 5
	腰囲:母:0 = 回復目標_腰囲:母:0
IF 育児日数:母:0 <= 0
	差 = 回復目標_胸囲:母:0 - 胸囲:母:0
	胸囲:母:0 += 差 / 4
	SIF ABS(回復目標_胸囲:母:0 - 胸囲:母:0) <= 5
		胸囲:母:0 = 回復目標_胸囲:母:0
ENDIF
;胸と腰が戻るにつれて、バストと下半身の段も引き直す（出産で腰が張れば安産型に寄る。→ERB/体格.ERB）
CALL 体格の段を引き直す(母, 体格_バスト + 体格_下半身)
IF 胸囲:母:0 == 回復目標_胸囲:母:0 && 胴囲:母:0 == 回復目標_胴囲:母:0 && 腰囲:母:0 == 回復目標_腰囲:母:0
	回復目標_胸囲:母:0 = 0
	回復目標_胴囲:母:0 = 0
	回復目標_腰囲:母:0 = 0
	SIF 母 == MASTER
		PRINTFORMW 体が元に戻った
ENDIF


;================================ 口上の窓口 ================================
;妊娠の局面の口上（→設計メモ「口上のフック構造」）。局面は文字列（着床／妊娠発覚／陣痛開始／破水／…）。
;キャラ別 口上_妊娠_{番号}(番号, 局面) → タイプ別 口上_妊娠_%タイプ%(番号, 局面) → 無ければ出さない。RESULTS に台詞。
;地の文（主人公だけ）は呼ぶ側が出す。空なら止めもしない
@妊娠の口上(番号, 局面)
#DIM 番号
#DIMS 局面
#DIMS タイプ
#DIMS 方言

;主人公は 口上の使い方（1=固有のみ 2=汎用のみ）で段を飛ばす（→個室.ERB @主人公の行為の口上）
RESULTS '= ""
SIF CFLAG:番号:口上なし
	RETURN 0
IF !(番号 == MASTER && 口上の使い方 == 2)
	TRYCCALLFORM 口上_妊娠_{番号}(番号, 局面)
	CATCH
	ENDCATCH
ENDIF
;キャラ別が無いか空ならタイプ別に落ちる（行為と同じ。2026-09-15 に揃えた。それまではキャラ別があれば空でも黙っていた）
IF RESULTS == "" && !(番号 == MASTER && 口上の使い方 == 1)
	タイプ '= 口上タイプ(番号)
	方言 '= 方言の接尾(番号)
	;方言が付いていれば先に _方言 付き（2026-10-01）
	IF 方言 != ""
		TRYCCALLFORM 口上_妊娠_%タイプ%%方言%(番号, 局面)
		CATCH
		ENDCATCH
	ENDIF
	IF RESULTS == ""
		TRYCCALLFORM 口上_妊娠_%タイプ%(番号, 局面)
		CATCH
		ENDCATCH
	ENDIF
ENDIF
IF RESULTS != ""
	;主人公（あなた）のセリフだけ水色にする
	SIF 番号 == MASTER
		SETCOLOR 150, 200, 255
	PRINTFORMW 　%RESULTS%
	RESETCOLOR
ENDIF
