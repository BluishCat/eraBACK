ENDSELECT


;体型の名札（素質タグに並べる）。小柄・長身は保存せず、その時の身長から引く（既定−8cm 未満＝小柄、+8cm 以上＝長身）。
;バスト・体型・下半身は素質の段のまま（→ERB/体格.ERB @体格の札。普通の段は出さない）。無ければ ""
@体型の名札(番号)
#FUNCTIONS
#DIM 番号
#DIMS 出力

出力 '= ""
SIF 身長:番号:0 < 身長の既定(番号) - 80
	出力 += "[小柄]"
SIF 身長:番号:0 >= 身長の既定(番号) + 80
	出力 += "[長身]"
RETURNF 出力 + 体格の札(番号)


;アンダーバスト（0.1cm）。身長から決め、妊娠でも変わらない（eraTOWN の @UNDER_BUST_STD と同じ式：身長×424/1000−2）
;胴囲は関与させない。お腹が出るとカップが減る、を避けるため
@アンダーバスト(番号)
#FUNCTION
#DIM 番号

RETURNF 身長:番号:0 * 424 / 1000 - 2


;カップ。トップ（胸囲）−アンダーの差 2.5cm 刻み。AAA / AA / A 〜（→設計メモ「体型の変化」）
@カップ(番号)
#FUNCTIONS
#DIM 番号
#DIM 差

差 = 胸囲:番号:0 - アンダーバスト(番号)
SIF 差 < 75
	RETURNF "AAA"
SIF 差 < 100
	RETURNF "AA"
;A=10.0〜12.5cm、以後 2.5cm ごとに1文字進む。L を超えたら L+
差 = (差 - 100) / 25
SIF 差 > 11
	RETURNF "L+"
RETURNF SUBSTRINGU("ABCDEFGHIJKL", 差, 1)
