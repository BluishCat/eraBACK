@SYSTEM_TITLE

;セーブに載せないもの（動線・台帳）はここで組む。「続きから」でも通る
CALL 初期化_起動

ALIGNMENT CENTER
PRINTL 
PRINTL eraBACK
PRINTL 
ALIGNMENT LEFT
DRAWLINE

PRINTL [1] はじめから
PRINTL [2] 続きから
PRINTL [3] 遊び方
PRINTL [9] 終了
PRINTL 

INPUT

SELECTCASE RESULT
	CASE 1
		BEGIN FIRST
	CASE 2
		CALL ロード画面
	CASE 3
		;セーブが無くても読める（→導入.ERB @遊び方）
		CALL 遊び方
	CASE 9
		QUIT
	CASEELSE
		PRINTL その番号は無い
		WAIT
ENDSELECT

BEGIN TITLE


;セーブデータの説明文。セーブする瞬間（SAVEGAME）に呼ばれ、PUTFORMで組んだ文字列がそのセーブファイルに焼き込まれる
;（CHKDATAは焼き込み済みの文字列を読むだけなので、追加より前のセーブには遡って反映されない）
@SAVEINFO
PUTFORM %店名%　{経過日数 + 1}日目　%日付の文(経過日数, 曜日)%　%CALLNAME:MASTER%

;セーブデータの一覧を出して選ばせる。タイトル・起床前・行動中のどこからでも同じ画面
;（LOADGAME は SHOP でしか使えないので、自前の一覧＋LOADDATA にしてある）
;表示だけ+1にずらして [0] を戻る専用に空ける（2026-09-23 ユーザ指定「マウス操作のみで戻れない画面を解消」。RESULT-1 でセーブ番号に戻す）
@ロード画面
#DIM 番号
#DIM 選んだ

PRINTL
PRINTL どのデータを読みますか（[0] で戻る）
PRINTL [ 0] 戻る
FOR 番号, 0, 20
	CHKDATA 番号
	SIF RESULT == 0
		PRINTFORML [{番号 + 1, 2}] %RESULTS%
NEXT
INPUT
選んだ = RESULT - 1

SIF 選んだ < 0 || 選んだ > 19
	RETURN 0
番号 = 選んだ
CHKDATA 番号
SIF RESULT != 0
	RETURN 0

LOADDATA 番号


@EVENTFIRST

;前のゲームの状態を全部捨てる。タイトルに戻って「はじめから」をしても、変数・キャラが残る（キャラ登録が 500 → 1000 に重なる）ため（2026-10-01）。
;RESETDATA は台帳・隣接（セーブに載せない変数）も空にするので、起動時と同じ組み直しをここでもする
RESETDATA
CALL 初期化_起動

;導入。名前を聞くより前に出す（→導入.ERB @オープニング、画面イメージ「オープニングと遊び方」）
CALL オープニング
CALL 店名を決める
CALL 妊娠設定を入れる
CALL 裏設定を入れる
CALL 初期化_キャラ登録
CALL 主人公を作る
;段は登録と主人公作成で入った（古いセーブの引き直しをしない旗）
体格の段の整備済 = 1
CALL 初期化_店
CALL 最初のスタッフを選ぶ
;初日の日替わり（来店予定は開店の時点で組む → @営業の日を組む）
CALL 日替わり
;リザルトの「所持金 前 → 後」の左側（→一日.ERB @今日の集計を戻す）
締めの所持金 = MONEY:MASTER
締めの評判 = 評判

;主人公は自宅の自室から始まる。初日は起床前メニューから
CFLAG:MASTER:現在位置 = 510
SAVESTR:モード = 店

BEGIN SHOP


;主人公を作る は ERB/主人公作成.ERB（2026-09-15 に一枚の画面へ置き換えた）


;ロード直後。既定値の無い古いセーブに設定を入れる。
;LOADDATA はセーブに載せない変数（台帳・隣接）も空に戻すので、起動時と同じ組み直しをここでもする（2026-09-21。続きから始めると個室に行為が一つも出なかった）
@EVENTLOAD
CALL 初期化_起動
CALL 妊娠設定を入れる
CALL 裏設定を入れる
CALL 母乳の上限を入れる
CALL 服装をCSVから読み直す
CALL 体格の段を整える


;体格の段（体型・バスト・下半身）を持たない古いセーブを、一度だけ数値から引き直す（2026-09-30。→ERB/体格.ERB）
@体格の段を整える
#DIM 番号

SIF 体格の段の整備済
	RETURN 0
FOR 番号, 0, キャラ枠
	SIF 番号 != MASTER && !実キャラ:番号:0
		CONTINUE
	CALL 体格の段を引き直す(番号, 体格_全部)
NEXT
体格の段の整備済 = 1


;服装と容姿の素の値はキャラCSVが正（→画面イメージ「個室の中」の脱衣と汚れ・容姿）。CSTR・CFLAG はセーブに載るので、
;続きからで始めても CSV の直しが効くように、ロードのたびに同梱キャラの分だけ CSV から取り直す（主人公は自分で決めた服なので触らない。着せた服装 も触らない）。
;取り方：同じ番号のキャラを末尾に一時登録して写し、消す（ADDCHARA は末尾に付く）。2026-09-22
@服装をCSVから読み直す
#DIM 番号
#DIM 末尾
#DIM 品

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !EXISTCSV(番号)
		CONTINUE
	ADDCHARA 番号
	末尾 = CHARANUM - 1
	;服装（0）と枠ごとの上書き（2〜6）。着せた服装（7）は残す
	CSTR:番号:服装 = %CSTR:末尾:服装%
	FOR 品, 2, 7
		CSTR:番号:品 = %CSTR:末尾:品%
	NEXT
	CFLAG:番号:初期容姿 = CFLAG:末尾:初期容姿
	DELCHARA 末尾
NEXT


@初期化_起動

CALL 初期化_隣接
CALL 台帳を読む


;CSV/台帳 を読む。行の形は台帳ごと（料理「番号,名前,必要な料理Lv,材料費,系統」、飲み物「番号,名前,材料費,酔い,系統」）。系統は無くてもよい（空）。
;先頭が数字でない行（コメント・空行）は飛ばす
@台帳を読む
#DIMS 欄, 16
#DIM 欄数
#DIM 番号
#DIM 行数
#DIM 品

VARSET 料理名, ""
VARSET 料理必要Lv
VARSET 料理材料費
VARSET 料理系統, ""
料理数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/料理.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 料理枠
		CONTINUE
	料理名:品 = %欄:1%
	料理必要Lv:品 = TOINT(欄:2)
	料理材料費:品 = TOINT(欄:3)
	SIF 欄数 >= 5
		料理系統:品 = %欄:4%
	SIF 品 >= 料理数
		料理数 = 品 + 1
NEXT

VARSET 商品名, ""
VARSET 商品系統
VARSET 商品値段
VARSET 商品中出し
VARSET 商品仕事
商品数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/商品.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 商品枠
		CONTINUE
	商品系統:品 = TOINT(欄:1)
	商品名:品 = %欄:2%
	商品値段:品 = TOINT(欄:3)
	;中出しの列（無ければ 0）：客が中で出してよい品目（→画面イメージ「個室の中」の膣内射精）
	商品中出し:品 = 0
	SIF 欄数 >= 5 && ISNUMERIC(欄:4)
		商品中出し:品 = TOINT(欄:4)
	;仕事の列（無ければ 0）：地下の仕事に就くための同意（→画面イメージ「地下のステージと手出し」）
	商品仕事:品 = 0
	SIF 欄数 >= 6 && ISNUMERIC(欄:5)
		商品仕事:品 = TOINT(欄:5)
	SIF 品 >= 商品数
		商品数 = 品 + 1
NEXT

VARSET 品目種類
VARSET 品目軸
VARSET 品目好物, -1
品目数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/品目.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 2048
		CONTINUE
	品目種類:品 = TOINT(欄:1)
	品目軸:品 = TOINT(欄:2)
	品目好物:品 = -1
	SIF 欄:3 != "-" && 欄:3 != ""
		品目好物:品 = GETNUM(TALENT, 欄:3)
	SIF 品 >= 品目数
		品目数 = 品 + 1
NEXT

VARSET 設備名, ""
VARSET 設備値段
設備数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/設備.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 3 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 16
		CONTINUE
	設備名:品 = %欄:1%
	設備値段:品 = TOINT(欄:2)
	SIF 品 >= 設備数
		設備数 = 品 + 1
NEXT

VARSET 施設名, ""
VARSET 施設値段
VARSET 施設の一言, ""
施設種類数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/施設.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 16
		CONTINUE
	施設名:品 = %欄:1%
	施設値段:品 = TOINT(欄:2)
	施設の一言:品 = %欄:3%
	SIF 品 >= 施設種類数
		施設種類数 = 品 + 1
NEXT

VARSET 行事名, ""
VARSET 行事の始め
VARSET 行事の終わり
VARSET 行事の客足, 100
VARSET 行事の売れ筋, ""
VARSET 行事の気分, ""
VARSET 行事の一文, ""
VARSET 行事の一言, ""
行事数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/行事.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 9 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 32
		CONTINUE
	行事名:品 = %欄:1%
	行事の始め:品 = TOINT(欄:2) * 100 + TOINT(欄:3)
	行事の終わり:品 = TOINT(欄:4) * 100 + TOINT(欄:5)
	行事の客足:品 = TOINT(欄:6)
	行事の売れ筋:品 = %欄:7%
	行事の気分:品 = %欄:8%
	SIF 欄数 > 9
		行事の一文:品 = %欄:9%
	SIF 欄数 > 10
		行事の一言:品 = %欄:10%
	SIF 品 >= 行事数
		行事数 = 品 + 1
NEXT

VARSET 目標名, ""
VARSET 目標の種類, ""
VARSET 目標の値
VARSET 目標の報酬, ""
VARSET 目標の一言, ""
目標数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/目標.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 5 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 64
		CONTINUE
	目標名:品 = %欄:1%
	目標の種類:品 = %欄:2%
	目標の値:品 = TOINT(欄:3)
	目標の報酬:品 = %欄:4%
	SIF 欄数 > 5
		目標の一言:品 = %欄:5%
	SIF 品 >= 目標数
		目標数 = 品 + 1
NEXT
VARSET 称号名, ""
VARSET 称号の種類, ""
VARSET 称号の値
VARSET 称号の一言, ""
称号数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/称号.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 64
		CONTINUE
	称号名:品 = %欄:1%
	称号の種類:品 = %欄:2%
	称号の値:品 = TOINT(欄:3)
	SIF 欄数 > 4
		称号の一言:品 = %欄:4%
	SIF 品 >= 称号数
		称号数 = 品 + 1
NEXT
VARSET 行為名, ""
VARSET 行為の分類
VARSET 行為の系統
VARSET 行為の向き
VARSET 行為の部位, -1
VARSET 行為の使用
VARSET 行為のモード, ""
VARSET 行為の要るモード, ""
VARSET 行為の快感
VARSET 行為の苦痛
VARSET 行為の羞恥
VARSET 行為の欲情
VARSET 行為の要る設備, -1
行為数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/行為.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 13 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 行為枠
		CONTINUE
	行為の分類:品 = 分類の番号(欄:1)
	行為名:品 = %欄:2%
	行為の系統:品 = TOINT(欄:3)
	行為の向き:品 = TOINT(欄:4)
	CALL 部位の欄を読む(欄:5, 品, 0)
	CALL 部位の欄を読む(欄:6, 品, 1)
	行為の快感:品 = TOINT(欄:7)
	行為の苦痛:品 = TOINT(欄:8)
	行為の羞恥:品 = TOINT(欄:9)
	行為の欲情:品 = TOINT(欄:10)
	SIF 欄:11 != "-"
		行為のモード:品 = %欄:11%
	SIF 欄:12 != "-"
		行為の要るモード:品 = %欄:12%
	;要る設備（14列目。無ければ -1）。設備の台帳の名前で引く
	行為の要る設備:品 = -1
	SIF 欄数 >= 14 && 欄:13 != "-" && 欄:13 != ""
		行為の要る設備:品 = 設備の番号(欄:13)
	SIF 品 >= 行為数
		行為数 = 品 + 1
NEXT

;衣類（一枚ずつ）。名前,枠,はだけ可,めくり可,ずらし可。枠は 枠の名 で引く（無い枠名の行は飛ばす）
VARSET 衣類名, ""
VARSET 衣類の枠
VARSET 衣類の性質
衣類数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/衣類.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	;見出しの行（;名前,…）は欄が5つあるので、先頭が ; の行も飛ばす（服装の一覧に「[1] ;名前」が出ていた。2026-09-21）
	SIF 欄数 < 5 || 欄:0 == "" || SUBSTRINGU(欄:0, 0, 1) == ";" || 衣類数 >= 256
		CONTINUE
	衣類の枠:衣類数 = -1
	FOR 品, 0, 衣類の枠数
		SIF 枠の名:品 == 欄:1
			衣類の枠:衣類数 = 品
	NEXT
	SIF 衣類の枠:衣類数 < 0
		CONTINUE
	衣類名:衣類数 = %欄:0%
	FOR 品, 0, 3
		衣類の性質:衣類数:品 = TOINT(欄:(品 + 2))
	NEXT
	;容姿＋（6列目）・露出＋（7列目）・密着＋（8列目）。無ければ 0
	衣類の容姿:衣類数 = 0
	SIF 欄数 >= 6
		衣類の容姿:衣類数 = TOINT(欄:5)
	衣類の露出:衣類数 = 0
	SIF 欄数 >= 7
		衣類の露出:衣類数 = TOINT(欄:6)
	衣類の密着:衣類数 = 0
	SIF 欄数 >= 8
		衣類の密着:衣類数 = TOINT(欄:7)
	;値段（9列目）。無ければ 0（買えない＝一覧に出さない）
	衣類の値段:衣類数 = 0
	SIF 欄数 >= 9
		衣類の値段:衣類数 = TOINT(欄:8)
	衣類数 += 1
NEXT

;衣装の組。名前,性別,上の服,下の服,上の下着,下の下着,小物,値段,靴下,靴。同じ名前で女と男の行を置ける（引くのは 個室.ERB @衣装の組）。靴下・靴は後から足した列（9・10列目）
VARSET 衣装名, ""
VARSET 衣装の性別
VARSET 衣装の枠, ""
VARSET 衣装の小物, ""
衣装数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/衣装.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 6 || 欄:0 == "" || SUBSTRINGU(欄:0, 0, 1) == ";" || 衣装数 >= 64
		CONTINUE
	衣装名:衣装数 = %欄:0%
	衣装の性別:衣装数 = 衣装性別_どちらも
	SIF 欄:1 == "男"
		衣装の性別:衣装数 = 衣装性別_男
	SIF 欄:1 == "女"
		衣装の性別:衣装数 = 衣装性別_女
	FOR 品, 0, 4
		衣装の枠:衣装数:品 = %欄:(品 + 2)%
	NEXT
	衣装の小物:衣装数 '= ""
	SIF 欄数 >= 7
		衣装の小物:衣装数 = %欄:6%
	衣装の値段:衣装数 = 0
	SIF 欄数 >= 8
		衣装の値段:衣装数 = TOINT(欄:7)
	;靴下・靴（9・10列目）。無ければ履いていない
	SIF 欄数 >= 9
		衣装の枠:衣装数:服_靴下 = %欄:8%
	SIF 欄数 >= 10
		衣装の枠:衣装数:服_靴 = %欄:9%
	衣装数 += 1
NEXT

;最初のスタッフの組。名前,一言,番号×最初のスタッフの上限（→画面イメージ「最初のスタッフ」。引くのは 主人公作成.ERB @最初のスタッフを選ぶ）
VARSET 最初の組名, ""
VARSET 最初の組の一言, ""
VARSET 最初の組の番号
最初の組数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/最初のスタッフ.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 3 || 欄:0 == "" || SUBSTRINGU(欄:0, 0, 1) == ";" || 最初の組数 >= 16
		CONTINUE
	最初の組名:最初の組数 = %欄:0%
	最初の組の一言:最初の組数 = %欄:1%
	FOR 品, 0, 最初のスタッフの上限
		SIF 欄数 >= 品 + 3
			最初の組の番号:最初の組数:品 = TOINT(欄:(品 + 2))
	NEXT
	最初の組数 += 1
NEXT

;募集の名前（→画面イメージ「募集する」。引くのは 募集.ERB）。種別（男／女）,名前
VARSET 募集名_男, ""
VARSET 募集名_女, ""
募集名数_男 = 0
募集名数_女 = 0
行数 = 台帳ファイルを読む("CSV/台帳/募集の名前.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 2 || 欄:1 == ""
		CONTINUE
	IF 欄:0 == "男" && 募集名数_男 < 160
		募集名_男:募集名数_男 = %欄:1%
		募集名数_男 += 1
	ELSEIF 欄:0 == "女" && 募集名数_女 < 160
		募集名_女:募集名数_女 = %欄:1%
		募集名数_女 += 1
	ENDIF
NEXT

VARSET 飲み物名, ""
VARSET 飲み物材料費
VARSET 飲み物酔い
VARSET 飲み物系統, ""
飲み物数 = 0
行数 = 台帳ファイルを読む("CSV/台帳/飲み物.csv")
FOR 番号, 0, 行数
	SPLIT 台帳行:番号, ",", 欄
	欄数 = RESULT
	SIF 欄数 < 4 || !ISNUMERIC(欄:0)
		CONTINUE
	品 = TOINT(欄:0)
	SIF 品 < 0 || 品 >= 128
		CONTINUE
	飲み物名:品 = %欄:1%
	飲み物材料費:品 = TOINT(欄:2)
	飲み物酔い:品 = TOINT(欄:3)
	SIF 欄数 >= 5
		飲み物系統:品 = %欄:4%
	SIF 品 >= 飲み物数
		飲み物数 = 品 + 1
NEXT

;料理・飲み物を開ける目標を引く（料理・飲み物の台帳を読んだあとで。飲み物は一番最後に読むのでここ）
CALL 目標の鍵を引く


;台帳の「分類」の文字 → 行為分類名 の番号。無ければ0（会話）
@分類の番号(文字)
#FUNCTION
#DIMS 文字
#DIM 番号

FOR 番号, 0, 行為分類数
	SIF 行為分類名:番号 == 文字
		RETURNF 番号
NEXT
RETURNF 0


;台帳の部位の欄（"Bh" のような英字の並び）を 行為の部位（快感の入る部位＝最初の大文字）と 行為の使用（使う部位のビット）に。
;M B C V A P G H。大文字は使って快感が入る、小文字は使うだけ。"-" は無し
@部位の欄を読む(文字, 行為, 側)
#DIMS 文字
#DIM 行為
#DIM 側
#DIM 位置
#DIM 番号
#DIMS 一字

行為の部位:行為:側 = -1
行為の使用:行為:側 = 0
FOR 位置, 0, STRLENS(文字)
	一字 '= SUBSTRINGU(文字, 位置, 1)
	番号 = 部位の番号(TOUPPER(一字))
	SIF 番号 < 0
		CONTINUE
	行為の使用:行為:側 |= 1 << 番号
	SIF 一字 == TOUPPER(一字) && 番号 != 部位_手 && 番号 != 部位_目 && 行為の部位:行為:側 < 0
		行為の部位:行為:側 = 番号
NEXT


;部位の英字（M B C V A P）→ 部位の番号。G は性器（部位_性器）、H は手（部位_手）、E は目（部位_目）。不明は -1
@部位の番号(文字)
#FUNCTION
#DIMS 文字
#DIM 番号

FOR 番号, 0, 6
	SIF 部位記号:番号 == 文字
		RETURNF 番号
NEXT
SIF 文字 == "G"
	RETURNF 部位_性器
SIF 文字 == "H"
	RETURNF 部位_手
SIF 文字 == "E"
	RETURNF 部位_目
RETURNF -1


;ファイルを行に割って 台帳行 に入れ、行数を返す。LOADTEXT は exe からの相対パス。
;.csv を読むには _fixed.config の「LOADTEXTとSAVETEXTで使える拡張子」に csv が要る（無いと黙って空が返る）
@台帳ファイルを読む(パス)
#FUNCTION
#DIMS パス
#DIMS 全文
#DIM 番号
#DIM 行数

VARSET 台帳行, ""
LOADTEXT パス
全文 = %RESULTS%
SPLIT 全文, UNICODE(10), 台帳行
行数 = RESULT
;CRLF の CR を落とす
FOR 番号, 0, 行数
	台帳行:番号 = %REPLACE(台帳行:番号, UNICODE(13), "")%
NEXT
RETURNF 行数


@初期化_キャラ登録
;0〜499 の全枠を必ず登録する。CSVの無い番号は空枠で埋めて、キャラ番号＝登録番号を固定する
#DIM 実数

実数 = 0

FOR LOCAL, 0, キャラ枠
	IF EXISTCSV(LOCAL)
		ADDCHARA LOCAL
		実キャラ:LOCAL:0 = 1
		CALL キャラの初期値を入れる(LOCAL)
		実数 += 1
	ELSE
		ADDVOIDCHARA
		実キャラ:LOCAL:0 = 0
	ENDIF
NEXT

