		体重:番号:0 = 体重:番号:0 * (100 + 補正) / 100
	ENDIF
ELSEIF TALENT:番号:体型 == 0
	TALENT:番号:体型 = 体型の段を出す(番号)
ENDIF
IF 性別ビット(番号) & 6
	IF TALENT:番号:バストサイズ != 0 && CFLAG:番号:初期胸囲 <= 0
		CALL 体格の段から数値を作る(番号, 体格_バスト)
	ELSEIF TALENT:番号:バストサイズ == 0
		TALENT:番号:バストサイズ = バストの段を出す(番号)
	ENDIF
ENDIF
IF TALENT:番号:下半身 != 0 && CFLAG:番号:初期腰囲 <= 0
	CALL 体格の段から数値を作る(番号, 体格_下半身)
