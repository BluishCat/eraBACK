	胴囲:番号:0 = 600 + ゆらぎ(30)
ENDIF
IF CFLAG:番号:初期腰囲 > 0
	腰囲:番号:0 = CFLAG:番号:初期腰囲
ELSEIF 男寄り
	腰囲:番号:0 = 900 + ゆらぎ(40)
