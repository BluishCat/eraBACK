;前のリザルトを閉じたときの値を 成長控え に取っておき、今の値との差を一人一行で出す。差を見るのは 技能Lv・体力／気力／精力の上限・開発度Lv（感度・耐性・慣れ）

;一人ぶんの値を控える
@成長を控える(番号)
#DIM 番号
#DIM 技能
#DIM 部位

FOR 技能, 0, 技能数
	成長控え:番号:技能 = ABL:番号:技能
NEXT
成長控え:番号:(技能数) = MAXBASE:番号:体力
成長控え:番号:(技能数 + 1) = MAXBASE:番号:気力
成長控え:番号:(技能数 + 2) = MAXBASE:番号:精力
FOR 部位, 0, 6
	成長控え:番号:(技能数 + 3 + 部位) = 開発度_感度:番号:部位 / 開発度の一段
NEXT
成長控え:番号:(技能数 + 9) = 開発度_耐性:番号:0 / 開発度の一段
成長控え:番号:(技能数 + 10) = 開発度_慣れ:番号:0 / 開発度の一段
成長控え済み:番号:0 = 1


;全員の控えを取り直す。リザルトの後（@今日の集計を戻す。数字採りの日回しも通る）
@成長を控え直す
#DIM 番号

CALL 成長を控える(MASTER)
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0
		CALL 成長を控える(番号)
NEXT


;控えの無い者だけ取る。起床前メニューに入ったとき（新しく始めた・控えの無い古いセーブ）
@成長の控えを揃える
#DIM 番号

SIF !成長控え済み:MASTER:0
	CALL 成長を控える(MASTER)
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && !成長控え済み:番号:0
		CALL 成長を控える(番号)
NEXT


;一人ぶんの成長を一つの文に。変わりが無い・控えが無いなら空
@成長の文(番号)
#FUNCTIONS
#DIM 番号
#DIM 技能
#DIM 部位
#DIM 前
#DIM 後
#DIMS 文
#DIMS 感度

文 '= ""
SIF !成長控え済み:番号:0
	RETURNF ""
FOR 技能, 0, 技能数
	前 = 成長控え:番号:技能
	SIF ABL:番号:技能 != 前
		文 += 区切り(文) + @"%ABLNAME:技能% Lv{前}→{ABL:番号:技能}"
NEXT
前 = 成長控え:番号:(技能数)
後 = MAXBASE:番号:体力
SIF 後 != 前
	文 += 区切り(文) + @"体力上限 {前}→{後}"
前 = 成長控え:番号:(技能数 + 1)
後 = MAXBASE:番号:気力
SIF 後 != 前
	文 += 区切り(文) + @"気力上限 {前}→{後}"
前 = 成長控え:番号:(技能数 + 2)
後 = MAXBASE:番号:精力
SIF 後 != 前
	文 += 区切り(文) + @"精力上限 {前}→{後}"
;感度は部位をまとめて一つに（B1→2 V0→1）
感度 '= ""
FOR 部位, 0, 6
	前 = 成長控え:番号:(技能数 + 3 + 部位)
	後 = 開発度_感度:番号:部位 / 開発度の一段
	IF 後 != 前
		SIF 感度 != ""
			感度 += " "
		感度 += @"%部位記号:部位%{前}→{後}"
	ENDIF
NEXT
SIF 感度 != ""
	文 += 区切り(文) + "感度Lv " + 感度
前 = 成長控え:番号:(技能数 + 9)
後 = 開発度_耐性:番号:0 / 開発度の一段
SIF 後 != 前
	文 += 区切り(文) + @"耐性 Lv{前}→{後}"
前 = 成長控え:番号:(技能数 + 10)
後 = 開発度_慣れ:番号:0 / 開発度の一段
SIF 後 != 前
	文 += 区切り(文) + @"慣れ Lv{前}→{後}"
RETURNF 文


;成長の一行。名前の列を揃え、増えた分は色を付ける
@成長の一行(名, 文)
#DIMS 名
#DIMS 文

PRINTFORM 　%PAD(名, 10)%
SETCOLOR 増える色
PRINTFORML %文%
RESETCOLOR


;リザルトの次の画面。変わった者だけ、あなた→スタッフ→客の順（2026-10-06 ユーザ指定「変化があった人のみだすように」）。誰も変わらなければ「変わりなし」
@成長を出す
#DIM 番号
#DIM 出た
#DIM 客の数
#DIM 超えた
#DIMS 文

出た = 0
PRINTL
DRAWLINE
PRINTFORML {今日の日数 + 1}日目　%日付の文(今日の日数, 今日の曜日)%の成長
DRAWLINE
文 '= 成長の文(MASTER)
IF 文 != ""
	CALL 成長の一行("あなた", 文)
	出た = 1
ENDIF
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0
		CONTINUE
	文 '= 成長の文(番号)
	SIF 文 == ""
		CONTINUE
	CALL 成長の一行(CALLNAME:番号, 文)
	出た = 1
NEXT

;客は多い日は 成長の客の行数 まで
客の数 = 0
超えた = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || スタッフ:番号:0
		CONTINUE
	文 '= 成長の文(番号)
	SIF 文 == ""
		CONTINUE
	IF 客の数 == 0
		SIF 出た
			PRINTL
		PRINTL 　（客）
		出た = 1
	ENDIF
	客の数 += 1
	IF 客の数 > 成長の客の行数
		超えた += 1
		CONTINUE
	ENDIF
	CALL 成長の一行(CALLNAME:番号, 文)
NEXT
SIF 超えた > 0
	PRINTFORML 　ほか {超えた}人
SIF !出た
	PRINTL 　変わりなし
DRAWLINE
WAIT


;出来事（スタッフ以外のこと）を一つ足す。枠を超えた分は捨てる
@出来事を記す(文)
#DIMS 文

SIF 今日の出来事の数 >= 20
	RETURN 0
今日の出来事:(今日の出来事の数) '= 文
今日の出来事の数 += 1


;スタッフの一日の変化を一つ足す（リザルトに一人一行）。スタッフ以外は捨てる
@変化を記す(番号, 文)
#DIM 番号
#DIMS 文

SIF 番号 == MASTER || !実キャラ:番号:0 || !スタッフ:番号:0
	RETURN 0
今日の変化:番号:0 '= 今日の変化:番号:0 + 区切り(今日の変化:番号:0) + 文


;続けて書くときの区切り。先が空なら要らない
@区切り(先)
#FUNCTIONS
#DIMS 先

SIF 先 == ""
	RETURNF ""
RETURNF "　　"


;収支の表の一行。項目は全角空白で埋め、額は半角空白で右詰め。幅はどちらも表示幅（STRLENS。全角＝2）で数える。
;ＭＳ ゴシックなので全角＝半角2つで揃う（文字数 STRLENSU で数えると全角の分がずれる）。
;0 の欄は空けずに 0 と出す（列が揃って読める）。註（給料の人数）は列の外の右端
@収支の行(項目, 収入, 支出, 註 = "")
#DIMS 項目
#DIM 収入
#DIM 支出
#DIMS 註

PRINTFORM 　%PAD(項目, 収支の項目幅)%
IF 収入 != 0
	SETCOLOR 増える色
	PRINTFORM %金額(収入, 収支の額幅)%
	RESETCOLOR
ELSE
	PRINTFORM %金額(収入, 収支の額幅)%
ENDIF
IF 支出 != 0
	SETCOLOR 減る色
	PRINTFORM %金額(支出, 収支の額幅)%
	RESETCOLOR
ELSE
	PRINTFORM %金額(支出, 収支の額幅)%
ENDIF
PRINTFORML %註%


;表示幅まで半角空白で右詰め
@右詰め(文, 幅)
#FUNCTIONS
#DIMS 文
#DIM 幅

SIF 幅 > STRLENS(文)
	文 '= " " * (幅 - STRLENS(文)) + 文
RETURNF 文


;金額を桁区切りで。幅を与えれば右寄せ
@金額(額, 幅 = 0)
#FUNCTIONS
#DIM 額
#DIM 幅

RETURNF 右詰め(TOSTR(額, "#,0"), 幅)


;増減を「+3」「-1,000」「±0」で
@符号付き(値)
#FUNCTIONS
#DIM 値

SIF 値 > 0
	RETURNF "+" + TOSTR(値, "#,0")
SIF 値 < 0
	RETURNF TOSTR(値, "#,0")
RETURNF "±0"


;給料は働いた日だけ出る（→設計メモ「スタッフ」）。出勤した時点で 今日の給料 に積んであるので、ここで払う
;黙る=1 なら文を出さない（リザルトの一覧と数字採り → デバッグ.ERB）。浮いた額と払えなかった額は 今日の給料の浮き・不足 に残す
@給料を払う(黙る = 0)
#DIM 黙る
#DIM 引く率
#DIM 浮いた
#DIM 払う

SIF 今日の給料 <= 0
	RETURN 0

;事務は支出を下げる（効く先はこれだけ → 設計メモ「仕事の一覧」）
引く率 = 事務の率 * 事務のLv合計()
SIF 引く率 > 事務の上限
	引く率 = 事務の上限
浮いた = 今日の給料 * 引く率 / 100
払う = 今日の給料 - 浮いた
今日の給料の浮き = 浮いた

IF MONEY:MASTER >= 払う
	MONEY:MASTER -= 払う
	昨日の給料 = 払う
	SIF !黙る
		PRINTFORML 　給料 %金額(払う)%円（{出勤の数()}人）
ELSE
	SIF !黙る
		PRINTFORML 　給料 %金額(払う)%円（{出勤の数()}人）のうち %金額(MONEY:MASTER)%円しか払えなかった
	昨日の給料 = MONEY:MASTER
	今日の給料の不足 = 払う - MONEY:MASTER
	MONEY:MASTER = 0
	CALL 出来事を記す(@"給料のうち %金額(今日の給料の不足, 0)%円 が払えなかった")
	CALL 給料不払いの傷(払う, 今日の給料の不足)
ENDIF
SIF 浮いた > 0 && !黙る
	PRINTFORML 　事務で %金額(浮いた)%円 浮いた
今日の給料 = 0
;事務に入っていた者は一日に一回ぶん伸びる（他の仕事は回ごと → 行動.ERB @経験を積む）
CALL 事務の経験


;給料が払えなかった日は、その日出勤したスタッフの友情が下がる（恋愛と体の関係は動かない）。下がる幅は払えなかった割合に比例。
;払えなかったと伝わるのは本人の行（リザルトのスタッフ）。主人公が詫びる手は無い（友情は会話などで戻す）
@給料不払いの傷(予定, 不足)
#DIM 予定
#DIM 不足
#DIM 番号
#DIM 傷

SIF 予定 <= 0 || 不足 <= 0
	RETURN 0
傷 = 給料不払いの傷 * 不足 / 予定
SIF 傷 < 1
	傷 = 1
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0 || シフト:番号:営業曜日 <= 0
		CONTINUE
	好感度_友情:番号:0 -= 傷
	SIF 好感度_友情:番号:0 < 0
		好感度_友情:番号:0 = 0
	CALL 変化を記す(番号, @"給料が出なかった（友情 −{傷}）")
NEXT


@事務の経験
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0 || シフト:番号:営業曜日 != 9
		CONTINUE
	CALL 経験を積む(番号, 技能_事務, 接客の経験)
NEXT


;その日 事務に入っていたスタッフの事務Lvの合計
@事務のLv合計
#FUNCTION
#DIM 番号
#DIM 合計

合計 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0 || シフト:番号:営業曜日 != 9
		CONTINUE
	合計 += ABL:番号:事務
NEXT
RETURNF 合計


;================================ 回復 ================================
;寝た長さに応じて戻す。率 = (分／全回復の分)^2。上限は総量
@睡眠回復(分)
#DIM 分
#DIM 率

SIF 分 > 全回復の分
	分 = 全回復の分
SIF 分 < 0
	分 = 0
率 = 分 * 分 * 100 / (全回復の分 * 全回復の分)
;回復早い／回復遅い（→Talent.csv の体質、個室.ERB @体質の倍率）
率 = 体質の倍率(MASTER, 率, GETNUM(TALENT, "回復早い"), GETNUM(TALENT, "回復遅い"))

BASE:MASTER:体力 += MAXBASE:MASTER:体力 * 率 / 100
BASE:MASTER:気力 += MAXBASE:MASTER:気力 * 率 / 100
BASE:MASTER:体力 = LIMIT(BASE:MASTER:体力, 0, MAXBASE:MASTER:体力)
BASE:MASTER:気力 = LIMIT(BASE:MASTER:気力, 0, MAXBASE:MASTER:気力)
