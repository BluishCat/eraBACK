;================================ 呼び寄せる ================================
;店に居ない者の来店予定を 今＋呼び寄せるの分 にする（→設計メモ「呼び寄せる — 連絡先がなくても、任意のキャラを店へ来させる」）。
;来店の流れはそのまま（玄関→席）。曜日の偏りと来店時刻の制約だけを外す。使うたびに使用料。時間は食わない
;［その他］の入口。能力を持っていて、営業中で、呼べる者が居るときだけ
@呼び寄せる_入口

SIF !能力を持っているか(能力_呼び寄せる) || !営業中(現在時刻)
	RETURN 0
SIF 呼べる者の数() <= 0
	RETURN 0
CALL コマンドを並べる(1006, "呼び寄せる")


;店に居ない者。外（現在位置 0）か、寮に居る休みのスタッフ。店の中・勤務中は呼べない
@呼べるか(番号)
#FUNCTION
#DIM 番号

SIF 番号 <= 0 || !実キャラ:番号:0
	RETURNF 0
SIF 勤務中:番号:0
	RETURNF 0
;主人公に連れられている者は呼べない（→同行.ERB）。気絶して眠っている者も（→気絶.ERB）。寝床で陣痛中の者も（→立ち会い.ERB）
SIF 同行キャラ == 番号 || 気絶中:番号:0 || 分娩で休んでいるか(番号)
	RETURNF 0
;同棲している人は自宅の自分の部屋に居れば呼べる（→行動.ERB「同棲」）
SIF 家に居るか(番号)
	RETURNF 1
RETURNF CFLAG:番号:現在位置 >= 400 && CFLAG:番号:現在位置 < 500


@呼べる者の数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 呼べるか(番号)
		数 += 1
NEXT
RETURNF 数


@呼び寄せる
#DIM 番号
#DIM 数

IF MONEY:MASTER < 呼び寄せるの使用料
	PRINTFORML 一人 %金額(呼び寄せるの使用料)%円かかる。金が足りない
	WAIT
	RETURN 0
ENDIF

PRINTL 
PRINTFORML 誰を呼びますか（キャラ番号。[0] でやめる）　一人 %金額(呼び寄せるの使用料)%円　所持金 %金額(MONEY:MASTER)%円
数 = 0
FOR 番号, 1, キャラ枠
	SIF !呼べるか(番号)
		CONTINUE
	SIF 数 > 0 && 数 % 4 == 0
		PRINTL
	PRINTFORM [{番号, 3}] %CALLNAME:番号, 10, LEFT%
	数 += 1
NEXT
PRINTL
PRINTL [  0] やめる
INPUT
番号 = RESULT
SIF 番号 < 0 || 番号 >= キャラ枠 || !呼べるか(番号)
	RETURN 0

MONEY:MASTER -= 呼び寄せるの使用料
今日の店の外:外_怪しい店 -= 呼び寄せるの使用料
;寮に居た者は外へ出てから来る（来店はティック処理が 現在位置 0 の者にだけ起こす）
CFLAG:番号:現在位置 = 0
来店予定:番号:0 = 経過日数 * 1440 + 現在時刻 + 呼び寄せるの分
PRINTFORML %CALLNAME:番号%を呼び寄せた（%金額(呼び寄せるの使用料)%円）。{呼び寄せるの分}分ほどで来る
WAIT


;================================ 記憶 ================================
;キャラごとの文の輪（記憶枠 件。古いものから消える）。主人公が居ようが居まいが常に残す（能力は読む側。買う前の出来事も読める）。
;残すのは人とのことだけ：指名（@指名を引く）・個室（@裏を終える）・親しくなる（@自律交流）・迷惑客を収めた（@警備が収める）。
;主人公自身の記憶は残さない（自分のことは知っている）（→画面イメージ「怪しい店」の記憶を覗く）
@記憶に残す(番号, 文)
#DIM 番号
#DIMS 文
#DIM 甲

SIF 番号 <= 0 || 番号 >= キャラ枠 || !実キャラ:番号:0
	RETURN 0
;新しいものを 0 に置き、後ろへずらす。末尾は落ちる
FOR 甲, 記憶枠 - 1, 0, -1
	記憶:番号:甲 '= 記憶:番号:(甲 - 1)
NEXT
記憶:番号:0 '= @"{経過日数 + 1}日目 %時刻表示(現在時刻)%　%文%"
SIF 記憶の数:番号:0 < 記憶枠
	記憶の数:番号:0 += 1


;［その他］の入口。能力を持っているときだけ
@記憶を覗く_入口

SIF !能力を持っているか(能力_記憶を覗く)
	RETURN 0
CALL コマンドを並べる(1007, "記憶を覗く")


;誰でも・どこでも・時間なし（→設計メモ「見る能力3つには代償を置かない」）
@記憶を覗く
#DIM 番号
#DIM 数
#DIM 甲

PRINTL 
PRINTL 誰の記憶を覗きますか（キャラ番号。[0] でやめる）
数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	SIF 数 > 0 && 数 % 4 == 0
		PRINTL
	PRINTFORM [{番号, 3}] %CALLNAME:番号, 10, LEFT%
	数 += 1
NEXT
PRINTL
PRINTL [  0] やめる
INPUT
番号 = RESULT
SIF 番号 <= 0 || 番号 >= キャラ枠 || !実キャラ:番号:0
	RETURN 0

PRINTL 
PRINTFORML %CALLNAME:番号%の記憶（新しいものから）
IF 記憶の数:番号:0 <= 0
	PRINTL 　（何も覚えていない）
ELSE
	FOR 甲, 0, 記憶の数:番号:0
		PRINTFORML 　%記憶:番号:甲%
	NEXT
ENDIF
WAIT


;================================ 居場所感知 ================================
;クイック移動タブの見取り図の下に、部屋ごとに居る者を並べる（→設計メモ「居場所感知」）。
;見えるのは店・寮・自宅の中（2026-10-09 ユーザ指定で寮と自宅を足した）。店の外に居る者は出さない（→居場所感知.ERB @居場所の場所か）
@居場所の文
#FUNCTIONS
#DIM 場所
#DIM 番号
#DIMS 出力
#DIMS 名
#DIMS 所
#DIM 数

SIF !能力を持っているか(能力_居場所感知)
	RETURNF ""
;見出しを押すと別画面（追跡枠と、押して移動できる一覧。→居場所感知.ERB）。部屋の行を押すとそこへ移動する（2026-10-09 ユーザ指定）
出力 '= "<br><font color='#808080'><button value='1009'>居場所［くわしく］</button></font><br>"
数 = 0
FOR 場所, 1, 600
	SIF !居場所の場所か(場所)
		CONTINUE
	所 '= 居場所の名(場所)
	名 '= ""
	FOR 番号, 1, キャラ枠
		SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 場所
			CONTINUE
		SIF 名 != ""
			名 += "・"
		名 += CALLNAME:番号
		;スタッフはそうと分かるように札を付ける（客には付けない。別画面は全員に付く → 居場所感知.ERB）
		SIF スタッフ:番号:0
			名 += 立場のタグ(番号)
	NEXT
	SIF 名 == ""
		CONTINUE
	;押すとそこへ移動する（場所番号をそのまま返す。見取り図のボタンと同じ受け方で、寮・自宅へは @移動 が出口を通る）。いま居る部屋は押せない
	IF 場所 == CFLAG:MASTER:現在位置
		出力 += @"　%所, 16, LEFT%%名%<br>"
	ELSE
		出力 += @"<button value='{場所}'>　%所, 16, LEFT%%名%</button><br>"
	ENDIF
	数 += 1
NEXT
SIF 数 == 0
	出力 += "　（誰も居ない）<br>"
RETURNF 出力
