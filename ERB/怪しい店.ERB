;怪しい店（店の外 303。→設計メモ「主人公の能力」、画面イメージ「怪しい店」。2026-09-14）。
;能力（一つ買えば完成・以後ずっと使える）と施術（対象に一度・都度払い）の2系統。
;
;**感情を動かす・時間を止める・昂ぶらせる の3つは作らない**（2026-09-14）。
;相手の意思や体を直接いじって同意のない状態を作る仕組みで、個室につながるため。設計メモのラインナップからも落とした。
;
;能力6つ（居場所感知・ステータス開示・言葉を通す・呼び寄せる・記憶を覗く・いつでも眠る）と施術5つ、全部入っている（2026-09-14。いつでも眠るは 2026-10-15）

;================================ 見えるか ================================
;その能力を持っているか
@能力を持っているか(能力)
#FUNCTION
#DIM 能力

RETURNF 特殊能力:MASTER:能力 != 0


;その値が見えるか。主人公は自分のことなので段に関わらず全部見える（→画面イメージ「怪しい店」の見えるものの段）
@値が見えるか(番号, 要る段)
#FUNCTION
#DIM 番号
#DIM 要る段

SIF 番号 == MASTER
	RETURNF 1
RETURNF 開示の段 >= 要る段


;================================ 店 ================================
;起床前メニューの [104]（2026-09-14 ユーザ指定で店の外 303 から移した。施術が場所と無関係になったので、
;店を空けて外へ出る意味が無くなった）。増築・シフトと同じく一日の区切りなので、行動の時間は食わない
@怪しい店メニュー
#DIM 一言がまだ

一言がまだ = 1
DO
	PRINTL
	;起床前の画面なのでサイドの枠も出す（→一日.ERB「起床前のサイド」）
	CALL 起床前のサイド
	CALL 起床前の見出し
	;対応してくれる人がいることを一言、初めてなら説明も（→導入.ERB @施設対応の一言／@初めての場所。場所 303 を借りる）
	;枠（起床前のサイドの罫線）の中で出すよう、ここで一度だけ呼ぶ（2026-09-28 ユーザ指摘「枠外に出ているので、喋っているカンジがなかった」）
	IF 一言がまだ
		CALL 施設対応の一言(303)
		CALL 初めての場所(303)
		一言がまだ = 0
	ENDIF
	PRINTFORML 怪しい店　　所持金 %金額(MONEY:MASTER)%円
	PRINTL [1] 能力を買う
	PRINTL [2] 施術を受ける
	PRINTL [3] 店名を変える
	PRINTL [0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE

	SELECTCASE RESULT
		CASE 1
			CALL 能力を買う
		CASE 2
			CALL 施術を受ける
		CASE 3
			CALL 店名を変える
		CASE 0
			RETURN 0
	ENDSELECT
LOOP 1


;店の名前を変える（→導入.ERB @店名を決める。最初は無料、以後はここで都度払い）
@店名を変える
#DIMS 入力名

PRINTL
PRINTFORML 店の名前を変えますか（いま：%店名%）　所持金 %金額(MONEY:MASTER)%円　　値段 %金額(店名変更の値段)%円
IF MONEY:MASTER < 店名変更の値段
	PRINTL お金が足りない
	WAIT
	RETURN 0
ENDIF
PRINTL 新しい名前を決めてください（空のまま決定でやめる）
INPUTS
入力名 '= RESULTS
IF 入力名 == ""
	RETURN 0
ENDIF
MONEY:MASTER -= 店名変更の値段
今日の店の外:外_怪しい店 -= 店名変更の値段
店名 = %入力名%
PRINTFORML 店の名前を%店名%にした（%金額(店名変更の値段)%円）
WAIT


;能力の一覧。買ったものは「（買ってある）」、金が足りないものは番号を付けずに理由を出す（増築と同じ形）
@能力を買う
#DIM 甲
#DIM 選んだ

;サイドの枠つきで描く（店の画面と同じ位置から始め、サイドのタブを押したら描き直す。→一日.ERB「起床前のサイド」）
DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 何を買いますか（番号。[0] でやめる）　所持金 %金額(MONEY:MASTER)%円
	CALL 能力の行(1, 能力_居場所感知, "居場所感知", 居場所感知の値段, "店・寮・自宅に居る全員の居場所が分かり、そこへ移動できる")
	CALL 開示の行(2)
	CALL 能力の行(3, 能力_言葉を通す, "言葉を通す", 言葉を通すの値段, @"説得の成算が上がる（使うたび %金額(言葉を通すの使用料)%円）")
	CALL 能力の行(4, 能力_呼び寄せる, "呼び寄せる", 呼び寄せるの値段, @"店に居ない者を店へ来させる（使うたび %金額(呼び寄せるの使用料)%円）")
	CALL 能力の行(5, 能力_記憶を覗く, "記憶を覗く", 記憶を覗くの値段, "任せている間に誰と何があったかを、後から知る")
	CALL 能力の行(6, 能力_いつでも眠る, "いつでも眠る", いつでも眠るの値段, @"起きてから{就寝できる分 / 60}時間たたなくても就寝できる")
	PRINTL [0] やめる
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	BREAK
LOOP 1
選んだ = RESULT - 1

SELECTCASE 選んだ
	CASE 0
		SIF 能力を持っているか(能力_居場所感知) || MONEY:MASTER < 居場所感知の値段
			RETURN 0
		MONEY:MASTER -= 居場所感知の値段
		今日の店の外:外_怪しい店 -= 居場所感知の値段
		特殊能力:MASTER:(能力_居場所感知) = 1
		PRINTFORML 居場所感知を手に入れた（%金額(居場所感知の値段)%円）
		PRINTL 目を閉じると、店の中に居る者の気配がそれぞれの部屋に見えるようになった
		WAIT
	CASE 2
		SIF 能力を持っているか(能力_言葉を通す) || MONEY:MASTER < 言葉を通すの値段
			RETURN 0
		MONEY:MASTER -= 言葉を通すの値段
		今日の店の外:外_怪しい店 -= 言葉を通すの値段
		特殊能力:MASTER:(能力_言葉を通す) = 1
		PRINTFORML 言葉を通すを手に入れた（%金額(言葉を通すの値段)%円）
		PRINTL 口にした言葉が、相手の胸の奥まで届く感覚を覚えた
		WAIT
	CASE 3
		SIF 能力を持っているか(能力_呼び寄せる) || MONEY:MASTER < 呼び寄せるの値段
			RETURN 0
		MONEY:MASTER -= 呼び寄せるの値段
		今日の店の外:外_怪しい店 -= 呼び寄せるの値段
		特殊能力:MASTER:(能力_呼び寄せる) = 1
		PRINTFORML 呼び寄せるを手に入れた（%金額(呼び寄せるの値段)%円）
		PRINTL 思い浮かべた相手の足が、こちらへ向く。そんな手応えがあった
		WAIT
	CASE 4
		SIF 能力を持っているか(能力_記憶を覗く) || MONEY:MASTER < 記憶を覗くの値段
			RETURN 0
		MONEY:MASTER -= 記憶を覗くの値段
		今日の店の外:外_怪しい店 -= 記憶を覗くの値段
		特殊能力:MASTER:(能力_記憶を覗く) = 1
		PRINTFORML 記憶を覗くを手に入れた（%金額(記憶を覗くの値段)%円）
		PRINTL 相手の目を見ると、その人が過ごした時間が、こちらへ流れ込んでくるようになった
		WAIT
	CASE 5
		SIF 能力を持っているか(能力_いつでも眠る) || MONEY:MASTER < いつでも眠るの値段
			RETURN 0
		MONEY:MASTER -= いつでも眠るの値段
		今日の店の外:外_怪しい店 -= いつでも眠るの値段
		特殊能力:MASTER:(能力_いつでも眠る) = 1
		PRINTFORML いつでも眠るを手に入れた（%金額(いつでも眠るの値段)%円）
		PRINTL まぶたを閉じれば、時刻を選ばず深い眠りに落ちられるようになった
		WAIT
	CASE 1
		SIF 開示の段 >= 開示の段数 || MONEY:MASTER < 開示の値段(開示の段)
			RETURN 0
		MONEY:MASTER -= 開示の値段(開示の段)
		今日の店の外:外_怪しい店 -= 開示の値段(開示の段)
		開示の段 += 1
		PRINTFORML ステータス開示を手に入れた（%金額(開示の値段(開示の段 - 1))%円）
		PRINTFORML %開示の中身(開示の段)%が見えるようになった
		WAIT
ENDSELECT


;能力1行（買い切りのもの）
@能力の行(番号, 能力, 名前, 値段, 説明)
#DIM 番号
#DIM 能力
#DIMS 名前
#DIM 値段
#DIMS 説明

IF 能力を持っているか(能力)
	PRINTFORML 　　　 %名前, 16, LEFT%（買ってある）
ELSEIF MONEY:MASTER < 値段
	PRINTFORML 　　　 %名前, 16, LEFT%%金額(値段)%円（所持金が足りない）
ELSE
	PRINTFORML [{番号, 2}] %名前, 16, LEFT%%金額(値段, 8)%円　%説明%
ENDIF


;ステータス開示だけ段階制。次の段の値段と、その段で何が見えるかを出す
@開示の行(番号)
#DIM 番号

IF 開示の段 >= 開示の段数
	PRINTL 　　　 ステータス開示　（買ってある）
ELSEIF MONEY:MASTER < 開示の値段(開示の段)
	PRINTFORML 　　　 ステータス開示　%金額(開示の値段(開示の段))%円（所持金が足りない）
ELSE
	PRINTFORML [{番号, 2}] %"ステータス開示", 16, LEFT%%金額(開示の値段(開示の段), 8)%円　%開示の中身(開示の段 + 1)%が見えるようになる（いまは{開示の段}段目まで）
ENDIF


;段の値段（段0を買うと1段目になる）
@開示の値段(段)
#FUNCTION
#DIM 段

SIF 段 < 0 || 段 >= 開示の段数
	RETURNF 0
RETURNF 開示の値段表:段


;その段で見えるようになるもの
@開示の中身(段)
#FUNCTIONS
#DIM 段

SELECTCASE 段
	CASE 1
		RETURNF "技能とLv"
	CASE 2
		RETURNF "満足度"
	CASE 3
		RETURNF "好感度と素質"
	CASE 4
		RETURNF "キャラ同士の好感度"
ENDSELECT
RETURNF ""


;================================ 施術 ================================
;対象に一度だけ適用して終わり・都度払い（→設計メモ「主人公の能力」）。7つ全部入っている（体を変える・素質を付ける・技能を上げる・性別を変える・孕みやすさ・妊娠の可否・呼び方）。
;先に何をするか（施術の種類）を選び、その後で対象を選ぶ（2026-09-23 ユーザ指定「内容より先に対象を選ぶのは順番が違う」）。
;対象を選んだ直後にその人のいま（性別・体型・技能・素質・体質・妊娠）を出してから施す。同じ内容のまま、やめるまで別の対象に続けて施せる
@施術を受ける
#DIM 相手
#DIM 選んだ

DO
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 何を施しますか（番号。[0] でやめる）　所持金 %金額(MONEY:MASTER)%円
	PRINTFORML [ 1] %"体を変える", 16, LEFT%胸囲・胴囲・腰囲を変える（1cm あたり %金額(体を変えるの単価 * 10)%円）
	PRINTFORML [ 2] %"素質を付ける", 16, LEFT%口上タイプ・方言・好物・裏の好み・技能の伸び・体質・性癖を付ける／外す（一つ %金額(素質の施術の値段)%円）
	PRINTFORML [ 3] %"技能を上げる", 16, LEFT%目標の Lv まで上げる（1Lv あたり %金額(技能の施術の単価)%円）
	PRINTFORML [ 4] %"性別を変える", 16, LEFT%男・女・ふたなり・性別なし に張り替える（%金額(性別の施術の値段)%円）
	PRINTFORML [ 5] %"孕みやすさ", 16, LEFT%受精のしやすさを変える（1％あたり%金額(孕みやすさの施術の単価)%円）
	PRINTFORML [ 6] %"妊娠の可否", 16, LEFT%孕む体・孕まない体にする（%金額(妊娠の可否の施術の値段)%円）
	PRINTFORML [ 7] %"呼び方", 16, LEFT%口上の中の一人称・二人称を変える（変えるたびに %金額(呼び方の施術の値段)%円）
	PRINTFORML [ 0] やめる
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	選んだ = RESULT - 1
	SIF 選んだ < 0 || 選んだ > 6
		RETURN 0

	DO
		CALL 施術の相手を選ぶ
		相手 = RESULT
		SIF 相手 < 0
			BREAK
		CALL 起床前のサイド
		CALL 起床前の見出し
		CALL 施術の様子(相手)
		SELECTCASE 選んだ
			CASE 0
				CALL 体を変える(相手)
			CASE 1
				CALL 素質を付ける(相手)
			CASE 2
				CALL 技能を上げる(相手)
			CASE 3
				CALL 性別を変える(相手)
			CASE 4
				CALL 孕みやすさを変える(相手)
			CASE 5
				CALL 妊娠の可否を変える(相手)
			CASE 6
				CALL 呼び方を選ぶ(相手, 呼び方の施術の値段)
		ENDSELECT
	LOOP 1
LOOP 1


;その人のいま。施術で変わるものだけ（性別・妊娠・体型・体質・技能・素質）。居場所は出さない（居場所感知を買っていない者に漏れる）。
;店が診るので開示の段は見ない（技能・素質の「いま」は各施術の一覧にも出ている）。妊娠は主人公が気づいているときだけ
@施術の様子(番号)
#DIM 番号
#DIMS 出力
#DIM 体質

PRINTL 
;サイドを横切らない本文幅の罫線
CALL 本文罫線
IF 番号 == MASTER
	出力 '= "<font color='#ffcc44'>■あなた</font>"
ELSE
	出力 '= "<font color='#ffcc44'>■" + CALLNAME:番号 + 立場のタグ(番号) + "</font>"
ENDIF
出力 += @"　%性別名(番号)%"
SELECTCASE 妊娠の確度(番号, MASTER)
	CASE 2
		出力 += @"　妊娠{妊娠日数:番号:0}日目（%腹段階の名(腹段階(番号))%）"
	CASE 1
		出力 += "　妊娠の疑い"
ENDSELECT
体質 = 0
SIF TALENT:番号:妊娠する && !TALENT:番号:妊娠しない
	体質 = 1
SIF TALENT:番号:妊娠しない && !TALENT:番号:妊娠する
	体質 = 2
IF 妊娠する体か(番号)
	出力 += @"　　体質：%体質の名(体質)%（孕む体・受精しやすさ{受精しやすさ倍率(番号)}％）"
ELSE
	出力 += @"　　体質：%体質の名(体質)%（孕まない体・受精しやすさ{受精しやすさ倍率(番号)}％）"
ENDIF
HTML_PRINT 出力
PRINTL 
出力 '= @"　B/W/H {胸囲:番号:0 / 10}.{胸囲:番号:0 % 10}cm"
SIF 性別ビット(番号) & 6
	出力 += @"(%カップ(番号)%)"
出力 += @" / {胴囲:番号:0 / 10}.{胴囲:番号:0 % 10}cm / {腰囲:番号:0 / 10}.{腰囲:番号:0 % 10}cm"
出力 += @"<br>　%体格の行(番号)%"
HTML_PRINT 出力
PRINTL 
CALL 能力表示_節("技能", 能力表示_技能(番号))
CALL 能力表示_節("素質", 能力表示_素質(番号))


;目標値を入れて、いまとの差 × 単価を払う。増やすのも減らすのも同じ扱い
@体を変える(相手)
#DIM 相手
#DIM 部位
#DIM 今
#DIM 先
#DIM 代金
#DIMS 前の段

PRINTL
PRINTFORML %CALLNAME:相手%のどこを変えますか（番号。[0] でやめる）
FOR 部位, 0, 3
	PRINTFORML [{部位 + 1, 2}] %体型の名:部位, 8, LEFT%いま {体型を読む(相手, 部位) / 10}.{体型を読む(相手, 部位) % 10}cm
NEXT
PRINTL [0] やめる
INPUT
部位 = RESULT - 1
SIF 部位 < 0 || 部位 > 2
	RETURN 0

今 = 体型を読む(相手, 部位)
CALL 体型の入力(今)
先 = RESULT
SIF 先 == 今
	RETURN 0
代金 = ABS(先 - 今) * 体を変えるの単価
IF MONEY:MASTER < 代金
	PRINTFORML %金額(代金)%円かかる。金が足りない
	WAIT
	RETURN 0
ENDIF
MONEY:MASTER -= 代金
今日の店の外:外_怪しい店 -= 代金
前の段 '= 体格の行(相手)
CALL 体型を書く(相手, 部位, 先)
PRINTFORML %CALLNAME:相手%の%体型の名:部位%を {今 / 10}.{今 % 10}cm から {先 / 10}.{先 % 10}cm にした（%金額(代金)%円）
;段が動いたら知らせる（→ERB/体格.ERB）
SIF 前の段 != 体格の行(相手)
	PRINTFORML 　体格が変わった：%体格の行(相手)%
WAIT


;施術の相手。主人公と、登録されている者全員（→設計メモ「施術は他人にも適用できる。同意は要らない」）。
;**その場に居なくても選べる**（金を払えば店の側が手配する扱い。2026-09-14 ユーザ指定）。4人ずつ折り返す。選ばなければ -1。
;居場所はここには出さない（買っていない者に居場所が漏れる → 居場所感知）
;表示だけ+1にずらして [0] をやめる専用に空ける（2026-09-23 ユーザ指定「マウス操作のみで戻れない画面を解消」。RESULT-1 で元の意味（0=あなた自身）に戻す）
@施術の相手を選ぶ
#DIM 番号
#DIM 数
#DIM 選んだ

;サイドの枠つきで描く（→一日.ERB「起床前のサイド」）
DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTL 誰に施しますか（キャラ番号。[0] でやめる）
	PRINTFORM [  0] %埋める("やめる", 10)%
	;名前だけでは誰が誰か分からないので、性別・立場・あなたへの好感度の段を添える（2026-09-22 ユーザ指定「判断材料となる情報を画面に表示」）
	PRINTFORM [  1] %埋める(CALLNAME:MASTER, 10)%%埋める(性別名(MASTER), 10)%%埋める("あなた", 13)%
	数 = 2
	FOR 番号, 1, キャラ枠
		SIF !実キャラ:番号:0
			CONTINUE
		SIF 数 % 3 == 0
			PRINTL
		PRINTFORM [{番号 + 1, 3}] %埋める(CALLNAME:番号, 10)%%埋める(性別名(番号), 10)%
		IF スタッフ:番号:0
			PRINTFORM %埋める("スタッフ", 8)%
		ELSE
			PRINTFORM %埋める("客", 8)%
		ENDIF
		PRINTFORM %埋める(@"{好感度の段(好感度_友情:番号:0)}段", 5)%
		数 += 1
	NEXT
	PRINTL
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	BREAK
LOOP 1
選んだ = RESULT - 1
SIF 選んだ == 0
	RETURN MASTER
SIF 選んだ < 0 || 選んだ >= キャラ枠 || !実キャラ:(選んだ):0
	RETURN -1
RETURN 選んだ


;部位のいまの値（0.1cm 単位）。部位 0=胸囲 1=胴囲 2=腰囲
@体型を読む(番号, 部位)
#FUNCTION
#DIM 番号
#DIM 部位

SELECTCASE 部位
	CASE 0
		RETURNF 胸囲:番号:0
	CASE 1
		RETURNF 胴囲:番号:0
ENDSELECT
RETURNF 腰囲:番号:0


;書き換え。回復目標_*（妊娠中は妊娠前サイズ、産後は回復目標）も同じだけ動かす。
;動かさないと、出産後の体型の回復で施術の前のサイズへ戻ってしまう（→妊娠.ERB「体型の回復」）
@体型を書く(番号, 部位, 値)
#DIM 番号
#DIM 部位
#DIM 値
#DIM 差

差 = 値 - 体型を読む(番号, 部位)
SELECTCASE 部位
	CASE 0
		胸囲:番号:0 = 値
		SIF 回復目標_胸囲:番号:0 > 0
			回復目標_胸囲:番号:0 += 差
	CASE 1
		胴囲:番号:0 = 値
		SIF 回復目標_胴囲:番号:0 > 0
			回復目標_胴囲:番号:0 += 差
	CASEELSE
		腰囲:番号:0 = 値
		SIF 回復目標_腰囲:番号:0 > 0
			回復目標_腰囲:番号:0 += 差
ENDSELECT
;体格の段も引き直す（胸→バスト、胴→体型と下半身、腰→下半身。→ERB/体格.ERB）
SELECTCASE 部位
	CASE 0
		CALL 体格の段を引き直す(番号, 体格_バスト)
	CASE 1
		CALL 体格の段を引き直す(番号, 体格_体型 + 体格_下半身)
	CASEELSE
		CALL 体格の段を引き直す(番号, 体格_下半身)
ENDSELECT


;何cmにするか。0.1cm 単位の整数で返す。やめたときは今の値のまま
;マウスだけで打てる数値パッドに直した（2026-09-23 ユーザ指定。→マップ/共通.ERB @数値パッド）
@体型の入力(今)
#DIM 今

CALL 数値パッド("何cmにしますか", 体型の下限, 体型の上限, 今, 10, 今, 1)
RETURN RESULT


;================================ 素質を付ける／外す ================================
;付いていないものを選べば付け、付いているものを選べば外す（2026-09-14 ユーザ指定。設計メモの「足す」に外すを足した）。
;番号は Talent.csv の素質番号そのまま。出すのは 口上タイプ（名前が 口上_ で始まるもの。排他なので付けると今のものは消える）と
;好物・下戸（好物素質の始め〜終わり）。性別と妊娠可否は別の施術、中出し癖は同意をさせる素質なので出さない（→画面イメージ「怪しい店」）
;体質（体質素質の始め〜終わり。敏感／鈍感・痛み・恥・濡れ・快感・絶倫・酒豪・回復・母乳体質）も出す（2026-09-22 ユーザ指定「出す」）。
;性癖（性癖素質の始め〜終わり。羞恥好き・被虐・加虐・拘束好き・口好き・胸好き・尻好き・母乳好き。重ねてよい。2026-10-04）も出す。
;対になるもの（M敏感↔M鈍感、痛みに強い↔弱い…）は片方を付けるともう片方が外れる（@体質の相方）。体型の入口（小柄・巨乳など 140〜）は数値の側なので「体を変える」のまま出さない
@素質を付ける(相手)
#DIM 相手
#DIM 素質
#DIM 他

PRINTL
PRINTFORML %CALLNAME:相手%の素質（番号。付いていないものは付け、付いているものは外す。[0] でやめる）　一つ %金額(素質の施術の値段)%円　所持金 %金額(MONEY:MASTER)%円
PRINTL 　口上タイプ（一つだけ。付けると今のものと入れ替わる）
CALL 素質の並び(相手, 1)
PRINTL 　好物
CALL 素質の並び(相手, 0)
PRINTL 　裏の好み（客として何を指名しやすいか）
CALL 素質の並び(相手, 2)
PRINTL 　技能の伸び（才と苦手は同じ技能で重ねない。付けると相方は外れる）
CALL 素質の並び(相手, 3)
PRINTL 　体質（敏感と鈍感、強いと弱い は対。付けると相方は外れる）
CALL 素質の並び(相手, 4)
PRINTL 　方言（口上の言葉づかい。一つだけ。付けると今のものと入れ替わる。外せば標準語）
CALL 素質の並び(相手, 5)
PRINTL 　性癖（当たる行為で快感・欲情が増え、おねだりや客の指名にも出る。重ねてよい）
CALL 素質の並び(相手, 6)
INPUT
素質 = RESULT
SIF !施術できる素質か(素質)
	RETURN 0
;一覧に出ていない素質（性別に無いもの）は番号を打っても付けない
SIF !TALENT:相手:素質 && !(素質の許す性別(素質) & 性別ビット(相手))
	RETURN 0
IF MONEY:MASTER < 素質の施術の値段
	PRINTFORML %金額(素質の施術の値段)%円かかる。金が足りない
	WAIT
	RETURN 0
ENDIF
MONEY:MASTER -= 素質の施術の値段
今日の店の外:外_怪しい店 -= 素質の施術の値段
IF TALENT:相手:素質
	TALENT:相手:素質 = 0
	;母乳体質を外したら量は 0 に戻す（→妊娠.ERB @母乳の日替わり と同じ）
	IF 素質 == GETNUM(TALENT, "母乳体質")
		BASE:相手:母乳 = 0
		母乳_出産由来:相手:0 = 0
	ENDIF
	PRINTFORML %CALLNAME:相手%の %施術の素質の名(素質)% を外した（%金額(素質の施術の値段)%円）
ELSE
	IF 口上タイプの素質か(素質)
		FOR 他, 0, 100
			SIF 口上タイプの素質か(他)
				TALENT:相手:他 = 0
		NEXT
	ENDIF
	;方言も排他（一つだけ。2026-10-01）
	IF 方言の素質か(素質)
		FOR 他, 方言素質の始め, 方言素質の終わり + 1
			SIF 方言の素質か(他)
				TALENT:相手:他 = 0
		NEXT
	ENDIF
	;技能の伸びは相方（器用↔不器用、〜の才↔〜が苦手）と両立しないので外す。体質の対も同じ
	他 = 伸びの相方(素質)
	SIF 他 < 0
		他 = 体質の相方(素質)
	SIF 他 >= 0
		TALENT:相手:他 = 0
	TALENT:相手:素質 = 1
	;施術で付けた母乳体質は元から持っていた者と同じ扱い（授乳期間で外れない）。量の上限も入れておく
	IF 素質 == GETNUM(TALENT, "母乳体質")
		母乳_出産由来:相手:0 = 0
		SIF MAXBASE:相手:母乳 <= 0
			MAXBASE:相手:母乳 = 母乳の上限
	ENDIF
	PRINTFORML %CALLNAME:相手%に %施術の素質の名(素質)% を付けた（%金額(素質の施術の値段)%円）
ENDIF
WAIT


;一覧の一段。組=1 で口上タイプ、0 で好物、2 で裏の好み、3 で技能の伸び、4 で体質、5 で方言、6 で性癖。4つずつ折り返し、付いているものは色を変える（付いている色）
@素質の並び(番号, 組)
#DIM 番号
#DIM 組
#DIM 素質
#DIM 数

数 = 0
PRINTS "　"
FOR 素質, 0, 性癖素質の終わり + 1
	SIF !施術できる素質か(素質) || 素質の組(素質) != 組
		CONTINUE
	;濡れ系は膣のある性別だけ。性別を変えた後に残ったものは外せるよう、付いていれば出す
	SIF !TALENT:番号:素質 && !(素質の許す性別(素質) & 性別ビット(番号))
		CONTINUE
	CALL 選択肢を並べる(数, 素質, 施術の素質の名(素質), TALENT:番号:素質, 4, "　")
	数 += 1
NEXT
PRINTL 


;この施術で付け外しできる素質か（組が -1 でないもの）
@施術できる素質か(素質)
#FUNCTION
#DIM 素質

RETURNF 素質の組(素質) >= 0


;素質の組。1=口上タイプ 0=好物 2=裏の好み 3=技能の伸び 4=体質（100〜139。体型の入口 140〜 は出さない） 5=方言（160〜169） 6=性癖（180〜189）、対象外は -1
@素質の組(素質)
#FUNCTION
#DIM 素質

SIF 方言の素質か(素質)
	RETURNF 5
SIF 性癖の素質か(素質)
	RETURNF 6
SIF 素質 < 0 || 素質 > 体質素質の終わり
	RETURNF -1
SIF TALENTNAME:素質 == ""
	RETURNF -1
SIF 素質 >= 体質素質の始め
	RETURNF 4
SIF 口上タイプの素質か(素質)
	RETURNF 1
SIF 素質 >= 好物素質の始め && 素質 <= 好物素質の終わり
	RETURNF 0
SIF 素質 >= 裏の好み素質の始め && 素質 <= 裏の好み素質の終わり
	RETURNF 2
SIF 素質 >= 伸び素質の始め && 素質 <= 伸び素質の終わり
	RETURNF 3
RETURNF -1


;技能の伸びの素質の相方。器用↔不器用、「Xの才」↔「Xが苦手」。無ければ -1
@伸びの相方(素質)
#FUNCTION
#DIM 素質
#DIMS 名

SIF 素質の組(素質) != 3
	RETURNF -1
名 '= TALENTNAME:素質
SIF 名 == "器用"
	RETURNF GETNUM(TALENT, "不器用")
SIF 名 == "不器用"
	RETURNF GETNUM(TALENT, "器用")
SIF STRLENSU(名) > 2 && SUBSTRINGU(名, STRLENSU(名) - 2, 2) == "の才"
	RETURNF GETNUM(TALENT, SUBSTRINGU(名, 0, STRLENSU(名) - 2) + "が苦手")
SIF STRLENSU(名) > 3 && SUBSTRINGU(名, STRLENSU(名) - 3, 3) == "が苦手"
	RETURNF GETNUM(TALENT, SUBSTRINGU(名, 0, STRLENSU(名) - 3) + "の才")
RETURNF -1


;体質の相方。M〜P 敏感（100〜105）↔ 鈍感（110〜115）、痛みに強い↔弱い（120/121）、恥じらい↔恥薄い（122/123）、
;濡れやすい↔濡れにくい（124/125）、快感に素直↔快感の否定（126/127）、回復早い↔回復遅い（132/133）。絶倫・酒豪・母乳体質・潮吹き体質は相方なし
@体質の相方(素質)
#FUNCTION
#DIM 素質

SIF 素質 >= 100 && 素質 <= 105
	RETURNF 素質 + 10
SIF 素質 >= 110 && 素質 <= 115
	RETURNF 素質 - 10
SIF (素質 >= 120 && 素質 <= 127) || 素質 == 132 || 素質 == 133
	RETURNF 素質 ^ 1
RETURNF -1


;口上タイプの素質か（名前が 口上_ で始まる。→個室.ERB @口上タイプ）
@口上タイプの素質か(素質)
#FUNCTION
#DIM 素質

SIF 素質 < 0 || 素質 >= 100 || TALENTNAME:素質 == ""
	RETURNF 0
RETURNF STRFIND(TALENTNAME:素質, "口上_") == 0


;一覧に出す名前。口上タイプは「口上_」、方言は「方言_」を外す
@施術の素質の名(素質)
#FUNCTIONS
#DIM 素質

SIF 口上タイプの素質か(素質) || 方言の素質か(素質)
	RETURNF SUBSTRINGU(TALENTNAME:素質, 3, -1)
RETURNF TALENTNAME:素質


;================================ 技能を上げる ================================
;目標の Lv を入れ、(先 − 今) × 単価を払う（体を変える と同じ形。上げる方向だけ）。番号は技能番号（Abl.csv）そのまま。
;EXP も 先 × 技能の一段 に揃える（次の Lv までのバーが 0 から。→行動.ERB @経験を積む、SYSTEM.ERB @経験を揃える）
@技能を上げる(相手)
#DIM 相手
#DIM 技能
#DIM 今
#DIM 先
#DIM 代金
#DIMS セル

PRINTL
PRINTFORML %CALLNAME:相手%のどれを上げますか（番号。[0] でやめる）　1Lv あたり %金額(技能の施術の単価)%円　所持金 %金額(MONEY:MASTER)%円
FOR 技能, 0, 技能数
	SIF 技能 > 0 && 技能 % 4 == 0
		PRINTL
	;上限のものは番号なし。幅を揃えるためにセルを一つの文字列にしてから出す
	IF ABL:相手:技能 >= 技能Lv上限
		セル '= @"　　　 %ABLNAME:技能, 8, LEFT%いま Lv{ABL:相手:技能}（上限）"
	ELSE
		セル '= @"[{技能 + 1, 2}] %ABLNAME:技能, 8, LEFT%いま Lv{ABL:相手:技能}"
	ENDIF
	PRINTFORM %セル, 32, LEFT%
NEXT
PRINTL
PRINTL [0] やめる
INPUT
技能 = RESULT - 1
SIF 技能 < 0 || 技能 >= 技能数 || ABL:相手:技能 >= 技能Lv上限
	RETURN 0

今 = ABL:相手:技能
;マウスだけで打てる数値パッドに直した（2026-09-23 ユーザ指定。→マップ/共通.ERB @数値パッド）
CALL 数値パッド(@"%CALLNAME:相手%を何Lvにしますか（いまは Lv{今}）", 今 + 1, 技能Lv上限, 今 + 1, 1, 今, 1)
先 = RESULT
SIF 先 <= 今 || 先 > 技能Lv上限
	RETURN 0
代金 = (先 - 今) * 技能の施術の単価
IF MONEY:MASTER < 代金
	PRINTFORML %金額(代金)%円かかる。金が足りない
	WAIT
	RETURN 0
ENDIF
MONEY:MASTER -= 代金
今日の店の外:外_怪しい店 -= 代金
ABL:相手:技能 = 先
EXP:相手:技能 = 先 * 技能の一段
PRINTFORML %CALLNAME:相手%の%ABLNAME:技能%を Lv{今} から Lv{先} にした（%金額(代金)%円）
WAIT


