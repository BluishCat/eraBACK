;暦（月・日。→画面イメージ「暦」）
;月日は持たずに計算で出す。持つのは 開始月（1日目の月。1日目は必ずその月の1日）だけ。経過日数から割り出すので、日替わりに処理は増えない。
;月の日数は実際のとおり（閏年なし）。年は数えない。曜日は今までどおり（暦とは連動しない）


;1日目の月。古いセーブ（入っていない＝0）は4月始まりとして読む
@開始の月
#FUNCTION

SIF 開始月 < 1 || 開始月 > 12
	RETURNF 4
RETURNF 開始月


@月の日数(月)
#FUNCTION
#DIM 月

SELECTCASE 月
	CASE 2
		RETURNF 28
	CASE 4, 6, 9, 11
		RETURNF 30
ENDSELECT
RETURNF 31


;経過日数が 日数 の日の月（1〜12）。日数は 0 が1日目
@暦の月(日数)
#FUNCTION
#DIM 日数
#DIM 月
#DIM 残り

月 = 開始の月()
残り = 日数
WHILE 残り >= 月の日数(月)
	残り -= 月の日数(月)
	月 = 月 % 12 + 1
WEND
RETURNF 月


;その日の日（1〜31）
@暦の日(日数)
#FUNCTION
#DIM 日数
#DIM 月
#DIM 残り

月 = 開始の月()
残り = 日数
WHILE 残り >= 月の日数(月)
	残り -= 月の日数(月)
	月 = 月 % 12 + 1
WEND
RETURNF 残り + 1


;季節の番号（0＝春 3〜5月／1＝夏 6〜8月／2＝秋 9〜11月／3＝冬 12〜2月）
@暦の季節(日数)
#FUNCTION
#DIM 日数
#DIM 月

月 = 暦の月(日数)
SIF 月 >= 3 && 月 <= 5
	RETURNF 0
SIF 月 >= 6 && 月 <= 8
	RETURNF 1
SIF 月 >= 9 && 月 <= 11
	RETURNF 2
RETURNF 3


@季節名(番号)
#FUNCTIONS
#DIM 番号

SELECTCASE 番号
	CASE 0
		RETURNF "春"
	CASE 1
		RETURNF "夏"
	CASE 2
		RETURNF "秋"
ENDSELECT
RETURNF "冬"


;「4月12日（月）」。曜日はその日の曜日の番号で渡す（日数から割り出さない。強制就寝で曜日が先に進むことがあるので呼ぶ側の持っている値を使う）
@日付の文(日数, 曜日番号)
#FUNCTIONS
#DIM 日数
#DIM 曜日番号

RETURNF @"{暦の月(日数)}月{暦の日(日数)}日（%曜日名(曜日番号)%）"


;表の行用の短い形「4/12（月）」
@日付の短文(日数, 曜日番号)
#FUNCTIONS
#DIM 日数
#DIM 曜日番号

RETURNF @"{暦の月(日数)}/{暦の日(日数)}（%曜日名(曜日番号)%）"
