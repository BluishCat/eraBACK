;能力表示の [1047]／起床前の [106]・[108] の「服装を変える」（スタッフか主人公）。
;eraTOWN（eraJK-master）の @CHANGE_CLOTHES と同じ「枠の一覧」（2026-09-23 ユーザ指定「eraTOWN のように部位ごとに設定できるように」→画面イメージ「着替え」の部位ごと）。
;組（一式）が既定で、部位ごとの指定（CSTR 8〜12、17・18 着せた上の服〜着せた小物、着せた靴下・靴）がその上書き。選べるのは棚にある組に入っている衣類だけ。
;枠の一覧は [1]〜[6] 上の服／下の服／上の下着／下の下着／靴下／靴、[7] 小物（2026-10-16 靴下・靴を足した。小物は [5] から [7] に移った）
@服装を変える(番号)
#DIM 番号
#DIM 枠
#DIMS 名

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 服装を変える（%CALLNAME:番号%　いま：%着ている組の名(番号)%%着せられ方の文(番号)%）　容姿 %容姿の文(番号)%　露出度 {露出度(番号)}
	PRINTFORML 　%着ているものの文(番号)%
	PRINTL
	FOR 枠, 0, 服の枠数
		名 '= 着ている名(番号, 枠)
		SIF 名 == ""
			名 '= "なし"
		PRINTFORML 　[{枠 + 1}] %埋める(服の名:枠, 12)%%埋める(名, 24)%%部位ごとの印(番号, 枠)%
	NEXT
	名 '= 小物の名(番号)
	SIF 名 == ""
		名 '= "なし"
	PRINTFORML 　[{服の枠数 + 1}] %埋める("小物", 12)%%埋める(名, 24)%%部位ごとの印(番号, 服の枠数)%
	PRINTL
	PRINTL 　[8] 一式で着替える　　[9] 元に戻す　　[0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	SELECTCASE RESULT
		CASE 1 TO 服の枠数
			CALL 部位を選ぶ(番号, RESULT - 1)
		CASE 服の枠数 + 1
			CALL 小物を選ぶ(番号)
		CASE 8
			CALL 一式で着替える(番号)
		CASE 9
			CALL 元の服に戻す(番号)
		CASE 0
			RETURN 0
	ENDSELECT
LOOP 1

;枠の行に添える印。その枠に部位ごとの指定があれば「（指定）」（枠＝服の枠数 は小物）
@部位ごとの印(番号, 枠)
#FUNCTIONS
#DIM 番号
#DIM 枠

SIF CSTR:番号:(着せた欄(枠)) == ""
	RETURNF ""
RETURNF "（指定）"

;一覧に添える衣類の点。「容姿   5　露出  10」。上下一体なら添える
@衣類の点の文(名)
#FUNCTIONS
#DIMS 名
#DIM 甲
#DIMS 出力

甲 = 衣類の番号(名)
SIF 甲 < 0
	RETURNF ""
出力 '= @"容姿 {衣類の容姿:甲, 4}　露出 {衣類の露出:甲 + 衣類の密着:甲, 4}"
SIF 衣類の枠:甲 == 枠_上下一体 || 衣類の枠:甲 == 枠_上下一体の下着
	出力 += "　（上下一体）"
RETURNF 出力

;その衣類（衣類.csv の名前）が、CSTR の枠（服_上〜服_靴）に着せられる種類か。上下一体は服_上、上下一体の下着は服_上の下着に入る（衣装.csv の規約と同じ畳み方）
@衣類がその枠に合うか(衣類番号, 枠)
#FUNCTION
#DIM 衣類番号
#DIM 枠
#DIM 種

種 = 衣類の枠:衣類番号
SELECTCASE 枠
	CASE 服_上
		RETURNF 種 == 枠_上の服 || 種 == 枠_上下一体
	CASE 服_下
		RETURNF 種 == 枠_スカート || 種 == 枠_ズボン
	CASE 服_上の下着
		RETURNF 種 == 枠_ブラ || 種 == 枠_上下一体の下着
	CASE 服_下の下着
		RETURNF 種 == 枠_パンツ
	CASE 服_靴下
		RETURNF 種 == 枠_靴下
	CASE 服_靴
		RETURNF 種 == 枠_靴
ENDSELECT
RETURNF 0

;棚にある組に入っている衣類、および部位ごとにバラ買いして棚に直接ある衣類を、その枠（服_上〜服_靴）のぶんだけ重複なく 衣類の候補 に並べる。RESULT＝数
;上下一体は上の枠に入っている（組の 下の服 は空なので下の枠には出ない）。バラ買いの衣類は性別を問わない（衣類.csv に性別は無い）
@棚の衣類を集める(番号, 枠)
#DIM 番号
#DIM 枠
#DIM 甲
#DIM 乙
#DIM 数
#DIM 側
#DIMS 名

側 = 衣装の性別の側(番号)
数 = 0
FOR 甲, 0, 衣装数
	SIF 衣装の性別:甲 != 側 && 衣装の性別:甲 != 衣装性別_どちらも
		CONTINUE
	SIF !棚にあるか(衣装名:甲)
		CONTINUE
	名 '= 衣装の枠:甲:枠
	SIF 名 == ""
		CONTINUE
	乙 = 0
	WHILE 乙 < 数 && 衣類の候補:乙 != 名
		乙 += 1
	WEND
	SIF 乙 < 数
		CONTINUE
	衣類の候補:数 = %名%
	数 += 1
NEXT
FOR 甲, 0, 衣類数
	SIF !衣類がその枠に合うか(甲, 枠)
		CONTINUE
	SIF !衣類が棚にあるか(衣類名:甲)
		CONTINUE
	乙 = 0
	WHILE 乙 < 数 && 衣類の候補:乙 != 衣類名:甲
		乙 += 1
	WEND
	SIF 乙 < 数
		CONTINUE
	衣類の候補:数 = %衣類名:甲%
	数 += 1
NEXT
RETURN 数

;棚にある組に入っている小物、および部位ごとにバラ買いして棚に直接ある小物を重複なく 小物の候補 に並べる（組の小物は ・ 区切り）。RESULT＝数
@棚の小物を集める(番号)
#DIM 番号
#DIM 甲
#DIM 乙
#DIM 丙
#DIM 数
#DIM 側
#DIM 個数
#DIMS 名
#DIMS 分けた, 16

側 = 衣装の性別の側(番号)
数 = 0
FOR 甲, 0, 衣装数
	SIF 衣装の性別:甲 != 側 && 衣装の性別:甲 != 衣装性別_どちらも
		CONTINUE
	SIF !棚にあるか(衣装名:甲)
		CONTINUE
	名 '= 衣装の小物:甲
	SIF 名 == ""
		CONTINUE
	SPLIT 名, "・", 分けた
	個数 = RESULT
	FOR 丙, 0, 個数
		乙 = 0
		WHILE 乙 < 数 && 小物の候補:乙 != 分けた:丙
			乙 += 1
		WEND
		SIF 乙 < 数
			CONTINUE
		小物の候補:数 = %分けた:丙%
		数 += 1
	NEXT
NEXT
FOR 甲, 0, 衣類数
	SIF 衣類の枠:甲 != 枠_小物
		CONTINUE
	SIF !衣類が棚にあるか(衣類名:甲)
		CONTINUE
	乙 = 0
	WHILE 乙 < 数 && 小物の候補:乙 != 衣類名:甲
		乙 += 1
	WEND
	SIF 乙 < 数
		CONTINUE
	小物の候補:数 = %衣類名:甲%
	数 += 1
NEXT
RETURN 数

;[1]〜[6]。その枠に着せるものを棚の衣類から選ぶ。脱ぐ＝その枠を無しに、組のまま＝指定を消す
;項目が多くて見切れるので 衣類一覧の一段 件ごとにページを分ける（[922] 前のページ／[923] 次のページ）
@部位を選ぶ(番号, 枠)
#DIM 番号
#DIM 枠
#DIM 甲
#DIM 数
#DIM 総ページ
#DIM ページ
#DIM 開始
#DIM 終了
#DIMS 名

CALL 棚の衣類を集める(番号, 枠)
数 = RESULT
名 '= 着ている名(番号, 枠)
SIF 名 == ""
	名 '= "なし"
IF 数 == 0
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML %服の名:枠%（%CALLNAME:番号%　いま：%名%）
	PRINTL 　棚にこの枠の衣類が無い（ショップの［日常］の [1019] 衣装を買う で増える）
	CALL 起床前のサイドの下
	WAIT
	RETURN 0
ENDIF
総ページ = (数 - 1) / 衣類一覧の一段 + 1
ページ = 0
DO
	開始 = ページ * 衣類一覧の一段
	終了 = 開始 + 衣類一覧の一段
	SIF 終了 > 数
		終了 = 数
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML %服の名:枠%（%CALLNAME:番号%　いま：%名%）　（{ページ + 1}／{総ページ}ページ）
	FOR 甲, 開始, 終了
		PRINTFORML 　[{甲 + 1, 2}] %埋める(衣類の候補:甲, 24)%%衣類の点の文(衣類の候補:甲)%
	NEXT
	PRINTL
	SIF ページ > 0
		PRINTFORML [{衣類一覧の前のページ}] 前のページ
	SIF ページ < 総ページ - 1
		PRINTFORML [{衣類一覧の次のページ}] 次のページ
	PRINTFORML 　[{衣類を脱ぐ}] 脱ぐ　　[{衣類を組のまま}] 組のまま　　[0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	IF RESULT == 衣類一覧の前のページ && ページ > 0
		ページ -= 1
		CONTINUE
	ELSEIF RESULT == 衣類一覧の次のページ && ページ < 総ページ - 1
		ページ += 1
		CONTINUE
	ELSEIF RESULT == 0
		RETURN 0
	ELSEIF RESULT == 衣類を脱ぐ
		名 '= "-"
	ELSEIF RESULT == 衣類を組のまま
		名 '= ""
	ELSEIF RESULT >= 1 && RESULT <= 数
		名 '= 衣類の候補:(RESULT - 1)
	ELSE
		RETURN 0
	ENDIF
	CALL 部位を着せる(番号, 枠, 名)
	RETURN 0
LOOP 1

;その枠に 名 を指定する（"" は組のまま、"-" は脱ぐ）。上下一体を畳み、露出が上がるなら同意を見る
@部位を着せる(番号, 枠, 名)
#DIM 番号
#DIM 枠
#DIMS 名
#DIM 甲
#DIM 前の露出
#DIMS 前, 7

前の露出 = 着たときの露出度(番号)
CALL 着替え前を控える(番号)
;同意が通らなかったときに戻すため、部位ごとの指定を全部（6枠＋小物）控える
FOR 甲, 0, 服の枠数 + 1
	前:甲 = %CSTR:番号:(着せた欄(甲))%
NEXT
;上下一体の畳み（eraTOWN の @CHANGE_CLOTHES と同じ）。上に一体を着たら下の指定は消し、下を指定するとき上が一体なら上は脱ぐ。
;[9] 組のまま（名 が ""）は指定を外すだけなので畳まない。靴下・靴は上下一体と関わらない
IF 名 != "" && 枠 < 4
	IF 枠 == 服_上 || 枠 == 服_上の下着
		SIF 衣類の枠か(名, 枠_上下一体) || 衣類の枠か(名, 枠_上下一体の下着)
			CSTR:番号:(着せた欄(枠 + 1)) '= ""
	ELSEIF 衣類の枠か(着ている名(番号, 枠 - 1), 枠_上下一体) || 衣類の枠か(着ている名(番号, 枠 - 1), 枠_上下一体の下着)
		CSTR:番号:(着せた欄(枠 - 1)) '= "-"
	ENDIF
ENDIF
CSTR:番号:(着せた欄(枠)) = %名%
;同意（→画面イメージ「着替え」）。露出が上がって 着せるのに同意の要る露出 を超えるなら体の段が要る。主人公は判定なし
IF 番号 != MASTER && 着たときの露出度(番号) >= 着せるのに同意の要る露出 && 着たときの露出度(番号) > 前の露出
	IF 好感度の段(好感度_体:番号:0) < 着せるのに要る体の段
		FOR 甲, 0, 服の枠数 + 1
			CSTR:番号:(着せた欄(甲)) = %前:甲%
		NEXT
		PRINTFORML %CALLNAME:番号%は首を振った
		CALL 着替えの口上(番号, 2)
		WAIT
		RETURN 0
	ENDIF
ENDIF
;個室の中なら服の状態も合わせる（その枠は名前が同じでも着る）
CALL 個室の服を合わせる(番号, 枠)
IF 番号 == MASTER
	IF 名 == "-"
		PRINTFORML %服の名:枠%を脱いだ
	ELSEIF 名 == ""
		PRINTFORML %服の名:枠%を組のままに戻した
	ELSE
		PRINTFORML %名%に着替えた
	ENDIF
ELSE
	IF 名 == "-"
		PRINTFORML %CALLNAME:番号%の%服の名:枠%を脱がせた
	ELSEIF 名 == ""
		PRINTFORML %CALLNAME:番号%の%服の名:枠%を組のままに戻した
	ELSE
		PRINTFORML %CALLNAME:番号%に%名%を着せた
	ENDIF
	;露出が同意の要る高さになったなら場面 1
	IF 着たときの露出度(番号) >= 着せるのに同意の要る露出
		CALL 着替えの口上(番号, 1)
	ELSE
		CALL 着替えの口上(番号, 0)
	ENDIF
ENDIF
PRINTFORML 　%着ているものの文(番号)%　容姿 %容姿の文(番号)%　露出度 {露出度(番号)}
WAIT

;[7] 小物。・ 区切りで何個でも付くので、選ぶたびに付く／外れる
;項目が多くて見切れるので 衣類一覧の一段 件ごとにページを分ける（[922] 前のページ／[923] 次のページ）
@小物を選ぶ(番号)
#DIM 番号
#DIM 甲
#DIM 数
#DIM 総ページ
#DIM ページ
#DIM 開始
#DIM 終了
#DIMS 名

ページ = 0
DO
	CALL 棚の小物を集める(番号)
	数 = RESULT
	名 '= 小物の名(番号)
	SIF 名 == ""
		名 '= "なし"
	IF 数 == 0
		PRINTL
		CALL 起床前のサイド
		CALL 起床前の見出し
		PRINTFORML 小物（%CALLNAME:番号%　付いている：%名%）
		PRINTL 　棚に小物が無い（ショップの［日常］の [1019] 衣装を買う で増える）
		CALL 起床前のサイドの下
		WAIT
		RETURN 0
	ENDIF
	総ページ = (数 - 1) / 衣類一覧の一段 + 1
	SIF ページ >= 総ページ
		ページ = 総ページ - 1
	開始 = ページ * 衣類一覧の一段
	終了 = 開始 + 衣類一覧の一段
	SIF 終了 > 数
		終了 = 数
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 小物（%CALLNAME:番号%　付いている：%名%）　（{ページ + 1}／{総ページ}ページ）
	FOR 甲, 開始, 終了
		PRINTFORML 　[{甲 + 1, 2}] %埋める(小物の候補:甲, 24)%%衣類の点の文(小物の候補:甲)%%付いている印(番号, 小物の候補:甲)%
	NEXT
	PRINTL
	SIF ページ > 0
		PRINTFORML [{衣類一覧の前のページ}] 前のページ
	SIF ページ < 総ページ - 1
		PRINTFORML [{衣類一覧の次のページ}] 次のページ
	PRINTFORML 　[{衣類を組のまま}] 組のまま　　[0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	IF RESULT == 衣類一覧の前のページ && ページ > 0
		ページ -= 1
		CONTINUE
	ELSEIF RESULT == 衣類一覧の次のページ && ページ < 総ページ - 1
		ページ += 1
		CONTINUE
	ELSEIF RESULT == 0
		RETURN 0
	ELSEIF RESULT == 衣類を組のまま
		CSTR:番号:着せた小物 '= ""
		RETURN 0
	ENDIF
	SIF RESULT < 1 || RESULT > 数
		CONTINUE
	CALL 小物を付け外しする(番号, 小物の候補:(RESULT - 1))
LOOP 1

;その小物が付いているか
@付いている印(番号, 名)
#FUNCTIONS
#DIM 番号
#DIMS 名
#DIM 甲
#DIM 数
#DIMS いま, 32
#DIMS 元

元 '= 小物の名(番号)
SIF 元 == ""
	RETURNF ""
SPLIT 元, "・", いま
数 = RESULT
FOR 甲, 0, 数
	SIF いま:甲 == 名
		RETURNF "　付いている"
NEXT
RETURNF ""

;小物を一つ付ける／外す。結果を ・ 区切りで CSTR 着せた小物 に入れる（全部外したら "-"。"" は組のまま）
@小物を付け外しする(番号, 名)
#DIM 番号
#DIMS 名
#DIM 甲
#DIM 数
#DIM あった
#DIMS いま, 32
#DIMS 元
#DIMS 出力

元 '= 小物の名(番号)
数 = 0
IF 元 != ""
	SPLIT 元, "・", いま
	数 = RESULT
ENDIF
出力 '= ""
あった = 0
FOR 甲, 0, 数
	IF いま:甲 == 名
		あった = 1
		CONTINUE
	ENDIF
	SIF 出力 != ""
		出力 += "・"
	出力 += いま:甲
NEXT
IF !あった
	SIF 出力 != ""
		出力 += "・"
	出力 += 名
ENDIF
SIF 出力 == ""
	出力 '= "-"
CSTR:番号:着せた小物 = %出力%

;[8] 一式で着替える。棚にある組から選ぶ。一式で上書きするので部位ごとの指定は消す
@一式で着替える(番号)
#DIM 番号
#DIM 甲
#DIM 数
#DIMS 名

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 一式で着替える（%CALLNAME:番号%　いま：%着ている組の名(番号)%）
	CALL 組の候補を集める(1)
	数 = RESULT
	FOR 甲, 0, 数
		CALL 選択肢を並べる(甲, 甲 + 1, 組の候補:甲, 組の候補:甲 == 着ている組の名(番号), 4, "")
	NEXT
	PRINTL
	PRINTL 　[0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	BREAK
LOOP 1
SIF RESULT < 1 || RESULT > 数
	RETURN 0
名 '= 組の候補:(RESULT - 1)
IF !着せられるか(番号, 名)
	PRINTFORML %CALLNAME:番号%は首を振った
	CALL 着替えの口上(番号, 2)
	WAIT
	RETURN 0
ENDIF
CALL 着替え前を控える(番号)
CALL 部位ごとの指定を消す(番号)
CSTR:番号:着せた服装 = %名%
;個室の中なら服の状態も合わせる（一式なので全部着る）
CALL 個室の服を合わせる(番号, 服の枠数)
IF 番号 == MASTER
	PRINTFORML %名%に着替えた
ELSE
	PRINTFORML %CALLNAME:番号%に%名%を着せた
	;露出の高い組（同意が要るもの）なら場面 1
	IF 組の露出度(組を引く(名, 衣装の性別の側(番号))) >= 着せるのに同意の要る露出
		CALL 着替えの口上(番号, 1)
	ELSE
		CALL 着替えの口上(番号, 0)
	ENDIF
ENDIF
PRINTFORML 　%着ているものの文(番号)%　容姿 %容姿の文(番号)%　露出度 {露出度(番号)}
WAIT

;[9] 元に戻す。組も部位ごとも消して自分の服（勤務中なら店の制服）へ
@元の服に戻す(番号)
#DIM 番号

CALL 着替え前を控える(番号)
CSTR:番号:着せた服装 '= ""
CALL 部位ごとの指定を消す(番号)
;個室の中なら服の状態も合わせる（元の服を全部着る）
CALL 個室の服を合わせる(番号, 服の枠数)
PRINTL
PRINTFORML %CALLNAME:番号%は自分の服に戻った（%着ている組の名(番号)%）
PRINTFORML 　%着ているものの文(番号)%　容姿 %容姿の文(番号)%　露出度 {露出度(番号)}
WAIT


;[1048] 脱ぐ・着る。行動中いつでも自分（MASTER）に対してだけ出す軽量な着脱（棚から選ぶ「服装を変える」とは別。→erablue_resort の CLOTHES_SETTING_TRAIN を参考に 2026-09-24）。
;6枠（上の服／下の服／上の下着／下の下着／靴下／靴）を並べて押すたびにトグル（着ていれば脱ぐ＝部位を着せる(…, "-")、脱いでいれば組のまま＝部位を着せる(…, "")）。小物は含めない。時間は掛からない
@脱ぐ・着る(番号)
#DIM 番号
#DIM 枠
#DIMS 名

DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 脱ぐ・着る（%CALLNAME:番号%　いま：%着ている組の名(番号)%%着せられ方の文(番号)%）　露出度 {露出度(番号)}
	FOR 枠, 0, 服の枠数
		名 '= 着ている名(番号, 枠)
		SIF 名 == ""
			名 '= "脱いでいる"
		PRINTFORML 　[{枠 + 1}] %埋める(服の名:枠, 12)%%名%
	NEXT
	PRINTL
	PRINTL 　[0] 戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	SELECTCASE RESULT
		CASE 1 TO 服の枠数
			枠 = RESULT - 1
			名 '= 着ている名(番号, 枠)
			IF 名 == ""
				CALL 部位を着せる(番号, 枠, "")
			ELSE
				CALL 部位を着せる(番号, 枠, "-")
			ENDIF
		CASE 0
			RETURN 0
	ENDSELECT
LOOP 1


;================================ 使う ================================
;［その他］の [1005]。薬かアイテムを一つでも持っているときだけ（コンドームは一覧に出さず、Ｖ系の体勢に入るときに聞く）
@持ち物を使う_入口

SIF 使える持ち物の数() <= 0
