RETURNF 香水の日 == 経過日数 + 1


;================================ 贈る ================================
;主役の段の [1108]。プレゼントを一つでも持っていて、主役が客かスタッフのとき（→画面イメージ「ショップ」の贈る）
@贈るの行

SIF プレゼントの数() <= 0
	RETURN 0
CALL コマンドを並べる(1108, "贈る")


@プレゼントの数
#FUNCTION
#DIM 甲
#DIM 数

数 = 0
FOR 甲, 0, 品目数
	SIF ITEM:甲 > 0 && 品目種類:甲 == 種類_プレゼント
		数 += 1
NEXT
RETURNF 数


;上げ幅 ＝ 贈るの幅 ＋ 価格／贈るの価格割。好物なら倍。軸は台帳の軸だけ。気力なし・贈るの分
@贈る(相手)
#DIM 相手
#DIM 甲
#DIM 選んだ
#DIM 幅
#DIM 好物

PRINTL
PRINTFORML %CALLNAME:相手%に何を贈りますか（番号。[0] でやめる）
PRINTL [ 0] やめる
FOR 甲, 0, 品目数
	SIF ITEM:甲 <= 0 || 品目種類:甲 != 種類_プレゼント
		CONTINUE
	PRINTFORML [{甲 + 1,2}] %ITEMNAME:甲,18,LEFT%持っている {ITEM:甲}　%軸の名(品目軸:甲)%%好物の添え(甲)%
NEXT
INPUT
選んだ = RESULT - 1
SIF 選んだ < 0 || 選んだ >= 品目数 || ITEM:選んだ <= 0 || 品目種類:選んだ != 種類_プレゼント
	RETURN 0
ITEM:選んだ -= 1
幅 = 贈るの幅 + ITEMPRICE:選んだ / 贈るの価格割
好物 = 0
SIF 品目好物:選んだ >= 0
	好物 = TALENT:相手:(品目好物:選んだ) != 0
SIF 好物
	幅 *= 2
IF 品目軸:選んだ == 2
	好感度_恋愛:相手:0 += 幅
ELSE
	好感度_友情:相手:0 += 幅
ENDIF
IF 好物
	PRINTFORML %CALLNAME:相手%に%ITEMNAME:選んだ%を贈った。%CALLNAME:相手%は大喜びだ
ELSE
	PRINTFORML %CALLNAME:相手%に%ITEMNAME:選んだ%を贈った。%CALLNAME:相手%は嬉しそうに受け取った
ENDIF
CALL 時間を進める(贈るの分)
CALL 結果で止まる


;================================ 貰う ================================
;主人公の行動の直後に、同じ場所に居る者の友情・恋愛の段を前回と比べ、3・6・9・10段目をまたいでいれば贈ってくる（→設計メモ「売り物はどこから来るか」）。
;前の段は 段＋1 で持ち、0（未記録）なら記録するだけ。段が上がるのは主人公の行動でだけなので、居合わせないことは無い
@贈り物を見る
#DIM 番号
#DIM 段
#DIM 品

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	段 = 好感度の段(好感度_友情:番号:0) + 1
	IF 前の段_友情:番号:0 > 0 && 貰う段の数(段 - 1) > 貰う段の数(前の段_友情:番号:0 - 1)
		CALL 贈ってくる(番号, 1)
	ENDIF
	前の段_友情:番号:0 = 段
	段 = 好感度の段(好感度_恋愛:番号:0) + 1
	IF 前の段_恋愛:番号:0 > 0 && 貰う段の数(段 - 1) > 貰う段の数(前の段_恋愛:番号:0 - 1)
		CALL 贈ってくる(番号, 2)
	ENDIF
	前の段_恋愛:番号:0 = 段
NEXT


;段までに贈ってくる段がいくつあるか（3段おき＋最後の段）。前回より増えていれば贈る
@貰う段の数(段)
#FUNCTION
#DIM 段

RETURNF 段 / 貰う段おき + (段 >= 10 && 10 % 貰う段おき != 0)


;その軸のプレゼントからランダムに一つ
@贈ってくる(番号, 軸)
#DIM 番号
#DIM 軸
#DIM 品

品 = 軸の品目を引く(軸)
SIF 品 < 0
	RETURN 0
ITEM:品 += 1
IF 軸 == 2
	PRINTFORML %CALLNAME:番号%が「……これ、受け取ってほしい」と%ITEMNAME:品%をくれた
ELSE
	PRINTFORML %CALLNAME:番号%が「これ、よかったら」と%ITEMNAME:品%をくれた
ENDIF
WAIT


;軸のプレゼント（0 なら全部の品目：アイテムとプレゼント）からランダムに一つ。無ければ -1
@軸の品目を引く(軸)
#FUNCTION
#DIM 軸
#DIM 甲
#DIM 候補, 2048
#DIM 数

数 = 0
FOR 甲, 0, 品目数
	SIF ITEMNAME:甲 == ""
		CONTINUE
	IF 軸 > 0
		SIF 品目種類:甲 != 種類_プレゼント || 品目軸:甲 != 軸
			CONTINUE
	ELSE
		SIF 品目種類:甲 != 種類_プレゼント && 品目種類:甲 != 種類_アイテム
			CONTINUE
	ENDIF
	候補:数 = 甲
	数 += 1
NEXT
SIF 数 == 0
	RETURNF -1
RETURNF 候補:(RAND:数)


;================================ 拾う ================================
;ティックごと（客.ERB @ティック処理 の末尾）。客の居る席で 客数 × 拾い物の率‰ で落ちる。
;主人公がその場所に居るときだけ落とし物になる。居なければ何も起きない（任せている間に落ちた物は消える → 設計メモ「拾得」）。
;主人公がその場所を離れていれば落とし物は消える
@落とし物のティック
#DIM 場所
#DIM 番号
#DIM 数

SIF 落とし物の場所 > 0 && 落とし物の場所 != CFLAG:MASTER:現在位置
	落とし物の場所 = 0
SIF 落とし物の場所 > 0
	RETURN 0
場所 = CFLAG:MASTER:現在位置
SIF !客の席か(場所)
	RETURN 0
数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && CFLAG:番号:現在位置 == 場所 && !(スタッフ:番号:0 && 勤務中:番号:0)
		数 += 1
NEXT
SIF 数 <= 0 || RAND(1000) >= 数 * 拾い物の率
	RETURN 0
落とし物の品 = 軸の品目を引く(0)
SIF 落とし物の品 < 0
	RETURN 0
落とし物の場所 = 場所
PRINTL 床に何か落ちているのが目に入った


;場所名の行に付ける
@落とし物のタグ(場所)
#FUNCTIONS
#DIM 場所

SIF 落とし物の場所 <= 0 || 落とし物の場所 != 場所
	RETURNF ""
RETURNF "（何か落ちている）"


@拾う_入口

SIF 落とし物の場所 <= 0 || 落とし物の場所 != CFLAG:MASTER:現在位置
	RETURN 0
CALL コマンドを並べる(1034, "拾う")


@拾う

SIF 落とし物の場所 <= 0 || 落とし物の場所 != CFLAG:MASTER:現在位置
	RETURN 0
ITEM:(落とし物の品) += 1
PRINTFORML 床に落ちていた%ITEMNAME:(落とし物の品)%を拾った
落とし物の場所 = 0
WAIT
