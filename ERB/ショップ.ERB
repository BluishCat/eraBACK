;ショップと持ち物（→設計メモ「売り物はどこから来るか」「貰った物の行き先」、画面イメージ「ショップ」。2026-09-14）。
;売る／アイテムを買う／プレゼントを買う、持ち物を使う、贈る、貰う（段が上がったとき）、拾う（落とし物）。
;品目は Item.csv（名前・価格）と CSV/台帳/品目.csv（種類・軸・好物）。持ち主は主人公だけ、上限なし。数は全部仮

;================================ ショップ ================================
;場所 301 の日常。売るのは何か持っているときだけ。買うのは金が無くても一覧は見られる
@ショップ_入口

SIF 持ち物の数() > 0
	CALL コマンドを並べる(1010, "貰い物・拾い物を売る")
CALL コマンドを並べる(1016, "アイテムを買う")
CALL コマンドを並べる(1017, "プレゼントを買う")
CALL コマンドを並べる(1019, "衣装を買う")


;持っている品目の数
@持ち物の数
#FUNCTION
#DIM 甲
#DIM 数

数 = 0
FOR 甲, 0, 品目数
	SIF ITEM:甲 > 0
		数 += 1
NEXT
RETURNF 数


;売値（価格の半分。買った物を売り直しても儲からない）
@売値(番号)
#FUNCTION
#DIM 番号

RETURNF ITEMPRICE:番号 / 売値の割


;売る。持っている物だけ並べる（薬も売れる）。一つずつ
@売る
#DIM 甲
#DIM 選んだ

;一覧はサイドの枠つきで描く（店の画面と同じ位置から始め、サイドのタブを押したら描き直す。→一日.ERB「起床前のサイド」）
DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 何を売りますか（番号。[0] でやめる）　所持金 %金額(MONEY:MASTER)%円
	PRINTL [ 0] やめる
	FOR 甲, 0, 品目数
		SIF ITEM:甲 <= 0
			CONTINUE
		PRINTFORML [{甲 + 1,2}] %ITEMNAME:甲,18,LEFT%売値 %金額(売値(甲), 7)%円　　持っている {ITEM:甲}
	NEXT
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	BREAK
LOOP 1
選んだ = RESULT - 1
SIF 選んだ < 0 || 選んだ >= 品目数 || ITEM:選んだ <= 0
	RETURN 0
ITEM:選んだ -= 1
MONEY:MASTER += 売値(選んだ)
今日の店の外:外_買い物 += 売値(選んだ)
PRINTFORML %ITEMNAME:選んだ%を売った（%金額(売値(選んだ))%円）
CALL 結果で止まる


;買う。種類（アイテム／プレゼント）の一覧から一つ
@アイテムを買う

CALL 買う(種類_アイテム)


@プレゼントを買う

CALL 買う(種類_プレゼント)


@買う(種類)
#DIM 種類
#DIM 甲
#DIM 選んだ

;サイドの枠つきで描く（→売る と同じ）
DO
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	PRINTFORML 何を買いますか（番号。[0] でやめる）　所持金 %金額(MONEY:MASTER)%円
	PRINTL [ 0] やめる
	FOR 甲, 0, 品目数
		SIF 品目種類:甲 != 種類 || ITEMNAME:甲 == ""
			CONTINUE
		PRINTFORM [{甲 + 1,2}] %ITEMNAME:甲,18,LEFT%%金額(ITEMPRICE:甲, 7)%円　　持っている {ITEM:甲}
		SIF 種類 == 種類_プレゼント
			PRINTFORM 　%軸の名(品目軸:甲)%%好物の添え(甲)%
		PRINTL
		SIF 種類 != 種類_プレゼント
			PRINTFORML 　　　　└ %品目の効果(甲)%
	NEXT
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	BREAK
LOOP 1
選んだ = RESULT - 1
SIF 選んだ < 0 || 選んだ >= 品目数 || 品目種類:選んだ != 種類
	RETURN 0
IF MONEY:MASTER < ITEMPRICE:選んだ
	PRINTL 金が足りない
	WAIT
	RETURN 0
ENDIF
MONEY:MASTER -= ITEMPRICE:選んだ
今日の店の外:外_買い物 -= ITEMPRICE:選んだ
ITEM:選んだ += 1
PRINTFORML %ITEMNAME:選んだ%を買った（%金額(ITEMPRICE:選んだ)%円）
CALL 結果で止まる


;薬・アイテムの効果の一行（買う一覧・使う一覧・病院の薬の一覧に添える。プレゼントは 軸の名・好物の添え があるので空）。
;数字は定数から出すので、値を変えても文は合う（→@持ち物を一つ使う、病院.ERB @薬を飲む）
@品目の効果(番号)
#FUNCTIONS
#DIM 番号

SELECTCASE 番号
	CASE アイテム_避妊薬
		RETURNF @"飲むと{薬の日数}日間、妊娠しない"
	CASE アイテム_アフターピル
		RETURNF "着床する前の受精卵を消す（妊娠中は飲めない）"
	CASE アイテム_排卵誘発剤
		RETURNF @"飲むと{薬の日数}日間、双子・三つ子になりやすい"
	CASE アイテム_陣痛促進剤
		RETURNF "臨月から飲める。陣痛が始まり、進みが速くなる（体力・気力を削る）"
	CASE アイテム_栄養ドリンク
		RETURNF @"体力を{ドリンクの回復}回復する"
	CASE アイテム_気付け薬
		RETURNF @"気力を{ドリンクの回復}回復する"
	CASE アイテム_酔い覚まし
		RETURNF "酔いを醒ます"
	CASE アイテム_媚薬
		RETURNF @"個室の相手の欲情を{媚薬の欲情}上げる（個室の中でだけ使える）"
	CASE アイテム_香水
		RETURNF "今日一日、話す・口説く・スキンシップ・一緒に飲むが成功しやすくなる"
	CASE アイテム_コンドーム
		RETURNF "Ｖ系に入るとき着ける（使うかは、その時に聞かれる）。膣の中には出ない"
ENDSELECT
RETURNF ""


@軸の名(軸)
#FUNCTIONS
#DIM 軸

SIF 軸 == 1
	RETURNF "友情"
SIF 軸 == 2
	RETURNF "恋愛"
RETURNF ""


;「（甘党が喜ぶ）」
@好物の添え(番号)
#FUNCTIONS
#DIM 番号

SIF 品目好物:番号 < 0
	RETURNF ""
RETURNF @"（%TALENTNAME:(品目好物:番号)%が喜ぶ）"


;================================ 衣装棚 ================================
;衣装は組の単位で買って店の衣装棚に入れ、誰にでも何度でも着せる（→画面イメージ「着替え」）。値段 0 の組は買わなくても棚にある。
;着せ方は 既定＋上書き：店の制服（設定。勤務中のスタッフ全員）＋一人ずつ（能力表示の別画面 [1047]。CSTR 着せた服装）。
;露出の高い組は本人の同意（主人公への体の段）が要る（→個室.ERB @着せられるか）

;その組が棚にあるか
@棚にあるか(名)
#FUNCTION
#DIMS 名
#DIM 甲

FOR 甲, 0, 64
	SIF 衣装棚:甲 == 名
		RETURNF 1
NEXT
FOR 甲, 0, 衣装数
	SIF 衣装名:甲 == 名 && 衣装の値段:甲 == 0
		RETURNF 1
NEXT
RETURNF 0

;棚に入れる（空きに。64 で打ち止め）
@棚に入れる(名)
#DIMS 名
#DIM 甲

SIF 棚にあるか(名)
	RETURN 0
FOR 甲, 0, 64
	IF 衣装棚:甲 == ""
		衣装棚:甲 = %名%
		RETURN 0
	ENDIF
NEXT

;部位ごとにバラ買いした衣類・小物が棚にあるか。組名と衣類名が同じ場合がある（「浴衣」等）ので 衣装棚（組）とは別に 衣類棚 を見る
@衣類が棚にあるか(名)
#FUNCTION
#DIMS 名
#DIM 甲

FOR 甲, 0, 256
	SIF 衣類棚:甲 == 名
		RETURNF 1
NEXT
RETURNF 0

;衣類棚に入れる（空きに。256 で打ち止め）
@衣類棚に入れる(名)
#DIMS 名
#DIM 甲

SIF 衣類が棚にあるか(名)
	RETURN 0
FOR 甲, 0, 256
	IF 衣類棚:甲 == ""
		衣類棚:甲 = %名%
		RETURN 0
	ENDIF
NEXT

;組の名前を重複なしで 候補 に並べる。棚にあるものだけ＝1 なら棚の分だけ。RESULT＝数
@組の候補を集める(棚だけ)
#DIM 棚だけ
#DIM 甲
#DIM 乙
#DIM 数

数 = 0
FOR 甲, 0, 衣装数
	乙 = 0
	WHILE 乙 < 数 && 組の候補:乙 != 衣装名:甲
		乙 += 1
	WEND
	SIF 乙 < 数
		CONTINUE
	SIF 棚だけ && !棚にあるか(衣装名:甲)
		CONTINUE
	組の候補:数 = %衣装名:甲%
	組の候補の値段:数 = 衣装の値段:甲
	数 += 1
NEXT
RETURN 数

;[1019] 衣装を買う。一式（組）か、部位ごとのバラ買いかを選ぶ（2026-09-23 ユーザ「部位ごとに選択してバラで買えるように」）
;戻り値の決まり（この下の段すべて共通。2026-10-16 ユーザ指定「やめるは一つだけ戻る。別のコマンドでショップのトップまで」）：
;  RETURN 0 ＝ 一つ前の段へ戻る（[0] やめる／戻る）　RETURN 1 ＝ ショップのトップまで戻る（[925] ショップのトップに戻る）
@衣装を買う
#DIM 選んだ

WHILE 1
	;サイドの枠つきで描く（→売る と同じ）
	DO
		PRINTL
		CALL 起床前のサイド
		CALL 起床前の見出し
		PRINTL 何を買いますか
		PRINTL 　[1] 一式（組）で買う
		PRINTL 　[2] 部位ごとに買う
		PRINTL 　[0] やめる
		CALL 起床前のサイドの下
		INPUT
		CALL 起床前のサイド入力
		SIF サイドで受けた
			CONTINUE
		BREAK
	LOOP 1
	選んだ = RESULT
	IF 選んだ == 1
		CALL 一式で買う
	ELSEIF 選んだ == 2
		CALL 部位ごとに買う
	ELSE
		RETURN 0
	ENDIF
	;下の段から「ショップのトップに戻る」で来たら、ここも抜ける（ここから一つ戻ってもショップのトップ）
	SIF RESULT
		RETURN 0
WEND


;[1] 一式（組）で買う。組の名前を並べ、買えば棚へ。買ったあとも一覧に残る（続けて買える）
;一行一件で、衣類一覧の一段 件ごとにページを分ける（[922] 前のページ／[923] 次のページ。2026-10-19 ユーザ指摘「表示がつまりすぎている上に見切れている」）
@一式で買う
#DIM 甲
#DIM 数
#DIM 選んだ
#DIM 総ページ
#DIM ページ
#DIM 開始
#DIM 終了

ページ = 0
WHILE 1
	;サイドの枠つきで描く（→売る と同じ）
	DO
		CALL 組の候補を集める(0)
		数 = RESULT
		総ページ = (数 - 1) / 衣類一覧の一段 + 1
		SIF ページ >= 総ページ
			ページ = 総ページ - 1
		開始 = ページ * 衣類一覧の一段
		終了 = 開始 + 衣類一覧の一段
		SIF 終了 > 数
			終了 = 数
		PRINTL
		CALL 起床前のサイド
		CALL 起床前の見出し
		PRINTFORML 何を買いますか（番号。[0] でやめる）　所持金 %金額(MONEY:MASTER)%円
		PRINTFORML （{ページ + 1}／{総ページ}ページ）
		FOR 甲, 開始, 終了
			;値段の欄は半角8（「　棚にある」と同じ幅）で列を揃える
			IF 棚にあるか(組の候補:甲)
				PRINTFORML [{甲 + 1,2}] %組の候補:甲,24,LEFT%　棚にある
			ELSE
				PRINTFORML [{甲 + 1,2}] %組の候補:甲,24,LEFT%%金額(組の候補の値段:甲, 8)%円
			ENDIF
		NEXT
		PRINTL
		SIF ページ > 0
			PRINTFORML [{衣類一覧の前のページ}] 前のページ
		SIF ページ < 総ページ - 1
			PRINTFORML [{衣類一覧の次のページ}] 次のページ
		PRINTL [ 0] やめる
		PRINTFORML [{衣類一覧のトップへ}] ショップのトップに戻る
		CALL 起床前のサイドの下
		INPUT
		CALL 起床前のサイド入力
		SIF サイドで受けた
			CONTINUE
		IF RESULT == 衣類一覧の前のページ && ページ > 0
			ページ -= 1
			CONTINUE
		ELSEIF RESULT == 衣類一覧の次のページ && ページ < 総ページ - 1
			ページ += 1
			CONTINUE
		ENDIF
		BREAK
	LOOP 1
	SIF RESULT == 衣類一覧のトップへ
		RETURN 1
	選んだ = RESULT - 1
	SIF 選んだ < 0 || 選んだ >= 数
		RETURN 0
	IF 棚にあるか(組の候補:選んだ)
		PRINTFORML %組の候補:選んだ%はもう棚にある
		WAIT
		CONTINUE
	ENDIF
	IF MONEY:MASTER < 組の候補の値段:選んだ
		PRINTL 金が足りない
		WAIT
		CONTINUE
	ENDIF
	MONEY:MASTER -= 組の候補の値段:選んだ
	今日の店の外:外_買い物 -= 組の候補の値段:選んだ
	CALL 棚に入れる(組の候補:選んだ)
	PRINTFORML %組の候補:選んだ%を買った（%金額(組の候補の値段:選んだ)%円）。店の衣装棚に入れた
	CALL 結果で止まる
WEND


;[2] 部位ごとに買う。枠を選ぶ（服装を変える の枠の一覧と同じ6枠＋小物。枠の番号は 枠＋1、小物は 7）
@部位ごとに買う
#DIM 枠

WHILE 1
	;サイドの枠つきで描く（→売る と同じ）
	DO
		PRINTL
		CALL 起床前のサイド
		CALL 起床前の見出し
		PRINTL 部位ごとに買う（枠を選ぶ。それ以外でやめる）
		PRINTL 　[1] 上の服
		PRINTL 　[2] 下の服
		PRINTL 　[3] 上の下着
		PRINTL 　[4] 下の下着
		PRINTL 　[5] 靴下
		PRINTL 　[6] 靴
		PRINTL 　[7] 小物
		PRINTL 　[0] 戻る
		PRINTFORML 　[{衣類一覧のトップへ}] ショップのトップに戻る
		CALL 起床前のサイドの下
		INPUT
		CALL 起床前のサイド入力
		SIF サイドで受けた
			CONTINUE
		BREAK
	LOOP 1
	IF RESULT >= 1 && RESULT <= 服の枠数
		枠 = RESULT - 1
		CALL 枠の衣類を買う(枠)
	ELSEIF RESULT == 服の枠数 + 1
		CALL 小物を買う
	ELSEIF RESULT == 衣類一覧のトップへ
		RETURN 1
	ELSE
		RETURN 0
	ENDIF
	SIF RESULT
		RETURN 1
WEND


;その枠（服_上〜服_靴）に合う衣類を衣類.csv 全体から一覧にして買う。棚にあるものだけ着せられる（→@棚の衣類を集める）
@枠の衣類を買う(枠)
#DIM 枠
#DIM 甲
#DIM 数

数 = 0
FOR 甲, 0, 衣類数
	SIF 衣類の値段:甲 <= 0 || !衣類がその枠に合うか(甲, 枠)
		CONTINUE
	衣類の候補:数 = %衣類名:甲%
	数 += 1
NEXT
IF 数 == 0
	PRINTL
	PRINTFORML %服の名:枠%を買いますか（番号。それ以外でやめる）　所持金 %金額(MONEY:MASTER)%円
	PRINTL 　買える衣類が無い
	WAIT
	RETURN 0
ENDIF
CALL 衣類の一覧から買う(数, 0, 枠)
RETURN RESULT


;小物を衣類.csv 全体から一覧にして買う
@小物を買う
#DIM 甲
#DIM 数

数 = 0
FOR 甲, 0, 衣類数
	SIF 衣類の値段:甲 <= 0 || 衣類の枠:甲 != 枠_小物
		CONTINUE
	小物の候補:数 = %衣類名:甲%
	数 += 1
NEXT
IF 数 == 0
	PRINTL
	PRINTFORML 小物を買いますか（番号。それ以外でやめる）　所持金 %金額(MONEY:MASTER)%円
	PRINTL 　買える小物が無い
	WAIT
	RETURN 0
ENDIF
CALL 衣類の一覧から買う(数, 1, 0)
RETURN RESULT


;衣類の候補／小物の候補（小物か で切り替え）を一覧から選んで一つ買う。共通処理。見出しは 小物か と 枠（衣類のとき）から出す
;項目が多くて見切れるので 衣類一覧の一段 件ごとにページを分ける（[922] 前のページ／[923] 次のページ）
;サイドの枠つきで描く（→売る と同じ。ページ送りと同じ要領でタブを押したら描き直す）
@衣類の一覧から買う(数, 小物か, 枠)
#DIM 数
#DIM 小物か
#DIM 枠
#DIM 甲
#DIM 選んだ
#DIM 総ページ
#DIM ページ
#DIM 開始
#DIM 終了
#DIMS 名

総ページ = (数 - 1) / 衣類一覧の一段 + 1
ページ = 0
DO
	開始 = ページ * 衣類一覧の一段
	終了 = 開始 + 衣類一覧の一段
	SIF 終了 > 数
		終了 = 数
	PRINTL
	CALL 起床前のサイド
	CALL 起床前の見出し
	IF 小物か
		PRINTFORML 小物を買いますか（番号。それ以外でやめる）　所持金 %金額(MONEY:MASTER)%円
	ELSE
		PRINTFORML %服の名:枠%を買いますか（番号。それ以外でやめる）　所持金 %金額(MONEY:MASTER)%円
	ENDIF
	PRINTFORML （{ページ + 1}／{総ページ}ページ）
	FOR 甲, 開始, 終了
		IF 小物か
			名 '= 小物の候補:甲
		ELSE
			名 '= 衣類の候補:甲
		ENDIF
		IF 衣類が棚にあるか(名)
			PRINTFORM [{甲 + 1,2}] %埋める(名, 16)%　棚にある　　
		ELSE
			PRINTFORM [{甲 + 1,2}] %埋める(名, 16)%%金額(衣類の値段を引く(名), 7)%円　　
		ENDIF
		PRINTFORML %衣類の点の文(名)%
	NEXT
	PRINTL
	SIF ページ > 0
		PRINTFORML [{衣類一覧の前のページ}] 前のページ
	SIF ページ < 総ページ - 1
		PRINTFORML [{衣類一覧の次のページ}] 次のページ
	PRINTFORML [{衣類一覧のやめる}] やめる
	PRINTFORML [{衣類一覧のトップへ}] ショップのトップに戻る
	CALL 起床前のサイドの下
	INPUT
	CALL 起床前のサイド入力
	SIF サイドで受けた
		CONTINUE
	IF RESULT == 衣類一覧の前のページ && ページ > 0
		ページ -= 1
		CONTINUE
	ELSEIF RESULT == 衣類一覧の次のページ && ページ < 総ページ - 1
		ページ += 1
		CONTINUE
	ELSEIF RESULT == 衣類一覧のやめる
		RETURN 0
	ELSEIF RESULT == 衣類一覧のトップへ
		RETURN 1
	ENDIF
	選んだ = RESULT - 1
	SIF 選んだ < 0 || 選んだ >= 数
		RETURN 0
	IF 小物か
		名 '= 小物の候補:選んだ
	ELSE
		名 '= 衣類の候補:選んだ
	ENDIF
	;買ったあとも同じページの一覧に残る（続けて買える。やめるで一つ戻る）
	CALL 衣類を一つ買う(名)
LOOP 1


;衣類・小物を一つ買って棚に入れる（部位ごと・小物 共通）
@衣類を一つ買う(名)
#DIMS 名
#DIM 値段

値段 = 衣類の値段を引く(名)
IF 衣類が棚にあるか(名)
	PRINTFORML %名%はもう棚にある
	WAIT
	RETURN 0
ENDIF
IF MONEY:MASTER < 値段
	PRINTL 金が足りない
	WAIT
	RETURN 0
ENDIF
MONEY:MASTER -= 値段
今日の店の外:外_買い物 -= 値段
CALL 衣類棚に入れる(名)
PRINTFORML %名%を買った（%金額(値段)%円）。店の衣装棚に入れた
CALL 結果で止まる


;その名前の衣類のバラ買いの値段（台帳に無ければ 0）
@衣類の値段を引く(名)
#FUNCTION
