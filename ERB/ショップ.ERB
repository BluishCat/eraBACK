;時間は食わない
@持ち物を使う
#DIM 甲
#DIM 選んだ

PRINTL
PRINTL 何を使いますか（番号。[0] でやめる）
PRINTL [ 0] やめる
FOR 甲, 0, 品目数
	SIF ITEM:甲 <= 0 || !使えるか(甲)
		CONTINUE
	PRINTFORM [{甲 + 1,2}] %ITEMNAME:甲,14,LEFT%　持っている {ITEM:甲}
	IF 甲 == アイテム_避妊薬 && 避妊薬残:MASTER:0 > 0
		PRINTFORM 　（あと{避妊薬残:MASTER:0}日効いている）
	ELSEIF 甲 == アイテム_排卵誘発剤 && 排卵誘発剤残:MASTER:0 > 0
		PRINTFORM 　（あと{排卵誘発剤残:MASTER:0}日効いている）
	ELSEIF 甲 == アイテム_香水 && 香水の日 == 経過日数 + 1
		PRINTFORM 　（今日はもう付けている）
	ENDIF
	PRINTL
	PRINTFORML 　　　　└ %品目の効果(甲)%
NEXT
INPUT
選んだ = RESULT - 1
SIF 選んだ < 0 || 選んだ >= 品目数
	RETURN 0
CALL 持ち物を一つ使う(選んだ)


;一つ使う。サイドの持ち物タブの［使う］（5600＋番号）からも来る（2026-09-14）。使えないものなら何もしない
@持ち物を一つ使う(選んだ)
#DIM 選んだ
#DIM 相手

SIF 選んだ < 0 || 選んだ >= 品目数 || ITEM:選んだ <= 0 || !使えるか(選んだ)
	RETURN 0
IF 品目種類:選んだ == 種類_薬
	CALL 薬を飲む(選んだ)
	RETURN 0
ENDIF
ITEM:選んだ -= 1
SELECTCASE 選んだ
	CASE アイテム_栄養ドリンク
		BASE:MASTER:体力 += ドリンクの回復
		SIF BASE:MASTER:体力 > MAXBASE:MASTER:体力
			BASE:MASTER:体力 = MAXBASE:MASTER:体力
		PRINTL 栄養ドリンクを飲んだ。
	CASE アイテム_気付け薬
		BASE:MASTER:気力 += ドリンクの回復
		SIF BASE:MASTER:気力 > MAXBASE:MASTER:気力
			BASE:MASTER:気力 = MAXBASE:MASTER:気力
		PRINTL 気付け薬を飲んだ。
	CASE アイテム_酔い覚まし
		BASE:MASTER:酔い = 0
		PRINTL 酔い覚ましを飲んだ。頭がはっきりした
	CASE アイテム_香水
		香水の日 = 経過日数 + 1
		PRINTL 香水を付けた。今日は少し会話が弾みそうだ
	CASE アイテム_媚薬
		相手 = 裏の相手:MASTER:0
		PALAM:相手:欲情 += 媚薬の欲情
		SIF PALAM:相手:欲情 > PALAM上限
			PALAM:相手:欲情 = PALAM上限
		CALL 性の値を整える(相手)
		PRINTFORML %CALLNAME:相手%に媚薬を飲ませた。%CALLNAME:相手%の息が熱くなってきた
ENDSELECT
CALL 結果で止まる


