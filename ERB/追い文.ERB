;行為の地の文の後に添える一文（2026-10-27 ユーザ指定「エロさが足りない」→ 行為の厚み。→進捗.md）。
;行為文_◯◯ は一手一文で、何手続けても「した」という事実しか言わなかった。ここで受け手の体の反応（息・声・脚・音）を、盛り上がりの段（@盛り上がりの段）で足す。
;愛撫（2）・奉仕（3）・Ｖ系（4）・Ａ系（5）だけ。受け手は 向き 1（客が主人公に）なら主人公、それ以外は相手。主人公が受け手のときは一人称（主語を省く）。
;段 0/1/2 ごとに 追い文の率 ％で出す。縛られていれば段 1 以上で半分は縄の文に。母乳の手（33・34・58・59）・破瓜の手・気絶中は出さない。口上はこの後に出る

@行為の追い文(行為, 相手)
#DIM 行為
#DIM 相手
#DIM 分類
#DIM 受け手
#DIM 側
#DIM 段
#DIM 潤滑
#DIM 縛り
#DIMS 文

分類 = 行為の分類:行為
SIF 分類 < 2 || 分類 > 5
	RETURN 0
SIF 行為 == 33 || 行為 == 34 || 行為 == 58 || 行為 == 59
	RETURN 0
SIF 破瓜か(行為, 相手) != 0
	RETURN 0
受け手 = 相手
側 = 0
IF 行為の向き:行為 == 1
	受け手 = MASTER
	側 = 1
ENDIF
SIF 気絶中:受け手:0
	RETURN 0
段 = 盛り上がりの段(受け手)
SIF RAND(100) >= 追い文の率:段
	RETURN 0
潤滑 = 潤滑充分か(受け手)
縛り = 縛られているか(側)
文 '= 追い文の本文(分類, 段, 受け手 == MASTER, 受け手, 潤滑, 縛り)
SIF 文 != ""
	PRINTFORML %文%


;追い文の本文。主人公は一人称（主語を省く）、相手は三人称
@追い文の本文(分類, 段, 主人公か, 受け手, 潤滑, 縛り)
#FUNCTIONS
#DIM 分類
#DIM 段
#DIM 主人公か
#DIM 受け手
#DIM 潤滑
#DIM 縛り
#DIMS 名

名 '= CALLNAME:受け手
;縛られていれば、段 1 以上で半分は縄の文
IF 縛り && 段 >= 1 && RAND(100) < 50
	SIF 主人公か
		RETURNF ひとつ選ぶ("縛られた体では逃げることもできず、快感を受け止めるしかない/縄に食い込む手首の痛みさえ、快感に変わっていく")
	RETURNF ひとつ選ぶ(名 + "は縛られた体を捩らせ、逃げ場のない快感に喘いだ/縄がきしむほど身をよじって、" + 名 + "は声を押し殺している")
ENDIF
IF 主人公か
	SELECTCASE 分類
		CASE 2
			SELECTCASE 段
				CASE 0
					RETURNF ひとつ選ぶ("触れられた肌が、じわりと熱を持っていく/指先の動きに、背筋がぞくりと粟立った")
				CASE 1
					RETURNF ひとつ選ぶ("思わず息が漏れ、体が勝手に反応してしまう/甘い声が喉まで込み上げて、必死に飲み込んだ")
			ENDSELECT
			RETURNF ひとつ選ぶ("もう膝に力が入らず、触れられるたびに体が跳ねる/頭の芯が痺れて、何も考えられなくなってきた/声を抑えようとしても、息が甘く乱れてしまう")
		CASE 3
			SELECTCASE 段
				CASE 0
					RETURNF ひとつ選ぶ("与えられる刺激に、腰がわずかに浮いた/ゆっくりとした刺激に、息が浅くなっていく")
				CASE 1
					RETURNF ひとつ選ぶ("刺激が重なるたびに、腰が勝手に震えた/思わず手を伸ばして、引き寄せるように力を込めていた")
			ENDSELECT
			RETURNF ひとつ選ぶ("脚が強張って、限界がすぐそこまで来ている/荒い息が止まらず、腰が勝手に突き出されてしまう/頭が白く霞んで、刺激だけが意識を占めていく")
		CASE 4
			SELECTCASE 段
				CASE 0
					SIF 潤滑
						RETURNF "つながった所から、濡れた音が小さく響いた"
					RETURNF ひとつ選ぶ("ゆっくりとした律動に合わせて、吐息が漏れていく/つながった所から、相手の体温がじんわりと伝わってくる")
				CASE 1
					SIF 潤滑
						RETURNF "溢れた蜜が、動かれるたびに淫らな音を立てた"
					RETURNF ひとつ選ぶ("突き上げられるたびに体が揺れ、甘い声が抑えられない/中が熱く絡みつくように疼き、動かれるたびに声が漏れる/唇を噛んで堪えても、動かれるたびに吐息が漏れてしまう")
			ENDSELECT
			RETURNF ひとつ選ぶ("奥を突かれるたびに頭の芯まで痺れて、今にも達してしまいそうだ/しがみつくように手を伸ばし、焦点が合わないまま喘いでいる/中が勝手に締まって、深く繋がった所から熱が広がっていく/息もできないほどの快感に、爪先まで力が入る")
		CASE 5
			SELECTCASE 段
				CASE 0
					RETURNF ひとつ選ぶ("慣れない感覚に、息を詰めながら受け入れている/ゆっくりと押し広げられるたびに、体がこわばった")
				CASE 1
					RETURNF ひとつ選ぶ("押し広げられる感覚に、尻がひくひくと震える/戸惑いながらも、次第に声が抑えられなくなってきた")
			ENDSELECT
			RETURNF ひとつ選ぶ("背徳的な快感に抗えず、腰が震えている/奥を突かれるたびに、声が裏返ってしまう/経験したことのない深さの快感に、爪先まで力が入る")
	ENDSELECT
	RETURNF ""
ENDIF
SELECTCASE 分類
	CASE 2
		SELECTCASE 段
			CASE 0
				RETURNF ひとつ選ぶ(名 + "の吐息が、少しずつ熱を帯びていく/" + 名 + "の肌がうっすらと汗ばみ、体温が上がってきた/触れた指先に、" + 名 + "の体がぴくりと反応した")
			CASE 1
				RETURNF ひとつ選ぶ(名 + "の喉から、堪えきれない甘い声が漏れた/" + 名 + "は身をよじり、もっと求めるように体を寄せてくる/" + 名 + "の目がとろんと潤み、唇が薄く開いている")
		ENDSELECT
		RETURNF ひとつ選ぶ(名 + "の体が小刻みに震え、今にも崩れ落ちそうだ/" + 名 + "は声を抑えることもできず、縋るように見上げてくる/" + 名 + "の脚から力が抜け、触れるたびに体が跳ねる/" + 名 + "は唇を噛んで声を殺そうとするが、吐息に甘い響きが混じってしまう")
	CASE 3
		SELECTCASE 段
			CASE 0
				RETURNF ひとつ選ぶ("与えられる刺激に、" + 名 + "の息が浅くなっていく/" + 名 + "の腰が、わずかに浮いた/" + 名 + "は目を細めて、小さく息を吐いた")
			CASE 1
				RETURNF ひとつ選ぶ("刺激が重なるたびに、" + 名 + "の腰が震えた/" + 名 + "は思わず手を伸ばし、引き寄せるように力を込めてきた/" + 名 + "の吐息が荒くなり、堪えるように唇を噛んだ")
		ENDSELECT
		RETURNF ひとつ選ぶ(名 + "の脚が強張り、限界が近いことが伝わってくる/" + 名 + "は荒い息の合間に、もう限界だと目で訴えている/" + 名 + "の腰が勝手に突き出され、止まらなくなっている/" + 名 + "は目を潤ませ、与えられる刺激に身を任せている")
	CASE 4
		SELECTCASE 段
			CASE 0
				SIF 潤滑
					RETURNF "つながった所から、濡れた音が小さく響いた"
				RETURNF ひとつ選ぶ("ゆっくりとした律動に合わせて、" + 名 + "の吐息が重なっていく/つながった所から、" + 名 + "の体温がじんわりと伝わってくる")
			CASE 1
				SIF 潤滑
					RETURNF "溢れた蜜が、動くたびに淫らな音を立てた"
				RETURNF ひとつ選ぶ("動くたびに" + 名 + "の体が揺れ、甘い声が重なった/" + 名 + "の中が熱く絡みつき、動くたびに声が漏れる/" + 名 + "は唇を噛んで声を堪えるが、動くたびに吐息が漏れてしまう")
		ENDSELECT
		RETURNF ひとつ選ぶ("奥を突かれるたびに" + 名 + "の中がきゅうきゅうと締まり、今にも達してしまいそうだ/" + 名 + "はしがみつくように手を伸ばし、焦点の合わない目で喘いでいる/" + 名 + "の体が弓なりに反り、繋がった所から熱が溢れてくる/" + 名 + "は切れ切れに息を吐き、中が脈打つように震えている")
	CASE 5
		SELECTCASE 段
			CASE 0
				RETURNF ひとつ選ぶ("慣れない感覚に、" + 名 + "は息を詰めながら受け入れている/ゆっくりと押し広げられるたびに、" + 名 + "の体がこわばった")
			CASE 1
				RETURNF ひとつ選ぶ("押し広げられる感覚に、" + 名 + "の尻がひくひくと震える/" + 名 + "は戸惑いながらも、次第に声を抑えられなくなってきた")
		ENDSELECT
		RETURNF ひとつ選ぶ("背徳的な快感に、" + 名 + "は抗えず腰を震わせている/" + 名 + "の中が強く収縮し、奥を突かれるたびに声が裏返った/" + 名 + "は震える声を漏らし、奥を突かれるたびに体が跳ねた")
ENDSELECT
RETURNF ""
