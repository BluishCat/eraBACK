;今日シフトの入っている人数
@出勤の数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && スタッフ:番号:0 && シフト:番号:営業曜日 > 0
		数 += 1
