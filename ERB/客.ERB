#DIM する側
#DIM 手
#DIM 客か
#DIMS 文

客か = !スタッフ:する側:0 || !勤務中:する側:0
PRINTL
PRINTFORML %CALLNAME:する側%%主人公へのセクハラの文:手%。どうしますか
PRINTL [0] 受け入れる　[1] かわす　[2] 突き放す
[IF_DEBUG]
;[1992] の日回しは主人公が自分で選べないので、決めた答え（かわす）を入れる。デバッグ起動のときだけ（→デバッグ.ERB）
IF デバッグ自動応答
	RESULT = 1
ELSE
	INPUT
ENDIF
[ENDIF]
[IF_NDEBUG]
INPUT
[ENDIF]
SELECTCASE RESULT
	CASE 0
		CALL セクハラを受ける(MASTER, する側, 手)
		好感度_体:する側:0 += 1
		IF 客か
			満足度:する側:0 += 自律セクハラの受け入れ
			SIF 満足度:する側:0 > 満足度上限
				満足度:する側:0 = 満足度上限
		ENDIF
		;股間を弄られたなら、主人公の潤滑・勃起が線に届いていれば相手に伝わる（2026-10-15）
		文 '= ""
		SIF 手 == セクハラ_股間 && 股間の触感(MASTER) != ""
			文 '= @"%股間の触感(MASTER)%。"
		PRINTFORML 抗わずに受け入れた。%文%%CALLNAME:する側%は満足げだ
		;尻・胸・股間なら、触れ方の口上（相手＝する側が触る。→個室.ERB @外の触れ方の口上）
		CALL 外の触れ方の口上(する側, 手, 1)
		;触れられた部位の快感が線に達していれば、その場で達する（→行動.ERB @触れられて達する）
		CALL 触れられて達する(MASTER, 1, 手)
	CASE 2
		好感度_友情:する側:0 -= セクハラの傷 / 2
		好感度_恋愛:する側:0 -= セクハラの傷 / 2
		SIF 好感度_友情:する側:0 < 0
			好感度_友情:する側:0 = 0
		SIF 好感度_恋愛:する側:0 < 0
			好感度_恋愛:する側:0 = 0
		SIF 客か
			CALL 満足度を下げる(する側, セクハラの傷)
		セクハラ断られた:する側:0 = MASTER + 1
		PRINTFORML 強く突き放した。%CALLNAME:する側%は気まずそうに手を引いた
		CALL 警備が間に入る(する側, MASTER)
	CASEELSE
		SIF 客か
			CALL 満足度を下げる(する側, 自律セクハラのかわし)
		PRINTFORML さりげなくかわした
