	RETURNF 1
SIF 位置 == 地下ホールの位置 || 位置 == 地下ステージの位置
	RETURNF 2
RETURNF 0


;同じ空間に流す要約の定型。半個室（ボックス席）は「何かしている」、開いた場所は「声が上がった」
@空間の要約(位置)
#FUNCTIONS
#DIM 位置

SIF 位置 >= 80 && 位置 < 100
	RETURNF @"%GET_PLACE_NAME(位置)%で何かしているようだ"
RETURNF @"%GET_PLACE_NAME(位置)%のほうで声が上がった"


;いま居る場所に居る者を並べる。居なければ何も出さない
;名前はボタン。押すと主役が切り替わる（2000＋キャラ番号。0〜999 は移動に使っているので）（→画面イメージ）
;いま向き合っている相手（主役）は下の▼の段に居るので、この行には入れない（2026-09-22 ユーザ指定）
@同室者表示
#DIM 番号
#DIM 居た

CALL 主役を決める
居た = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置 || 番号 == 主役 || その場の最中か(番号)
		CONTINUE
	SIF !居た
		PRINT 同室者：
	居た = 1
	PRINTBUTTON @"[%CALLNAME:番号%] ", 2000 + 番号
NEXT

SIF 居た
	PRINTL 

;厨房では端末に届いている注文を並べる（→画面イメージ「料理の流れ」）
IF CFLAG:MASTER:現在位置 == 6
	CALL 端末表示
	居た = 1
ENDIF

;▼の行との間は1行あける（→画面イメージ）
SIF 居た
	PRINTL 


;厨房の端末。「端末：みどり チーズ盛り合わせ（待ち）　健二 マルゲリータ（できあがり）」。注文が無ければ「端末：注文なし」
@端末表示
#DIM 番号
#DIM 居た

PRINT 端末：
居た = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || 注文状態:番号:0 < 1 || 注文状態:番号:0 > 2
		CONTINUE
	SIF 居た
		PRINT 　
	居た = 1
	PRINTFORM %CALLNAME:番号% %料理名:(注文品目:番号:0)%（%注文状態名(注文状態:番号:0)%）
NEXT
SIF !居た
	PRINT 注文なし
PRINTL 


;注文の状態の名前（→画面イメージ「料理の流れ」）
@注文状態名(状態)
#FUNCTIONS
#DIM 状態

SELECTCASE 状態
	CASE 1
		RETURNF "待ち"
	CASE 2
		RETURNF "できあがり"
	CASE 3
		RETURNF "済"
ENDSELECT
RETURNF ""
