;客の来店と退店（→設計メモ「客」「時間進行の実装形」）
;
;日替わりのたびに「今日来るか・何時に来るか」を全員分引き、ティックごとに予定時刻と今を比べる。
;毎ティック500人分の確率計算をしないで済むし、来店時刻の「中心＋ばらつき」がそのまま乱数1回になる。
;予定は「経過日数×1440＋時刻」の絶対分で持つ。日をまたぐ滞在もこれで比べられる
;
;居合わせた客同士は勝手に親しくなる。毎ティック数ペアだけ抽選するので、負荷は在室者数によらない
;
;所持金は来店ごとに決めて、帰るときに捨てる（→設計メモ「客」）。額と席料は仮の数
;
;満足度は来店をまたいで持ち越し、日替わりで中立へ戻る。来店の頻度・滞在・使う額に効き、帰るとき評判を動かす。
;主人公が何もしない客は据え置き（→設計メモ「経済の輪」）
;
;連れ立っての来店：予定の立った客に友情の高い相手が同じ時刻で付いてくる（自分では来ない日でも）。席は誘い主の所へ
;
;まだ無いもの：スタッフの区別、閉店の操作


;一日の終わり（05:00）と、ゲーム開始時に呼ぶ。来店予定はここでは組まない（→ @営業の日を組む）
@日替わり
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	;スタッフの一日ぶんの記録を戻す
	今日広報した:番号:0 = 0
	次の披露:番号:0 = 0
	セクハラ回数:番号:0 = 0
	セクハラ止め:番号:0 = 0
	セクハラ断られた:番号:0 = 0
	CALL 性欲が溜まる(番号)
	CALL 精力が戻る(番号)
	CALL ストレスの日替わり(番号)
	;ストレスを見てから戻す（休めていない日はストレスが溜まってから、翌日は上限で始まる）
	CALL NPCの休養(番号)
	CALL 妊娠の日替わり(番号)
NEXT
CALL 性欲が溜まる(MASTER)
CALL 精力が戻る(MASTER)
CALL ストレスの日替わり(MASTER)
CALL 妊娠の日替わり(MASTER)


;営業の一晩ぶんの来店予定を全員分組む。開店の時刻に一度だけ（@ティック処理 の頭）。
;日替わり（05:00）でなく開店で組むのは、強制就寝だと日替わりがリザルトより先に走り、起床前に営業時間を変えても間に合わないから。
;曜日（営業曜日）・シフト・満足の戻りも一晩の区切りはここ
@営業の日を組む
#DIM 番号

営業曜日 = 曜日
予定を組んだ日 = 経過日数
;その晩の行事（客足・売れ筋・気分・開店の一文。→行事.ERB）
CALL 営業の行事を決める
;開店のたびに営業日数が一つ進む（目標カード。→目標.ERB）
営業日数 += 1
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	;店に居ない者だけ戻す。居座っている客の満足はまだ前の晩のもの。同棲している人は自宅の自分の部屋が家（→行動.ERB「同棲」）
	IF 家に居るか(番号)
		CALL 満足度を戻す(番号)
		連れ:番号:0 = -1
	ENDIF
	CALL 来店予定を引く(番号)
NEXT
;店の規模で一晩の来店数に上限を掛ける（連れを組む前。連れは枠に数えない）
CALL 来店の枠に収める
;広報は打った翌日の一晩だけ効く
広報の効き = 0
CALL 連れを組む
;開店の知らせ。初日はそのあとに何を押せばいいかを3行（→導入.ERB @開店の案内）
CALL 開店の知らせ
CALL 開店の案内


;開店と閉店は見出しの罫線と色で本文から浮かせる。開店は来店予定を組むこの時刻、閉店は営業中でなくなった最初のティック
@開店の知らせ

営業中の晩 = 1
PRINTL
CALL 見出し罫線("開店")
SETCOLOR 0xffd27f
PRINTFORML 　★ 開店　%時刻表示(営業開始)%　（今夜は %時刻表示(営業終了)% まで）
RESETCOLOR
CALL 行事の知らせ
PRINTL


@閉店を見る

SIF !営業中の晩 || 営業中(現在時刻)
	RETURN 0
営業中の晩 = 0
PRINTL
CALL 見出し罫線("閉店")
SETCOLOR 0x9fc4ff
PRINTFORML 　★ 閉店　%時刻表示(営業終了)%
RESETCOLOR
PRINTFORML 　ここまでの来客 {今日の来客}人　売上 %金額(今日の売上)%円　残っている客は帰ります。
PRINTL


;日が経つと性欲が溜まる（→設計メモ「性欲は Base に持つ」）。減るのは裏の仕事（@裏を終える）。指名の率とセクハラの通りに効く
@性欲が溜まる(番号)
#DIM 番号

BASE:番号:性欲 += 性欲の溜まり
SIF BASE:番号:性欲 > MAXBASE:番号:性欲
	BASE:番号:性欲 = MAXBASE:番号:性欲


;休むと精力が戻る（→設計メモ「精力も Base」）。減るのは射精（@射精を見る 個室.ERB）
@精力が戻る(番号)
#DIM 番号

BASE:番号:精力 += 精力の回復
SIF BASE:番号:精力 > MAXBASE:番号:精力
	BASE:番号:精力 = MAXBASE:番号:精力


;予定の立った客（誘い主）ごとに、友情が連れ立ちの段以上の相手で今日の予定が無い者を、確率で同じ時刻に引き込む。
;自分の予定がある者はそちらを優先。誘われた者は誰かを誘わない（連鎖しない）。集客になる（→設計メモ「関係が進むと」）
@連れを組む
#DIM 甲
#DIM 乙

FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0 || 来店予定:甲:0 < 0 || 連れ:甲:0 >= 0
		CONTINUE
	FOR 乙, 1, キャラ枠
		SIF 乙 == 甲 || !実キャラ:乙:0 || 来店予定:乙:0 >= 0 || !家に居るか(乙) || 連れ:乙:0 >= 0
			CONTINUE
		SIF 好感度_友情:乙:甲 < 連れ立ちの段 * 好感度の一段
			CONTINUE
		;誘い主が店に満足しているほど誘いやすい（満足度％ぶん。不満なら誘わない側に。2026-09-15）
		SIF RAND(100) >= 連れ立ちの確率 * (100 + 満足度:甲:0) / 100
			CONTINUE
		来店予定:乙:0 = 来店予定:甲:0
		連れ:乙:0 = 甲
	NEXT
NEXT


;理性を全員ぶん満タンに。PALAM は BEGIN TRAIN で0に戻るので、起床のたびに（@EVENTTRAIN から）呼ぶ。
;行為が終わったときにも戻す予定（その場の値 → 設計メモ「行為の値」）
@理性を戻す
#DIM 番号

PALAM:MASTER:理性 = 理性の上限
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0
		PALAM:番号:理性 = 理性の上限
NEXT


;満足度を下げる。下限は上限と同じ幅（-100）で止める
@満足度を下げる(番号, 幅)
#DIM 番号
#DIM 幅

SIF 幅 <= 0
	RETURN 0
満足度:番号:0 -= 幅
SIF 満足度:番号:0 < 0 - 満足度上限
	満足度:番号:0 = 0 - 満足度上限


;来店の間は中立へ少しずつ戻る（→設計メモ「経済の輪」）
@満足度を戻す(番号)
#DIM 番号

IF 満足度:番号:0 > 満足度の戻り
	満足度:番号:0 -= 満足度の戻り
ELSEIF 満足度:番号:0 < 0 - 満足度の戻り
	満足度:番号:0 += 満足度の戻り
ELSE
	満足度:番号:0 = 0
ENDIF


@来店予定を引く(番号)
#DIM 番号
#DIM 確率
#DIM 偏り
#DIM 時刻

来店予定:番号:0 = -1

;まだ店に居る者は引かない（日をまたいで居座っている客）。同棲している人は自宅の自分の部屋に居れば家に居る扱い（→行動.ERB「同棲」）
SIF !家に居るか(番号)
	RETURN 0
;その晩シフトの入っているスタッフは客として来ない。休みの日は客として来る（→設計メモ「割り振りの形」）
SIF スタッフ:番号:0 && シフト:番号:営業曜日 > 0
	RETURN 0

;曜日の客足 × キャラごとの曜日の偏り（100が等倍。未記入の0は偏りなし → 等倍）
確率 = 曜日客足:営業曜日
偏り = CFLAG:番号:(GETNUM(CFLAG, "曜日偏り_日") + 営業曜日)
SIF 偏り > 0
	確率 = 確率 * 偏り / 100
;店の評判が客足を上げる（評判100で2倍）。個人の満足は帰るときに評判へ渡すので、ここでは上げない（2026-09-15 に決めた。重ねると天井が×4になる）
;まだ一度も来ていない客は評判が低いうちは来にくい（新規客の量 → 設計メモ「評判」）
IF 来店回数:番号:0 <= 0
	確率 = 確率 * (新規の下駄 + 評判) / 100
ELSE
	確率 = 確率 * (100 + 評判) / 100
ENDIF
;前回の不満は来にくくする（不満だけ。満足の側は評判が受け持つ）
SIF 満足度:番号:0 < 0
	確率 = 確率 * (100 + 満足度:番号:0) / 100
;昨日打った広報。客の量だけが増える（評判は動かさない → 設計メモ「経済の輪」）
SIF 広報の効き > 0
	確率 = 確率 * (100 + 広報の効き) / 100
;行事の日は客足が動く（→行事.ERB。来店の上限にも同じ倍率を掛ける）
確率 = 確率 * 行事の客足を引く() / 100
SIF RAND(100) >= 確率
	RETURN 0

;来やすい時間帯。未記入なら営業時間の中のどこか
IF CFLAG:番号:来店時刻中心 > 0
	時刻 = CFLAG:番号:来店時刻中心 + ゆらぎ(CFLAG:番号:来店時刻ばらつき)
ELSE
	時刻 = 営業開始 + RAND(営業終了 - 営業開始)
ENDIF

;CSV は 01:00 を 60 とも 1500 とも書ける。一日の時計（05:00 始まり）に直してから営業中かを見る
時刻 = (時刻 + 1440) % 1440
SIF 時刻 < 一日の始まり
	時刻 += 1440
;営業時間の外に当たった日は来ない。深夜型の客は深夜まで開けないと会えない（→設計メモ「世界と時間」）
SIF !営業中(時刻)
	RETURN 0

;10分刻みに揃える
時刻 = 時刻 / 10 * 10
来店予定:番号:0 = 経過日数 * 1440 + 時刻


;一晩の来店数を店の規模に収める（→設計メモ「店内での居場所」）。上限は 来店の基本枠＋ボックス席数×席あたりの来店枠。
;引き当たった人が上限を超えたら、超えた分を無作為に落とす（番号順に落とすと若い番号ばかりが来る）。
;スマホで呼ぶ・呼び寄せる・連れは来店予定を通らないので枠の外
@来店の枠に収める
#DIM 番号
#DIM 候補, 500
#DIM 候補数
#DIM 上限
#DIM 選

上限 = 来店の上限() * 行事の客足を引く() / 100
SIF 上限 < 1
	上限 = 1
候補数 = 0
FOR 番号, 1, キャラ枠
	IF 実キャラ:番号:0 && 来店予定:番号:0 >= 0
		候補:候補数 = 番号
		候補数 += 1
	ENDIF
NEXT
WHILE 候補数 > 上限
	選 = RAND(候補数)
	番号 = 候補:選
	来店予定:番号:0 = -1
	候補数 -= 1
	候補:選 = 候補:候補数
WEND

;一晩に来る客の上限。増築メニューにも出す（→一日.ERB @増築メニュー）
@来店の上限
#FUNCTION
RETURNF 来店の基本枠 + ボックス席数 * 席あたりの来店枠


;評判の上限。基本＋開始時から増築に使った額÷単位（ボックス席・個室・後付け施設・地下。寮の部屋は数えない）。
;建てた分は減らないので上限も下がらない。増築メニューにも出す（→一日.ERB @増築メニュー）
@評判の上限
#FUNCTION
#DIM 額
#DIM 枠

額 = (ボックス席数 - 開始のボックス席数) * ボックス席の値段
額 += (個室数 - 開始の個室数) * 個室の値段
FOR 枠, 0, 後付け施設数
	;種類が入っていない枠は古いセーブで建てた分。浴場（番号0）の値段で数える
	IF 施設の種類:枠 > 0
		額 += 施設値段:(施設の種類:枠 - 1)
	ELSE
		額 += 施設値段:0
	ENDIF
NEXT
SIF 地下あり
	額 += 地下の値段
;監視カメラは枠を持たないので、枠の数え上げの外で足す
SIF 監視カメラあり
	額 += 施設値段:施設_監視カメラ
RETURNF 評判上限の基本 + 額 / 評判上限の単位 + 目標の評判上限


;-ばらつき〜+ばらつき の三角分布。中心付近に寄る
@ゆらぎ(ばらつき)
#FUNCTION
#DIM ばらつき

SIF ばらつき <= 0
	RETURNF 0

RETURNF (RAND(ばらつき * 2 + 1) - ばらつき + RAND(ばらつき * 2 + 1) - ばらつき) / 2


;営業時間の中か。時刻は一日の時計（300〜1739。0時過ぎは 1440 を足した値）
@営業中(時刻)
#FUNCTION
#DIM 時刻

RETURNF 時刻 >= 営業開始 && 時刻 < 営業終了


;「18:00〜02:00」
@営業時間の文
#FUNCTIONS

RETURNF @"%時刻表示(営業開始)%〜%時刻表示(営業終了)%"


;本文の一番上の行に出す営業状態。「営業中（02:00 まで）」「開店前（18:00 から）」「閉店後」（→画面イメージ）
@営業状態の文(時刻)
#FUNCTIONS
#DIM 時刻
SIF 営業中(時刻)
	RETURNF @"営業中（%時刻表示(営業終了)% まで）"
SIF 時刻 < 営業開始
	RETURNF @"開店前（%時刻表示(営業開始)% から）"
RETURNF "閉店後"


;毎ティック。来る者・席へ向かう者・帰る者を動かす
@ティック処理
#DIM 番号
#DIM 今
#DIM 位置

今 = 経過日数 * 1440 + 現在時刻
在室者数 = 0

;営業時間が終わった最初のティックで閉店の知らせ（客は下のループで帰る）
CALL 閉店を見る
;開店の時刻に、その晩の来店予定を組む（一日に一度。起床前に営業時間を変えた日は、変えた後の開店で）
SIF 現在時刻 >= 営業開始 && 予定を組んだ日 != 経過日数
	CALL 営業の日を組む

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	;主人公に連れられている間は世界から外れる（帰らない・飲まない・指名しない → 同行.ERB）
	SIF 同行キャラ == 番号
		CONTINUE
	;気絶して眠っている間は世界から外れる。起きる時刻が来たら目を覚ます（→気絶.ERB）
	IF 気絶中:番号:0
		CALL 目覚めを見る(番号, 今)
		CONTINUE
	ENDIF
	位置 = CFLAG:番号:現在位置
	;主人公の場面の相手（個室・舞台の場面・夜這い・自宅の風呂）は主人公が動かす。飲まない・帰らない・在室者に数えない。
	;個室なら 裏のティック が何もしないので同じだったが、舞台の場面（19）はここを素通りして注文や退店が走った（2026-09-21 お迎え棒の最中にけんたが白ワインを頼んだ）
	SIF 裏の相手:MASTER:0 == 番号 || 裏の同席:MASTER:0 == 番号
		CONTINUE
	;舞台で分娩中・処女を競りにかけられている（→「出産ショー」「処女オークション」）。動かさない・帰さない・在室者に数えない。分娩は @分娩の時間 が進める
	SIF 舞台に立っているか(番号)
		CONTINUE
	;寝床で陣痛中。分娩が終わるまで来店も退店もしない（→立ち会い.ERB）。分娩は @分娩の時間 が進める
	SIF 分娩で休んでいるか(番号)
		CONTINUE

	IF 家に居るか(番号)
		;予定の時刻が来たら来店（同棲している人は自宅の自分の部屋から）。営業時間を途中で変えて時間外になっていたら、その予定は流す
		IF 来店予定:番号:0 >= 0 && 来店予定:番号:0 <= 今
			IF 営業中(現在時刻)
				CALL 来店(番号, 今)
			ELSE
				来店予定:番号:0 = -1
			ENDIF
		ENDIF
	ELSEIF 位置 == 8
		;玄関に現れた客は次のティックで席へ
		CALL 着席(番号)
	ELSEIF 位置 >= 20 && 位置 < 20 + 個室数
		;個室に入っている。終わる時刻が来たら出す（→設計メモ「他室の進行」）
		CALL 裏のティック(番号, 今)
	ELSEIF 位置 == 地下ホールの位置 && 裏の相手:番号:0 > 0
		;地下ホールのその場の裏の最中（席のまま。→画面イメージ「地下ホールのその場の裏」）。飲まない・帰らない・在室者に数えない
		CALL 裏のティック(番号, 今)
	ELSEIF 位置 < 100 && スタッフ:番号:0 && 勤務中:番号:0
		;勤務中のスタッフは客ではない。出退勤は @スタッフのティック が見る。
		;居合わせてはいるので自律交流の対象にはなる
		在室者:在室者数 = 番号
		在室者数 += 1
	ELSEIF 位置 < 100
		;店の中に居る客。滞在時間が尽きたか、閉店したら帰る
		IF 退店予定:番号:0 <= 今 || !営業中(現在時刻)
			CALL 退店(番号)
		ELSEIF トイレか(位置) && 離席元:番号:0 > 0
			;トイレに立っている。時間が経てば元の席へ（→「離席」）
			CALL 離席から戻る(番号, 今)
		ELSEIF 客の席か(位置) && 離席を引く(番号)
			CALL 離席する(番号, 今)
		ELSE
			在室者:在室者数 = 番号
			在室者数 += 1
			;客が居れば店は汚れる。目につくほど汚れていれば機嫌が下がる（→設計メモ「経済の輪」）
			CALL 汚れを足す(位置, 汚れの溜まり)
			CALL 満足度を下げる(番号, 汚れの不快(位置))
			;放っておいても飲む（→画面イメージ「飲み物の流れ」）
			SIF 次の一杯:番号:0 >= 0 && 次の一杯:番号:0 <= 今
				CALL 勝手に飲む(番号, 今)
			;迷惑客が居合わせていると機嫌が下がる（→設計メモ「迷惑客」）
			SIF 迷惑客の場所 > 0 && 位置 == 迷惑客の場所
				CALL 満足度を下げる(番号, 迷惑客の被害)
			;露出の高いスタッフ（か主人公）が同じ場所に居れば欲情が上がる（→画面イメージ「個室の中」の露出度）
			CALL 目の保養(番号, 位置)
			;裏メニューの指名（→設計メモ「指名」）
			SIF 客の席か(位置)
				CALL 指名を引く(番号)
		ENDIF
	ENDIF
NEXT

;酔いは時間で醒める。主人公も含める（→画面イメージ「飲み物の流れ」）
FOR 番号, 0, キャラ枠
	SIF 実キャラ:番号:0 && BASE:番号:酔い > 0
		CALL 酔いを動かす(番号, 0 - 酔いの醒め)
NEXT

;主人公が個室に入っているときも進める（ティックの走査は1番から回るので、主人公はここで見る）
SIF CFLAG:MASTER:現在位置 >= 20 && CFLAG:MASTER:現在位置 < 20 + 個室数
	CALL 裏のティック(MASTER, 今)
;地下ホールのその場の裏（主人公が提供する側。商品のある場面だけ。逢引などは自分の終わり方がある）
SIF 地下あり && CFLAG:MASTER:現在位置 == 地下ホールの位置 && 裏の相手:MASTER:0 > 0 && 裏の商品:MASTER:0 >= 0
	CALL 裏のティック(MASTER, 今)

CALL 自律交流
;客とスタッフも自分から手を出す（→画面イメージ「セクハラは三者がする」）
CALL 自律セクハラ
;主人公が眠っていれば、寝床へ忍んで来る人が居るか（→夜這い.ERB）
CALL 夜這いのティック
;主人公が誰かと二人きりなら、その人から逢引に誘われるか（→行動.ERB「逢引」）
CALL 逢引のティック
CALL スタッフのティック
CALL 迷惑客のティック
;自慰・逢引の最中に第三者が同じ場所に着いたか（人が動いたあとに見る → 見つかる.ERB）
CALL 見つかるのティック
CALL 妊娠の露見
;客の居る席で物が落ちる（主人公が居るときだけ → ショップ.ERB）
CALL 落とし物のティック
;臨月の人が店に居れば、出産ショーの打診の旗を立てる（聞くのはコマンドの後 → USERCOM.ERB @USERCOM）
CALL 出産ショーの候補を見る
;主人公が自宅に居れば、訪ねてくる人が居るか（旗を立て、聞くのはコマンドの後 → 行動.ERB「訪ねてくる」）
CALL 訪ねてくるを引く


;スタッフの出退勤。営業時間の間だけ仕事の場所に居る（→設計メモ「スタッフ」「仕事の一覧」）。
;決めるのは曜日と仕事だけで、時間帯は指定しない。休みの日は寮の部屋に居るか、客として来店する（→@来店予定を組む）。
;仕事の中身（接客・調理・清掃…）はまだ。ここでは居場所と給料だけ
@スタッフのティック
#DIM 番号
#DIM 仕事
#DIM 場所

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0
		CONTINUE
	;主人公に連れられている間は持ち場へ戻さない（→同行.ERB）。気絶して眠っている間も（→気絶.ERB）。舞台で分娩中も（→「出産ショー」）。寝床で陣痛中も（→立ち会い.ERB）
	SIF 同行キャラ == 番号 || 気絶中:番号:0 || 舞台に立っているか(番号) || 分娩で休んでいるか(番号)
		CONTINUE
	;主人公の逢引の相手と同席側（勤務中でも誘う・参加する → 見つかる.ERB）は持ち場へ戻さない。場面が終わるまで居場所はそのまま
	SIF 裏の相手:MASTER:0 == 番号 || (裏の同席:MASTER:0 > 0 && 裏の同席:MASTER:0 == 番号)
		CONTINUE
	仕事 = シフト:番号:営業曜日

	;巡回の仕事（清掃・警備）は行き先を自分で決める（→設計メモ「割り振りの形」）
	場所 = 0
	IF 仕事 > 0
		場所 = 仕事の場所:仕事
		SIF 場所 == 0
			場所 = 巡回の行き先(仕事)
	ENDIF

	IF 勤務中:番号:0
		;上がり。営業が終わったか、日が変わって休みになったら寮へ帰る
		IF !営業中(現在時刻) || 仕事 == 0
			CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%は上がった")
			;同棲していれば自宅の自分の部屋へ（→行動.ERB「同棲」）
			CFLAG:番号:現在位置 = 住まい(番号)
			勤務中:番号:0 = 0
			休息中:番号:0 = 0
		ELSEIF 裏の相手:番号:0 > 0
			;個室で裏の仕事の最中。持ち場へは戻さない（→設計メモ「裏メニューはシフトに載せない」）
			CONTINUE
		ELSEIF 休息中:番号:0
			;控室で戻す。両方が線まで戻れば持ち場へ（→設計メモ「体力と気力」：尽きる前に自ら控室へ下がって戻る）
			CALL 休息する(番号)
			IF 休息が足りたか(番号)
				休息中:番号:0 = 0
				CFLAG:番号:現在位置 = 場所
				CALL 見える(場所, @"%CALLNAME:番号%が持ち場に戻った")
			ENDIF
		ELSEIF 休息が要るか(番号)
			;尽きる前に控室へ下がる
			CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%は控室に下がった")
			休息中:番号:0 = 1
			今日の休息 += 1
			CFLAG:番号:現在位置 = 控室の位置
		ELSE
			;持ち場（巡回なら今の行き先）へ。勤務で減る（接客・フロアは気力も）
			CFLAG:番号:現在位置 = 場所
			CALL 勤務で減る(番号, 仕事)
			CALL 仕事をする(番号, 仕事)
		ENDIF
		CONTINUE
	ENDIF

	;出勤するのは、店に居ない（寮か外）ときだけ。客として来ている間は客のまま
	SIF !営業中(現在時刻) || 仕事 == 0
		CONTINUE
	SIF CFLAG:番号:現在位置 > 0 && CFLAG:番号:現在位置 < 100
		CONTINUE
	;給料は働いた日だけ出る（→設計メモ「スタッフ」）
	今日の給料 += 給料(番号)
	勤務中:番号:0 = 1
	CFLAG:番号:現在位置 = 場所
	CALL 見える(場所, @"%CALLNAME:番号%が%仕事名:仕事%に入った")
NEXT


;================================ 勤務の消耗と休息 ================================
;（→設計メモ「体力と気力」：NPCは勤務で減り、休息で戻る。普通に働く分には割らない。割るのは休息が足りていないときだけ）
@勤務で減る(番号, 仕事)
#DIM 番号
#DIM 仕事

;尽きれば気絶する（→気絶.ERB。普通は 休息に入る率 で先に控室へ下がるので起きない）
IF 仕事 == 1 || 仕事 == 2 || 仕事 == 11 || 仕事 == 12 || 仕事 == 仕事_ストリップ || 仕事 == 仕事_客参加ショー
	CALL 体力気力を減らす(番号, 勤務の体力, 勤務の気力)
ELSE
	CALL 体力気力を減らす(番号, 勤務の体力, 0)
ENDIF


;体力か気力が上限の 休息に入る率％ を割った
@休息が要るか(番号)
#FUNCTION
#DIM 番号

RETURNF BASE:番号:体力 * 100 < MAXBASE:番号:体力 * 休息に入る率 || BASE:番号:気力 * 100 < MAXBASE:番号:気力 * 休息に入る率


;両方が上限の 休息を終える率％ まで戻った
@休息が足りたか(番号)
#FUNCTION
#DIM 番号

RETURNF BASE:番号:体力 * 100 >= MAXBASE:番号:体力 * 休息を終える率 && BASE:番号:気力 * 100 >= MAXBASE:番号:気力 * 休息を終える率


;控室で1ティックぶん戻す
@休息する(番号)
#DIM 番号

;回復早い／回復遅い（→Talent.csv の体質）
BASE:番号:体力 += 体質の倍率(番号, 休息の回復, GETNUM(TALENT, "回復早い"), GETNUM(TALENT, "回復遅い"))
SIF BASE:番号:体力 > MAXBASE:番号:体力
	BASE:番号:体力 = MAXBASE:番号:体力
BASE:番号:気力 += 体質の倍率(番号, 休息の回復, GETNUM(TALENT, "回復早い"), GETNUM(TALENT, "回復遅い"))
SIF BASE:番号:気力 > MAXBASE:番号:気力
	BASE:番号:気力 = MAXBASE:番号:気力


;日替わり。NPC は寝たものとして上限へ（効率の差を持つのは主人公だけ → 設計メモ「体力と気力」）。ストレスの日替わりの後に呼ぶ
@NPCの休養(番号)
#DIM 番号

BASE:番号:体力 = MAXBASE:番号:体力
BASE:番号:気力 = MAXBASE:番号:気力


;巡回の仕事の行き先。清掃はいちばん汚れている場所、警備は迷惑客の居る場所。
;どちらも無ければ控室で待つ（→設計メモ「割り振りの形」）
@巡回の行き先(仕事)
#FUNCTION
#DIM 仕事
#DIM 場所
#DIM 最悪
#DIM 行き先

;警備は迷惑客の所へ
IF 仕事 == 6
	SIF 迷惑客の場所 > 0
		RETURNF 迷惑客の場所
	RETURNF 7
ENDIF

;清掃は汚れの高い場所へ。使用中の個室には入らない（→設計メモ「割り振りの形」）
最悪 = 0
行き先 = 7
FOR 場所, 0, 100
	SIF GET_PLACE_NAME(場所) == "" || 汚れ:場所 <= 0
		CONTINUE
	SIF 場所 >= 20 && 場所 < 20 + 個室数 && 個室の使用者(場所)
		CONTINUE
	IF 汚れ:場所 > 最悪
		最悪 = 汚れ:場所
		行き先 = 場所
	ENDIF
NEXT
RETURNF 行き先


;その個室に誰か居るか
@個室の使用者(場所)
#FUNCTION
#DIM 場所
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && CFLAG:番号:現在位置 == 場所
		RETURNF 番号
NEXT
RETURNF 0


;持ち場に立っている間、ティックごとに仕事をする。人数が増えれば効果も増える（→設計メモ「割り振りの形」）
@仕事をする(番号, 仕事)
#DIM 番号
#DIM 仕事
#DIM 位置

位置 = CFLAG:番号:現在位置

SELECTCASE 仕事
	CASE 7
		;清掃。居る場所の汚れを落とす。落とすものがあった回だけ経験
		IF 汚れ:位置 > 0
			CALL 汚れを足す(位置, 0 - 清掃の落ち * ABL:番号:清掃)
			CALL 経験を積む(番号, 技能_清掃, 接客の経験)
		ENDIF
	CASE 4, 5, 10, 13, 15
		;歌・踊り・演奏。間隔を置いて披露する。効くのは立っている舞台が見える客（1階の舞台ならホールとボックス席、地下ステージなら地下ホール → 設計メモ「技能」）
		CALL スタッフの披露(番号, 仕事)
	CASE 仕事_ストリップ
		;地下ステージで脱ぎながら踊る（→画面イメージ「地下のステージと手出し」）
		CALL スタッフのストリップ(番号)
	CASE 仕事_客参加ショー
		;地下ホールの客を一人ステージに上げて、体を触らせる
		CALL スタッフの客参加ショー(番号)
	CASE 仕事_セクシーダンス, 仕事_縛りショー, 仕事_自慰ショー, 仕事_二人ショー, 仕事_客参加本番
		;2026-09-16 に足した演目（→画面イメージ「演目を増やす」）
		CALL スタッフの演目(番号, 仕事)
	CASE 1, 2, 11, 12
		;接客（カウンター）とフロア担当（ホール）。注文をとる。フロアは配膳も持つ（→設計メモ「仕事の一覧」）。
		;地下の担当（11・12）も同じことをする。客は端末で頼むので、持ち場から離れなくてよい
		SIF 仕事 == 2 || 仕事 == 12
			CALL スタッフが料理を出す(番号)
		CALL スタッフが注文をとる(番号)
	CASE 3
		;調理。端末に届いている注文を作る
		CALL スタッフが料理を作る(番号)
	CASE 8
		;広報。その日1回、翌日の客足を上げる。評判は上げない（→設計メモ「経済の輪」）
		IF !今日広報した:番号:0
			今日広報した:番号:0 = 1
			広報の効き += スタッフ広報の率 * ABL:番号:広報
			CALL 見える(位置, @"%CALLNAME:番号%が店の告知を流した")
			CALL 経験を積む(番号, 技能_広報, 接客の経験)
		ENDIF
ENDSELECT
;警備は人数でLvを合算するので、一人ずつではなく @迷惑客のティック でまとめて判定する（→設計メモ「迷惑客」）


;注文をとる。まだ注文をとっていない客を一人選ぶ。満足度と、その相手への好感度の両方が上がる（→設計メモ「仕事の一覧」）。
;カウンターの接客もホールのフロア担当も同じことをする（客は端末で頼むので、持ち場から離れなくてよい）
@スタッフが注文をとる(働く人)
#DIM 働く人
#DIM 番号
#DIM 相手
#DIM 候補, 500
#DIM 数
#DIM 品
#DIM 飲

数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || 注文済:番号:0
		CONTINUE
	SIF スタッフ:番号:0 && 勤務中:番号:0
		CONTINUE
	SIF !客の席か(CFLAG:番号:現在位置)
		CONTINUE
	候補:数 = 番号
	数 += 1
NEXT
SIF 数 == 0
	RETURN 0
相手 = 候補:(RAND:数)

注文済:相手:0 = 1
満足度:相手:0 += 注文の満足度 + ABL:働く人:会話 * 2
SIF 満足度:相手:0 > 満足度上限
	満足度:相手:0 = 満足度上限
;接客は好感度にも効く（主人公の「注文をとる」は好感度を上げないが、スタッフは持ち場として応対する）。容姿で伸びが変わる
;友情の伸び の確率でだけ上がる（幅が小さいので幅を削らず確率で遅くする）
SIF RAND(100) < 友情の伸び
	好感度_友情:相手:働く人 += 接客の好感度 * 容姿(働く人) / 容姿の基準

;客が頼むものを決める。飲み物はその場で出る
飲 = 客が選ぶ飲み物(相手)
SIF 飲 >= 0
	今日使える額:相手:0 -= 飲み物材料費:飲 * 売値の倍率
品 = 客が選ぶ品目(相手)
SIF 飲 >= 0
	今日使える額:相手:0 += 飲み物材料費:飲 * 売値の倍率
IF 品 >= 0
	注文品目:相手:0 = 品
	注文状態:相手:0 = 1
	注文時点:相手:0 = 経過日数 * 1440 + 現在時刻
ENDIF
SIF 飲 >= 0
	CALL 一杯飲む(相手, 飲)

CALL 見える(CFLAG:相手:現在位置, @"%CALLNAME:働く人%が%CALLNAME:相手%の注文をとった")
CALL 経験を積む(働く人, 技能_会話, 接客の経験)


;客が座る席か（ホールとボックス席。地下が建っていれば地下ホールも）
@客の席か(位置)
#FUNCTION
#DIM 位置

SIF 地下あり && 位置 == 地下ホールの位置
	RETURNF 1
RETURNF 位置 == 3 || (位置 >= 80 && 位置 < 80 + ボックス席数)


;================================ 地下（会員制） ================================
;会員＝裏メニューを受けた回数（商品回数の合計）が 会員の線 以上の客（2026-09-15 ユーザ指定 → 画面イメージ「地下」）。
;主人公が渡す会員証は無い。線を越えた客は次の来店から自分で地下へ降りる
@会員か(番号)
#FUNCTION
#DIM 番号

SIF 番号 <= 0 || !実キャラ:番号:0
	RETURNF 0
RETURNF 裏を受けた回数(番号) >= 会員の線


;裏メニューを受けた回数（商品回数の合計）。会員の線と見える化（→画面イメージ「会員の見える化」）が同じ数を見る
@裏を受けた回数(番号)
#FUNCTION
#DIM 番号
#DIM 商品
#DIM 合計

合計 = 0
FOR 商品, 0, 商品枠
	合計 += 商品回数:番号:商品
NEXT
RETURNF 合計


;回数を足した後に呼ぶ。線を越えた客はリザルトの出来事に（→画面イメージ「今日の結果」）。スタッフと主人公は数えない
@会員化を見る(番号, 前)
#DIM 番号
#DIM 前

SIF 前 || 番号 == MASTER || スタッフ:番号:0 || !会員か(番号)
	RETURN 0
CALL 出来事を記す(@"%CALLNAME:番号%が会員になった")


;会員の数（店の持ち主なので数だけは分かる → サイド領域）。スタッフは数えない（裏を提供しても回数が貯まるため。→画面イメージ「会員の見える化」）
@会員数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !スタッフ:番号:0 && 会員か(番号)
		数 += 1
NEXT
RETURNF 数


;あと1回で会員になる客の数（回数が 会員の線 − 1。スタッフは数えない）
@会員まであと1回の数
#FUNCTION
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF 実キャラ:番号:0 && !スタッフ:番号:0 && 裏を受けた回数(番号) == 会員の線 - 1
		数 += 1
NEXT
RETURNF 数


;その客の会員状況を一句に。「裏メニュー 1回　会員まであと2回」「裏メニュー 5回　会員」。地下が未建設なら会員の後ろに但し書き
;@引数 降りる＝1 なら「（地下ホールに降りる）」などを添える（能力表示用。勧める画面は添えない）
@会員状況の文(番号, 降りる = 0)
#FUNCTIONS
#DIM 番号
#DIM 降りる
#DIM 回

回 = 裏を受けた回数(番号)
IF 回 < 会員の線
	RETURNF @"裏メニュー {回}回　会員まであと{会員の線 - 回}回"
ENDIF
SIF !降りる
	RETURNF @"裏メニュー {回}回　会員"
SIF 地下あり
	RETURNF @"裏メニュー {回}回　会員（地下ホールに降りる）"
RETURNF @"裏メニュー {回}回　会員（地下を建てれば降りる）"


;その場所に居る客の数（勤務中のスタッフは数えない）
@客の数(位置)
#FUNCTION
#DIM 位置
#DIM 番号
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 位置
		CONTINUE
	SIF スタッフ:番号:0 && 勤務中:番号:0
		CONTINUE
	数 += 1
NEXT
RETURNF 数


;地下勤務中か。地下の仕事に就いていて（勤務中で地下に居て）「地下勤務」に同意している者。
;客の手出しが全部出て必ず通り、警備も入らない（→画面イメージ「地下のステージと手出し」）
@地下勤務中か(番号)
#FUNCTION
#DIM 番号
#DIM 位置

SIF 番号 <= 0 || !実キャラ:番号:0 || !スタッフ:番号:0 || !勤務中:番号:0
	RETURNF 0
位置 = CFLAG:番号:現在位置
SIF 位置 < 地下ホールの位置 || 位置 > 地下ステージの位置
	RETURNF 0
RETURNF 同意しているか(番号, 商品_地下勤務)


;================================ 地下のステージ ================================
;ストリップと客参加ショーはシフトの仕事（商品ではない。2026-09-15 ユーザ指定）。主人公も同じ処理を通る（行動.ERB）

;ストリップの効き。見ている客（地下ホール）の満足度と性欲が上がる。クールタイムは踊りと共用。効いた人数を返す
@ストリップが効く(番号)
#FUNCTION
#DIM 番号
#DIM 相手
#DIM 今
#DIM 幅
#DIM 効いた
#DIM 払い

今 = 経過日数 * 1440 + 現在時刻
幅 = ストリップの満足度 + ABL:番号:舞踏 * 3
効いた = 0
FOR 相手, 1, キャラ枠
	SIF !実キャラ:相手:0 || CFLAG:相手:現在位置 != 地下ホールの位置
		CONTINUE
	SIF スタッフ:相手:0 && 勤務中:相手:0
		CONTINUE
	;演目の途中で気絶して舞台に残っている人は見ていない（→気絶.ERB）
	SIF 気絶中:相手:0
		CONTINUE
	SIF 披露クールタイム:相手:1 > 今
		CONTINUE
	満足度:相手:0 += 幅
	SIF 満足度:相手:0 > 満足度上限
		満足度:相手:0 = 満足度上限
	BASE:相手:性欲 += ストリップの性欲
	SIF BASE:相手:性欲 > MAXBASE:相手:性欲
		BASE:相手:性欲 = MAXBASE:相手:性欲
	披露クールタイム:相手:1 = 今 + 披露のクールタイム
	払い = 投げ銭を受ける(相手, 幅, 番号)
	効いた += 1
NEXT
払い = おひねりを見せる()
;演者は恥ずかしい。脱ぎ慣れる
PALAM:番号:羞恥 += ストリップの羞恥
開発度_慣れ:番号:0 += 1
RETURNF 効いた


@スタッフのストリップ(番号)
#DIM 番号
#DIM 今
#DIM 効いた

今 = 経過日数 * 1440 + 現在時刻
SIF 次の披露:番号:0 > 今
	RETURN 0
次の披露:番号:0 = 今 + 披露の間隔

;誰も見ていなくても練習として踊る（披露と同じ）
効いた = ストリップが効く(番号)
CALL 見える(地下ホールの位置, @"%CALLNAME:番号%がステージで服を脱ぎながら踊っている")
CALL 見える(地下ステージの位置, @"%CALLNAME:番号%がステージで服を脱ぎながら踊っている")
CALL 経験を積む(番号, 技能_舞踏, 接客の経験)


;客参加ショーに上げる客。地下ホールに居る客（勤務中のスタッフ・離席中・演目の途中で気絶した人は除く）からランダム。居なければ 0
@ショーに上げる客
#FUNCTION
#DIM 番号
#DIM 候補, 64
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 地下ホールの位置
		CONTINUE
	SIF (スタッフ:番号:0 && 勤務中:番号:0) || 気絶中:番号:0
		CONTINUE
	SIF 数 >= 64
		BREAK
	候補:数 = 番号
	数 += 1
NEXT
SIF 数 == 0
	RETURNF 0
RETURNF 候補:(RAND:数)


;上がった客が演者に手を通す。手は 客参加の手数 だけ（見つめる・えっちな話・腰・スカートは除く）。
;買ってある個室の設備（縄・目隠し・ボールギャグ・鞭・カメラ）は設備の手として候補に加わる（2026-09-16 ユーザ指定。演者が主人公でも同じ）
;通った手の値は自律セクハラと同じ（@セクハラを受ける）。演者→客の体の段が上がる。上がった客の満足度と、見ていた客の満足度
@客参加ショーを行う(演者, 客)
#DIM 演者
#DIM 客
#DIM 回
#DIM 手
#DIM 相手
#DIM 前
#DIM 候補, 16
#DIM 数
#DIM 払い

CALL 見える(地下ホールの位置, @"%CALLNAME:客%がステージに上げられた")
CALL 見える(地下ステージの位置, @"%CALLNAME:客%がステージに上げられた")
;体に触れる(2)・尻(5)・胸(6)・股間(7)・キス(8) と、買ってある設備の手
候補:0 = 2
候補:1 = 5
候補:2 = 6
候補:3 = 7
候補:4 = 8
数 = 5
FOR 手, 設備の手の最初, セクハラ数
	SIF セクハラの元行為:手 < 0 || 行為の要る設備:(セクハラの元行為:手) < 0 || !個室の設備:(行為の要る設備:(セクハラの元行為:手))
		CONTINUE
	候補:数 = 手
	数 += 1
NEXT
FOR 回, 0, 客参加の手数
	手 = 候補:(RAND:数)
	CALL セクハラを受ける(演者, 客, 手)
	IF 演者 == MASTER
		PRINTFORM %CALLNAME:客%%主人公へのセクハラの文:手%
		IF 手 == セクハラ_股間
			CALL 股間の様子を続ける(MASTER, 1)
		ELSE
			PRINTL
		ENDIF
		CALL 外の触れ方の口上(客, 手, 1)
	ELSE
		CALL 見える(地下ホールの位置, 自律セクハラの文(客, 演者, 手, 1))
		CALL 見える(地下ステージの位置, 自律セクハラの文(客, 演者, 手, 1))
		CALL NPC同士の触れ方の口上(客, 演者, 手, 地下ホールの位置, 地下ステージの位置)
	ENDIF
	;触れられた部位の快感が線に達していれば、その場で達する（演者が主人公なら主人公の画面に出す。NPC なら一行だけ見せる）
	IF 演者 == MASTER
		CALL 触れられて達する(MASTER, 1, 手)
	ELSE
		CALL NPCが触れられて達する(演者, 手, 地下ホールの位置, 地下ステージの位置)
	ENDIF
NEXT
IF 演者 == MASTER
	好感度_体:客:0 += 1
ELSE
	前 = 好感度の段(好感度_体:演者:客)
	好感度_体:演者:客 += 1
	SIF 好感度の段(好感度_体:演者:客) > 前
		CALL 記憶に残す(演者, @"ステージで%CALLNAME:客%に触れられて、体が近づいた（%体の段名:好感度の段(好感度_体:演者:客)%）")
ENDIF
満足度:客:0 += 客参加の満足度
SIF 満足度:客:0 > 満足度上限
	満足度:客:0 = 満足度上限
;見ていた客
FOR 相手, 1, キャラ枠
	SIF !実キャラ:相手:0 || 相手 == 客 || CFLAG:相手:現在位置 != 地下ホールの位置
		CONTINUE
	SIF スタッフ:相手:0 && 勤務中:相手:0
		CONTINUE
	満足度:相手:0 += 客参加の見る満足度
	SIF 満足度:相手:0 > 満足度上限
		満足度:相手:0 = 満足度上限
	払い = 投げ銭を受ける(相手, 客参加の見る満足度, 演者)
NEXT
払い = おひねりを見せる()
CALL 記憶に残す(客, @"ステージに上げられて%CALLNAME:演者%の体に触れた")


@スタッフの客参加ショー(番号)
#DIM 番号
#DIM 今
#DIM 客

今 = 経過日数 * 1440 + 現在時刻
SIF 次の披露:番号:0 > 今
	RETURN 0
次の披露:番号:0 = 今 + 披露の間隔

客 = ショーに上げる客()
SIF 客 <= 0
	RETURN 0
;演目の間は気絶しても舞台に残る（→気絶.ERB）
CALL 演目に出る(番号)
CALL 演目に出る(客)
CALL 客参加ショーを行う(番号, 客)
CALL 経験を積む(番号, 技能_会話, 接客の経験)
CALL 演目を終える(番号)
CALL 演目を終える(客)


;================================ 地下の演目（2026-09-16 に足した分。→画面イメージ「演目を増やす」） ================================
;型はストリップ・客参加ショーと同じ：`披露の間隔` ごとに1回、地下ホールの客に効き、演者の値が動く。主人公も同じ処理を通る（行動.ERB）

;投げ銭。見ている客（地下ホール）が 満足度の上がり幅×投げ銭の率 だけ払う（→画面イメージ「地下の入場料と投げ銭」）。払った額を返す。
;出るのは演者が地下ステージに居るときだけ（1階の舞台では出ない）。今日使える額の残りが上限。店の売上に入り、演者がスタッフなら 分け前の率 を分け前に積む。
;客ごとには文を出さず、一回の披露の最後に @おひねりを見せる が一行にまとめる
@投げ銭を受ける(客, 幅, 演者)
#FUNCTION
#DIM 客
#DIM 幅
#DIM 演者
#DIM 額

SIF !地下あり || CFLAG:演者:現在位置 != 地下ステージの位置 || CFLAG:客:現在位置 != 地下ホールの位置
	RETURNF 0
額 = 幅 * 投げ銭の率
SIF 額 > 今日使える額:客:0
	額 = 今日使える額:客:0
SIF 額 <= 0
	RETURNF 0
今日使える額:客:0 -= 額
今日の売上 += 額
今日の売上_投げ銭 += 額
今回の投げ銭 += 額
SIF 演者 != MASTER && スタッフ:演者:0
	今日の分け前 += 額 * 分け前の率 / 100
RETURNF 額


;一回の披露で集まった投げ銭を一行で見せて 0 に戻す。出なかったら何もしない。
;披露の効きは #FUNCTION なので CALL が使えず、式で呼ぶために #FUNCTION にしてある（返すのは 0）
@おひねりを見せる
#FUNCTION
#DIMS 文

SIF 今回の投げ銭 <= 0
	RETURNF 0
文 '= @"客席からおひねりが飛んだ（%金額(今回の投げ銭, 0)%円）"
今回の投げ銭 = 0
;@見える は CALL なので #FUNCTION からは呼べない。地下ホールかステージに居るときだけ出す、を直に書く
SIF CFLAG:MASTER:現在位置 == 地下ホールの位置 || CFLAG:MASTER:現在位置 == 地下ステージの位置
	PRINTFORML %文%
RETURNF 0


;見ている客（地下ホール。勤務中のスタッフと 除く は外す）に満足度と性欲。クールタイムは 段（0歌 1舞踏 2演奏）で披露と共用。効いた人数を返す
@ショーが効く(番号, 幅, 性欲幅, 段, 除く)
#FUNCTION
#DIM 番号
#DIM 幅
#DIM 性欲幅
#DIM 段
#DIM 除く
#DIM 相手
#DIM 今
#DIM 効いた
#DIM 払い

今 = 経過日数 * 1440 + 現在時刻
効いた = 0
FOR 相手, 1, キャラ枠
	SIF !実キャラ:相手:0 || 相手 == 除く || CFLAG:相手:現在位置 != 地下ホールの位置
		CONTINUE
	SIF (スタッフ:相手:0 && 勤務中:相手:0) || 気絶中:相手:0
		CONTINUE
	SIF 披露クールタイム:相手:段 > 今
		CONTINUE
	満足度:相手:0 += 幅
	SIF 満足度:相手:0 > 満足度上限
		満足度:相手:0 = 満足度上限
	BASE:相手:性欲 += 性欲幅
	SIF BASE:相手:性欲 > MAXBASE:相手:性欲
		BASE:相手:性欲 = MAXBASE:相手:性欲
	披露クールタイム:相手:段 = 今 + 披露のクールタイム
	払い = 投げ銭を受ける(相手, 幅, 番号)
	効いた += 1
NEXT
払い = おひねりを見せる()
RETURNF 効いた


;演者に入る値：個室の行為の値（@行為の値を入れる。耐性・慣れ・体質で変わる）＋公開の羞恥。慣れ＋1
@演目の値(番号, 行為, 側, 羞恥)
#DIM 番号
#DIM 行為
#DIM 側
#DIM 羞恥

SIF 行為 >= 0
	CALL 行為の値を入れる(番号, 行為, 側)
IF 羞恥 > 0
	PALAM:番号:羞恥 += 羞恥
	SIF PALAM:番号:羞恥 > PALAM上限
		PALAM:番号:羞恥 = PALAM上限
ENDIF
開発度_慣れ:番号:0 += 1


;セクシーダンス（脱がない。ストリップの軽い版）。RESULT＝効いた人数
@セクシーダンスを行う(番号)
#DIM 番号
#DIM 効いた

効いた = ショーが効く(番号, セクシーダンスの満足度 + ABL:番号:舞踏 * 3, セクシーダンスの性欲, 1, 0)
CALL 演目の値(番号, -1, 0, セクシーダンスの羞恥)
RESULT = 効いた


;縛りショー（縄で縛られた姿で舞台に立つ。設備 縄 が要る）。RESULT＝効いた人数
@縛りショーを行う(番号)
#DIM 番号
#DIM 効いた

効いた = ショーが効く(番号, 縛りショーの満足度 + ABL:番号:舞踏 * 3, 縛りショーの性欲, 1, 0)
CALL 演目の値(番号, 演目の行為_縄, 0, 縛りショーの羞恥)
RESULT = 効いた


;自慰ショー。演者は「自慰して見せる」の提供側の値（性器の快感・羞恥・欲情）。RESULT＝効いた人数
@自慰ショーを行う(番号)
#DIM 番号
#DIM 効いた

効いた = ショーが効く(番号, 自慰ショーの満足度, 自慰ショーの性欲, 1, 0)
CALL 演目の値(番号, 演目の行為_自慰, 1, 0)
RESULT = 効いた


;二人ショーの相手。19 に居る地下勤務中のスタッフで、二人ショーに同意している別の者（スタッフ同士なら同じ仕事に就いている者）。居なければ 0。
;演目の途中で気絶して舞台に残っている者は除く（→気絶.ERB）
@二人ショーの相手(番号)
#FUNCTION
#DIM 番号
#DIM 甲

FOR 甲, 1, キャラ枠
	SIF 甲 == 番号 || !地下勤務中か(甲) || CFLAG:甲:現在位置 != 地下ステージの位置 || 気絶中:甲:0 || 舞台に立っているか(甲)
		CONTINUE
	SIF !同意しているか(甲, 商品_二人ショー)
		CONTINUE
	SIF 番号 != MASTER && シフト:甲:営業曜日 != 仕事_二人ショー
		CONTINUE
	RETURNF 甲
NEXT
RETURNF 0


;二人ショー。二人とも 愛撫＋キス の受け手の値＋羞恥。互いの体の段が＋1。RESULT＝効いた人数
@二人ショーを行う(甲, 乙)
#DIM 甲
#DIM 乙
#DIM 効いた

効いた = ショーが効く(甲, 二人ショーの満足度, 二人ショーの性欲, 1, 0)
CALL 演目の値(甲, 演目の行為_愛撫, 0, 二人ショーの羞恥)
CALL 演目の値(甲, 演目の行為_キス, 0, 0)
CALL 演目の値(乙, 演目の行為_愛撫, 0, 二人ショーの羞恥)
CALL 演目の値(乙, 演目の行為_キス, 0, 0)
CALL 体の段を進める(甲, 乙, 1, "舞台で体を重ねて")
CALL 体の段を進める(乙, 甲, 1, "舞台で体を重ねて")
RESULT = 効いた


;甲→乙 の体の段を進める（主人公が絡むときは 相手→主人公 の値しか無いのでそれ）。段が上がれば甲の記憶に残す
@体の段を進める(甲, 乙, 幅, 文)
#DIM 甲
#DIM 乙
#DIM 幅
#DIMS 文
#DIM 前

IF 甲 == MASTER
	好感度_体:乙:0 += 幅
	RETURN 0
ENDIF
IF 乙 == MASTER
	前 = 好感度の段(好感度_体:甲:0)
	好感度_体:甲:0 += 幅
	SIF 好感度の段(好感度_体:甲:0) > 前
		CALL 記憶に残す(甲, @"%文%、あなたと体が近づいた（%体の段名:好感度の段(好感度_体:甲:0)%）")
	RETURN 0
ENDIF
前 = 好感度の段(好感度_体:甲:乙)
好感度_体:甲:乙 += 幅
SIF 好感度の段(好感度_体:甲:乙) > 前
	CALL 記憶に残す(甲, @"%文%、%CALLNAME:乙%と体が近づいた（%体の段名:好感度の段(好感度_体:甲:乙)%）")


;裏の仕事で近づく。受けた側→出た側は3軸とも、出た側→受けた側は体だけ（金で買った関係なので、友情・恋愛は客の側にしか残らない）。
;主人公の側の好感度は持っていないので、主人公が出たときは客→主人公だけ。段が上がれば記憶に（→@体の段を進める）
@裏で近づく(提供, 受け手, 幅)
#DIM 提供
#DIM 受け手
#DIM 幅

SIF 幅 <= 0
	RETURN 0
;客からの好感度の伸びは提供側の容姿で変わる（→画面イメージ「個室の中」の容姿）。体の段はそのままの幅
IF 提供 == MASTER
	好感度_友情:受け手:0 += 幅 * 容姿(MASTER) / 容姿の基準
	好感度_恋愛:受け手:0 += 幅 * 容姿(MASTER) / 容姿の基準
ELSE
	好感度_友情:受け手:提供 += 幅 * 容姿(提供) / 容姿の基準
	好感度_恋愛:受け手:提供 += 幅 * 容姿(提供) / 容姿の基準
	CALL 体の段を進める(提供, 受け手, 幅, "個室で過ごして")
ENDIF
CALL 体の段を進める(受け手, 提供, 幅, "個室で過ごして")


;客参加本番に上げる客。地下ホールに居る男性器のある客からランダム。居なければ 0。
;精力要る＝1 なら精力が残っている客だけ（出産ショーのお迎え棒。必ず中に出させるので → 「出産ショー」）
@本番に上げる客(精力要る = 0)
#FUNCTION
#DIM 精力要る
#DIM 番号
#DIM 候補, 64
#DIM 数

数 = 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != 地下ホールの位置
		CONTINUE
	SIF (スタッフ:番号:0 && 勤務中:番号:0) || 気絶中:番号:0
		CONTINUE
	SIF !(性別ビット(番号) & 5)
		CONTINUE
	SIF 精力要る && BASE:番号:精力 <= 0
		CONTINUE
	SIF 数 >= 64
		BREAK
	候補:数 = 番号
	数 += 1
NEXT
SIF 数 == 0
	RETURNF 0
