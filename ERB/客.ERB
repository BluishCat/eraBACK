	CALL 見える(CFLAG:する側:現在位置, @"%CALLNAME:番号%が間に入った。%CALLNAME:する側%はばつが悪そうに引き下がった", @"%GET_PLACE_NAME(CFLAG:する側:現在位置)%のほうの騒ぎが収まったようだ")
	CALL 記憶に残す(番号, @"%CALLNAME:する側%が%CALLNAME:される側%に手を出したのを止めた")
