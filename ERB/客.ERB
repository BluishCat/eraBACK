舞台 = CFLAG:番号:現在位置
客席 = 3
SIF 舞台 == 地下ステージの位置
	客席 = 地下ホールの位置
効いた = 披露が効く(番号, 技能)
IF 技能 == 技能_歌唱
	CALL 見える(客席, @"%CALLNAME:番号%が舞台で歌っている")
	CALL 見える(舞台, @"%CALLNAME:番号%が舞台で歌っている", @"舞台で%CALLNAME:番号%が歌いはじめた")
ELSEIF 技能 == 技能_演奏
	CALL 見える(客席, @"%CALLNAME:番号%が舞台で演奏している")
