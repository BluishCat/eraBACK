;系統ごとに、開発度が動く部位（M口 B胸 Cクリ V膣 A尻 P男性器）。性別に無い部位は -1
@系統の部位(系統, 番号)
#FUNCTION
#DIM 系統
#DIM 番号
#DIM 部位

SELECTCASE 系統
	CASE 3
		;接触は口
		部位 = 0
	CASE 4
		;本番は女性器のある性別なら膣、男性器なら男性器
		部位 = 3
		SIF !(部位のある性別:3 & 性別ビット(番号))
			部位 = 5
	CASE 5
		;特殊は尻
		部位 = 4
	CASEELSE
		RETURNF -1
ENDSELECT
SIF !(部位のある性別:部位 & 性別ビット(番号))
