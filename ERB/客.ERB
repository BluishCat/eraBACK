IF BASE:番号:精力 <= 0
	CALL 空打ちを見る(番号)
	今回の空打ち = 1
	CALL NPCの絶頂を見せる(番号, 部位_男性器, 場所, 場所2)
	今回の空打ち = 0
	RETURN 0
ENDIF
