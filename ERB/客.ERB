;居合わせた者同士の交流。在室者から数ペアを引き、同じ場所に居るペアだけ友情が上がる
;（→設計メモ「好感度は全キャラクター間に持つ」「時間進行の実装形」）
;長く居合わせた者ほど当たりやすいので、結果は「居合わせた分だけ上がる」に近づく。
;主人公は入れない。主人公との好感度は主人公が話しかけて上げるもの
;描写は出さない。NPC同士のことは無音で進む（→設計メモ「出力ゲート」）
@自律交流
#DIM 回
#DIM 甲
#DIM 乙
#DIM 前

SIF 在室者数 < 2
	RETURN 0

FOR 回, 0, 交流抽選数
	甲 = 在室者:RAND(在室者数)
	乙 = 在室者:RAND(在室者数)
	SIF 甲 == 乙 || CFLAG:甲:現在位置 != CFLAG:乙:現在位置
		CONTINUE
	;友情の伸び の確率でだけ当たる（幅が 1 なので幅を削らず確率で遅くする）
	SIF RAND(100) >= 友情の伸び
		CONTINUE
	;段が上がったときだけ、その向きの本人の記憶に残す（毎ティックの +1 は残さない。友情は向きごとの値なので別々に見る。→怪しい店.ERB「記憶」）
	前 = 好感度の段(好感度_友情:甲:乙)
	好感度_友情:甲:乙 += 交流の幅
	SIF 好感度の段(好感度_友情:甲:乙) > 前
		CALL 記憶に残す(甲, @"%CALLNAME:乙%と親しくなった（%友情の段名:好感度の段(好感度_友情:甲:乙)%）")
	前 = 好感度の段(好感度_友情:乙:甲)
	好感度_友情:乙:甲 += 交流の幅
	SIF 好感度の段(好感度_友情:乙:甲) > 前
		CALL 記憶に残す(乙, @"%CALLNAME:甲%と親しくなった（%友情の段名:好感度の段(好感度_友情:乙:甲)%）")
NEXT


;玄関に現れる。滞在時間はここで引く
@来店(番号, 今)
#DIM 番号
#DIM 今
#DIM 滞在

来店予定:番号:0 = -1
;自宅で同棲している人は自分の部屋から出かける（→行動.ERB「同棲」）
SIF 同棲:番号:0 > 0 && CFLAG:番号:現在位置 == 同棲:番号:0
	CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%は店へ出かけていった")
;ホールが汚れていれば、入口で引き返す客が出る。来店には数えず、気分は下がる（2026-10-18 ユーザ指定「効かせる」）
IF 汚れで引き返すか()
	CALL 満足度を下げる(番号, 汚れで引き返した不満)
	今日の汚れで帰った += 1
	CALL 入口まわりに見える(8, @"%CALLNAME:番号%が店に入りかけたが、汚れに顔をしかめて引き返した", "玄関のほうで、誰かが引き返していった")
	RETURN 0
ENDIF
CFLAG:番号:現在位置 = 8
来店回数:番号:0 += 1
注文済:番号:0 = 0
注文状態:番号:0 = 0
会話累積:番号:0 = 0

;標準の滞在時間。未記入は90分。接客で伸縮するのはこれから
滞在 = CFLAG:番号:滞在時間中心
SIF 滞在 <= 0
	滞在 = 90
滞在 += ゆらぎ(CFLAG:番号:滞在時間ばらつき)

;今日使える額。評判から出し、素質 金持ち なら倍率を掛ける（→変数定義.ERH「今日使える額」の表。2026-09-22。それまで素質は効いていなかった）
今日使える額:番号:0 = 今日使える額の基本 + 評判 * 評判の額 + ゆらぎ(ゆらぎの基本 + 評判 * 評判のゆらぎ)
SIF TALENT:番号:金持ち
	今日使える額:番号:0 *= 金持ちの倍率

;満足の客は長居して金を使い、不満の客は早く帰って金を使わない（満足度％ぶん。2026-09-15 に満足の側も効かせた → 設計メモ「経済の輪」）
滞在 = 滞在 * (100 + 満足度:番号:0) / 100
今日使える額:番号:0 = 今日使える額:番号:0 * (100 + 満足度:番号:0) / 100
SIF 滞在 < 10
	滞在 = 10
SIF 今日使える額:番号:0 < 0
	今日使える額:番号:0 = 0
退店予定:番号:0 = 今 + 滞在

今日の来客 += 1
IF 連れ:番号:0 >= 0
	CALL 入口まわりに見える(8, @"%CALLNAME:番号%が%CALLNAME:(連れ:番号:0)%と一緒に店に入ってきた", @"玄関に%CALLNAME:番号%が%CALLNAME:(連れ:番号:0)%と一緒に入ってきた")
ELSE
	CALL 入口まわりに見える(8, @"%CALLNAME:番号%が店に入ってきた", @"玄関に%CALLNAME:番号%が入ってきた")
ENDIF
;行事の日はときどき一言（→行事.ERB）
CALL 行事の一言(番号)


;席を選ぶ。客が自分で選ぶ（→設計メモ「店内での居場所」）
;会員は地下ホールへ（ボックス席より先。席料の代わりに入場料 → 画面イメージ「地下」「地下の入場料と投げ銭」）。
;席料を払ってもまだ飲める額を持っていて、空きがあればボックス席。なければホール。好みで選ぶ分はこれから。
;連れ立って来た者は誘い主の席へ（ボックス席でも席料は取らない。会員に連れられれば会員でなくても地下に入れる）。誘い主がまだ玄関なら、座るのを待つ
@着席(番号)
#DIM 番号
#DIM 席
#DIM 誘い主

誘い主 = 連れ:番号:0
IF 誘い主 >= 0
	席 = CFLAG:誘い主:現在位置
	SIF 席 == 8
		RETURN 0
	IF 客の席か(席)
		CFLAG:番号:現在位置 = 席
		次の一杯:番号:0 = 経過日数 * 1440 + 現在時刻 + 一杯の間隔
		CALL 見える(席, @"%CALLNAME:番号%が%CALLNAME:誘い主%の席についた")
		RETURN 0
	ENDIF
	;誘い主が席に居ない（帰った・来なかった）なら自分で選ぶ
	連れ:番号:0 = -1
ENDIF

;席に着いたら間隔ごとに一杯頼む
次の一杯:番号:0 = 経過日数 * 1440 + 現在時刻 + 一杯の間隔

;入場料×2 の額が無い会員は降りない（その来店だけ1階の席へ。→画面イメージ「地下の入場料と投げ銭」）
IF 地下あり && 会員か(番号) && 今日使える額:番号:0 >= 地下の入場料 * 2
	今日使える額:番号:0 -= 地下の入場料
	今日の売上 += 地下の入場料
	今日の売上_入場 += 地下の入場料
	CFLAG:番号:現在位置 = 地下ホールの位置
	;降りていくところはホールから見える
	CALL 見える(3, @"%CALLNAME:番号%が地下へ降りていった")
	CALL 見える(地下ホールの位置, @"%CALLNAME:番号%が地下ホールの席についた")
	RETURN 0
ENDIF

席 = 空きボックス席()

IF 席 > 0 && 今日使える額:番号:0 >= ボックス席料 * 2
	CFLAG:番号:現在位置 = 席
	今日使える額:番号:0 -= ボックス席料
	今日の売上 += ボックス席料
	今日の売上_席 += ボックス席料
	;ボックス席に入るところはホールから見える。中で何をしているかは見えない（→設計メモ「出力ゲート」）
	CALL 見える(3, @"%CALLNAME:番号%が%GET_PLACE_NAME(席)%に入った", @"%GET_PLACE_NAME(席)%に誰かが入った")
	CALL 見える(席, @"%CALLNAME:番号%が%GET_PLACE_NAME(席)%に入ってきた")
ELSE
	CFLAG:番号:現在位置 = 3
	CALL 見える(3, @"%CALLNAME:番号%がホールの席についた", "ホールに客が一人入ってきた")
ENDIF


;ホールの汚れで客が入口から引き返すか。気になる線以下なら引き返さない（→変数定義.ERH「汚れが売上に響く」）
@汚れで引き返すか
#FUNCTION
#DIM 率

SIF 汚れ:3 <= 汚れの気になる線
	RETURNF 0
率 = (汚れ:3 - 汚れの気になる線) * 汚れで引き返す率
SIF 率 > 汚れで引き返す上限 * 10
	率 = 汚れで引き返す上限 * 10
RETURNF RAND(1000) < 率


;誰も居ないボックス席の番号。無ければ0。汚れがひどい席は客が避ける
@空きボックス席
#FUNCTION
#DIM 席

FOR 席, 80, 80 + ボックス席数
	SIF 汚れ:席 >= 席を避ける汚れ
		CONTINUE
	SIF ボックス席の使用者(席) == 0
		RETURNF 席
NEXT

RETURNF 0


;その席に居る客の番号。誰も居なければ0。トイレに立っている間も席は空けたままなので、その者の席として扱う（→「離席」）
@ボックス席の使用者(席)
#FUNCTION
#DIM 席
#DIM 番号

FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0
		CONTINUE
	SIF CFLAG:番号:現在位置 == 席
		RETURNF 番号
	SIF トイレか(CFLAG:番号:現在位置) && 離席元:番号:0 == 席
		RETURNF 番号
NEXT

RETURNF 0


;使われているボックス席の数。主人公が見ていなくても数だけは分かる（店の持ち主なので → 画面イメージ）
@ボックス席使用数
#FUNCTION
#DIM 席
#DIM 数

数 = 0
FOR 席, 80, 80 + ボックス席数
	SIF ボックス席の使用者(席) != 0
		数 += 1
NEXT

RETURNF 数


;================================ 離席 ================================
;客が一時的にトイレへ立つ（→変数定義.ERH「客のトイレ離席」）。席は空けたままで、戻れば同じ席。
;離席中は飲まない・指名しない・交流しない（在室者に入れない）。滞在時間は進む
@離席を引く(番号)
#FUNCTION
#DIM 番号

RETURNF RAND(100) < 離席の率 + BASE:番号:酔い / 100


@離席する(番号, 今)
#DIM 番号
#DIM 今

離席元:番号:0 = CFLAG:番号:現在位置
離席戻り:番号:0 = 今 + 離席の分
CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%がトイレに立った")
;地下ホールの客は地下のトイレへ（2026-09-15）
IF 地下あり && 離席元:番号:0 == 地下ホールの位置
	CFLAG:番号:現在位置 = 地下トイレの位置
ELSE
	CFLAG:番号:現在位置 = トイレの位置
ENDIF


;トイレか（1階の 10 と、地下の 79）
@トイレか(位置)
#FUNCTION
#DIM 位置

RETURNF 位置 == トイレの位置 || 位置 == 地下トイレの位置


@離席から戻る(番号, 今)
#DIM 番号
#DIM 今

SIF 離席戻り:番号:0 > 今
	RETURN 0
CFLAG:番号:現在位置 = 離席元:番号:0
離席元:番号:0 = 0
離席戻り:番号:0 = -1
CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%が席に戻ってきた")


@退店(番号)
#DIM 番号
#DIM 位置

位置 = CFLAG:番号:現在位置
;同棲している人は自宅の自分の部屋へ（→行動.ERB「同棲」）。それ以外は店の外の自分の家（世界から外れる）
CFLAG:番号:現在位置 = 0
SIF 同棲:番号:0 > 0
	CFLAG:番号:現在位置 = 同棲:番号:0
退店予定:番号:0 = -1
連れ:番号:0 = -1
離席元:番号:0 = 0
離席戻り:番号:0 = -1
;使い残した額は持ち越さない
今日使える額:番号:0 = 0
;料理を待たずに帰れば注文は消える。作ってあった分の材料費は戻らない（→画面イメージ「料理の流れ」）
注文状態:番号:0 = 0
次の一杯:番号:0 = -1

;満足なら評判が上がり、不満なら下がる。中立の幅の中なら動かない（→設計メモ「経済の輪」）。評判は 0〜評判の上限()（2026-09-15 数字採り：上限なしだと35日で677。上限は増築で上がる → @評判の上限）
IF 満足度:番号:0 >= 中立の幅
	評判 += 1
	SIF 評判 > 評判の上限()
		評判 = 評判の上限()
ELSEIF 満足度:番号:0 <= 0 - 中立の幅
	評判 -= 1
	SIF 評判 < 0
		評判 = 0
ENDIF

CALL 汚れを足す(位置, 退店の汚れ)
IF 同棲:番号:0 > 0 && 位置 >= 500 && 位置 < 600
	;自宅の中（添い寝の目覚めなど）なら自分の部屋へ戻るだけ。自分の部屋で目を覚ましたならそのまま
	SIF 位置 != 同棲:番号:0
		CALL 見える(位置, @"%CALLNAME:番号%は自分の部屋へ戻った")
ELSEIF 位置 < 100
	;店の中から帰る客。玄関・ホール・カウンター・舞台に居れば、別の席からでも帰るのが分かる
	CALL 入口まわりに見える(位置, @"%CALLNAME:番号%が帰っていった", @"%CALLNAME:番号%が玄関から帰っていった")
ELSE
	CALL 見える(位置, @"%CALLNAME:番号%が帰っていった")
ENDIF


;客が勝手に一杯頼む。払えるものからランダム。金が尽きるか泥酔の線を超えたら頼まなくなる（→画面イメージ「飲み物の流れ」）
;目の保養。同じ場所に居る勤務中のスタッフと主人公のうち、露出度がいちばん高い人を見て欲情が上がる（ティックごとに（露出度−露出の基礎）/目の保養の割。普段着なら 0）
@目の保養(客, 位置)
#DIM 客
#DIM 位置
#DIM 番号
#DIM 最高
#DIM 値

最高 = 0
SIF CFLAG:MASTER:現在位置 == 位置
	最高 = 露出度(MASTER)
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || !スタッフ:番号:0 || !勤務中:番号:0 || CFLAG:番号:現在位置 != 位置
		CONTINUE
	SIF 気絶中:番号:0 || 番号 == 客
		CONTINUE
	値 = 露出度(番号)
	SIF 値 > 最高
		最高 = 値
NEXT
値 = (最高 - 露出の基礎) / 目の保養の割
SIF 値 < 0
	値 = 0
;欲情しやすい行事の晩は、誰も露出していなくてもティックごとに足す（→行事.ERB）
値 += 行事の欲情()
SIF 値 <= 0
	RETURN 0
PALAM:客:欲情 += 値
SIF PALAM:客:欲情 > PALAM上限
	PALAM:客:欲情 = PALAM上限
CALL 理性を出す(客)


@勝手に飲む(番号, 今)
#DIM 番号
#DIM 今
#DIM 飲

飲 = 客が選ぶ飲み物(番号)
IF 飲 < 0 || 酔いすぎ(番号)
	次の一杯:番号:0 = -1
	RETURN 0
ENDIF
CALL 一杯飲む(番号, 飲)
次の一杯:番号:0 = 今 + 一杯の間隔
CALL 見える(CFLAG:番号:現在位置, @"%CALLNAME:番号%は%飲み物名:飲%を頼んだ")


;================================ 自律セクハラ ================================
;客とスタッフも自分から手を出す（→画面イメージ「セクハラは三者がする」。erablue_resort の AUTOCOM12_逆セクハラ に倣う。2026-09-15）。
;迷惑客（名無し）とは別の出来事。名前のあるキャラがするので、結果はその二人の関係に残る。
;手の表と通るかの式は主人公のもの（変数定義.ERH の セクハラ名〜、行動.ERB）を共有する。腰に手を回す（同行）は主人公だけの仕組みなので NPC は出さない
@自律セクハラ
#DIM 甲
#DIM する側
#DIM される側
#DIM 手

SIF 在室者数 < 1
	RETURN 0
FOR 甲, 0, 在室者数
	する側 = 在室者:甲
	SIF セクハラ回数:する側:0 >= 自律セクハラの上限 || セクハラ止め:する側:0
		CONTINUE
	;相手を先に引き、その相手への関係で率を出す（関係・性格・性欲・欲情・理性・酔い →画面イメージ「セクハラは三者がする」）
	される側 = セクハラの相手を引く(する側)
	SIF される側 < 0
		CONTINUE
	SIF RAND(100) >= 自律セクハラの起きる率(する側, される側)
		CONTINUE
	手 = 自律セクハラの手を引く(する側, される側)
	SIF 手 < 0
		CONTINUE
	セクハラ回数:する側:0 += 1
	IF される側 == MASTER
		CALL 主人公へのセクハラ(する側, 手)
	ELSE
		CALL NPCへのセクハラ(する側, される側, 手)
	ENDIF
NEXT


;起きる率（％）。基本 `自律セクハラの率` に係数（％）を掛け合わせる（2026-09-15 ユーザ指定「関係性や性格、性欲、欲情、理性も影響するはず」）：
;  性欲 50〜200（溜まるほど）／欲情 100＋段×50（上限300）／理性 200−理性×150/上限（理性が満タンで50、空で200）／酔い 100＋酔い×100/泥酔の線
;  関係 50＋体の段×25＋恋愛の段×15（する側→される側。上限300）／性格 口上タイプで（奔放200・甘え150・クール75・内気／上品／真面目50）、素質 手が早い ×300
;  される側の露出度 100＋（露出度−200）（上限300。→画面イメージ「個室の中」の露出度。2026-09-22）
;  上限は `自律セクハラの率の上限`
;  細かく＝1 なら 0.01％ 単位のまま返す（夜這いが基本率を替えて使う → 夜這い.ERB。低い率が 0 に丸まらないように）
@自律セクハラの起きる率(する側, される側, 細かく = 0)
#FUNCTION
#DIM する側
#DIM される側
#DIM 細かく
#DIM 率
#DIM 係数
#DIM 体
#DIM 恋
#DIMS タイプ

;100 倍で持って最後に戻す
率 = 自律セクハラの率 * 100
率 = 率 * (50 + BASE:する側:性欲 * 150 / MAXBASE:する側:性欲) / 100
係数 = 100 + PALAM:する側:欲情 / 欲情の一段 * 50
SIF 係数 > 300
	係数 = 300
率 = 率 * 係数 / 100
率 = 率 * (200 - PALAM:する側:理性 * 150 / 理性の上限) / 100
率 = 率 * (100 + BASE:する側:酔い * 100 / 泥酔の線) / 100
;関係（する側→される側）。主人公が相手なら する側→主人公 の値
IF される側 == MASTER
	体 = 好感度の段(好感度_体:する側:0)
	恋 = 好感度の段(好感度_恋愛:する側:0)
ELSE
	体 = 好感度の段(好感度_体:する側:される側)
	恋 = 好感度の段(好感度_恋愛:する側:される側)
ENDIF
係数 = 50 + 体 * 25 + 恋 * 15
SIF 係数 > 300
	係数 = 300
率 = 率 * 係数 / 100
;性格
タイプ '= 口上タイプ(する側)
SELECTCASE タイプ
	CASE "奔放"
		率 = 率 * 200 / 100
	CASE "甘え"
		率 = 率 * 150 / 100
	CASE "クール"
		率 = 率 * 75 / 100
	CASE "内気", "上品", "真面目", "無口"
		率 = 率 * 50 / 100
ENDSELECT
SIF TALENT:する側:手が早い
	率 = 率 * 300 / 100
;される側の露出が高いほど手が出やすい
係数 = 100 + 露出度(される側) - 露出の基礎
SIF 係数 > 300
	係数 = 300
SIF 係数 < 50
	係数 = 50
率 = 率 * 係数 / 100
;地下では手出しがOKなので、地下勤務中のスタッフには出やすい（→画面イメージ「地下のステージと手出し」）
SIF 地下勤務中か(される側)
	率 = 率 * 地下の手出しの倍率 / 100
IF 細かく
	SIF 率 > 自律セクハラの率の上限 * 100
		率 = 自律セクハラの率の上限 * 100
	RETURNF 率
ENDIF
率 = 率 / 100
SIF 率 > 自律セクハラの率の上限
	率 = 自律セクハラの率の上限
RETURNF 率


;================================ 逢引に誘われる ================================
;ティックごと（→@ティック処理）。主人公が誰かと二人きり（→施設.ERB @二人きりか）のときだけ、その人から誘われる（一日に一人まで）
@逢引のティック
#DIM 番号
#DIM 率

;眠っている間は誘われない。眠りのループは場面が開いても続き、閉じた後に相手の居ない逢引が残った（→夜這いは別に忍んで来る）
SIF 気絶中:MASTER:0 || 陣痛:MASTER:0 > 0 || 裏の相手:MASTER:0 > 0 || 逢引の日 == 経過日数 || 主人公が眠っている
	RETURN 0
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || CFLAG:番号:現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	SIF 気絶中:番号:0 || 陣痛:番号:0 > 0 || 舞台に立っているか(番号) || 裏の相手:番号:0 > 0
		CONTINUE
	SIF !二人きりか(番号) || !逢引の下限か(番号)
		CONTINUE
	;率は 0.01％ 単位で受けて、基本率を逢引用に替える（→夜這い.ERB @夜這いのティック と同じ形）
	率 = 自律セクハラの起きる率(番号, MASTER, 1) * 逢引に誘われる率 / 自律セクハラの率
	;セフレは誘ってくる率が倍（逢引を重ねた相手。→変数定義.ERH「逢引」）
	SIF TALENT:番号:セフレ
		率 = 率 * セフレの誘われる倍率
	SIF RAND(10000) >= 率
		CONTINUE
	逢引の日 = 経過日数
	CALL 逢引に誘われる(番号)
	RETURN 1
NEXT


;関係の下限：その人→主人公の 体の段 か 恋愛の段（→変数定義.ERH「逢引」。夜這いの下限と同じ形）
@逢引の下限か(番号)
#FUNCTION
#DIM 番号

SIF 好感度の段(好感度_体:番号:0) >= 逢引の体の下限
	RETURNF 1
RETURNF 好感度の段(好感度_恋愛:番号:0) >= 逢引の恋の下限


;誘われる。応じる／断る の二択。応じれば個室と同じ行為の一覧をいまの場所で開く（→個室.ERB「逢引」）
@逢引に誘われる(番号)
#DIM 番号
#DIMS 断られた文
#DIMS 受け入れられた文

PRINTL
IF 人気のない所へ移る場所か()
	PRINTFORML %CALLNAME:番号%が、人気のない所へ行きたそうに、あなたを見つめてきた
	断られた文 = 人気のない所へ誘ったが、断られた
	受け入れられた文 = 人気のない所へ誘い、受け入れられた
ELSE
	PRINTFORML ほかに誰も居なくなったところで、%CALLNAME:番号%があなたを見つめてきた
	断られた文 = 二人きりのときに誘ったが、断られた
	受け入れられた文 = 二人きりのときに誘い、受け入れられた
ENDIF
PRINTL 「……少し、いいですか」
PRINTL [1] 応じる　　[0] 断る
[IF_DEBUG]
;[1992] の日回しでは断る。デバッグ起動のときだけ（→デバッグ.ERB）
IF デバッグ自動応答
	RESULT = 0
ELSE
	INPUT
ENDIF
[ENDIF]
[IF_NDEBUG]
INPUT
[ENDIF]
IF RESULT != 1
	PRINTFORML %CALLNAME:番号%は寂しそうに引き下がった
	CALL 記憶に残す(番号, 断られた文)
	WAIT
	RETURN 0
ENDIF
CALL 記憶に残す(番号, 受け入れられた文)
WAIT
CALL 逢引の場面を開く(番号)


;同じ場所に居る 主人公／客／スタッフ から一人。主人公は重み3。個室の中の主人公・その日に断られた相手は除く。居なければ -1
@セクハラの相手を引く(する側)
#FUNCTION
#DIM する側
#DIM 候補, 64
#DIM 数
#DIM 甲
#DIM 位置

位置 = CFLAG:する側:現在位置
数 = 0
;（断られた相手は 番号＋1 で持つ。0 が「無し」。主人公は 0 なのでそのままだと区別できない）
IF CFLAG:MASTER:現在位置 == 位置 && 裏の相手:MASTER:0 <= 0 && セクハラ断られた:する側:0 != MASTER + 1
	REPEAT 自律セクハラの主人公の重み
		SIF 数 < 64
			候補:数 = MASTER
		数 += 1
	REND
ENDIF
FOR 甲, 0, 在室者数
	SIF 在室者:甲 == する側 || CFLAG:(在室者:甲):現在位置 != 位置 || セクハラ断られた:する側:0 == 在室者:甲 + 1
		CONTINUE
	SIF 数 >= 64
		BREAK
	候補:数 = 在室者:甲
	数 += 1
NEXT
SIF 数 == 0
	RETURNF -1
SIF 数 > 64
	数 = 64
RETURNF 候補:(RAND:数)


;出せる手からランダム。軽い手ほど出やすい（要る段 0＝3、1＝2、2以上＝1 の重み）。段に届かず相手も泥酔していない手は出ない。無ければ -1
@自律セクハラの手を引く(する側, される側)
#FUNCTION
#DIM する側
#DIM される側
#DIM 手
#DIM 段
#DIM 候補, 32
#DIM 数
#DIM 重み

;される側→する側 の体の関係の段（主人公が相手なら する側→主人公 の値しか無いのでそれ）
IF される側 == MASTER
	段 = 好感度の段(好感度_体:する側:0)
ELSE
	段 = 好感度の段(好感度_体:される側:する側)
ENDIF
数 = 0
FOR 手, 0, セクハラ数
	SIF 手 == セクハラ_腰
		CONTINUE
	;設備の手は、設備を買ってあり相手が地下勤務中のときだけ（→変数定義.ERH「設備の手」）
	SIF 手 >= 設備の手の最初 && !設備の手が使えるか(手, される側)
		CONTINUE
	;地下勤務中の相手には段を見ない（手出しOK →画面イメージ「地下のステージと手出し」）
	SIF セクハラの要る段:手 > 段 && !酔いすぎ(される側) && !地下勤務中か(される側)
		CONTINUE
	SIF 手 == セクハラ_スカート && !服の性質か(される側, 服_下, 性質_めくり可)
		CONTINUE
	重み = 3 - セクハラの要る段:手
	SIF 重み < 1
		重み = 1
	REPEAT 重み
		SIF 数 < 32
			候補:数 = 手
		数 += 1
	REND
NEXT
SIF 数 == 0
	RETURNF -1
SIF 数 > 32
	数 = 32
RETURNF 候補:(RAND:数)


;NPC 同士。通るかは主人公の式と同じ（される側の理性・性欲、される側→する側の体の段、要る段）
@NPCへのセクハラ(する側, される側, 手)
#DIM する側
#DIM される側
#DIM 手
#DIM 率
#DIM 前

率 = セクハラが通る率(する側, される側, 手)

IF RAND(100) < 率
	CALL セクハラを受ける(される側, する側, 手)
	前 = 好感度の段(好感度_体:される側:する側)
	好感度_体:される側:する側 += 1
	SIF 好感度の段(好感度_体:される側:する側) > 前
		CALL 記憶に残す(される側, @"%CALLNAME:する側%に触れられて、体が近づいた（%体の段名:好感度の段(好感度_体:される側:する側)%）")
	SIF !スタッフ:される側:0 || !勤務中:される側:0
		満足度:される側:0 += 自律セクハラの満足度
	SIF 満足度:される側:0 > 満足度上限
		満足度:される側:0 = 満足度上限
	CALL 見える(CFLAG:する側:現在位置, 自律セクハラの文(する側, される側, 手, 1), 空間の要約(CFLAG:する側:現在位置))
	CALL NPC同士の触れ方の口上(する側, される側, 手, CFLAG:する側:現在位置)
	CALL NPCが触れられて達する(される側, 手, CFLAG:する側:現在位置)
ELSE
	好感度_友情:される側:する側 -= セクハラの傷 / 2
	好感度_恋愛:される側:する側 -= セクハラの傷 / 2
	SIF 好感度_友情:される側:する側 < 0
		好感度_友情:される側:する側 = 0
	SIF 好感度_恋愛:される側:する側 < 0
		好感度_恋愛:される側:する側 = 0
	IF スタッフ:される側:0 && 勤務中:される側:0
		ストレス:される側:0 += 自律セクハラのストレス
		;客がスタッフに手を出して拒まれたとき、警備が居れば間に入る
		CALL 警備が間に入る(する側, される側)
	ELSE
		CALL 満足度を下げる(される側, セクハラの傷)
	ENDIF
	セクハラ断られた:する側:0 = される側 + 1
	CALL 見える(CFLAG:する側:現在位置, 自律セクハラの文(する側, される側, 手, 0), 空間の要約(CFLAG:する側:現在位置))
ENDIF


