;================================ 性癖 ================================
;2026-10-04 ユーザ指定「キャラに性癖を追加できる？」→「行為の分類・部位・モードごとに括る」。素質 180〜187（Talent.csv）。
;どの手が当たるかは 行為台帳の値（羞恥・苦痛・部位・モード）と 向き から決まる。行為ごとの印は持たない。
;効くのは4つ：①当たる手の快感・欲情 ×性癖の強/性癖の弱（@行為の値を入れる）②おねだり（要望・なすがまま）で当たる手が選ばれやすい（@要望の行為を選ぶ）
;③客の指名で対応する商品が選ばれやすい（@指名する商品。@性癖の商品か）④当たる手の最中の反応の一言（@行為の文 → @性癖の反応）

;性癖の素質か（番号が 性癖素質の始め〜終わり で、名前がある）
@性癖の素質か(素質)
#FUNCTION
#DIM 素質

SIF 素質 < 性癖素質の始め || 素質 > 性癖素質の終わり || TALENTNAME:素質 == ""
	RETURNF 0
RETURNF 1


;その人が、この手でその性癖に当たるか。種は 性癖_◯◯。側は @行為の値を入れる と同じ（0=相手＝台帳の受け手の列、1=主人公＝提供側の列）
;される側＝苦痛・羞恥が入る側（向き 0 は相手、1 は主人公、2 は両方。→@行為の値を入れる）
@性癖に当たるか(番号, 行為, 種, 側)
#FUNCTION
#DIM 番号
#DIM 行為
#DIM 種
#DIM 側
#DIM 素質
#DIM される

SIF 種 < 0 || 種 >= 性癖の数 || 側 < 0 || 側 > 1 || 行為 < 0 || 行為 >= 行為数 || 行為名:行為 == ""
	RETURNF 0
素質 = 性癖素質の始め + 種
SIF !TALENT:番号:素質
	RETURNF 0
される = 行為の向き:行為 == 2 || (行為の向き:行為 == 0 && 側 == 0) || (行為の向き:行為 == 1 && 側 == 1)
SELECTCASE 種
	CASE 性癖_羞恥好き
		RETURNF される && 行為の羞恥:行為 >= 性癖の羞恥の下限
	CASE 性癖_被虐
		RETURNF される && 行為の苦痛:行為 >= 性癖の苦痛の下限
	CASE 性癖_加虐
		RETURNF !される && 行為の苦痛:行為 >= 性癖の苦痛の下限
	CASE 性癖_拘束好き
		RETURNF 拘束か(行為)
	CASE 性癖_口好き
		;部位のビットは 0=口 1=胸 …（→変数定義.ERH 行為の使用）。大文字（快感が入る）も小文字（使うだけ）も数える
		RETURNF (行為の使用:行為:側 & (1 << 0)) != 0
	CASE 性癖_胸好き
		RETURNF (行為の使用:行為:側 & (1 << 部位_胸)) != 0
	CASE 性癖_尻好き
		RETURNF (行為の使用:行為:側 & (1 << 部位_尻)) != 0
	CASE 性癖_母乳好き
		RETURNF 母乳を出す側(行為) >= 0
ENDSELECT
RETURNF 0


;反応を選ぶときの優先（具体的なものから）。順 0〜性癖の数−1 → 種
@性癖の優先(順)
#FUNCTION
#DIM 順

SELECTCASE 順
	CASE 0
		RETURNF 性癖_母乳好き
	CASE 1
		RETURNF 性癖_拘束好き
	CASE 2
		RETURNF 性癖_加虐
	CASE 3
		RETURNF 性癖_被虐
	CASE 4
		RETURNF 性癖_羞恥好き
	CASE 5
		RETURNF 性癖_尻好き
	CASE 6
		RETURNF 性癖_胸好き
ENDSELECT
RETURNF 性癖_口好き


;この手で当たる性癖。当たるものが無ければ -1、重なれば @性癖の優先 の先のもの
@当たる性癖(番号, 行為, 側)
#FUNCTION
#DIM 番号
#DIM 行為
#DIM 側
#DIM 順
#DIM 種

FOR 順, 0, 性癖の数
	種 = 性癖の優先(順)
	SIF 性癖に当たるか(番号, 行為, 種, 側)
		RETURNF 種
NEXT
RETURNF -1


;当たる手なら 量 に 性癖の強/性癖の弱 を掛ける（重なっても一度だけ。快感・欲情に使う）
@性癖で掛ける(番号, 行為, 側, 量)
#FUNCTION
#DIM 番号
#DIM 行為
#DIM 側
#DIM 量

SIF 当たる性癖(番号, 行為, 側) >= 0
	量 = 量 * 性癖の強 / 性癖の弱
RETURNF 量


;当たる手の最中の反応の一言（地の文）。気絶していれば出さない。出る率は 性癖の反応率。重なれば優先の先の一つだけ
@性癖の反応(番号, 行為, 側)
#DIM 番号
#DIM 行為
#DIM 側
#DIM 種

SIF 気絶中:番号:0
	RETURN 0
SIF RAND:100 >= 性癖の反応率
	RETURN 0
種 = 当たる性癖(番号, 行為, 側)
SIF 種 < 0
	RETURN 0
PRINTFORML %性癖の反応文(番号, 種)%
;地の文のあとに本人の一言（口上タイプ別。→@性癖の口上）
CALL 性癖の口上(番号, 種)


@性癖の反応文(番号, 種)
#FUNCTIONS
#DIM 番号
#DIM 種
#DIMS 主
#DIMS 文

IF 番号 == MASTER
	主 '= "あなた"
ELSE
	主 '= CALLNAME:番号
ENDIF
文 '= ""
SELECTCASE 種
	CASE 性癖_羞恥好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は恥ずかしさに身をよじりながら、その視線に昂ぶっている"
			CASE 1
				文 '= @"%主%は頬を染め、見られていることに息を乱した"
			CASEELSE
				文 '= @"%主%は羞恥に震えながら、どこか嬉しそうだった"
		ENDSELECT
	CASE 性癖_被虐
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は痛みに顔をしかめながら、その奥で熱を帯びていく"
			CASE 1
				文 '= @"%主%は苦しげな息に、甘い色を混ぜた"
			CASEELSE
				文 '= @"%主%は痛みを受けるたび、目を潤ませて身を預けた"
		ENDSELECT
	CASE 性癖_加虐
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は相手が苦しむ様子に、口元を緩めた"
			CASE 1
				文 '= @"%主%は相手の反応をたしかめるように、ゆっくりと力を込めた"
			CASEELSE
				文 '= @"%主%は相手の震えに、昂ぶりを隠せないでいる"
		ENDSELECT
	CASE 性癖_拘束好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は拘束という状況そのものに昂ぶっている"
			CASE 1
				文 '= @"%主%は縄やギャグの気配に、ひそかに息を弾ませた"
			CASEELSE
				文 '= @"%主%は動きを縛るものの感触に、深く息を吐いた"
		ENDSELECT
	CASE 性癖_口好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は唇と舌の感触に、うっとりと目を細めた"
			CASE 1
				文 '= @"%主%は口を使うことに、夢中になっている"
			CASEELSE
				文 '= @"%主%は口づけの熱を、飽きずに味わっている"
		ENDSELECT
	CASE 性癖_胸好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は胸の感触に、うっとりと息を漏らした"
			CASE 1
				文 '= @"%主%は胸元のぬくもりに、夢中になっている"
			CASEELSE
				文 '= @"%主%は胸を使うことに、いつもより熱が入っている"
		ENDSELECT
	CASE 性癖_尻好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は尻への刺激に、背を反らせて息を弾ませた"
			CASE 1
				文 '= @"%主%は後ろの感覚に、ひそかに昂ぶっている"
			CASEELSE
				文 '= @"%主%は尻の感触に、いつもより熱が入っている"
		ENDSELECT
	CASE 性癖_母乳好き
		SELECTCASE RAND:3
			CASE 0
				文 '= @"%主%は母乳の甘い気配に、うっとりと目を細めた"
			CASE 1
				文 '= @"%主%は乳のあたたかさに、夢中になっている"
			CASEELSE
				文 '= @"%主%は母乳があふれる様子に、昂ぶっている"
		ENDSELECT
ENDSELECT
RETURNF 文


;反応の一言（台詞）。口上_性癖_{キャラ番号}(番号, 種) → 口上_性癖_{タイプ}_{性別}(番号, 種)（ふたなりは _女 も）→ 口上_性癖_{タイプ}(番号, 種)。無ければ何も出さない（→口上/汎用/性癖.ERB）。
;口上の使い方（0=固有＋汎用 1=固有のみ 2=汎用のみ）は主人公にだけ効く（相手は @絶頂の口上 と同じく常に両方）。主人公の台詞は青で出す。気絶・口上なしのときは出さない
@性癖の口上(番号, 種)
#DIM 番号
#DIM 種
#DIMS タイプ
#DIMS 性別

RESULTS '= ""
SIF CFLAG:番号:口上なし
	RETURN 0
IF 番号 != MASTER || 口上の使い方 != 2
	CALL 性癖の口上を呼ぶ(番号, 種, TOSTR(番号))
ENDIF
タイプ '= 口上タイプ(番号)
性別 '= 性別名(番号)
IF RESULTS == "" && (番号 != MASTER || 口上の使い方 != 1)
	CALL 性癖の口上を呼ぶ(番号, 種, @"%タイプ%_%性別%")
ENDIF
IF RESULTS == "" && 性別 == "ふたなり" && (番号 != MASTER || 口上の使い方 != 1)
	CALL 性癖の口上を呼ぶ(番号, 種, @"%タイプ%_女")
ENDIF
IF RESULTS == "" && (番号 != MASTER || 口上の使い方 != 1)
	CALL 性癖の口上を呼ぶ(番号, 種, タイプ)
ENDIF
SIF RESULTS == ""
	RETURN 0
IF 番号 == MASTER
	SETCOLOR 150, 200, 255
	PRINTFORML 　%RESULTS%
	RESETCOLOR
ELSE
	PRINTFORML 　%RESULTS%
ENDIF


;一つの段の口上を呼ぶ。名は 口上_性癖_ の後ろの部分。結果は RESULTS（無ければ空）
@性癖の口上を呼ぶ(番号, 種, 名)
#DIM 番号
#DIM 種
#DIMS 名

RESULTS '= ""
TRYCCALLFORM 口上_性癖_%名%(番号, 種)
CATCH
ENDCATCH


;客の性癖に合う商品か（指名で候補に重ねる。→客.ERB @指名する商品）。商品は CSV/台帳/商品.csv の番号
;羞恥好き＝2 着替えを見せる・3 入浴に同席・4 下着を見せる・14 撮影、被虐／加虐／拘束好き＝13 拘束、口好き＝6 口で奉仕、胸好き＝8 愛撫を受ける。尻好き・母乳好きに合う商品は無い
@性癖の商品か(番号, 商品)
#FUNCTION
#DIM 番号
#DIM 商品
#DIM 種

FOR 種, 0, 性癖の数
	SIF !TALENT:番号:(性癖素質の始め + 種)
		CONTINUE
	SELECTCASE 種
		CASE 性癖_羞恥好き
			SIF 商品 == 2 || 商品 == 3 || 商品 == 4 || 商品 == 14
				RETURNF 1
		CASE 性癖_被虐, 性癖_加虐, 性癖_拘束好き
			SIF 商品 == 13
				RETURNF 1
		CASE 性癖_口好き
			SIF 商品 == 6
				RETURNF 1
		CASE 性癖_胸好き
			SIF 商品 == 8
				RETURNF 1
	ENDSELECT
NEXT
RETURNF 0
