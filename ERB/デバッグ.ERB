;[1997] 妊娠（とストレス）の日次だけ全員ぶん1日進める（着床や周期を待たずに見る）
@デバッグ_妊娠を一日
#DIM 甲

FOR 甲, 1, キャラ枠
	SIF 実キャラ:甲:0
		CALL ストレスの日替わり(甲)
	CALL 妊娠の日替わり(甲)
NEXT
CALL ストレスの日替わり(MASTER)
CALL 妊娠の日替わり(MASTER)
PRINTL 妊娠の日次を1日進めた


;[1996] 確率を飛ばして指名を1回起こす（記憶・他室の進行の確認）
@デバッグ_指名を起こす(客番号, 指定)
#DIM 客番号
#DIM 指定
#DIM 商品
#DIM 相手
#DIM 部屋

商品 = 指定
SIF 商品 < 0
	商品 = 指名する商品(客番号)
IF 商品 < 0
	PRINTL （指名できる商品が無い）
	RETURN 0
ENDIF
;地下ホールの客はその場で（客.ERB @指名を引く と同じ分岐）
IF 地下あり && CFLAG:客番号:現在位置 == 地下ホールの位置 && その場の商品か(商品)
	;確認用：地下勤務中のあかり（1）が地下ステージに居れば、ホールに出てきたことにする（ステージの演者は相手にならないため）
	SIF 地下勤務中か(1) && CFLAG:1:現在位置 == 地下ステージの位置
		CFLAG:1:現在位置 = 地下ホールの位置
	相手 = 指名される相手(客番号, 商品, 1)
	IF 相手 > 0
		CALL 見える(地下ホールの位置, @"%CALLNAME:客番号%が%CALLNAME:相手%を席に呼んだ。そのまま席の奥で「%商品名:商品%」が始まった", "地下ホールの席の奥に二人が入っていった")
		CALL 裏に入る(客番号, 相手, 商品, 地下ホールの位置)
		RETURN 0
	ENDIF
ENDIF
相手 = 指名される相手(客番号, 商品)
部屋 = 空き個室()
IF 相手 <= 0 || 部屋 <= 0
	PRINTL （相手か個室が無い）
	RETURN 0
ENDIF
CALL 記憶に残す(客番号, @"%CALLNAME:相手%を指名した")
CALL 記憶に残す(相手, @"%CALLNAME:客番号%に指名された")
CALL 裏に入る(客番号, 相手, 商品, 部屋)


;席は 3（ホール）か 80〜（ボックス席）を渡す
@デバッグ_座らせる(番号, 席)
#DIM 番号
#DIM 席

SIF CFLAG:番号:現在位置 != 0
	RETURN 0
SIF 席 <= 0
	席 = 3
来店予定:番号:0 = -1
CFLAG:番号:現在位置 = 席
注文済:番号:0 = 0
注文状態:番号:0 = 0
会話累積:番号:0 = 0
退店予定:番号:0 = 経過日数 * 1440 + 現在時刻 + 120
今日使える額:番号:0 = 今日使える額の基本
次の一杯:番号:0 = 経過日数 * 1440 + 現在時刻 + 一杯の間隔


;[1999] 0でない満足度と友情・汚れ・個室・今日の予定・関係・裏の記録を全部並べる
;（DEBUGPRINT はデバッグコンソールにしか出ないので普通の PRINT）
@デバッグ_関係一覧
#DIM 甲
#DIM 乙

PRINTFORML 【料理台帳】{料理数}品　0=%料理名:0%　1=%料理名:1%
PRINTL 【満足度】
FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0 || (満足度:甲:0 == 0 && CFLAG:甲:現在位置 == 0)
		CONTINUE
	PRINTFORM %CALLNAME:甲%　{満足度:甲:0}
	SIF CFLAG:甲:現在位置 > 0 && CFLAG:甲:現在位置 < 100
		PRINTFORM 　（店に居る。今日使える額 {今日使える額:甲:0}）
	PRINTL 
NEXT
PRINTL 【主人公との関係】
FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0
		CONTINUE
	SIF 好感度_友情:甲:0 == 0 && 好感度_恋愛:甲:0 == 0 && 好感度_体:甲:0 == 0
		CONTINUE
	PRINTFORML %CALLNAME:甲%　友情 {好感度_友情:甲:0}　恋愛 {好感度_恋愛:甲:0}　体 {好感度_体:甲:0}
NEXT
PRINTL 【汚れ】
FOR 甲, 0, 100
	SIF 汚れ:甲 <= 0 || GET_PLACE_NAME(甲) == ""
		CONTINUE
	PRINTFORML %GET_PLACE_NAME(甲)%　{汚れ:甲}
NEXT
PRINTL 【個室】
FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0 || 裏の相手:甲:0 <= 0 || 裏の相手:甲:0 < 甲
		CONTINUE
	PRINTFORML %CALLNAME:甲%－%CALLNAME:(裏の相手:甲:0)%　%商品名:(裏の商品:甲:0)%　%GET_PLACE_NAME(CFLAG:甲:現在位置)%　あと{裏の終わり:甲:0 - (経過日数 * 1440 + 現在時刻)}分
NEXT
PRINTL 【今日の予定】
FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0 || 来店予定:甲:0 < 0
		CONTINUE
	PRINTFORM %CALLNAME:甲%　%時刻表示(来店予定:甲:0)%
	SIF 連れ:甲:0 >= 0
		PRINTFORM （%CALLNAME:(連れ:甲:0)%の連れ）
	PRINTL 
NEXT
PRINTL 【関係一覧】
FOR 甲, 1, キャラ枠
	SIF !実キャラ:甲:0
		CONTINUE
	FOR 乙, 甲 + 1, キャラ枠
		SIF !実キャラ:乙:0 || 好感度_友情:甲:乙 == 0
			CONTINUE
		PRINTFORML %CALLNAME:甲%－%CALLNAME:乙%　友情 {好感度_友情:甲:乙}／{好感度_友情:乙:甲}
	NEXT
NEXT
;裏の記録は最後に（行が多いので画面の下に来るように）
PRINTL 【裏の記録】（主人公と、開発度か回数のある者。主人公は最後）
FOR 甲, 1, キャラ枠 + 1
	;最後の一周は主人公
	SIF 甲 == キャラ枠
		甲 = MASTER
	SIF !実キャラ:甲:0 && 甲 != MASTER
		CONTINUE
	SIF 甲 != MASTER && !スタッフ:甲:0 && 開発度_慣れ:甲:0 == 0 && 開発度_耐性:甲:0 == 0 && 開発度_感度:甲:0 == 0 && 開発度_感度:甲:1 == 0 && 開発度_感度:甲:2 == 0 && 開発度_感度:甲:3 == 0 && 開発度_感度:甲:4 == 0 && 開発度_感度:甲:5 == 0
		CONTINUE
	PRINTFORM %CALLNAME:甲%　慣れ {開発度_慣れ:甲:0}　耐性 {開発度_耐性:甲:0}　感度
	FOR 乙, 0, 6
		PRINTFORM 　%部位記号:乙%{開発度_感度:甲:乙}
	NEXT
	PRINTFORML 　同意 {同意の数(甲)}品　性欲 {BASE:甲:性欲}　精力 {BASE:甲:精力}
	;妊娠（膣のある者だけ）：周期・受精卵・妊娠・父親スロット
	IF 性別ビット(甲) & 6
		PRINTFORM 　周期 {生理周期:甲:0}　受精卵 {受精卵日数:甲:0}/{着床所要日数:甲:0}　妊娠 {妊娠日数:甲:0}日　父 {父親:甲:0}　胎児 {胎児数:甲:0}　B/W/H {胸囲:甲:0}/{胴囲:甲:0}/{腰囲:甲:0}→{回復目標_胸囲:甲:0}/{回復目標_胴囲:甲:0}/{回復目標_腰囲:甲:0}　陣痛 {陣痛:甲:0}　切迫 {切迫流産度:甲:0}　スト {ストレス:甲:0}　出産 {出産回数:甲:0}回{子供数:甲:0}人　流産 {流産回数:甲:0}　産後 {産後回復:甲:0}　育児 {育児日数:甲:0}　精液
		FOR 乙, 0, 父候補の数
			SIF 枠が使用中か(甲, 乙)
				PRINTFORM 　[{父候補_相手:甲:乙}:{父候補_残量:甲:乙}(膣{父候補_膣:甲:乙})@{父候補_到達日:甲:乙}→{受精力(甲, 乙)}]
		NEXT
		PRINTL 
	ENDIF
	;行為ごとの経験回数（あるものだけ）
	FOR 乙, 0, 行為数
		SIF 経験回数:甲:乙 > 0
			PRINTFORM 　%行為名:乙%×{経験回数:甲:乙}
	NEXT
	PRINTL 
	SIF 甲 == MASTER
		BREAK
NEXT


;================================ 数字採り（→進捗.md「数字採り」） ================================
;主人公は私室で寝たまま、店をスタッフに任せて n 日回し、一日を一行の数字にする。
;一日の流れは 一日.ERB の 就寝する→@EVENTTURNEND→@起床 と同じ勘定を、画面遷移（BEGIN）を挟まずにここで繰り返す。
;主人公が何もしない店の素の数字（来客・売上・給料・休息・満足度）を採るためのもの。主人公が働いたときの数字は実際に遊んで採る

;[1995] で呼ぶ
@デバッグ_日を回す
#DIM 日数
#DIM 日
#DIM 甲
#DIM 分
#DIM ピーク
#DIM 体力最低
#DIM 給料
#DIM 満足度計
#DIM 満足度数
#DIM 計_来客
#DIM 計_売上
#DIM 計_裏売上
#DIM 計_指名
#DIM 計_給料
#DIM 計_休息
#DIM 金始め

PRINTL
;マウスだけで打てる数値パッドに直した（2026-09-23 ユーザ指定。→マップ/共通.ERB @数値パッド）
CALL 数値パッド("何日回しますか", 1, 60, 1, 1, -1)
日数 = RESULT
SIF 日数 < 1 || 日数 > 60
	RETURN 0

CALL デバッグ_数字採りの準備

;主人公は私室に引っ込む。連れは帰す
CALL 同行を帰す
CFLAG:MASTER:現在位置 = 私室の位置
金始め = MONEY:MASTER

PRINTL 
PRINTFORML 【数字採り】{日数}日　営業 %営業時間の文()%　スタッフ {スタッフの数()}人　所持金 %金額(MONEY:MASTER)%円　評判 {評判}
PRINTL 日 曜 | 来客 在店ピーク | 売上 (うち裏 指名) | 給料 休息 スタッフ体力最低 | 所持金 評判 | 満足度平均(人数)

FOR 日, 0, 日数
	ピーク = 0
	体力最低 = 99999
	;05:00 まで回す。@時間を進める が日替わりを済ませて 強制就寝 を立てる
	強制就寝 = 0
	WHILE !強制就寝
		CALL 時間を進める(10)
		SIF 在室者数 > ピーク
			ピーク = 在室者数
		FOR 甲, 1, キャラ枠
			SIF 実キャラ:甲:0 && スタッフ:甲:0 && BASE:甲:体力 < 体力最低
				体力最低 = BASE:甲:体力
		NEXT
	WEND
	強制就寝 = 0

	;就寝する＋リザルト（→一日.ERB）。給料は黙って払う
	CALL 同行を帰す
	就寝時点 = 経過日数 * 1440 + 現在時刻
	CFLAG:MASTER:現在位置 = 私室の位置
	;一日ぶんのその場の値を全員ぶん開発度へ（→一日.ERB @EVENTTURNEND、個室.ERB @一日の開発度）
	CALL 一日の開発度
	昨日の結果がある = 1
	昨日の来客 = 今日の来客
	昨日の売上 = 今日の売上
	昨日の給料 = 0
	CALL 売上を所持金へ
	CALL 給料を払う(1)
	給料 = 昨日の給料

	満足度計 = 0
	満足度数 = 0
	FOR 甲, 1, キャラ枠
		SIF !実キャラ:甲:0
			CONTINUE
		満足度計 += 満足度:甲:0
		満足度数 += 1
	NEXT
	SIF 満足度数 == 0
		満足度数 = 1
	SIF 体力最低 == 99999
		体力最低 = 0

	;営業の晩の日付で出す（日替わりはもう済んでいるので 1 引く）
	PRINTFORML {経過日数 - 1, 2} %曜日名((曜日 + 6) % 7)% | {今日の来客, 3} {ピーク, 3} | {今日の売上, 7} ({今日の裏売上, 6} {今日の指名, 2}) | {給料, 6} {今日の休息, 2} {体力最低, 4} | {MONEY:MASTER, 8} {評判, 3} | {満足度計 / 満足度数, 4}({満足度数})

	;その晩が行事なら一行（客足の効きを来客の列と見比べる。→行事.ERB）
	SIF 営業の行事 > 0
		PRINTFORML 　　　↑ 行事：%行事名:(営業の行事 - 1)%（客足 ×{行事の客足:(営業の行事 - 1)}％）　来店の上限 {来店の上限() * 行事の客足を引く() / 100}
	計_来客 += 今日の来客
	計_売上 += 今日の売上
	計_裏売上 += 今日の裏売上
	計_指名 += 今日の指名
	計_給料 += 給料
	計_休息 += 今日の休息
	;日替わりはもう済んでいるので 1 引く（起床を通らないので 今日の日数 が古いまま。日ごとの記録の日付になる）
	今日の日数 = 経過日数 - 1
	今日の曜日 = (曜日 + 6) % 7
	CALL 今日の集計を戻す
	;目標が済んだ日はここに出る（→目標.ERB。通しで数字を採るとき、いつ何が開くかを見る）
	CALL 目標を見る

	;起床時刻まで眠る（→一日.ERB @起床）
	分 = (起床時刻 - 現在時刻 + 1440) % 1440
	CALL 時間を進める(分)
	起床時点 = 経過日数 * 1440 + 現在時刻
	連続睡眠長 = 起床時点 - 就寝時点
	CALL 睡眠回復(連続睡眠長)
NEXT

PRINTFORML 計 | 来客 {計_来客}（日平均 {計_来客 / 日数}） | 売上 {計_売上}（裏 {計_裏売上}、指名 {計_指名}） | 給料 {計_給料} 休息 {計_休息} | 所持金 {金始め} → {MONEY:MASTER}（{MONEY:MASTER - 金始め}）
PRINTFORML 終わり：{経過日数}日目（%曜日名(曜日)%）%時刻表示(現在時刻)%。主人公は私室に居る
WAIT


;================================ 積極的に遊んだ数字採り ================================
;[1992]。[1995] と同じく n 日回すが、営業中は主人公がホールに居て、客に会話を続ける（掃除ありなら、ホールが気になる線を超えたら先に掃除する）。
;「何もしない店」でなく「主人公が客に話しかけ続ける店」の数字を採るためのもの（2026-10-18。汚れの効き方を決める材料）。
;営業時間外は [1995] と同じく私室で眠る。主人公の操作は 会話(相手)・掃除する の中身をそのまま呼ぶ（気力・体力・時間の消費も同じ）。
;話しかける相手は、ホールに居る客（勤務中でないスタッフを含む）のうち会話累積がいちばん少ない人（話題を回す）。表示は SKIPDISP で止めて、一日一行だけ出す
@デバッグ_日を回す_遊ぶ
#DIM 日数
#DIM 掃除あり
#DIM 日
#DIM 分
#DIM 甲
#DIM ピーク
#DIM 給料
#DIM 満足度計
#DIM 満足度数
#DIM 友情計
#DIM 会話数
#DIM 掃除数
#DIM 計_来客
#DIM 計_売上
#DIM 計_会話
#DIM 計_掃除
#DIM 金始め
#DIM 友情始め
#DIM 睡眠開始
#DIM 席数指定
#DIM スタッフ指定
#DIM 清掃外し
#DIM 乙
#DIM 追加の顔ぶれ, 3
#DIM 席汚れ計
#DIM 席数

PRINTL
CALL 数値パッド("何日回しますか", 1, 60, 1, 1, -1)
日数 = RESULT
SIF 日数 < 1 || 日数 > 60
	RETURN 0
CALL 数値パッド("0 会話だけ／1 会話と掃除／2 何もしない（私室で寝たまま）", 0, 2, 0, 1, -1)
掃除あり = RESULT
SIF 掃除あり < 0
	RETURN 0
CALL 数値パッド("ボックス席の数（3 ならそのまま。最大20）", 3, 20, 3, 1, -1)
席数指定 = RESULT
SIF 席数指定 < 0
	RETURN 0
CALL 数値パッド("スタッフの数（3 ならそのまま。最大6。足すとおすすめで組み直す）", 3, 6, 3, 1, -1)
スタッフ指定 = RESULT
SIF スタッフ指定 < 0
	RETURN 0
CALL 数値パッド("清掃のシフトをフロアに替える（0 そのまま／1 替える）", 0, 1, 0, 1, -1)
清掃外し = RESULT
SIF 清掃外し < 0
	RETURN 0

CALL デバッグ_数字採りの準備
;席を増やす（建てた扱い。評判の上限も増築額で上がる）
SIF 席数指定 > ボックス席数
	ボックス席数 = 席数指定
;スタッフを足す（8 おさむ・10 なぎさ・4 いずみ の順。寮の空き部屋へ）。全員のシフトを消して おすすめで組み直す
IF スタッフ指定 > スタッフの数()
	追加の顔ぶれ:0 = 8
	追加の顔ぶれ:1 = 10
	追加の顔ぶれ:2 = 4
	FOR 乙, 0, 3
		SIF スタッフの数() >= スタッフ指定
			BREAK
		SIF !実キャラ:(追加の顔ぶれ:乙):0 || スタッフ:(追加の顔ぶれ:乙):0
			CONTINUE
		寮の部屋:(追加の顔ぶれ:乙):0 = 410 + スタッフの数()
		スタッフ:(追加の顔ぶれ:乙):0 = 1
	NEXT
	FOR 甲, 1, キャラ枠
		SIF 実キャラ:甲:0 && スタッフ:甲:0
			CALL 週で入れる(甲, 0)
	NEXT
	CALL おすすめで組む
ENDIF
;清掃を誰にも付けない店（汚れの効きだけを見る）。清掃（7）をフロア（2）に替える
IF 清掃外し
	FOR 甲, 1, キャラ枠
		SIF !実キャラ:甲:0 || !スタッフ:甲:0
			CONTINUE
		FOR 乙, 0, 7
			SIF シフト:甲:乙 == 7
				シフト:甲:乙 = 2
		NEXT
	NEXT
ENDIF
CALL 同行を帰す
CFLAG:MASTER:現在位置 = 私室の位置
金始め = MONEY:MASTER
友情始め = 0
FOR 甲, 1, キャラ枠
	SIF 実キャラ:甲:0
		友情始め += 好感度_友情:甲:0
NEXT

PRINTL
PRINTFORML 【遊んだ数字採り】{日数}日　遊び方 {掃除あり}（0 会話だけ／1 会話と掃除／2 何もしない）　営業 %営業時間の文()%　スタッフ {スタッフの数()}人　ボックス席 {ボックス席数}　来店の上限 {来店の上限()}　所持金 %金額(MONEY:MASTER)%円　評判 {評判}／天井 {評判の上限()}
PRINTL 日 曜 | 来客 引返 ピーク | 売上 | 給料 | 所持金 評判 | 満足度平均(人数) | 会話 掃除 友情増 ホール汚れ 席汚れ平均

デバッグ自動応答 = 1
FOR 日, 0, 日数
	SKIPDISP 1
	ピーク = 0
	会話数 = 0
	掃除数 = 0
	強制就寝 = 0
	睡眠開始 = -1
	WHILE !強制就寝
		;閉店したら寝る（閉店から 05:00 の日替わりまでが眠る時間。1995 は 05:00 から数えるので睡眠が短かった）
		SIF 睡眠開始 < 0 && 現在時刻 >= 営業終了 && !営業中(現在時刻)
			睡眠開始 = 経過日数 * 1440 + 現在時刻
		IF 営業中(現在時刻) && 掃除あり != 2
			;開店したらまずホール。その後は 遊ぶ一手 が客席を回る
			SIF CFLAG:MASTER:現在位置 == 私室の位置
				CFLAG:MASTER:現在位置 = 3
			CALL デバッグ_遊ぶ一手(掃除あり)
			SIF RESULT == 1
				会話数 += 1
			SIF RESULT == 2
				掃除数 += 1
		ELSE
			CFLAG:MASTER:現在位置 = 私室の位置
			CALL 時間を進める(10)
		ENDIF
		SIF 在室者数 > ピーク
			ピーク = 在室者数
	WEND
	強制就寝 = 0

	CALL 同行を帰す
	就寝時点 = 経過日数 * 1440 + 現在時刻
	CFLAG:MASTER:現在位置 = 私室の位置
	CALL 一日の開発度
	昨日の結果がある = 1
	昨日の来客 = 今日の来客
	昨日の売上 = 今日の売上
	昨日の給料 = 0
	CALL 売上を所持金へ
	CALL 給料を払う(1)
	給料 = 昨日の給料

	満足度計 = 0
	満足度数 = 0
	友情計 = 0
	FOR 甲, 1, キャラ枠
		SIF !実キャラ:甲:0
			CONTINUE
		満足度計 += 満足度:甲:0
		満足度数 += 1
		友情計 += 好感度_友情:甲:0
	NEXT
	SIF 満足度数 == 0
		満足度数 = 1
	席汚れ計 = 0
	FOR 甲, 0, ボックス席数
		席汚れ計 += 汚れ:(80 + 甲)
	NEXT
	席数 = ボックス席数
	SIF 席数 < 1
		席数 = 1

	SKIPDISP 0
	PRINTFORML {経過日数 - 1, 2} %曜日名((曜日 + 6) % 7)% | {今日の来客, 3} {今日の汚れで帰った, 3} {ピーク, 3} | {今日の売上, 7} | {給料, 6} | {MONEY:MASTER, 8} {評判, 3} | {満足度計 / 満足度数, 4}({満足度数}) | {会話数, 3} {掃除数, 3} {友情計 - 友情始め, 6} {汚れ:3, 3} {席汚れ計 / 席数, 3}
	計_来客 += 今日の来客
	計_売上 += 今日の売上
	計_会話 += 会話数
	計_掃除 += 掃除数
	SKIPDISP 1

	今日の日数 = 経過日数 - 1
	今日の曜日 = (曜日 + 6) % 7
	CALL 今日の集計を戻す
	;目標が済んだ日はここに出る（→目標.ERB。通しで数字を採るとき、いつ何が開くかを見る）
	CALL 目標を見る

	;起床時刻まで眠る。眠った長さは閉店から数える（閉店しなかった日は 05:00 から）
	分 = (起床時刻 - 現在時刻 + 1440) % 1440
	CALL 時間を進める(分)
	起床時点 = 経過日数 * 1440 + 現在時刻
	SIF 睡眠開始 < 0
		睡眠開始 = 就寝時点
	連続睡眠長 = 起床時点 - 睡眠開始
	CALL 睡眠回復(連続睡眠長)
NEXT
SKIPDISP 0
デバッグ自動応答 = 0

PRINTFORML 計 | 来客 {計_来客}（日平均 {計_来客 / 日数}） | 売上 {計_売上} | 会話 {計_会話} 掃除 {計_掃除} | 所持金 {金始め} → {MONEY:MASTER}（{MONEY:MASTER - 金始め}）
PRINTFORML 終わり：{経過日数}日目（%曜日名(曜日)%）%時刻表示(現在時刻)%。主人公は私室に居る
WAIT


;営業中の主人公の一手。掃除ありで ホール の汚れが気になる線を超えていれば掃除（2を返す）、
;それ以外は 会話累積がいちばん少ない客に会話（1を返す）、話せる相手か気力が無ければ10分待つ（0を返す）
@デバッグ_遊ぶ一手(掃除あり)
#DIM 掃除あり
#DIM 番号
#DIM 相手
#DIM 最少
#DIM 落ち
#DIM 場所
#DIM 汚い場所
#DIM 最大の汚れ

;店内の客席（ホール 3 とボックス席 80〜）のうち、いちばん汚れている所
汚い場所 = -1
最大の汚れ = 汚れの気になる線
FOR 場所, 3, 100
	SIF 場所 != 3 && (場所 < 80 || 場所 >= 80 + ボックス席数)
		CONTINUE
	IF 汚れ:場所 > 最大の汚れ
		最大の汚れ = 汚れ:場所
		汚い場所 = 場所
	ENDIF
NEXT
IF 掃除あり && 汚い場所 >= 0 && BASE:MASTER:体力 >= 掃除の体力
	;客席の間の移動は 1手5分
	IF CFLAG:MASTER:現在位置 != 汚い場所
		CFLAG:MASTER:現在位置 = 汚い場所
		CALL 時間を進める(5)
	ENDIF
	落ち = 掃除の落ち + ABL:MASTER:清掃 * 10
	CALL 汚れを足す(汚い場所, 0 - 落ち)
	CALL 体力気力を減らす(MASTER, 掃除の体力, 0)
	CALL 経験を入れる(技能_清掃, 接客の経験)
	CALL 時間を進める(掃除の分)
	RETURN 2
ENDIF
;話しかける相手：客席に居る客（勤務中でないスタッフを含む）のうち会話累積がいちばん少ない人
相手 = 0
最少 = 99999
FOR 番号, 1, キャラ枠
	SIF !実キャラ:番号:0 || 気絶中:番号:0
		CONTINUE
	場所 = CFLAG:番号:現在位置
	SIF 場所 != 3 && (場所 < 80 || 場所 >= 80 + ボックス席数)
		CONTINUE
	SIF スタッフ:番号:0 && 勤務中:番号:0
		CONTINUE
	IF 会話累積:番号:0 < 最少
		最少 = 会話累積:番号:0
		相手 = 番号
	ENDIF
NEXT
IF 相手 > 0 && 払えるか(0, 会話の気力)
	IF CFLAG:MASTER:現在位置 != CFLAG:相手:現在位置
		CFLAG:MASTER:現在位置 = CFLAG:相手:現在位置
		CALL 時間を進める(5)
	ENDIF
	主役 = 相手
	CALL 体力気力を減らす(MASTER, 0, 会話の気力)
	CALL 会話(相手)
	CALL 時間を進める(対面の分)
	RETURN 1
ENDIF
CALL 時間を進める(10)
RETURN 0


;スタッフが一人も居なければ、素の数字が採れる最小の顔ぶれを入れる（接客・フロア・調理・警備を全曜日）。
;寮は4部屋に広げる。居れば何もしない（いまのセーブの顔ぶれで採る）
@デバッグ_数字採りの準備
#DIM 甲
#DIM 乙
#DIM 顔ぶれ, 4
#DIM 仕事, 4

SIF スタッフの数() > 0
	RETURN 0

;1 あかり 会話3、10 なぎさ 会話2、8 おさむ 料理3、2 けんた 警備3（→CSV/chara）
顔ぶれ:0 = 1
顔ぶれ:1 = 10
顔ぶれ:2 = 8
顔ぶれ:3 = 2
仕事:0 = 1
仕事:1 = 2
仕事:2 = 3
仕事:3 = 6

SIF 寮の部屋数 < 4
	寮の部屋数 = 4
FOR 甲, 0, 4
	SIF !実キャラ:(顔ぶれ:甲):0
		CONTINUE
	スタッフ:(顔ぶれ:甲):0 = 1
	寮の部屋:(顔ぶれ:甲):0 = 410 + 甲
	FOR 乙, 0, 7
		シフト:(顔ぶれ:甲):乙 = 仕事:甲
	NEXT
	PRINTFORML %CALLNAME:(顔ぶれ:甲)%を%仕事名:(仕事:甲)%で雇った（寮 {410 + 甲}）
NEXT


;雇っている人数
@スタッフの数
#FUNCTION
#DIM 甲
#DIM 数

数 = 0
FOR 甲, 1, キャラ枠
	SIF 実キャラ:甲:0 && スタッフ:甲:0
		数 += 1
NEXT
RETURNF 数
