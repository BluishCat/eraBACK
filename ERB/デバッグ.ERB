			父親:MASTER:0 = 2
			胎児数:MASTER:0 = 1
			妊娠自覚:MASTER:0 = 0
		CASE 4
			地下あり = 1
			商品回数:2:0 = 3
			CFLAG:2:現在位置 = 8
			同意ビット:1:0 |= (1 << 15) | (1 << 16) | (1 << 17)
			FOR 甲, 0, 7
				シフト:1:甲 = 仕事_客参加ショー
			NEXT
			CFLAG:1:現在位置 = 地下ステージの位置
			次の披露:1:0 = 今 + 40
			CFLAG:3:現在位置 = 地下ホールの位置
