			CALL 性の値を整える(3)
			生理周期:1:0 = 13
			生理周期:3:0 = 13
			生理周期:MASTER:0 = 13
			設定_確実妊娠 = 1
			妊娠日数:1:0 = 12
			父親:1:0 = 2
			胎児数:1:0 = 1
			妊娠自覚:1:0 = 2
			営業開始 = 一日の始まり
			営業終了 = 一日の終わり
		CASE 1
			BASE:MASTER:体力 = 100
			ストレス:MASTER:0 = 1000
