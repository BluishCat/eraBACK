			FOR 甲, 0, 7
				シフト:1:甲 = 11
			NEXT
			ITEM:アイテム_陣痛促進剤 += 2
			BASE:1:体力 = 1000
		CASE 7
			CFLAG:2:現在位置 = 地下ホールの位置
			退店予定:2:0 = 今 + 600
			BASE:2:体力 = 500
