;称号（個人の記録。→画面イメージ「能力表示」の称号の節）
;台帳は CSV/台帳/称号.csv（SYSTEM.ERB @台帳を読む）。条件を満たした時点で本人に記録し、能力表示に並べる。どこかに効く値ではない。
;条件の値は 本番の相手数（この人が本番まで行った、重複しない相手の人数）・出産回数・子供数。
;見る契機は 本番の相手を記す（本番が起きた場所）と 出産_完了（妊娠.ERB）


;本番（膣・尻への挿入）まで行った相手を記す。同じ相手は一度だけ数える。初めての組なら両者の人数が +1 され、称号を見る。
;黙る=1 なら主人公にもその場の文を出さない（夜這い・他人の呼ぶ文の途中。リザルトの出来事には残る）
;呼ぶのは、本番が起きた場所：個室の一手（個室.ERB）・夜這い（夜這い.ERB）・舞台の客参加本番・スタッフだけの室の本番（客.ERB）
@本番の相手を記す(甲, 乙, 黙る = 0)
#DIM 甲
#DIM 乙
#DIM 黙る

SIF 甲 == 乙 || 甲 < 0 || 乙 < 0 || 甲 >= キャラ枠 || 乙 >= キャラ枠
	RETURN 0
SIF 本番の相手:甲:乙
	RETURN 0
本番の相手:甲:乙 = 1
本番の相手:乙:甲 = 1
本番の相手数:甲:0 += 1
本番の相手数:乙:0 += 1
CALL 称号を見る(甲, 黙る)
CALL 称号を見る(乙, 黙る)


;条件を満たしていて、まだ持っていない称号を渡す
@称号を見る(番号, 黙る = 0)
#DIM 番号
#DIM 黙る
#DIM 称号番号

SIF 番号 < 0 || 番号 >= キャラ枠 || !実キャラ:番号:0
	RETURN 0
FOR 称号番号, 0, 称号数
	SIF 称号名:称号番号 == "" || 称号の記録:番号:称号番号 > 0
		CONTINUE
	SIF 称号の現在値(番号, 称号の種類:称号番号) < 称号の値:称号番号
		CONTINUE
	称号の記録:番号:称号番号 = 経過日数 + 1
	CALL 称号を知らせる(番号, 称号番号, 黙る)
NEXT


;全員の称号を見る。その場で見ない場面（夜這い・舞台・NPC 同士）の分をリザルトの前に拾う。知らせは黙る（出来事・スタッフの行に出る）
@称号を一巡見る
#DIM 番号

FOR 番号, 0, キャラ枠
	SIF 実キャラ:番号:0
		CALL 称号を見る(番号, 1)
NEXT


;種類ごとの今の値。種類は「前:名前」の形（技能・行為・行為分類・商品系統）か、名前だけ
;  技能:歌唱 … 技能のLv（名前は Abl.csv の技能名）／行為:キスする … その行為の回数（行為.csv の名前）
;  行為分類:奉仕 … その分類の行為の回数の合計／商品系統:本番 … その系統の裏の商品の回数の合計（同席・見せる・接触・本番・特殊）
;  来店回数／裏の仕事の回数（商品の合計）／初物を頂いた回数 ほか
@称号の現在値(番号, 種類)
#FUNCTION
#DIM 番号
#DIMS 種類
#DIM 添字
#DIM 合計
#DIM 品
#DIMS 前
#DIMS 名

前 '= ""
名 '= ""
添字 = STRFINDU(種類, ":")
IF 添字 > 0
	前 '= SUBSTRINGU(種類, 0, 添字)
	名 '= SUBSTRINGU(種類, 添字 + 1, 99)
ENDIF
SELECTCASE 前
	CASE "技能"
		添字 = GETNUM(ABL, 名)
		SIF 添字 < 0
			RETURNF 0
		RETURNF ABL:番号:添字
	CASE "行為"
		FOR 品, 0, 行為数
			SIF 行為名:品 == 名
				RETURNF 経験回数:番号:品
		NEXT
		RETURNF 0
	CASE "行為分類"
		添字 = -1
		FOR 品, 0, 行為分類数
			SIF 行為分類名:品 == 名
				添字 = 品
		NEXT
		SIF 添字 < 0
			RETURNF 0
		合計 = 0
		FOR 品, 0, 行為数
			SIF 行為名:品 != "" && 行為の分類:品 == 添字
				合計 += 経験回数:番号:品
		NEXT
		RETURNF 合計
	CASE "商品系統"
		添字 = -1
		FOR 品, 1, 6
			SIF 系統名:品 == 名
				添字 = 品
		NEXT
		SIF 添字 < 0
			RETURNF 0
		合計 = 0
		FOR 品, 0, 商品数
			SIF 商品系統:品 == 添字
				合計 += 商品回数:番号:品
		NEXT
		RETURNF 合計
ENDSELECT
SELECTCASE 種類
	CASE "本番の相手数"
		RETURNF 本番の相手数:番号:0
	CASE "出産回数"
		RETURNF 出産回数:番号:0
	CASE "子供数"
		RETURNF 子供数:番号:0
	CASE "中出しした回数"
		RETURNF 中出しした回数:番号:0
	CASE "中出しされた回数"
		RETURNF 中出しされた回数:番号:0
	CASE "孕ませた子の数"
		RETURNF 孕ませた子の数:番号:0
	CASE "来店回数"
		RETURNF 来店回数:番号:0
	CASE "裏の仕事の回数"
		合計 = 0
		FOR 品, 0, 商品数
			合計 += 商品回数:番号:品
		NEXT
		RETURNF 合計
	CASE "初物を頂いた回数"
		RETURNF 初物を頂いた回数:番号:0
ENDSELECT
RETURNF 0


;初めての相手になった（処女・Ａ処女・童貞を頂いた）回数を数える。呼ぶ側は 初めての相手を記す／童貞の記録のすぐ近く。
;知らせは出さない（呼ぶ側の文の途中なので。個室の一手の後・結果の前に見る → 個室.ERB・一日.ERB）
@初物を頂く(頂いた側)
#DIM 頂いた側

SIF 頂いた側 < 0 || 頂いた側 >= キャラ枠
	RETURN 0
初物を頂いた回数:頂いた側:0 += 1


;得たことを知らせる。主人公はその場で（黙るならリザルトの出来事だけ）、スタッフはリザルトの本人の行、客は記録だけ
@称号を知らせる(番号, 称号番号, 黙る = 0)
#DIM 番号
#DIM 称号番号
#DIM 黙る

IF 番号 == MASTER
	CALL 出来事を記す(@"称号「%称号名:称号番号%」を得た")
	IF !黙る
		PRINTFORML 称号「%称号名:称号番号%」を得た
		SIF 称号の一言:称号番号 != ""
			PRINTFORML 　%称号の一言:称号番号%
	ENDIF
ELSE
	CALL 変化を記す(番号, @"称号「%称号名:称号番号%」を得た")
ENDIF


;持っている称号の数
@称号の数(番号)
#FUNCTION
#DIM 番号
#DIM 称号番号
#DIM 数

数 = 0
FOR 称号番号, 0, 称号数
	SIF 称号名:称号番号 != "" && 称号の記録:番号:称号番号 > 0
		数 += 1
NEXT
RETURNF 数


;能力表示の称号の節。本番の相手の人数（一人でも居れば）と、持っている称号（台帳の番号順）
@能力表示_称号(番号)
#FUNCTIONS
#DIM 番号
#DIM 称号番号
#DIMS 出力

出力 '= ""
SIF 本番の相手数:番号:0 > 0
	出力 += @"　本番の相手 {本番の相手数:番号:0}人<br>"
FOR 称号番号, 0, 称号数
	SIF 称号名:称号番号 == "" || 称号の記録:番号:称号番号 <= 0
		CONTINUE
	出力 += @"　称号「%称号名:称号番号%」"
	SIF 称号の一言:称号番号 != ""
		出力 += @"　%称号の一言:称号番号%"
	出力 += "<br>"
NEXT
RETURNF 出力
